+/**
+ * RED: The real Rhythm plugin page currently crashes when rendered against only
+ * the six keys the @hermes/plugin-sdk state contract supports:
+ *   activeSessionId, cwd, gateway, model, profile, viewport
+ *
+ * The plugin reads host.state.connectionId which is absent from that list.
+ * useValue(undefined) throws during React render, producing the crash
+ * documented here. No production code is changed.
+ */
+import { render } from '@testing-library/react'
+import { atom } from 'nanostores'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+// Provide only the six supported contract keys; connectionId is intentionally
+// absent so the crash is observable through the supported surface alone.
+vi.mock('@hermes/plugin-sdk', async () => {
+  const { useStore } = await import('@nanostores/react')
+
+  const host = {
+    state: {
+      activeSessionId: atom<string | null>(null),
+      cwd: atom<string>(''),
+      gateway: atom<string>('idle'),
+      model: atom<string>('claude-3-5-sonnet'),
+      profile: atom<string>('default'),
+      viewport: atom<{ width: number; height: number; narrow: boolean }>({
+        width: 1280,
+        height: 800,
+        narrow: false,
+      }),
+      // connectionId is intentionally absent — it is not a supported contract key
+    },
+    newChat: vi.fn(),
+    notify: vi.fn(),
+    notifyError: vi.fn(),
+    activeConnectionId: () => null,
+    onEvent: () => () => undefined,
+  }
+
+  return {
+    host,
+    useValue: useStore,
+    PALETTE_AREA: 'palette',
+    ROUTES_AREA: 'routes',
+    SIDEBAR_NAV_AREA: 'sidebar.nav',
+    PANES_AREA: 'panes',
+  }
+})
+
+import { registry } from './registry'
+
+describe('RED: Rhythm page crashes with supported six-key SDK state contract', () => {
+  const disposers: Array<() => void> = []
+
+  afterEach(() => {
+    disposers.forEach(d => d())
+    disposers.length = 0
+  })
+
+  it('throws because host.state.connectionId is undefined under the supported contract', async () => {
+    // Suppress the React error log that accompanies the throw; the crash itself
+    // is what the test asserts.
+    const consoleError = vi.spyOn(console, 'error').mockImplementation(() => undefined)
+
+    const plugin = (await import('../../../../plugins/rhythm/desktop/src/plugin')).default
+    const { createPluginContext } = await import('./plugin')
+
+    const ctx = createPluginContext('rhythm', dispose => disposers.push(dispose))
+    plugin.register(ctx)
+
+    const route = registry
+      .getArea('routes')
+      .find(c => c.id === 'rhythm:page' && c.source === 'plugin:rhythm')
+
+    expect(route, 'rhythm:page route must be registered').toBeDefined()
+    expect(typeof route!.render).toBe('function')
+
+    const element = route!.render!()
+
+    // The render throws because useValue(host.state.connectionId) is called
+    // with undefined — connectionId is absent from the supported contract.
+    expect(() => render(element as React.ReactElement)).toThrow()
+
+    consoleError.mockRestore()
+  })
+})
