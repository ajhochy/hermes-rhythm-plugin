+import { cleanup, render, screen } from '@testing-library/react'
+import { afterEach, describe, expect, it } from 'vitest'
+
+import { contributedRoutes } from '@/app/routes'
+import { $narrowViewport } from '@/components/pane-shell/tree/store'
+
+import { createPluginContext } from './plugin'
+import plugin from '../../../../plugins/rhythm/desktop/src/plugin'
+
+describe('Rhythm page acceptance (#15)', () => {
+  afterEach(() => {
+    cleanup()
+    $narrowViewport.set(false)
+  })
+
+  it('issue-15-c1: passes viewport=compact to the workspace adapter when the window is narrow', async () => {
+    const disposers: Array<() => void> = []
+    plugin.register(createPluginContext('rhythm', dispose => disposers.push(dispose)))
+
+    $narrowViewport.set(true)
+
+    const [route] = contributedRoutes().filter(r => r.path === '/rhythm')
+    render(route.render())
+
+    const dashboardScreen = await screen.findByTestId('rhythm-dashboard-screen')
+    expect(dashboardScreen.getAttribute('data-rhythm-viewport')).toBe('compact')
+
+    disposers.forEach(d => d())
+  })
+
+  it('issue-15-c2: the workspace root carries the active connection identity for external framing', async () => {
+    const disposers: Array<() => void> = []
+    plugin.register(createPluginContext('rhythm', dispose => disposers.push(dispose)))
+
+    const [route] = contributedRoutes().filter(r => r.path === '/rhythm')
+    render(route.render())
+
+    const workspace = await screen.findByTestId('rhythm-workspace-readonly')
+    expect(workspace.getAttribute('data-connection-id')).toBe('local')
+
+    disposers.forEach(d => d())
+  })
+})
