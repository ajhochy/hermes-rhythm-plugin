+// Open Design typed bridge (OD-06) — see open-design/register-open-design-ipc.ts.
+// `openDesignRuntimePort` is the narrow seam S1 satisfies with a real
+// supervisor during integration; this standalone slice never launches or
+// discovers Open Design, so every request reports a truthful unavailable
+// state until a real port is installed here. `openDesignBindingStore` is
+// also read by installOpenDesignGuestPolicy (wireCommonWindowHandlers,
+// above) — one binding, shared by the bridge and the guest policy.
+const openDesignBindingStore = createOpenDesignBindingStore()
+const openDesignRuntimePort = createUnavailableOpenDesignRuntimePort()
+// The exact identity set both the bridge (sender/broadcast trust) and the
+// guest policy treat as "a trusted Hermes host window" — populated only in
+// wireCommonWindowHandlers, never inferred from "any BrowserWindow exists".
+const trustedOpenDesignHostWindows = new Set<BrowserWindow>()
+
+function broadcastOpenDesignStatus(status: unknown) {
+  for (const win of trustedOpenDesignHostWindows) {
+    if (!win.isDestroyed()) {
+      win.webContents.send(OPEN_DESIGN_IPC_CHANNELS.statusBroadcast, status)
+    }
+  }
+}
+
+registerOpenDesignIpc({
+  ipcMain,
+  resolveSenderInfo: (event: unknown) => {
+    const ipcEvent = event as Electron.IpcMainInvokeEvent
+    const senderWindow = BrowserWindow.fromWebContents(ipcEvent.sender)
+
+    return {
+      isTrustedHostWindow: senderWindow != null && trustedOpenDesignHostWindows.has(senderWindow),
+      isDestroyed: ipcEvent.sender.isDestroyed(),
+      isMainFrame: ipcEvent.senderFrame === ipcEvent.sender.mainFrame
+    }
+  },
+  runtimePort: openDesignRuntimePort,
+  bindingStore: openDesignBindingStore,
+  broadcast: broadcastOpenDesignStatus
+})
+
