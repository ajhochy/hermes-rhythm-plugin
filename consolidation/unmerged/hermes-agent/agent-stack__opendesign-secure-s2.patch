new file mode 100644
index 0000000000..7b6a8856b4
--- /dev/null
+++ b/apps/desktop/electron/open-design/owner-coordinator.ts
@@ -0,0 +1,47 @@
+/**
+ * S1 exposes exactly one process-wide Open Design runtime supervisor, not
+ * one per Hermes window — so exactly one trusted host window may drive it at
+ * a time. The first trusted window to acquire owns; every other trusted
+ * window is turned back with a stable non-ready status until the owner
+ * releases (window close) and a peer acquires next. Identity is opaque to
+ * this module on purpose: the caller (register-open-design-ipc.ts, main.ts)
+ * supplies whatever it trusts as "this window" — never anything the
+ * renderer could influence.
+ */
+export interface OpenDesignOwnerCoordinator {
+  /** First-come: returns true iff `windowKey` is (now, or already) the owner. */
+  acquire(windowKey: unknown): boolean
+  isOwner(windowKey: unknown): boolean
+  getOwner(): unknown | null
+  /** No-op unless `windowKey` IS the current owner. Returns whether it released. */
+  release(windowKey: unknown): boolean
+}
+
+export function createOpenDesignOwnerCoordinator(): OpenDesignOwnerCoordinator {
+  let owner: unknown | null = null
+
+  return {
+    acquire(windowKey) {
+      if (owner === null) {
+        owner = windowKey
+      }
+
+      return owner === windowKey
+    },
+    isOwner(windowKey) {
+      return owner !== null && owner === windowKey
+    },
+    getOwner() {
+      return owner
+    },
+    release(windowKey) {
+      if (owner !== windowKey) {
+        return false
+      }
+
+      owner = null
+
+      return true
+    }
+  }
+}
