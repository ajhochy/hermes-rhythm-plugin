@@ -0,0 +1,272 @@
+import { act, cleanup, render } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+import { OpenDesignGuestHost } from './webview-host'
+
+const ORIGIN = 'http://127.0.0.1:5173'
+const PARTITION = 'persist:open-design-default'
+
+afterEach(() => {
+  cleanup()
+})
+
+function domReady(webview: Element) {
+  act(() => {
+    webview.dispatchEvent(new Event('dom-ready'))
+  })
+}
+
+describe('OpenDesignGuestHost', () => {
+  it('mounts a real <webview> element pointed at the exact origin/partition, with no webpreferences/preload/nodeintegration attribute', () => {
+    const rendered = render(
+      <OpenDesignGuestHost applyInitialTheme={async () => true} onFailure={vi.fn()} origin={ORIGIN} partition={PARTITION} />
+    )
+
+    const webview = rendered.container.querySelector('webview')
+
+    expect(webview).toBeInstanceOf(HTMLElement)
+    expect(webview?.getAttribute('src')).toBe(ORIGIN)
+    expect(webview?.getAttribute('partition')).toBe(PARTITION)
+    expect(webview?.hasAttribute('webpreferences')).toBe(false)
+    expect(webview?.hasAttribute('preload')).toBe(false)
+    expect(webview?.hasAttribute('nodeintegration')).toBe(false)
+    // Popup REQUESTS must be enabled — Electron reads this flag from this
+    // exact attribute, never from anything main can mutate later (see
+    // guest-policy.ts). Popup CREATION is still always denied by main's
+    // setWindowOpenHandler regardless of this flag's value.
+    expect(webview?.getAttribute('allowpopups')).toBe('true')
+  })
+
+  it('stays hidden until BOTH dom-ready fires and the theme seam resolves true', async () => {
+    let resolveTheme: (ok: boolean) => void = () => undefined
+    const applyInitialTheme = vi.fn(() => new Promise<boolean>(resolve => (resolveTheme = resolve)))
+
+    const rendered = render(
+      <OpenDesignGuestHost applyInitialTheme={applyInitialTheme} onFailure={vi.fn()} origin={ORIGIN} partition={PARTITION} />
+    )
+
+    const host = rendered.container.querySelector('[data-open-design-guest-host]')
+    const webview = rendered.container.querySelector('webview')!
+
+    expect(host?.getAttribute('data-revealed')).toBe('false')
+    expect(applyInitialTheme).not.toHaveBeenCalled()
+
+    domReady(webview)
+    expect(applyInitialTheme).toHaveBeenCalledTimes(1)
+    expect(host?.getAttribute('data-revealed')).toBe('false')
+
+    await act(async () => {
+      resolveTheme(true)
+      await Promise.resolve()
+    })
+
+    expect(rendered.container.querySelector('[data-open-design-guest-host]')?.getAttribute('data-revealed')).toBe('true')
+  })
+
+  it('fails closed to a visible themed error when the theme seam rejects/resolves false', async () => {
+    const onFailure = vi.fn()
+
+    const rendered = render(
+      <OpenDesignGuestHost applyInitialTheme={async () => false} onFailure={onFailure} origin={ORIGIN} partition={PARTITION} />
+    )
+
+    const webview = rendered.container.querySelector('webview')!
+
+    await act(async () => {
+      domReady(webview)
+      await Promise.resolve()
+    })
+
+    expect(onFailure).toHaveBeenCalledWith('theme-rejected')
+    expect(rendered.container.querySelector('[data-open-design-guest-host]')?.getAttribute('data-revealed')).toBe('false')
+  })
+
+  it('does not reveal early — never before dom-ready even if it would resolve true', () => {
+    const rendered = render(
+      <OpenDesignGuestHost applyInitialTheme={async () => true} onFailure={vi.fn()} origin={ORIGIN} partition={PARTITION} />
+    )
+
+    expect(rendered.container.querySelector('[data-open-design-guest-host]')?.getAttribute('data-revealed')).toBe('false')
+  })
+
+  it('hides an already revealed guest synchronously when a new document starts loading', async () => {
+    const rendered = render(
+      <OpenDesignGuestHost applyInitialTheme={async () => true} onFailure={vi.fn()} origin={ORIGIN} partition={PARTITION} />
+    )
+    const webview = rendered.container.querySelector('webview')!
+
+    await act(async () => {
+      domReady(webview)
+      await Promise.resolve()
+    })
+    expect(rendered.container.querySelector('[data-open-design-guest-host]')?.getAttribute('data-revealed')).toBe('true')
+
+    act(() => {
+      webview.dispatchEvent(new Event('did-start-loading'))
+    })
+    expect(rendered.container.querySelector('[data-open-design-guest-host]')?.getAttribute('data-revealed')).toBe('false')
+  })
+
+  it('allows only the latest document theme promise to reveal the guest', async () => {
+    const themeResolvers: Array<(ok: boolean) => void> = []
+    const applyInitialTheme = vi.fn(() => new Promise<boolean>(resolve => themeResolvers.push(resolve)))
+    const rendered = render(
+      <OpenDesignGuestHost applyInitialTheme={applyInitialTheme} onFailure={vi.fn()} origin={ORIGIN} partition={PARTITION} />
+    )
+    const webview = rendered.container.querySelector('webview')!
+
+    domReady(webview)
+    expect(applyInitialTheme).toHaveBeenCalledTimes(1)
+
+    act(() => {
+      webview.dispatchEvent(new Event('did-start-loading'))
+    })
+    domReady(webview)
+    expect(applyInitialTheme).toHaveBeenCalledTimes(2)
+
+    await act(async () => {
+      themeResolvers[0](true)
+      await Promise.resolve()
+    })
+    expect(rendered.container.querySelector('[data-open-design-guest-host]')?.getAttribute('data-revealed')).toBe('false')
+
+    await act(async () => {
+      themeResolvers[1](true)
+      await Promise.resolve()
+    })
+    expect(rendered.container.querySelector('[data-open-design-guest-host]')?.getAttribute('data-revealed')).toBe('true')
+  })
+
+  it('reports a crashed failure on render-process-gone', () => {
+    const onFailure = vi.fn()
+
+    const rendered = render(
+      <OpenDesignGuestHost applyInitialTheme={async () => true} onFailure={onFailure} origin={ORIGIN} partition={PARTITION} />
+    )
+
+    const webview = rendered.container.querySelector('webview')!
+
+    act(() => {
+      webview.dispatchEvent(Object.assign(new Event('render-process-gone'), { reason: 'crashed' }))
+    })
+
+    expect(onFailure).toHaveBeenCalledWith('crashed')
+  })
+
+  it('never reveals from a pending theme promise after the renderer crashes', async () => {
+    let resolveTheme: (ok: boolean) => void = () => undefined
+    const rendered = render(
+      <OpenDesignGuestHost
+        applyInitialTheme={() => new Promise(resolve => (resolveTheme = resolve))}
+        onFailure={vi.fn()}
+        origin={ORIGIN}
+        partition={PARTITION}
+      />
+    )
+    const webview = rendered.container.querySelector('webview')!
+
+    domReady(webview)
+    act(() => {
+      webview.dispatchEvent(new Event('render-process-gone'))
+    })
+    await act(async () => {
+      resolveTheme(true)
+      await Promise.resolve()
+    })
+
+    expect(rendered.container.querySelector('[data-open-design-guest-host]')?.getAttribute('data-revealed')).toBe('false')
+  })
+
+  it('reports a load-failed failure on a main-frame did-fail-load, ignoring aborted/subframe loads', () => {
+    const onFailure = vi.fn()
+
+    const rendered = render(
+      <OpenDesignGuestHost applyInitialTheme={async () => true} onFailure={onFailure} origin={ORIGIN} partition={PARTITION} />
+    )
+
+    const webview = rendered.container.querySelector('webview')!
+
+    act(() => {
+      webview.dispatchEvent(Object.assign(new Event('did-fail-load'), { errorCode: -3, isMainFrame: true }))
+    })
+    expect(onFailure).not.toHaveBeenCalled()
+
+    act(() => {
+      webview.dispatchEvent(
+        Object.assign(new Event('did-fail-load'), { errorCode: -105, isMainFrame: false })
+      )
+    })
