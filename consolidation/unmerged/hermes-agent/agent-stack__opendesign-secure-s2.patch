diff --git a/apps/desktop/src/app/open-design/webview-host.tsx b/apps/desktop/src/app/open-design/webview-host.tsx
new file mode 100644
index 0000000000..3a0093816a
--- /dev/null
+++ b/apps/desktop/src/app/open-design/webview-host.tsx
@@ -0,0 +1,133 @@
+import { useEffect, useRef, useState } from 'react'
+
+import type { OpenDesignThemeSeam, OpenDesignThemeSeamTarget } from './theme-seam'
+
+export type OpenDesignGuestFailure = 'crashed' | 'load-failed' | 'theme-rejected'
+
+export interface OpenDesignGuestHostProps {
+  /** The exact healthy loopback runtime origin main resolved. */
+  origin: string
+  /** The exact main-issued profile-scoped partition. */
+  partition: string
+  /** The initial-theme application seam (S3 supplies the real one). */
+  applyInitialTheme: OpenDesignThemeSeam
+  onFailure: (failure: OpenDesignGuestFailure) => void
+}
+
+type GuestWebviewElement = HTMLElement & OpenDesignThemeSeamTarget
+
+/**
+ * Mounts the real, sandboxed Electron `<webview>` for the Open Design
+ * document. Main enforces every navigation/popup/download/permission policy
+ * (OD-07) — this component only presents the guest and gates its own
+ * visibility on `dom-ready` + the injected theme seam, per OD-09. It sets
+ * only the profile partition, exact origin, and the renderer-side popup
+ * delegation flag that lets main inspect requests; no `webpreferences` or
+ * preload attribute is ever exposed. Main remains the denying policy boundary.
+ */
+export function OpenDesignGuestHost({ applyInitialTheme, onFailure, origin, partition }: OpenDesignGuestHostProps) {
+  const hostRef = useRef<HTMLDivElement | null>(null)
+  const [revealed, setRevealed] = useState(false)
+
+  useEffect(() => {
+    const host = hostRef.current
+
+    if (!host) {
+      return
+    }
+
+    setRevealed(false)
+    host.replaceChildren()
+
+    const webview = document.createElement('webview') as GuestWebviewElement
+    webview.className = 'absolute inset-0 size-full'
+    webview.setAttribute('partition', partition)
+    webview.setAttribute('src', origin)
+    // Electron reads `allowpopups` from THIS element's own attribute, not
+    // from anything main can mutate in `will-attach-webview` (verified
+    // against real Electron — see guest-policy.ts). Without it, a popup
+    // request never reaches main's setWindowOpenHandler at all, silently
+    // defeating safe-external-link delegation. Popup CREATION is still
+    // always denied: setWindowOpenHandler (installed by main before this
+    // guest's page can run any script) unconditionally returns
+    // `{action:'deny'}` regardless of this flag.
+    webview.setAttribute('allowpopups', 'true')
+
+    let active = true
+    let themeEpoch = 0
+
+    const onDidStartLoading = () => {
+      if (active) {
+        themeEpoch += 1
+        setRevealed(false)
+      }
+    }
+
+    const onDomReady = () => {
+      const epoch = ++themeEpoch
+      setRevealed(false)
+
+      void applyInitialTheme(webview)
+        .then(ok => {
+          if (!active || epoch !== themeEpoch) {
+            return
+          }
+
+          if (ok) {
+            setRevealed(true)
+          } else {
+            onFailure('theme-rejected')
+          }
+        })
+        .catch(() => {
+          if (active && epoch === themeEpoch) {
+            onFailure('theme-rejected')
+          }
+        })
+    }
+
+    const onDidFailLoad = (event: Event) => {
+      const detail = event as Event & { errorCode?: number; isMainFrame?: boolean }
+
+      if (active && detail.isMainFrame === true && detail.errorCode !== -3) {
+        themeEpoch += 1
+        setRevealed(false)
+        onFailure('load-failed')
+      }
+    }
+
+    const onRenderProcessGone = () => {
+      if (active) {
+        themeEpoch += 1
+        setRevealed(false)
+        onFailure('crashed')
+      }
+    }
+
+    webview.addEventListener('did-start-loading', onDidStartLoading)
+    webview.addEventListener('dom-ready', onDomReady)
+    webview.addEventListener('did-fail-load', onDidFailLoad)
+    webview.addEventListener('render-process-gone', onRenderProcessGone)
+    host.appendChild(webview)
+
+    return () => {
+      active = false
+      webview.removeEventListener('did-start-loading', onDidStartLoading)
+      webview.removeEventListener('dom-ready', onDomReady)
+      webview.removeEventListener('did-fail-load', onDidFailLoad)
+      webview.removeEventListener('render-process-gone', onRenderProcessGone)
+      webview.remove()
+    }
+    // eslint-disable-next-line react-hooks/exhaustive-deps -- applyInitialTheme/onFailure are stable per the caller's contract; including them would remount the guest on every render.
+  }, [origin, partition])
+
+  return (
+    <div
+      className="absolute inset-0 size-full"
+      data-open-design-guest-host
+      data-revealed={revealed}
+      ref={hostRef}
+      style={revealed ? undefined : { opacity: 0, pointerEvents: 'none' }}
+    />
+  )
+}
