+import assert from 'node:assert/strict'
+
+import { test } from 'vitest'
+
+import { readyOriginIfValid, sanitizeOpenDesignGuestEvent, sanitizeOpenDesignStatus } from './status-contract'
+
+const BINDING = { profile: 'default', partition: 'persist:open-design-default' }
+const READY_ORIGIN = 'http://127.0.0.1:5173'
+
+function validReadyRaw(overrides: Record<string, unknown> = {}) {
+  return {
+    state: 'ready',
+    origin: READY_ORIGIN,
+    source: 'packaged',
+    version: '0.20.0',
+    owned: true,
+    ...overrides
+  }
+}
+
+test('passes through each bare state untouched', () => {
+  assert.deepEqual(sanitizeOpenDesignStatus({ state: 'idle' }, null), { state: 'idle' })
+  assert.deepEqual(sanitizeOpenDesignStatus({ state: 'starting' }, null), { state: 'starting' })
+  assert.deepEqual(sanitizeOpenDesignStatus({ state: 'migrating' }, null), { state: 'migrating' })
+  assert.deepEqual(sanitizeOpenDesignStatus({ state: 'retrying' }, null), { state: 'retrying' })
+})
+
+test('bare states drop any extra/spoofed fields (e.g. an injected origin)', () => {
+  assert.deepEqual(sanitizeOpenDesignStatus({ state: 'idle', origin: 'http://evil.example.com' }, null), {
+    state: 'idle'
+  })
+})
+
+test('reason states pass through a recognized bounded reason code', () => {
+  assert.deepEqual(sanitizeOpenDesignStatus({ state: 'unavailable', reason: 'runtime_not_installed' }, null), {
+    state: 'unavailable',
+    reason: 'runtime_not_installed'
+  })
+  assert.deepEqual(sanitizeOpenDesignStatus({ state: 'crashed', reason: 'load_failed' }, null), {
+    state: 'crashed',
+    reason: 'load_failed'
+  })
+  assert.deepEqual(sanitizeOpenDesignStatus({ state: 'unsupported', reason: 'platform_unsupported' }, null), {
+    state: 'unsupported',
+    reason: 'platform_unsupported'
+  })
+  assert.deepEqual(sanitizeOpenDesignStatus({ state: 'error', reason: 'unknown' }, null), {
+    state: 'error',
+    reason: 'unknown'
+  })
+})
+
+test('reason states drop an unrecognized/arbitrary reason string (never raw logs or stack traces)', () => {
+  assert.deepEqual(
+    sanitizeOpenDesignStatus({ state: 'error', reason: 'TypeError: boom\n  at /Users/x/secret.js:42' }, null),
+    { state: 'error' }
+  )
+})
+
+test('reason states omit reason entirely when absent', () => {
+  assert.deepEqual(sanitizeOpenDesignStatus({ state: 'unavailable' }, null), { state: 'unavailable' })
+})
+
+test('ready: passes through sanitized facts when the binding is present and every field is valid', () => {
+  assert.deepEqual(sanitizeOpenDesignStatus(validReadyRaw(), BINDING), {
+    state: 'ready',
+    origin: READY_ORIGIN,
+    partition: BINDING.partition,
+    source: 'packaged',
+    version: '0.20.0',
+    profile: BINDING.profile,
+    owned: true
+  })
+})
+
+test('ready: partition and profile always come from the binding, never from raw', () => {
+  const result = sanitizeOpenDesignStatus(
+    validReadyRaw({ partition: 'persist:open-design-attacker', profile: 'attacker' }),
+    BINDING
+  )
+
+  assert.deepEqual(result, {
+    state: 'ready',
+    origin: READY_ORIGIN,
+    partition: BINDING.partition,
+    source: 'packaged',
+    version: '0.20.0',
+    profile: BINDING.profile,
+    owned: true
+  })
+})
+
+test('ready: drops every extra/unexpected field, including prototype-pollution-shaped keys', () => {
+  const result = sanitizeOpenDesignStatus(
+    validReadyRaw({ secretPath: '/etc/passwd', pid: 4242, __proto__: { polluted: true } }),
+    BINDING
+  ) as Record<string, unknown>
+
+  assert.deepEqual(Object.keys(result).sort(), ['origin', 'owned', 'partition', 'profile', 'source', 'state', 'version'])
+  assert.equal((result as { polluted?: boolean }).polluted, undefined)
+})
+
+test('ready: downgrades to unavailable when no profile is bound yet', () => {
+  assert.deepEqual(sanitizeOpenDesignStatus(validReadyRaw(), null), { state: 'unavailable', reason: 'no_profile_bound' })
+})
+
+test('ready: rejects an invalid origin (https, localhost alias, non-loopback)', () => {
+  assert.deepEqual(sanitizeOpenDesignStatus(validReadyRaw({ origin: 'https://127.0.0.1:5173' }), BINDING), {
+    state: 'error',
+    reason: 'invalid_status'
+  })
+  assert.deepEqual(sanitizeOpenDesignStatus(validReadyRaw({ origin: 'http://localhost:5173' }), BINDING), {
+    state: 'error',
+    reason: 'invalid_status'
+  })
+  assert.deepEqual(sanitizeOpenDesignStatus(validReadyRaw({ origin: 'not a url' }), BINDING), {
+    state: 'error',
+    reason: 'invalid_status'
+  })
+})
+
+test('ready: rejects an unrecognized source', () => {
+  assert.deepEqual(sanitizeOpenDesignStatus(validReadyRaw({ source: 'sideloaded' }), BINDING), {
+    state: 'error',
+    reason: 'invalid_status'
+  })
+})
+
+test('ready: rejects a missing/oversized/control-character version string', () => {
+  assert.deepEqual(sanitizeOpenDesignStatus(validReadyRaw({ version: undefined }), BINDING), {
+    state: 'error',
+    reason: 'invalid_status'
+  })
+  assert.deepEqual(sanitizeOpenDesignStatus(validReadyRaw({ version: 'x'.repeat(64) }), BINDING), {
+    state: 'error',
+    reason: 'invalid_status'
+  })
+  assert.deepEqual(sanitizeOpenDesignStatus(validReadyRaw({ version: '0.20.0\n[secret env dump]' }), BINDING), {
+    state: 'error',
+    reason: 'invalid_status'
+  })
+})
+
+test('ready: rejects a non-boolean owned', () => {
+  assert.deepEqual(sanitizeOpenDesignStatus(validReadyRaw({ owned: 'true' }), BINDING), {
+    state: 'error',
+    reason: 'invalid_status'
+  })
+  assert.deepEqual(sanitizeOpenDesignStatus(validReadyRaw({ owned: 1 }), BINDING), {
+    state: 'error',
+    reason: 'invalid_status'
+  })
+})
+
+test('rejects an unknown state name', () => {
+  assert.deepEqual(sanitizeOpenDesignStatus({ state: 'hacked' }, BINDING), { state: 'error', reason: 'invalid_status' })
+})
+
+test('rejects a missing state field', () => {
+  assert.deepEqual(sanitizeOpenDesignStatus({}, BINDING), { state: 'error', reason: 'invalid_status' })
+})
+
+test('rejects non-object raw values (string, number, array, null, undefined)', () => {
+  assert.deepEqual(sanitizeOpenDesignStatus('ready', BINDING), { state: 'error', reason: 'invalid_status' })
+  assert.deepEqual(sanitizeOpenDesignStatus(42, BINDING), { state: 'error', reason: 'invalid_status' })
+  assert.deepEqual(sanitizeOpenDesignStatus(['ready'], BINDING), { state: 'error', reason: 'invalid_status' })
+  assert.deepEqual(sanitizeOpenDesignStatus(null, BINDING), { state: 'error', reason: 'invalid_status' })
+  assert.deepEqual(sanitizeOpenDesignStatus(undefined, BINDING), { state: 'error', reason: 'invalid_status' })
+})
+
+test('rejects a non-string state field', () => {
+  assert.deepEqual(sanitizeOpenDesignStatus({ state: 42 }, BINDING), { state: 'error', reason: 'invalid_status' })
+})
+
+// ── getter/proxy/prototype hostility (never throws, never invokes a getter) ─
+
+test('a throwing getter on a known field never propagates — it is treated as absent', () => {
+  const hostile: Record<string, unknown> = { state: 'ready', source: 'packaged', version: '0.20.0', owned: true }
+
+  Object.defineProperty(hostile, 'origin', {
+    enumerable: true,
+    get() {
+      throw new Error('gotcha')
+    }
+  })
+
+  assert.doesNotThrow(() => sanitizeOpenDesignStatus(hostile, BINDING))
+  assert.deepEqual(sanitizeOpenDesignStatus(hostile, BINDING), { state: 'error', reason: 'invalid_status' })
+})
+
+test('a throwing getter on `state` itself never propagates', () => {
+  const hostile = {}
+
+  Object.defineProperty(hostile, 'state', {
+    enumerable: true,
+    get() {
+      throw new Error('gotcha')
+    }
+  })
+
+  assert.doesNotThrow(() => sanitizeOpenDesignStatus(hostile, BINDING))
+  assert.deepEqual(sanitizeOpenDesignStatus(hostile, BINDING), { state: 'error', reason: 'invalid_status' })
+})
+
+test('rejects an object with a non-plain prototype even when shaped correctly', () => {
+  class Hostile {
+    state = 'ready'
+    origin = READY_ORIGIN
+    source = 'packaged'
+    version = '0.20.0'
+    owned = true
+  }
+
+  assert.deepEqual(sanitizeOpenDesignStatus(new Hostile(), BINDING), { state: 'error', reason: 'invalid_status' })
+})
+
+test('rejects a value whose fields exist only on the prototype chain (inherited, not own)', () => {
+  const proto = { state: 'ready', origin: READY_ORIGIN, source: 'packaged', version: '0.20.0', owned: true }
+  const inherited = Object.create(proto)
+
+  assert.deepEqual(sanitizeOpenDesignStatus(inherited, BINDING), { state: 'error', reason: 'invalid_status' })
+})
+
+test('never throws for a Proxy whose traps throw on every access', () => {
+  const proxy = new Proxy(
+    { state: 'ready' },
+    {
+      get() {
+        throw new Error('get trap')
+      },
+      getOwnPropertyDescriptor() {
+        throw new Error('descriptor trap')
+      },
+      getPrototypeOf() {
+        throw new Error('proto trap')
+      }
+    }
+  )
+
+  assert.doesNotThrow(() => sanitizeOpenDesignStatus(proxy, BINDING))
+  assert.deepEqual(sanitizeOpenDesignStatus(proxy, BINDING), { state: 'error', reason: 'invalid_status' })
+})
+
+test('treats an accessor (get/set) property as absent rather than invoking it', () => {
+  // A well-behaved (non-throwing) getter is still refused — a status field
+  // implemented as an accessor is not the bounded data contract regardless
+  // of whether it happens to be safe to call.
+  const shaped: Record<string, unknown> = { state: 'ready', source: 'packaged', version: '0.20.0', owned: true }
+
+  Object.defineProperty(shaped, 'origin', { enumerable: true, get: () => READY_ORIGIN })
+
+  assert.deepEqual(sanitizeOpenDesignStatus(shaped, BINDING), { state: 'error', reason: 'invalid_status' })
+})
+
+// ── readyOriginIfValid (OD-06 finding #1: syncing main's binding authority) ─
+
+test('readyOriginIfValid extracts the origin only from a well-formed ready status', () => {
+  assert.equal(readyOriginIfValid(validReadyRaw()), READY_ORIGIN)
+})
+
+test('readyOriginIfValid returns null for any non-ready state', () => {
+  assert.equal(readyOriginIfValid({ state: 'starting' }), null)
+  assert.equal(readyOriginIfValid({ state: 'crashed' }), null)
+})
+
+test('readyOriginIfValid returns null for an invalid origin on an otherwise-ready status', () => {
+  assert.equal(readyOriginIfValid(validReadyRaw({ origin: 'https://127.0.0.1:5173' })), null)
+  assert.equal(readyOriginIfValid(validReadyRaw({ origin: 'not a url' })), null)
+})
+
+test('readyOriginIfValid is hostile-input-safe', () => {
+  assert.doesNotThrow(() => readyOriginIfValid('ready'))
+  assert.equal(readyOriginIfValid(null), null)
+  assert.equal(readyOriginIfValid(undefined), null)
+
+  const hostile = {}
+
+  Object.defineProperty(hostile, 'state', {
+    enumerable: true,
+    get() {
+      throw new Error('gotcha')
+    }
+  })
+  assert.doesNotThrow(() => readyOriginIfValid(hostile))
+  assert.equal(readyOriginIfValid(hostile), null)
+})
+
+// ── sanitizeOpenDesignGuestEvent (finding #5: main publishes, never just logs) ─
+
+test('sanitizeOpenDesignGuestEvent maps crashed to a bounded crashed status with no raw reason', () => {
+  assert.deepEqual(sanitizeOpenDesignGuestEvent('crashed'), { state: 'crashed' })
+})
+
+test('sanitizeOpenDesignGuestEvent maps load-failed to a bounded error status', () => {
+  assert.deepEqual(sanitizeOpenDesignGuestEvent('load-failed'), { state: 'error', reason: 'load_failed' })
+})
+
+test('sanitizeOpenDesignGuestEvent maps stale-revoked to a bounded unavailable status', () => {
+  assert.deepEqual(sanitizeOpenDesignGuestEvent('stale-revoked'), { state: 'unavailable', reason: 'stale_binding' })
+})
diff --git a/apps/desktop/electron/open-design/status-contract.ts b/apps/desktop/electron/open-design/status-contract.ts
