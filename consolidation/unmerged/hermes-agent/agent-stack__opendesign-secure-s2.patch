+import assert from 'node:assert/strict'
+
+import { test } from 'vitest'
+
+import { createUnavailableOpenDesignRuntimePort } from './runtime-port'
+
+const UNAVAILABLE = { state: 'unavailable', reason: 'runtime_not_installed' }
+
+function flushMicrotasks(): Promise<void> {
+  return new Promise(resolve => setTimeout(resolve, 0))
+}
+
+test('getStatus reports a truthful unavailable state', async () => {
+  const port = createUnavailableOpenDesignRuntimePort()
+
+  assert.deepEqual(await port.getStatus(), UNAVAILABLE)
+})
+
+test('start does not fabricate a running instance', async () => {
+  const port = createUnavailableOpenDesignRuntimePort()
+
+  assert.deepEqual(await port.start(), UNAVAILABLE)
+})
+
+test('retry does not fabricate a running instance', async () => {
+  const port = createUnavailableOpenDesignRuntimePort()
+
+  assert.deepEqual(await port.retry(), UNAVAILABLE)
+})
+
+test('stopOwned is a safe no-op', async () => {
+  const port = createUnavailableOpenDesignRuntimePort()
+
+  assert.deepEqual(await port.stopOwned(), UNAVAILABLE)
+})
+
+test('setProfile ignores its argument and stays unavailable', async () => {
+  const port = createUnavailableOpenDesignRuntimePort()
+
+  assert.deepEqual(await port.setProfile('anything'), UNAVAILABLE)
+  assert.deepEqual(await port.setProfile(undefined as unknown as string), UNAVAILABLE)
+})
+
+test('onStatus eventually reports the truthful unavailable state to a fresh subscriber', async () => {
+  const port = createUnavailableOpenDesignRuntimePort()
+  const received: unknown[] = []
+
+  port.onStatus(status => received.push(status))
+  await flushMicrotasks()
+
+  assert.deepEqual(received, [UNAVAILABLE])
+})
+
+test('onStatus notifies every independently registered listener', async () => {
+  const port = createUnavailableOpenDesignRuntimePort()
+  const first: unknown[] = []
+  const second: unknown[] = []
+
+  port.onStatus(status => first.push(status))
+  port.onStatus(status => second.push(status))
+  await flushMicrotasks()
+
+  assert.deepEqual(first, [UNAVAILABLE])
+  assert.deepEqual(second, [UNAVAILABLE])
+})
+
+test('onStatus unsubscribe prevents the callback from firing', async () => {
+  const port = createUnavailableOpenDesignRuntimePort()
+  const received: unknown[] = []
+
+  const unsubscribe = port.onStatus(status => received.push(status))
+  unsubscribe()
+  await flushMicrotasks()
+
+  assert.deepEqual(received, [])
+})
diff --git a/apps/desktop/electron/open-design/runtime-port.ts b/apps/desktop/electron/open-design/runtime-port.ts
new file mode 100644
index 0000000000..5287250344
--- /dev/null
+++ b/apps/desktop/electron/open-design/runtime-port.ts
@@ -0,0 +1,56 @@
+/**
+ * The narrow seam S1's real runtime supervisor satisfies during integration.
+ * This slice never launches, discovers, or supervises Open Design — it only
+ * defines the shape and ships a fail-closed default so the standalone S2
+ * main reports a truthful `unavailable` state instead of a fabricated one
+ * when no real port has been installed.
+ *
+ * Every method returns `unknown`: the caller (register-open-design-ipc.ts)
+ * always runs the result through `sanitizeOpenDesignStatus` before it can
+ * reach a renderer, so a future real implementation's raw shape is never
+ * trusted here either.
+ */
+export interface OpenDesignRuntimePort {
+  getStatus(): Promise<unknown>
+  start(): Promise<unknown>
+  retry(): Promise<unknown>
+  stopOwned(): Promise<unknown>
+  setProfile(profile: string): Promise<unknown>
+  /** Returns an unsubscribe function. */
+  onStatus(listener: (raw: unknown) => void): () => void
+}
+
+const UNAVAILABLE = Object.freeze({ state: 'unavailable', reason: 'runtime_not_installed' })
+
+/**
+ * Fail-closed default: no process is ever spawned, no state is fabricated.
+ * `onStatus` still reports the truthful unavailable state to every
+ * subscriber (asynchronously, so registration order never matters) rather
+ * than leaving the renderer to guess why nothing ever arrives.
+ */
+export function createUnavailableOpenDesignRuntimePort(): OpenDesignRuntimePort {
+  async function unavailable(): Promise<unknown> {
+    return UNAVAILABLE
+  }
+
+  return {
+    getStatus: unavailable,
+    start: unavailable,
+    retry: unavailable,
+    stopOwned: unavailable,
+    setProfile: async () => UNAVAILABLE,
+    onStatus(listener) {
+      let disposed = false
+
+      void Promise.resolve().then(() => {
+        if (!disposed) {
+          listener(UNAVAILABLE)
+        }
+      })
+
+      return () => {
+        disposed = true
+      }
+    }
+  }
+}
diff --git a/apps/desktop/electron/open-design/security-harness.ts b/apps/desktop/electron/open-design/security-harness.ts
new file mode 100644
index 0000000000..8f70022d07
--- /dev/null
+++ b/apps/desktop/electron/open-design/security-harness.ts
@@ -0,0 +1,498 @@
+/**
+ * Disposable real-Electron harness for OD-07 (`electron/open-design/guest-
+ * policy.ts`). Unit tests with fake Electron surfaces (guest-policy.test.ts)
+ * prove the module's LOGIC is called correctly; they cannot prove Electron
+ * ITSELF behaves the way those fakes assume. This harness runs the actual
+ * production `installOpenDesignGuestPolicy` (and `binding-store.ts`)
+ * against a real `<webview>`, a real local loopback HTTP server, and real
+ * Electron APIs, in an isolated `userData` directory. It is not part of the
+ * normal test suite (Electron cannot run under vitest) — see package.json's
+ * `test:open-design:security-harness`.
+ *
+ * Run via: npm run test:open-design:security-harness (bundles this file with
+ * esbuild first — see scripts/bundle-open-design-harness.mjs — because the
+ * production modules use extensionless relative imports that a bare
+ * TS-stripping Node run cannot resolve on its own).
+ */
+import assert from 'node:assert/strict'
+import { mkdtempSync, rmSync } from 'node:fs'
+import http from 'node:http'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+
+import { app, BrowserWindow, session } from 'electron'
+
+import { isBlockedOpenDesignAnalyticsRequest } from './analytics-block'
+import { createOpenDesignBindingStore } from './binding-store'
+import { installOpenDesignGuestPolicy } from './guest-policy'
+
+const PREVIEW_PARTITION = 'persist:hermes-preview'
+
+function log(message: string): void {
+  console.log(`[harness] ${message}`)
+}
+
+type RootPageVariant = 'interactive' | 'plain' | 'startup-popup'
+
+// The initial `<webview src>` must be the EXACT bound origin root (OD-07 —
+// no path is ever allowed as an initial source, verified above by the
+// "extra path denied" scenario). So every root-page-content variant this
+// harness needs — including the deliberately hostile ones — is served AT
+// the root itself, switched by this flag, rather than as a separate path a
+// real initial attach could never legally reach.
+let rootPageVariant: RootPageVariant = 'plain'
+
+const ROOT_PAGES: Record<RootPageVariant, string> = {
+  plain: '<!doctype html><html><body id="body">harness-guest</body></html>',
+  // An immediate, inline, startup popup attempt — no executeJavaScript round
+  // trip at all. Proves did-attach-webview installs the deny handler before
+  // the guest's OWN page script ever gets a chance to run (the "startup
+  // race" the popup-delegation finding specifically called out).
+  'startup-popup': '<!doctype html><html><body><script>window.open("https://example.com/inline-popup")</script></body></html>',
+  interactive:
+    '<!doctype html><html><body>' +
+    '<a id="anchor" href="https://example.com/anchor-blank" target="_blank">anchor</a>' +
+    '<form id="form" action="https://example.com/form-blank" target="_blank"><button id="submit" type="submit">go</button></form>' +
+    '</body></html>'
+}
+
+function startServer(): Promise<{ server: http.Server; origin: string }> {
+  const server = http.createServer((req, res) => {
+    if (req.url === '/file.bin') {
+      res.writeHead(200, { 'Content-Type': 'application/octet-stream', 'Content-Disposition': 'attachment; filename="file.bin"' })
+      res.end(Buffer.from([1, 2, 3, 4]))
+
+      return
+    }
+
+    // Any non-root path (the SPA-navigation/download targets) always gets
+    // plain content — only the ROOT's variant is ever switched.
+    const body = req.url === '/' || !req.url ? ROOT_PAGES[rootPageVariant] : ROOT_PAGES.plain
+
+    res.writeHead(200, { 'Content-Type': 'text/html' })
+    res.end(body)
+  })
+
+  return new Promise((resolve, reject) => {
+    server.on('error', reject)
+    server.listen(0, '127.0.0.1', () => {
+      const address = server.address()
+
+      if (!address || typeof address === 'string') {
+        reject(new Error('server did not bind to a loopback port'))
+
+        return
+      }
+
+      resolve({ server, origin: `http://127.0.0.1:${address.port}` })
+    })
+  })
+}
+
+/** Injects a `<webview>` into the host window's document and resolves with
+ *  the attached guest `WebContents`, or `null` if `did-attach-webview` never
+ *  fires within the deadline (i.e. `will-attach-webview` rejected it).
+ *  Matches the resolved event by the EXACT dedicated session identity
+ *  (`session.fromPartition`), never by attach order/position: this harness
+ *  deliberately runs concurrent, interleaved attaches (see the "concurrent
+ *  Open Design + unrelated preview attach" scenario), and a naive `once`
+ *  listener pairing would hand one call's promise the OTHER call's guest
+ *  whenever their two `did-attach-webview` events interleave — the exact
+ *  FIFO-is-not-identity bug production's own pendingApprovals map (see
+ *  guest-policy.ts) was hardened against. */
+async function attachWebview(
+  win: BrowserWindow,
+  attrs: { partition: string; src: string }
+): Promise<Electron.WebContents | null> {
+  const expectedSession = session.fromPartition(attrs.partition)
+
+  const attachPromise = new Promise<Electron.WebContents | null>(resolvePromise => {
+    let settled = false
+
+    const onAttach = (_event: unknown, guestContents: Electron.WebContents) => {
+      if (settled || guestContents.session !== expectedSession) {
+        return
+      }
+
+      settled = true
+      win.webContents.removeListener('did-attach-webview', onAttach)
+      resolvePromise(guestContents)
+    }
+
+    win.webContents.on('did-attach-webview', onAttach)
+    setTimeout(() => {
+      if (!settled) {
+        settled = true
+        win.webContents.removeListener('did-attach-webview', onAttach)
+        resolvePromise(null)
+      }
+    }, 3000)
+  })
+
+  await win.webContents.executeJavaScript(`
+    (function () {
+      const wv = document.createElement('webview')
+      wv.setAttribute('partition', ${JSON.stringify(attrs.partition)})
+      wv.setAttribute('src', ${JSON.stringify(attrs.src)})
+      wv.setAttribute('allowpopups', 'true')
+      document.body.appendChild(wv)
+    })()
+  `)
+
+  return attachPromise
+}
+
+/** Attaches a webview and resolves once it BOTH attached and finished
+ *  loading (dom-ready) — needed before a startup inline script can be
+ *  observed to have already run. Uses the GUEST's own `dom-ready` webContents
+ *  event (observable directly from main) rather than a DOM script racing the
+ *  element's own creation — bounded with a timeout so a missed/already-fired
+ *  event can never hang the harness. */
+async function attachAndWaitForDomReady(win: BrowserWindow, attrs: { partition: string; src: string }) {
+  const guest = await attachWebview(win, attrs)
+
+  if (!guest) {
+    return guest
+  }
+
+  await new Promise<void>(resolveReady => {
+    let settled = false
+    const finish = () => {
+      if (!settled) {
+        settled = true
+        resolveReady()
+      }
+    }
+
+    guest.once('dom-ready', finish)
+    setTimeout(finish, 2000)
+  })
+
+  // Give a startup inline <script> a tick to actually execute and reach
+  // setWindowOpenHandler/window.open — dom-ready fires once the document is
+  // constructed, essentially synchronous with inline script execution, but
+  // a macrotask of slack keeps this robust.
+  await new Promise(resolveWait => setTimeout(resolveWait, 200))
+
+  return guest
+}
+
+/** Clicks an element under a genuine `userGesture`, exercising the REAL
+ *  anchor `target=_blank` / form-submit-with-target navigation-type decision
+ *  Chromium makes from the element's own attributes — `executeJavaScript`'s
+ *  `userGesture` flag (not a coordinate-based synthetic OS input event,
+ *  which proved unreliable against a `<webview>` guest's compositor) is
+ *  what actually determines whether this counts as user-activated for the
+ *  popup-blocker / setWindowOpenHandler decision either way. */
+async function clickElement(guestContents: Electron.WebContents, selector: string): Promise<void> {
+  await guestContents.executeJavaScript(`document.querySelector(${JSON.stringify(selector)}).click()`, true)
+}
+
+async function createHostWindow(): Promise<BrowserWindow> {
+  const win = new BrowserWindow({
+    show: false,
+    webPreferences: { contextIsolation: true, nodeIntegration: false, sandbox: true, webviewTag: true }
+  })
+
+  await win.loadURL('data:text/html,<!doctype html><html><body></body></html>')
+
+  return win
+}
+
+async function run(): Promise<void> {
+  const runtimeDir = mkdtempSync(join(tmpdir(), 'hermes-open-design-harness-'))
+  app.setPath('userData', runtimeDir)
+  app.setPath('sessionData', runtimeDir)
+
+  const { server, origin } = await startServer()
+  log(`local loopback origin: ${origin}`)
+
+  const bindingStore = createOpenDesignBindingStore()
+  const binding = bindingStore.setProfile('harness')
+  assert.ok(binding, 'profile normalization must accept "harness"')
+  bindingStore.setOrigin(origin)
+
+  const externalUrls: string[] = []
+  const guestEvents: Array<{ type: string; [key: string]: unknown }> = []
+  const windowsToDestroy: BrowserWindow[] = []
+  let scenarioFailure: { error: unknown } | null = null
+  let cleanupFailure: { error: unknown } | null = null
+
+  function wirePolicy(win: BrowserWindow): void {
+    installOpenDesignGuestPolicy(win, {
+      bindingReader: bindingStore,
+      resolveSessionForPartition: partitionName => session.fromPartition(partitionName),
+      isBlockedAnalyticsRequest: isBlockedOpenDesignAnalyticsRequest,
+      openExternalUrl: url => {
+        // Captured, never actually opened — proves delegation without
+        // launching a real OS browser.
+        externalUrls.push(url)
+      },
+      onGuestEvent: event => guestEvents.push(event)
+    })
+  }
+
+  try {
+    const startWindowCount = BrowserWindow.getAllWindows().length
+
+    // ── 1. Hostile initial source is denied ──────────────────────────────
+    const host1 = await createHostWindow()
+    windowsToDestroy.push(host1)
+    wirePolicy(host1)
+
+    const hostileGuest = await attachWebview(host1, { partition: binding.partition, src: 'http://evil.example.com' })
+    assert.equal(hostileGuest, null, 'a hostile initial source must be denied, not downgraded')
+    log('PASS: hostile initial source denied')
+
+    // A matching partition but wrong path/origin on the bound host is denied too.
+    const malformedGuest = await attachWebview(host1, { partition: binding.partition, src: `${origin}/extra` })
+    assert.equal(malformedGuest, null, 'an initial source with an extra path must be denied')
+    log('PASS: initial source with extra path denied')
+
+    // ── 2. Exact initial attach succeeds with hardened preferences ───────
+    const guest = await attachWebview(host1, { partition: binding.partition, src: origin })
+    assert.ok(guest, 'the exact bound origin/partition must attach')
+    assert.ok(!guest.isDestroyed(), 'guest must be alive after attach')
+
+    const nodeLeak = await guest.executeJavaScript(
+      "JSON.stringify({ hasRequire: typeof require !== 'undefined', hasProcess: typeof process !== 'undefined', hasModule: typeof module !== 'undefined' })"
+    )
+    assert.deepEqual(
+      JSON.parse(nodeLeak),
+      { hasRequire: false, hasProcess: false, hasModule: false },
+      'no Node global may leak into the guest (nodeIntegration/contextIsolation/sandbox enforced)'
+    )
+    log('PASS: exact initial attach succeeded with no Node/require/process/module leak')
+
+    // ── 3. Same-origin SPA navigation works ──────────────────────────────
+    await guest.executeJavaScript("history.pushState({}, '', '/projects/42'); document.title = 'navigated'")
+    assert.equal(new URL(guest.getURL()).pathname, '/projects/42', 'same-origin SPA path navigation must be reflected')
+    log('PASS: same-origin SPA navigation allowed')
+
+    // ── 4. Cross-origin navigation is blocked ────────────────────────────
+    const beforeCrossOrigin = guest.getURL()
+
+    await guest.executeJavaScript("location.href = 'https://example.com/'").catch(() => undefined)
+    await new Promise(resolveWait => setTimeout(resolveWait, 500))
+    assert.equal(guest.getURL(), beforeCrossOrigin, 'cross-origin navigation must be blocked (URL must not change)')
+    log('PASS: cross-origin navigation blocked')
+
+    // ── 5. Popup denied; safe external delegation captured, not opened ───
+    // `userGesture: true` — window.open() from a gesture-less executeJavaScript
+    // call is eaten by Chromium's popup blocker before setWindowOpenHandler
+    // ever sees it; this simulates the real user-initiated click OD-07 requires.
+    await guest.executeJavaScript("window.open('https://example.com/docs')", true).catch(() => undefined)
+    await new Promise(resolveWait => setTimeout(resolveWait, 500))
+    assert.equal(BrowserWindow.getAllWindows().length, startWindowCount + 1, 'a popup must never create a new BrowserWindow')
+    assert.deepEqual(externalUrls, ['https://example.com/docs'], 'a safe https popup target must be delegated externally, exactly once')
+
+    externalUrls.length = 0
+    await guest.executeJavaScript(`window.open(${JSON.stringify(origin)})`, true).catch(() => undefined)
+    await new Promise(resolveWait => setTimeout(resolveWait, 300))
+    assert.deepEqual(externalUrls, [], 'a same-origin popup must be denied without external delegation')
+    log('PASS: scripted popup denied; only a safe external target was captured (never actually opened)')
+
+    // ── 5b. Startup popup race: an inline script's window.open() must be
+    // denied even though it runs before any executeJavaScript round trip —
+    // proving did-attach-webview installs the handler before guest script
+    // ever executes, not just before OUR test script happens to run. The
+    // hostile content is served at the ROOT itself (never a path — the
+    // initial src may only ever be the exact bound origin root).
+    externalUrls.length = 0
+    rootPageVariant = 'startup-popup'
+
+    const startupGuest = await attachAndWaitForDomReady(host1, { partition: binding.partition, src: origin })
+
+    rootPageVariant = 'plain'
+    assert.ok(startupGuest, 'the startup-popup guest must still attach normally')
+    assert.equal(BrowserWindow.getAllWindows().length, startWindowCount + 1, 'no BrowserWindow may appear from a startup inline popup')
+    assert.deepEqual(externalUrls, ['https://example.com/inline-popup'], 'the startup popup target is still captured for safe delegation')
+    log('PASS: startup inline-script popup denied before guest script could create a window; safe target still captured')
+
+    // ── 5c. A real user click on an anchor target=_blank is denied ───────
+    externalUrls.length = 0
+    rootPageVariant = 'interactive'
+
+    const interactiveGuest = await attachAndWaitForDomReady(host1, { partition: binding.partition, src: origin })
+
+    rootPageVariant = 'plain'
+    assert.ok(interactiveGuest, 'the interactive guest must attach')
+    await clickElement(interactiveGuest, '#anchor')
+    await new Promise(resolveWait => setTimeout(resolveWait, 500))
+    assert.equal(BrowserWindow.getAllWindows().length, startWindowCount + 1, 'a real anchor target=_blank click must never create a BrowserWindow')
+    assert.deepEqual(externalUrls, ['https://example.com/anchor-blank'], 'the anchor target is captured for safe delegation, not opened')
+    log('PASS: anchor target=_blank denied under a real user gesture; safe target captured')
+
+    // ── 5d. A real user click submitting a form target=_blank is denied ──
+    externalUrls.length = 0
+    await clickElement(interactiveGuest, '#submit')
+    await new Promise(resolveWait => setTimeout(resolveWait, 500))
+    assert.equal(BrowserWindow.getAllWindows().length, startWindowCount + 1, 'a real form target=_blank submit must never create a BrowserWindow')
+    // A real GET form submit appends its (empty) field set as `?` — genuine
+    // browser encoding behavior, not a harness artifact.
+    assert.deepEqual(externalUrls, ['https://example.com/form-blank?'], 'the form target is captured for safe delegation, not opened')
+    log('PASS: form target=_blank denied under a real user gesture; safe target captured')
+
+    // ── 6. Download canceled ──────────────────────────────────────────────
+    const downloadOutcome = new Promise<string>(resolveDownload => {
+      guest.session.once('will-download', (_event, item) => {
+        item.once('done', (_doneEvent, state) => resolveDownload(state))
+      })
+    })
+    void guest.executeJavaScript(`location.href = ${JSON.stringify(`${origin}/file.bin`)}`).catch(() => undefined)
+    const downloadState = await Promise.race([
+      downloadOutcome,
+      new Promise<string>(resolveTimeout => setTimeout(() => resolveTimeout('timed-out'), 3000))
+    ])
+    assert.equal(downloadState, 'cancelled', 'every download in the dedicated partition must be canceled')
+    log('PASS: download canceled')
+
+    // ── 7. Permission requests denied ────────────────────────────────────
+    const permissionResult = await guest.executeJavaScript(
+      `new Promise(resolveP => navigator.geolocation.getCurrentPosition(() => resolveP('granted'), () => resolveP('denied')))`
+    )
+    assert.equal(permissionResult, 'denied', 'geolocation must be denied by default')
+    log('PASS: geolocation permission denied')
+
+    // ── 8. Telemetry blocked without touching a same-origin request ─────
+    const telemetryProbe = await guest.executeJavaScript(`
+      Promise.all([
+        fetch('https://us.i.posthog.com/e/', { mode: 'no-cors' }).then(() => 'resolved').catch(() => 'blocked'),
+        fetch(${JSON.stringify(origin)}, { mode: 'no-cors' }).then(() => 'resolved').catch(() => 'blocked')
+      ])
+    `)
+    assert.deepEqual(telemetryProbe, ['blocked', 'resolved'], 'analytics host blocked; same-origin request unaffected')
+    log('PASS: telemetry blocked; same-origin request unaffected')
+
+    // ── 9. Concurrent Open Design + unrelated preview attach ─────────────
+    // Interleaved on purpose: the preview attach starts before the Open
+    // Design one resolves, proving the two never cross-contaminate (a
+    // preview guest must never receive the Open Design policy, and vice
+    // versa) even when their attach lifecycles overlap in real Electron.
+    const previewAttachPromise = attachWebview(host1, { partition: PREVIEW_PARTITION, src: 'about:blank' })
+    const concurrentOpenDesignGuest = await attachWebview(host1, { partition: binding.partition, src: origin })
+    const previewGuest = await previewAttachPromise
+
+    assert.ok(previewGuest, 'the concurrently-attached preview guest must still attach normally')
+    assert.ok(concurrentOpenDesignGuest, 'the concurrently-attached Open Design guest must still attach normally')
+    assert.notEqual(previewGuest.session, concurrentOpenDesignGuest.session, 'the two guests must never share a session')
+    log('PASS: concurrent Open Design + unrelated preview attach — no cross-contamination')
+
+    // ── 10. Stale-origin revocation: a same-profile runtime restart on a
+    // new port must revoke the guest still authorized under the old one.
+    const staleRevokedBefore = guestEvents.filter(event => event.type === 'stale-revoked').length
+    const realPort = Number(new URL(origin).port)
+    const differentPort = realPort >= 65535 ? realPort - 1 : realPort + 1
+
+    bindingStore.setOrigin(`http://127.0.0.1:${differentPort}`)
+    await new Promise(resolveWait => setTimeout(resolveWait, 300))
+
+    assert.ok(
+      guestEvents.filter(event => event.type === 'stale-revoked').length > staleRevokedBefore,
+      'a same-profile origin change must revoke the guest authorized under the prior origin'
+    )
+    log('PASS: same-profile origin change revoked the stale guest')
+
+    // Restore the real origin so the remaining crash/load-failure scenarios
+    // (which need a live, currently-bound guest) still make sense.
+    bindingStore.setOrigin(origin)
+
+    // ── 11. Crash signal becomes a nonblank host state ───────────────────
+    const freshGuestForCrash = await attachAndWaitForDomReady(host1, { partition: binding.partition, src: origin })
+    assert.ok(freshGuestForCrash, 'a fresh guest must attach for the crash scenario')
+
+    const crashSeenBefore = guestEvents.filter(event => event.type === 'crashed').length
+    const directCrashEvent = new Promise<boolean>(resolveCrash => {
+      freshGuestForCrash.once('render-process-gone', () => resolveCrash(true))
+    })
+
+    freshGuestForCrash.forcefullyCrashRenderer()
+    const directCrashSeen = await Promise.race([
+      directCrashEvent,
+      new Promise<boolean>(resolveTimeout => setTimeout(() => resolveTimeout(false), 3000))
+    ])
+    assert.equal(directCrashSeen, true, 'Electron must emit render-process-gone for the crashed guest')
+    assert.ok(
+      guestEvents.filter(event => event.type === 'crashed').length > crashSeenBefore,
+      'a real renderer crash must publish a crashed guest event (host paints a nonblank state from it)'
+    )
+    log('PASS: crash signal published')
+
+    // ── 12. Load failure becomes a nonblank host state ───────────────────
+    await new Promise<void>(resolveClose => server.close(() => resolveClose()))
+    const failGuest = await attachWebview(host1, { partition: binding.partition, src: origin })
+    assert.ok(failGuest, 'attach itself is still allowed (main cannot know the server just went down)')
+    await new Promise(resolveWait => setTimeout(resolveWait, 500))
+    assert.ok(
+      guestEvents.some(event => event.type === 'load-failed'),
+      'a real main-frame connection failure must publish a load-failed guest event'
+    )
+    log('PASS: load-failure signal published after the server went down')
+
+    log('ALL SCENARIOS PASSED')
+  } catch (error) {
+    scenarioFailure = { error }
+  } finally {
+    for (const win of windowsToDestroy) {
+      if (!win.isDestroyed()) {
+        win.destroy()
+      }
+    }
+
+    try {
+      server.close()
+    } catch {
+      // already closed above
+    }
+
+    // Zero residue: every window this harness created must be gone.
+    const residualWindows = BrowserWindow.getAllWindows().length
+
+    if (residualWindows > 0) {
+      console.error(`[harness] RESIDUE: ${residualWindows} window(s) still open after teardown`)
+    }
+
+    try {
+      // Electron's session/storage threads may still finish a final bounded
+      // write just after the last BrowserWindow is destroyed. Node's recursive
+      // remover can otherwise lose that race with ENOTEMPTY and, worse, a
+      // throw from this finally block would hide the actual scenario failure.
+      rmSync(runtimeDir, { force: true, maxRetries: 20, recursive: true, retryDelay: 50 })
+    } catch (cleanupError) {
+      cleanupFailure = { error: cleanupError }
+
+      if (scenarioFailure) {
+        console.error('[harness] teardown residue cleanup failed after a scenario failure')
+      }
+    }
+  }
+
+  if (scenarioFailure) {
+    throw scenarioFailure.error
+  }
+
+  if (cleanupFailure) {
+    throw cleanupFailure.error
+  }
+}
+
+// Watchdog: a stray unresolved promise anywhere above must fail loudly and
+// exit, never hang the harness (and whatever launched it) indefinitely.
+const WATCHDOG_MS = 45_000
+const watchdog = setTimeout(() => {
+  console.error(`[harness] WATCHDOG: run() did not complete within ${WATCHDOG_MS}ms — treating as failure`)
+  app.exit(1)
+}, WATCHDOG_MS)
+
+app
+  .whenReady()
+  .then(run)
+  .then(() => {
+    clearTimeout(watchdog)
+    app.exit(0)
+  })
+  .catch(error => {
+    clearTimeout(watchdog)
+    console.error(error)
+    app.exit(1)
+  })
