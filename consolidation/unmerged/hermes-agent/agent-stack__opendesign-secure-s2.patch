+/**
+ * The injectable initial-theme application seam. The guest stays hidden
+ * until BOTH `dom-ready` fires AND this resolves `true` — S3 will supply the
+ * real painted-theme applicator (Hermes skin -> Open Design CSS variables)
+ * during integration. Modeled as a plain function so a test can inject a
+ * fake that resolves true/false/rejects without touching Electron.
+ */
+export interface OpenDesignThemeSeamTarget {
+  insertCSS?: (css: string) => Promise<unknown>
+  executeJavaScript?: (code: string) => Promise<unknown>
+}
+
+export type OpenDesignThemeSeam = (guest: OpenDesignThemeSeamTarget) => Promise<boolean>
+
+/**
+ * S2 default: no real theme applicator exists yet. Fails closed — the guest
+ * never reveals — rather than inventing a fake raw-seed theme mapper. S3
+ * replaces this with the real painted-theme applicator during integration.
+ */
+export const UNINTEGRATED_THEME_SEAM: OpenDesignThemeSeam = async () => false
diff --git a/apps/desktop/src/app/open-design/use-open-design-status.test.tsx b/apps/desktop/src/app/open-design/use-open-design-status.test.tsx
new file mode 100644
index 0000000000..1682664187
--- /dev/null
+++ b/apps/desktop/src/app/open-design/use-open-design-status.test.tsx
@@ -0,0 +1,184 @@
+import { act, cleanup, renderHook, waitFor } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+import { useOpenDesignStatus } from './use-open-design-status'
+
+// Loosely typed on purpose: spreading a `Partial<...>` of the real bridge
+// interface over concrete `vi.fn()` defaults widens each overridden
+// property's type to a union with the strict interface signature (losing the
+// `.mock` accessor) — this keeps every property a plain mock function.
+function installBridge(overrides: Record<string, (...args: never[]) => unknown> = {}) {
+  let statusListener: ((status: unknown) => void) | null = null
+
+  const api = {
+    getStatus: vi.fn(async () => ({ state: 'idle' })),
+    start: vi.fn(async () => ({ state: 'starting' })),
+    retry: vi.fn(async () => ({ state: 'retrying' })),
+    stopOwned: vi.fn(async () => ({ state: 'idle' })),
+    setProfile: vi.fn(async (_profile: string) => ({ state: 'idle' })),
+    onStatus: vi.fn((callback: (status: unknown) => void) => {
+      statusListener = callback
+
+      return () => {
+        statusListener = null
+      }
+    }),
+    ...overrides
+  }
+
+  ;(window as unknown as { hermesDesktop: unknown }).hermesDesktop = { openDesign: api }
+
+  return {
+    api,
+    emit: (status: unknown) => statusListener?.(status)
+  }
+}
+
+afterEach(() => {
+  cleanup()
+  delete (window as unknown as { hermesDesktop?: unknown }).hermesDesktop
+  vi.clearAllMocks()
+})
+
+describe('useOpenDesignStatus', () => {
+  it('starts idle, then calls setProfile followed by start with the active profile fact', async () => {
+    const { api } = installBridge()
+
+    renderHook(() => useOpenDesignStatus('work'))
+
+    await waitFor(() => expect(api.start.mock.calls.length).toBe(1))
+
+    assertCalledBefore(api.setProfile, api.start)
+    expect(api.setProfile.mock.calls[0][0]).toBe('work')
+  })
+
+  it('adopts the resolved status from start()', async () => {
+    const { api } = installBridge({ start: vi.fn(async () => ({ state: 'ready', origin: 'x' })) })
+
+    const { result } = renderHook(() => useOpenDesignStatus('work'))
+
+    await waitFor(() => expect(result.current.status.state).toBe('ready'))
+  })
+
+  it('subscribes to onStatus and adopts every pushed update', async () => {
+    const { api, emit } = installBridge()
+
+    const { result } = renderHook(() => useOpenDesignStatus('work'))
+
+    await waitFor(() => expect(api.onStatus.mock.calls.length).toBe(1))
+
+    act(() => emit({ state: 'migrating' }))
+    await waitFor(() => expect(result.current.status.state).toBe('migrating'))
+
+    act(() => emit({ state: 'crashed', reason: 'load_failed' }))
+    await waitFor(() => expect(result.current.status.state).toBe('crashed'))
+  })
+
+  it('does not issue a second setProfile/start pair on a re-render with the same profile', async () => {
+    const { api } = installBridge()
+
+    const { rerender } = renderHook(({ profile }) => useOpenDesignStatus(profile), {
+      initialProps: { profile: 'work' }
+    })
+
+    await waitFor(() => expect(api.start.mock.calls.length).toBe(1))
+
+    rerender({ profile: 'work' })
+    rerender({ profile: 'work' })
+
+    // Give any accidental re-entrant call a chance to land before asserting.
+    await act(async () => undefined)
+    expect(api.setProfile.mock.calls.length).toBe(1)
+    expect(api.start.mock.calls.length).toBe(1)
+  })
+
+  it('issues a fresh setProfile/start pair when the profile actually changes', async () => {
+    const { api } = installBridge()
+
+    const { rerender } = renderHook(({ profile }) => useOpenDesignStatus(profile), {
+      initialProps: { profile: 'work' }
+    })
+
+    await waitFor(() => expect(api.start.mock.calls.length).toBe(1))
+
+    rerender({ profile: 'personal' })
+
+    await waitFor(() => expect(api.setProfile.mock.calls.length).toBe(2))
+    expect(api.setProfile.mock.calls[1][0]).toBe('personal')
+    expect(api.start.mock.calls.length).toBe(2)
+  })
+
+  it('never invokes start from a stale profile chain after that profile has been replaced', async () => {
+    let resolveWork: (value: unknown) => void = () => undefined
+    let resolvePersonal: (value: unknown) => void = () => undefined
+    const start = vi.fn(async () => ({ state: 'starting' }))
+    const setProfile = vi.fn((rawProfile: never) => new Promise(resolve => {
+      if (String(rawProfile) === 'work') {
+        resolveWork = resolve
+      } else {
+        resolvePersonal = resolve
+      }
+    }))
+    const { api } = installBridge({ setProfile, start })
+
+    const { rerender } = renderHook(({ profile }) => useOpenDesignStatus(profile), {
+      initialProps: { profile: 'work' }
+    })
+
+    await waitFor(() => expect(api.setProfile).toHaveBeenCalledTimes(1))
+    rerender({ profile: 'personal' })
+    await waitFor(() => expect(api.setProfile).toHaveBeenCalledTimes(2))
+
+    await act(async () => {
+      resolveWork({ state: 'idle' })
+      await Promise.resolve()
+    })
+    expect(api.start).not.toHaveBeenCalled()
+
+    await act(async () => {
+      resolvePersonal({ state: 'idle' })
+      await Promise.resolve()
+    })
+    await waitFor(() => expect(api.start).toHaveBeenCalledTimes(1))
+  })
+
+  it('unsubscribes from onStatus on unmount', async () => {
+    const { api } = installBridge()
+
+    const { unmount } = renderHook(() => useOpenDesignStatus('work'))
+
+    await waitFor(() => expect(api.onStatus.mock.calls.length).toBe(1))
+    unmount()
+
+    // The unsubscribe function returned by onStatus must have been invoked.
+    const unsubscribe = api.onStatus.mock.results[0]?.value as (() => void) | undefined
+    expect(typeof unsubscribe).toBe('function')
+  })
+
+  it('reports a truthful unavailable state when the bridge itself is missing', async () => {
+    delete (window as unknown as { hermesDesktop?: unknown }).hermesDesktop
+
+    const { result } = renderHook(() => useOpenDesignStatus('work'))
+
+    await waitFor(() => expect(result.current.status.state).toBe('unavailable'))
+  })
+
+  it('retry() calls the bridge and adopts the resolved status', async () => {
+    const { api } = installBridge({ retry: vi.fn(async () => ({ state: 'starting' })) })
+
+    const { result } = renderHook(() => useOpenDesignStatus('work'))
+
+    await waitFor(() => expect(api.start.mock.calls.length).toBe(1))
+
+    await act(async () => {
+      await result.current.retry()
+    })
+
+    expect(api.retry.mock.calls.length).toBe(1)
+    expect(result.current.status.state).toBe('starting')
+  })
+})
+
+function assertCalledBefore(first: { mock: { invocationCallOrder: number[] } }, second: typeof first) {
+  expect(first.mock.invocationCallOrder[0]).toBeLessThan(second.mock.invocationCallOrder[0])
+}
diff --git a/apps/desktop/src/app/open-design/use-open-design-status.ts b/apps/desktop/src/app/open-design/use-open-design-status.ts
new file mode 100644
index 0000000000..04f73096b6
--- /dev/null
+++ b/apps/desktop/src/app/open-design/use-open-design-status.ts
@@ -0,0 +1,85 @@
+import { useEffect, useRef, useState } from 'react'
+
+import type { OpenDesignStatus } from '@/global'
+
+const UNAVAILABLE_NO_BRIDGE: OpenDesignStatus = { state: 'unavailable', reason: 'runtime_not_installed' }
+
+export interface UseOpenDesignStatusResult {
+  status: OpenDesignStatus
+  /** Re-attempts from any failure state. Resolves once main has responded. */
+  retry: () => Promise<void>
+}
+
+/**
+ * The renderer's client for the six-operation Open Design bridge. On mount
+ * (and again only if `profile` actually changes) calls `setProfile` with the
+ * active profile fact, then `start` — guarded by a per-profile ref so
+ * StrictMode's mount/cleanup/remount and ordinary re-renders never issue a
+ * duplicate pair of client calls. Subscribes to `onStatus` for the lifetime
+ * of the mount and unsubscribes cleanly on teardown.
+ */
+export function useOpenDesignStatus(profile: string): UseOpenDesignStatusResult {
+  const [status, setStatus] = useState<OpenDesignStatus>({ state: 'idle' })
+  const startedForProfileRef = useRef<null | string>(null)
+
+  // eslint-disable-next-line no-restricted-syntax -- legitimate non-atom ref write (see eslint rule comment): startedForProfileRef is a local re-entry latch, not a mirror of reactive store state.
+  useEffect(() => {
+    const api = window.hermesDesktop?.openDesign
+
+    if (!api) {
+      setStatus(UNAVAILABLE_NO_BRIDGE)
+
+      return
+    }
+
+    let active = true
+
+    const unsubscribe = api.onStatus(next => {
+      if (active) {
+        setStatus(next)
+      }
+    })
+
+    if (startedForProfileRef.current !== profile) {
+      startedForProfileRef.current = profile
+
+      void api
+        .setProfile(profile)
+        .then(() => active ? api.start() : null)
+        .then(next => {
+          if (active && next !== null) {
+            setStatus(next)
+          }
+        })
+        .catch(() => {
+          if (active) {
+            setStatus({ state: 'error', reason: 'unknown' })
+          }
+        })
+    }
+
+    return () => {
+      active = false
+      unsubscribe()
+    }
+  }, [profile])
+
+  return {
+    status,
+    retry: async () => {
+      const api = window.hermesDesktop?.openDesign
+
+      if (!api) {
+        setStatus(UNAVAILABLE_NO_BRIDGE)
+
+        return
+      }
+
+      try {
+        setStatus(await api.retry())
+      } catch {
+        setStatus({ state: 'error', reason: 'unknown' })
+      }
+    }
+  }
+}
diff --git a/apps/desktop/src/app/open-design/webview-host.test.tsx b/apps/desktop/src/app/open-design/webview-host.test.tsx
