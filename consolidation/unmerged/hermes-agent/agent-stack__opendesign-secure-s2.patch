@@ -0,0 +1,36 @@
+#!/usr/bin/env node
+// bundle-open-design-harness.mjs — bundles electron/open-design/security-harness.ts
+// into a self-contained .mjs so the disposable real-Electron OD-07 harness can
+// run against the actual production guest-policy/binding-store/profile/
+// runtime-origin modules without needing a TS-aware Node runtime. Mirrors
+// bundle-electron-main.mjs's approach (esbuild, `electron` external).
+//
+// Output: dist-test/open-design-security-harness.mjs (gitignored, disposable).
+import { build } from 'esbuild'
+import { resolve, dirname } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { mkdirSync } from 'node:fs'
+
+const here = dirname(fileURLToPath(import.meta.url))
+const root = resolve(here, '..')
+const outDir = resolve(root, 'dist-test')
+mkdirSync(outDir, { recursive: true })
+
+const entry = resolve(root, 'electron/open-design/security-harness.ts')
+const outfile = resolve(outDir, 'open-design-security-harness.mjs')
+
+await build({
+  entryPoints: [entry],
+  bundle: true,
+  platform: 'node',
+  format: 'esm',
+  target: 'node20',
+  outfile,
+  external: ['electron'],
+  banner: {
+    js: "import { createRequire } from 'module'; const require = createRequire(import.meta.url);",
+  },
+  logLevel: 'info',
+})
+
+console.log(`bundled ${outfile}`)
