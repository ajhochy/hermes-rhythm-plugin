index 0000000000..e50ee7eb8f
--- /dev/null
+++ b/apps/desktop/electron/open-design/status-contract.ts
@@ -0,0 +1,240 @@
+import { isValidOpenDesignRuntimeOrigin } from './runtime-origin'
+
+/**
+ * The bounded, sanitized renderer state union. Every value that reaches the
+ * renderer (a direct IPC response or a broadcast) is constructed here —
+ * never forwarded from the runtime port as-is. Nothing outside this shape
+ * can cross the bridge: no executable/runtime/config paths, environment
+ * values, commands, raw logs, stack traces, secrets, PIDs, webContents ids,
+ * or arbitrary upstream objects.
+ */
+export type OpenDesignSource = 'attached' | 'installed' | 'packaged'
+
+export type OpenDesignStatusReason =
+  | 'health_check_failed'
+  | 'invalid_profile'
+  | 'invalid_status'
+  | 'load_failed'
+  | 'no_profile_bound'
+  | 'platform_unsupported'
+  | 'runtime_not_installed'
+  | 'stale_binding'
+  | 'theme_seam_rejected'
+  | 'unknown'
+
+export interface OpenDesignReadyStatus {
+  state: 'ready'
+  origin: string
+  partition: string
+  source: OpenDesignSource
+  version: string
+  profile: string
+  owned: boolean
+}
+
+export type OpenDesignStatus =
+  | { state: 'idle' }
+  | { state: 'starting' }
+  | { state: 'migrating' }
+  | { state: 'retrying' }
+  | OpenDesignReadyStatus
+  | { state: 'unavailable'; reason?: OpenDesignStatusReason }
+  | { state: 'unsupported'; reason?: OpenDesignStatusReason }
+  | { state: 'crashed'; reason?: OpenDesignStatusReason }
+  | { state: 'error'; reason?: OpenDesignStatusReason }
+
+/** The main-owned facts a `ready` status may never source from the runtime port. */
+export interface OpenDesignBindingFacts {
+  profile: string
+  partition: string
+}
+
+/** The main-detected guest-policy events (electron/open-design/guest-
+ *  policy.ts) that must reach the renderer as a real status, not just a log
+ *  line. Only the event's TYPE crosses this boundary — never Electron's raw
+ *  crash `reason` string, which is not part of the bounded reason contract. */
+export type OpenDesignGuestEventType = 'crashed' | 'load-failed' | 'stale-revoked'
+
+const REASONS: ReadonlySet<string> = new Set<OpenDesignStatusReason>([
+  'health_check_failed',
+  'invalid_profile',
+  'invalid_status',
+  'load_failed',
+  'no_profile_bound',
+  'platform_unsupported',
+  'runtime_not_installed',
+  'stale_binding',
+  'theme_seam_rejected',
+  'unknown'
+])
+
+const SOURCES: ReadonlySet<string> = new Set<OpenDesignSource>(['attached', 'installed', 'packaged'])
+
+const MAX_VERSION_LENGTH = 32
+const SAFE_VERSION_PATTERN = /^[A-Za-z0-9][A-Za-z0-9.+_-]{0,31}$/
+
+const INVALID_STATUS: OpenDesignStatus = { state: 'error', reason: 'invalid_status' }
+const NO_PROFILE_BOUND: OpenDesignStatus = { state: 'unavailable', reason: 'no_profile_bound' }
+
+/**
+ * `Object.getPrototypeOf`/`getOwnPropertyDescriptor` are themselves
+ * interceptable Proxy traps — every call a hostile `raw` value could see is
+ * wrapped in try/catch so a throwing trap degrades to "absent/unsafe"
+ * instead of propagating out of a function whose entire contract is "never
+ * throws".
+ */
+function hasSafePrototype(value: object): boolean {
+  try {
+    const proto: unknown = Object.getPrototypeOf(value)
+
+    return proto === Object.prototype || proto === null
+  } catch {
+    return false
+  }
+}
+
+function isPlainObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value) && hasSafePrototype(value)
+}
+
+/**
+ * Reads an OWN, plain data property — never a getter/accessor (even a
+ * non-throwing one: a status field implemented as an accessor is not the
+ * bounded data contract regardless of whether it happens to be callable
+ * safely) and never an inherited property. A throwing/lying descriptor trap
+ * on a hostile Proxy degrades to "absent" rather than propagating.
+ */
+function safeOwnValue(obj: object, key: string): unknown {
+  try {
+    const descriptor = Object.getOwnPropertyDescriptor(obj, key)
+
+    if (descriptor && 'value' in descriptor) {
+      return descriptor.value
+    }
+  } catch {
+    // Hostile Proxy trap — treat as absent.
+  }
+
+  return undefined
+}
+
+function isOpenDesignSource(value: unknown): value is OpenDesignSource {
+  return typeof value === 'string' && SOURCES.has(value)
+}
+
+function isSafeVersion(value: unknown): value is string {
+  return typeof value === 'string' && value.length <= MAX_VERSION_LENGTH && SAFE_VERSION_PATTERN.test(value)
+}
+
+function safeReason(value: unknown): OpenDesignStatusReason | undefined {
+  return typeof value === 'string' && REASONS.has(value) ? (value as OpenDesignStatusReason) : undefined
+}
+
+/**
+ * Total schema validator: given ANY value the runtime port hands back (a
+ * status it read off Open Design's own process, which this module treats as
+ * untrusted — including a hostile Proxy or a throwing getter, not just a
+ * malformed plain object), returns a guaranteed-safe `OpenDesignStatus`.
+ * Never throws and never passes anything through unsanitized — malformed or
+ * hostile input becomes a safe `error`/`unavailable` state. `binding`
+ * supplies the two facts a `ready` status is never allowed to source from
+ * the port itself: `partition` and `profile` are main-issued, not
+ * upstream-reported.
+ */
+export function sanitizeOpenDesignStatus(raw: unknown, binding: OpenDesignBindingFacts | null): OpenDesignStatus {
+  if (!isPlainObject(raw)) {
+    return INVALID_STATUS
+  }
+
+  const state = safeOwnValue(raw, 'state')
+
+  if (typeof state !== 'string') {
+    return INVALID_STATUS
+  }
+
+  if (state === 'idle' || state === 'starting' || state === 'migrating' || state === 'retrying') {
+    return { state }
+  }
+
+  if (state === 'unavailable' || state === 'unsupported' || state === 'crashed' || state === 'error') {
+    const reason = safeReason(safeOwnValue(raw, 'reason'))
+
+    return reason ? { state, reason } : { state }
+  }
+
+  if (state !== 'ready') {
+    return INVALID_STATUS
+  }
+
+  if (!binding) {
+    return NO_PROFILE_BOUND
+  }
+
+  const origin = safeOwnValue(raw, 'origin')
+  const source = safeOwnValue(raw, 'source')
+  const version = safeOwnValue(raw, 'version')
+  const owned = safeOwnValue(raw, 'owned')
+
+  if (
+    typeof origin !== 'string' ||
+    !isValidOpenDesignRuntimeOrigin(origin) ||
+    !isOpenDesignSource(source) ||
+    !isSafeVersion(version) ||
+    typeof owned !== 'boolean'
+  ) {
+    return INVALID_STATUS
+  }
+
+  return {
+    state: 'ready',
+    origin,
+    partition: binding.partition,
+    source,
+    version,
+    profile: binding.profile,
+    owned
+  }
+}
+
+/**
+ * Extracts the validated runtime origin from a raw status ONLY when it is a
+ * well-formed `ready` status — otherwise `null`. This is the seam
+ * register-open-design-ipc.ts uses to atomically sync main's authoritative
+ * binding (electron/open-design/binding-store.ts) with the exact origin
+ * that just passed the SAME validation `sanitizeOpenDesignStatus` uses,
+ * before that status is sanitized against (and returned/broadcast with) the
+ * binding it just updated. Hostile-input-safe for the same reasons as
+ * `sanitizeOpenDesignStatus` — never throws.
+ */
+export function readyOriginIfValid(raw: unknown): string | null {
+  if (!isPlainObject(raw)) {
+    return null
+  }
+
+  if (safeOwnValue(raw, 'state') !== 'ready') {
+    return null
+  }
+
+  const origin = safeOwnValue(raw, 'origin')
+
+  return typeof origin === 'string' && isValidOpenDesignRuntimeOrigin(origin) ? origin : null
+}
+
+/**
+ * Maps a main-detected guest-policy event (crash, load failure, stale-
+ * binding revocation) to the same bounded status shape the runtime-port
+ * path produces, so the renderer sees ONE truthful status regardless of
+ * which main-owned source detected the failure. Never carries Electron's
+ * raw crash `reason` string — only the bounded bridge reason vocabulary.
+ */
+export function sanitizeOpenDesignGuestEvent(eventType: OpenDesignGuestEventType): OpenDesignStatus {
+  if (eventType === 'crashed') {
+    return { state: 'crashed' }
+  }
+
+  if (eventType === 'load-failed') {
+    return { state: 'error', reason: 'load_failed' }
+  }
+
+  return { state: 'unavailable', reason: 'stale_binding' }
+}
