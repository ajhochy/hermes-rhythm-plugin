   isWindows: IS_WINDOWS,
diff --git a/apps/desktop/electron/open-design/binding-store.test.ts b/apps/desktop/electron/open-design/binding-store.test.ts
new file mode 100644
index 0000000000..022444da75
--- /dev/null
+++ b/apps/desktop/electron/open-design/binding-store.test.ts
@@ -0,0 +1,221 @@
+import assert from 'node:assert/strict'
+
+import { test } from 'vitest'
+
+import { createOpenDesignBindingStore } from './binding-store'
+
+test('starts with no binding', () => {
+  const store = createOpenDesignBindingStore()
+
+  assert.equal(store.getBinding(), null)
+})
+
+test('setProfile establishes a binding with a derived partition and no origin yet', () => {
+  const store = createOpenDesignBindingStore()
+
+  const binding = store.setProfile('default')
+
+  assert.deepEqual(binding, { profile: 'default', partition: 'persist:open-design-default', origin: null, generation: 1 })
+  assert.deepEqual(store.getBinding(), binding)
+})
+
+test('setProfile rejects an invalid profile and leaves any existing binding untouched', () => {
+  const store = createOpenDesignBindingStore()
+  const original = store.setProfile('default')
+
+  const result = store.setProfile('../etc/passwd')
+
+  assert.equal(result, null)
+  assert.deepEqual(store.getBinding(), original)
+})
+
+test('setProfile with no prior binding and an invalid profile stays unbound', () => {
+  const store = createOpenDesignBindingStore()
+
+  assert.equal(store.setProfile('bad profile!'), null)
+  assert.equal(store.getBinding(), null)
+})
+
+test('setProfile with the same profile again is idempotent — no generation bump of its own', () => {
+  const store = createOpenDesignBindingStore()
+
+  store.setProfile('default')
+  const beforeRecall = store.getBinding()
+  const second = store.setProfile('default')
+
+  assert.equal(second?.generation, beforeRecall?.generation)
+  assert.equal(second, beforeRecall) // same object identity — a true no-op, not just equal fields
+})
+
+test('setProfile with a different profile bumps generation and resets origin', () => {
+  const store = createOpenDesignBindingStore()
+
+  store.setProfile('work')
+  store.setOrigin('http://127.0.0.1:5173')
+  const switched = store.setProfile('personal')
+
+  assert.equal(switched?.profile, 'personal')
+  assert.equal(switched?.partition, 'persist:open-design-personal')
+  assert.equal(switched?.origin, null)
+  assert.equal(switched?.generation, 3) // gen 1 (work) -> gen 2 (origin set) -> gen 3 (personal)
+})
+
+test('switching back to a previous profile restores the exact same partition', () => {
+  const store = createOpenDesignBindingStore()
+
+  const work1 = store.setProfile('work')
+  store.setProfile('personal')
+  const work2 = store.setProfile('work')
+
+  assert.equal(work2?.partition, work1?.partition)
+  // Restoring is still a fresh binding session (a new generation), even
+  // though the partition string is identical — a stale guest attached under
+  // the earlier "work" generation must not be mistaken for this one.
+  assert.notEqual(work2?.generation, work1?.generation)
+})
+
+// ── setOrigin: every real value change is a new authority revision ─────────
+
+test('setOrigin(null -> value) bumps generation and updates origin, leaving profile/partition alone', () => {
+  const store = createOpenDesignBindingStore()
+  const before = store.setProfile('default')
+
+  const after = (() => {
+    store.setOrigin('http://127.0.0.1:5173')
+
+    return store.getBinding()
+  })()
+
+  assert.equal(after?.origin, 'http://127.0.0.1:5173')
+  assert.equal(after?.profile, before?.profile)
+  assert.equal(after?.partition, before?.partition)
+  assert.equal(after!.generation, before!.generation + 1)
+})
+
+test('setOrigin with the exact same value again is idempotent — no generation bump, no notification', () => {
+  const store = createOpenDesignBindingStore()
+  const seen: number[] = []
+
+  store.setProfile('default')
+  store.onGenerationChange(binding => seen.push(binding.generation))
+  store.setOrigin('http://127.0.0.1:5173')
+  const afterFirst = store.getBinding()
+
+  store.setOrigin('http://127.0.0.1:5173')
+  const afterSecond = store.getBinding()
+
+  assert.equal(afterSecond, afterFirst) // same object identity — a true no-op
+  assert.deepEqual(seen, [afterFirst!.generation])
+})
+
+test('setOrigin(A -> B) on the same profile bumps generation again (a runtime restart on a new port)', () => {
+  const store = createOpenDesignBindingStore()
+
+  store.setProfile('default')
+  store.setOrigin('http://127.0.0.1:5173')
+  const withA = store.getBinding()!
+
+  store.setOrigin('http://127.0.0.1:6001')
+  const withB = store.getBinding()!
+
+  assert.equal(withB.origin, 'http://127.0.0.1:6001')
+  assert.equal(withB.profile, withA.profile)
+  assert.equal(withB.partition, withA.partition)
+  assert.equal(withB.generation, withA.generation + 1)
+})
+
+test('setOrigin(value -> null) clears the origin and bumps generation', () => {
+  const store = createOpenDesignBindingStore()
+
+  store.setProfile('default')
+  store.setOrigin('http://127.0.0.1:5173')
+  const withOrigin = store.getBinding()!
+
+  store.setOrigin(null)
+  const cleared = store.getBinding()!
+
+  assert.equal(cleared.origin, null)
+  assert.equal(cleared.generation, withOrigin.generation + 1)
+})
+
+test('setOrigin is a safe no-op with no binding established', () => {
+  const store = createOpenDesignBindingStore()
+
+  assert.doesNotThrow(() => store.setOrigin('http://127.0.0.1:5173'))
+  assert.equal(store.getBinding(), null)
+})
+
+// ── onGenerationChange: fires on every real authority transition ───────────
+
+test('onGenerationChange fires on a real profile switch, not on the idempotent re-call', () => {
+  const store = createOpenDesignBindingStore()
+  const seen: number[] = []
+
+  store.onGenerationChange(binding => seen.push(binding.generation))
+
+  store.setProfile('work') // generation 1: fires
+  store.setProfile('work') // idempotent: does not fire
+  store.setProfile('personal') // generation 2: fires
+
+  assert.deepEqual(seen, [1, 2])
+})
+
+test('onGenerationChange fires on a real origin change, not on an idempotent re-call', () => {
+  const store = createOpenDesignBindingStore()
+  const seen: number[] = []
+
+  store.setProfile('work') // generation 1 (not observed — subscribed after)
+  store.onGenerationChange(binding => seen.push(binding.generation))
+
+  store.setOrigin('http://127.0.0.1:5173') // generation 2: fires
+  store.setOrigin('http://127.0.0.1:5173') // idempotent: does not fire
+  store.setOrigin('http://127.0.0.1:6001') // generation 3: fires
+  store.setOrigin(null) // generation 4: fires
+
+  assert.deepEqual(seen, [2, 3, 4])
+})
+
+test('onGenerationChange notifies every independently registered listener', () => {
+  const store = createOpenDesignBindingStore()
+  const first: number[] = []
+  const second: number[] = []
+
+  store.onGenerationChange(binding => first.push(binding.generation))
+  store.onGenerationChange(binding => second.push(binding.generation))
+  store.setProfile('work')
+
+  assert.deepEqual(first, [1])
+  assert.deepEqual(second, [1])
+})
+
+test('onGenerationChange unsubscribe stops further notifications', () => {
+  const store = createOpenDesignBindingStore()
+  const seen: number[] = []
+
+  const unsubscribe = store.onGenerationChange(binding => seen.push(binding.generation))
+  store.setProfile('work')
+  unsubscribe()
+  store.setProfile('personal')
+
+  assert.deepEqual(seen, [1])
+})
+
+test('onGenerationChange does not fire for a rejected setProfile call', () => {
+  const store = createOpenDesignBindingStore()
+  const seen: number[] = []
+
+  store.onGenerationChange(binding => seen.push(binding.generation))
+  store.setProfile('not a valid profile')
+
+  assert.deepEqual(seen, [])
+})
+
+test('onGenerationChange does not fire for setOrigin with no binding established', () => {
+  const store = createOpenDesignBindingStore()
+  const seen: number[] = []
+
+  store.onGenerationChange(binding => seen.push(binding.generation))
+  store.setOrigin('http://127.0.0.1:5173')
+
+  assert.deepEqual(seen, [])
+})
diff --git a/apps/desktop/electron/open-design/binding-store.ts b/apps/desktop/electron/open-design/binding-store.ts
new file mode 100644
index 0000000000..c0c46f2a88
--- /dev/null
+++ b/apps/desktop/electron/open-design/binding-store.ts
@@ -0,0 +1,89 @@
+import { deriveOpenDesignPartition, normalizeOpenDesignProfile } from './profile'
+
+/**
+ * Main's authoritative `{profile, partition, origin}` binding for the active
+ * Open Design guest. The renderer can only ever consume a sanitized read of
+ * this; it never authorizes it. `generation` bumps on every real profile
+ * switch (never on an idempotent re-call with the same profile) so the guest
+ * policy can tell a fresh attach from one still living under a stale, since-
+ * switched-away-from binding — even when the newly restored partition string
+ * is byte-identical to an old one.
+ */
+export interface OpenDesignBinding {
+  profile: string
+  partition: string
+  origin: string | null
+  generation: number
+}
+
+export interface OpenDesignBindingStore {
+  /** Normalizes+validates `raw`; rejects (returning null) without touching
+   *  any existing binding on invalid input. Idempotent for the same profile
+   *  (returns the SAME object, no generation bump). */
+  setProfile(raw: unknown): OpenDesignBinding | null
+  /** Installs (or clears, via `null`) the main-validated runtime origin for
+   *  the current binding. No-op when no binding is established yet, or when
+   *  `origin` already equals the current value (idempotent — same object,
+   *  no generation bump). Any REAL change — including the first origin ever
+   *  set, a same-profile runtime restart landing on a new loopback port, or
+   *  clearing back to `null` — is its own authority revision: a webview
+   *  approved under the prior origin must not be mistaken for one approved
+   *  under this one. */
+  setOrigin(origin: string | null): void
+  getBinding(): OpenDesignBinding | null
+  /** Fires on every real authority-changing transition — a profile switch OR
+   *  an origin set/change/clear — never on an idempotent re-call or a
+   *  rejected setProfile. Returns an unsubscribe fn. */
+  onGenerationChange(listener: (binding: OpenDesignBinding) => void): () => void
+}
+
+export function createOpenDesignBindingStore(): OpenDesignBindingStore {
+  let current: OpenDesignBinding | null = null
+  let generation = 0
+  const listeners = new Set<(binding: OpenDesignBinding) => void>()
+
+  function notify(binding: OpenDesignBinding): void {
+    for (const listener of listeners) {
+      listener(binding)
+    }
+  }
+
+  return {
+    setProfile(raw) {
+      const normalized = normalizeOpenDesignProfile(raw)
+
+      if (normalized === null) {
+        return null
+      }
+
+      if (current && current.profile === normalized) {
+        return current
+      }
+
+      generation += 1
+      current = { profile: normalized, partition: deriveOpenDesignPartition(normalized), origin: null, generation }
+      notify(current)
+
+      return current
+    },
+    setOrigin(origin) {
+      if (!current || current.origin === origin) {
+        return
+      }
+
+      generation += 1
+      current = { ...current, origin, generation }
+      notify(current)
+    },
+    getBinding() {
+      return current
+    },
+    onGenerationChange(listener) {
+      listeners.add(listener)
+
+      return () => {
+        listeners.delete(listener)
+      }
+    }
+  }
+}
diff --git a/apps/desktop/electron/open-design/guest-policy.test.ts b/apps/desktop/electron/open-design/guest-policy.test.ts
new file mode 100644
index 0000000000..43ea1dfae1
--- /dev/null
+++ b/apps/desktop/electron/open-design/guest-policy.test.ts
@@ -0,0 +1,745 @@
+import assert from 'node:assert/strict'
+
+import { test, vi } from 'vitest'
+
+import { installOpenDesignGuestPolicy } from './guest-policy'
+
+const ORIGIN = 'http://127.0.0.1:5173'
+const BINDING = { profile: 'default', partition: 'persist:open-design-default', origin: ORIGIN, generation: 1 }
+
+// ── fakes ────────────────────────────────────────────────────────────────────
+//
+// A real Electron `Session` exposes no public `.partition` string to read
+// back — these fakes deliberately do NOT provide one either, so a
+// regression that tries to re-derive the partition from `guest.session` at
+// `did-attach-webview` time fails loudly here instead of only in the real
+// harness (electron/open-design/security-harness.ts). Session IDENTITY is
+// modeled instead, via a shared per-partition registry mirroring Electron's
+// real `session.fromPartition` caching (same partition -> same object).
+
+function makeEmitter() {
+  const listeners = new Map<string, Array<(...args: unknown[]) => void>>()
+
+  return {
+    on: (event: string, listener: (...args: unknown[]) => void) => {
+      const list = listeners.get(event) ?? []
+
+      list.push(listener)
+      listeners.set(event, list)
+    },
+    once: (event: string, listener: (...args: unknown[]) => void) => {
+      const wrapped = (...args: unknown[]) => {
+        listeners.set(
+          event,
+          (listeners.get(event) ?? []).filter(candidate => candidate !== wrapped)
+        )
+        listener(...args)
+      }
+
+      const list = listeners.get(event) ?? []
+
+      list.push(wrapped)
+      listeners.set(event, list)
+    },
+    removeListener: (event: string, listener: (...args: unknown[]) => void) => {
+      listeners.set(
+        event,
+        (listeners.get(event) ?? []).filter(candidate => candidate !== listener)
+      )
+    },
+    emit: (event: string, ...args: unknown[]) => {
+      for (const listener of [...(listeners.get(event) ?? [])]) {
+        listener(...args)
+      }
+    },
+    listenerCount: (event: string) => (listeners.get(event) ?? []).length
+  }
+}
+
+function makeFakeEvent() {
+  return { defaultPrevented: false, preventDefault: vi.fn() }
+}
+
+function makeFakeSession() {
+  const emitter = makeEmitter()
+
+  const state: {
+    permissionRequestHandler: null | ((wc: unknown, permission: string, callback: (ok: boolean) => void) => void)
+    permissionCheckHandler: null | (() => boolean)
+    devicePermissionHandler: null | (() => boolean)
+    displayMediaRequestHandler: null | ((request: unknown, callback: (streams: unknown) => void) => void)
+    beforeRequestListener: null | ((details: { url: string }, callback: (r: { cancel: boolean }) => void) => void)
+  } = {
+    permissionRequestHandler: null,
+    permissionCheckHandler: null,
+    devicePermissionHandler: null,
+    displayMediaRequestHandler: null,
+    beforeRequestListener: null
+  }
+
+  return {
+    on: emitter.on,
+    emit: emitter.emit,
+    listenerCount: emitter.listenerCount,
+    get permissionRequestHandler() {
+      return state.permissionRequestHandler
+    },
+    get permissionCheckHandler() {
+      return state.permissionCheckHandler
+    },
+    get devicePermissionHandler() {
+      return state.devicePermissionHandler
+    },
+    get displayMediaRequestHandler() {
+      return state.displayMediaRequestHandler
+    },
+    get beforeRequestListener() {
+      return state.beforeRequestListener
+    },
+    setPermissionRequestHandler: (handler: typeof state.permissionRequestHandler) => {
+      state.permissionRequestHandler = handler
+    },
+    setPermissionCheckHandler: (handler: typeof state.permissionCheckHandler) => {
+      state.permissionCheckHandler = handler
+    },
+    setDevicePermissionHandler: (handler: typeof state.devicePermissionHandler) => {
+      state.devicePermissionHandler = handler
+    },
+    setDisplayMediaRequestHandler: (handler: typeof state.displayMediaRequestHandler) => {
+      state.displayMediaRequestHandler = handler
+    },
+    webRequest: {
+      onBeforeRequest: (listener: typeof state.beforeRequestListener) => {
+        state.beforeRequestListener = listener
+      }
+    }
+  }
+}
+
+type FakeSession = ReturnType<typeof makeFakeSession>
+
+/** Mirrors Electron's real `session.fromPartition`: same partition string ->
+ *  the SAME cached session object, every time. */
+function makeSessionRegistry() {
+  const byPartition = new Map<string, FakeSession>()
+
+  return {
+    resolveSessionForPartition: (partition: string): FakeSession => {
+      const existing = byPartition.get(partition)
+
+      if (existing) {
+        return existing
+      }
+
+      const created = makeFakeSession()
+
+      byPartition.set(partition, created)
+
+      return created
+    }
+  }
+}
+
+function makeFakeGuestWebContents(session: FakeSession = makeFakeSession()) {
+  const emitter = makeEmitter()
+  let destroyed = false
+  let windowOpenHandler: null | ((details: { url: string; disposition: string }) => { action: string }) = null
+
+  return {
+    session,
+    on: emitter.on,
+    once: emitter.once,
+    removeListener: emitter.removeListener,
+    emit: emitter.emit,
+    listenerCount: emitter.listenerCount,
+    isDestroyed: () => destroyed,
+    forcefullyCrashRenderer: vi.fn(() => {
+      destroyed = true
+    }),
+    setWindowOpenHandler: (handler: typeof windowOpenHandler) => {
+      windowOpenHandler = handler
+    },
+    getWindowOpenHandler: () => windowOpenHandler
+  }
+}
+
+function makeFakeHostWindow() {
+  const emitter = makeEmitter()
+
+  return {
+    webContents: {
+      on: emitter.on,
+      removeListener: emitter.removeListener,
+      emit: emitter.emit,
+      listenerCount: emitter.listenerCount
+    }
+  }
+}
+
+function makeBindingReader(initial: typeof BINDING | null = BINDING) {
+  let current = initial
+  const listeners = new Set<(binding: typeof BINDING) => void>()
+
+  return {
+    getBinding: () => current,
+    onGenerationChange: (listener: (binding: typeof BINDING) => void) => {
+      listeners.add(listener)
+
+      return () => listeners.delete(listener)
+    },
+    // test-only: simulate a profile switch
+    switchTo: (binding: typeof BINDING) => {
+      current = binding
+
+      for (const listener of listeners) {
+        listener(binding)
+      }
+    }
+  }
+}
+
+function makeDeps(bindingReader = makeBindingReader(), sessionRegistry = makeSessionRegistry()) {
+  const events: Array<{ type: string; [key: string]: unknown }> = []
+
+  return {
+    bindingReader,
+    resolveSessionForPartition: sessionRegistry.resolveSessionForPartition,
+    isBlockedAnalyticsRequest: vi.fn((url: string) => url.includes('posthog')),
+    openExternalUrl: vi.fn(),
+    onGuestEvent: (event: { type: string; [key: string]: unknown }) => events.push(event),
+    events,
+    sessionRegistry
+  }
+}
+
+/**
+ * Mirrors the real Electron event pairing: `will-attach-webview` always
+ * fires before the matching `did-attach-webview` for the same attach
+ * operation, and the guest's `.session` is the SAME object
+ * `resolveSessionForPartition` returns for that partition (real Electron:
+ * `session.fromPartition` caching). Every "attached guest" test below goes
+ * through this rather than emitting `did-attach-webview` alone, so the
+ * fixture stays honest about what actually authorizes a guest.
+ */
+function attachGuest(
+  win: ReturnType<typeof makeFakeHostWindow>,
+  deps: ReturnType<typeof makeDeps>,
+  options: { partition?: string; src?: string } = {}
+) {
+  const partition = options.partition ?? BINDING.partition
+  const src = options.src ?? ORIGIN
+  const willAttachEvent = makeFakeEvent()
+  const webPreferences: Record<string, unknown> = {}
+  const params: Record<string, unknown> = { partition, src }
+
+  win.webContents.emit('will-attach-webview', willAttachEvent, webPreferences, params)
+
+  const guest = makeFakeGuestWebContents(deps.sessionRegistry.resolveSessionForPartition(partition))
+
+  win.webContents.emit('did-attach-webview', makeFakeEvent(), guest)
+
+  return { guest, willAttachEvent }
+}
