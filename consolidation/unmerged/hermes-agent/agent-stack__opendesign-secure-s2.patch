diff --git a/apps/desktop/src/app/open-design/index.test.tsx b/apps/desktop/src/app/open-design/index.test.tsx
new file mode 100644
index 0000000000..af59dbba9d
--- /dev/null
+++ b/apps/desktop/src/app/open-design/index.test.tsx
@@ -0,0 +1,156 @@
+import { act, cleanup, render, screen, waitFor } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+import { $activeGatewayProfile } from '@/store/profile'
+
+import { OpenDesignView } from './index'
+
+const READY_STATUS = {
+  state: 'ready',
+  origin: 'http://127.0.0.1:5173',
+  partition: 'persist:open-design-default',
+  source: 'packaged',
+  version: '0.20.0',
+  profile: 'default',
+  owned: true
+}
+
+function installBridge() {
+  let statusListener: ((status: unknown) => void) | null = null
+
+  const api = {
+    getStatus: vi.fn(async () => ({ state: 'idle' })),
+    start: vi.fn(async () => ({ state: 'starting' })),
+    retry: vi.fn(async () => ({ state: 'starting' })),
+    stopOwned: vi.fn(async () => ({ state: 'idle' })),
+    setProfile: vi.fn(async (_profile: string) => ({ state: 'idle' })),
+    onStatus: vi.fn((callback: (status: unknown) => void) => {
+      statusListener = callback
+
+      return () => {
+        statusListener = null
+      }
+    })
+  }
+
+  ;(window as unknown as { hermesDesktop: unknown }).hermesDesktop = { openDesign: api }
+
+  return {
+    api,
+    // Waits for the effect's onStatus subscription to attach before pushing —
+    // the subscription is registered inside a useEffect, which does not run
+    // synchronously within a bare render() call.
+    emit: async (status: unknown) => {
+      await waitFor(() => expect(statusListener).not.toBeNull())
+      act(() => statusListener?.(status))
+    }
+  }
+}
+
+afterEach(() => {
+  cleanup()
+  delete (window as unknown as { hermesDesktop?: unknown }).hermesDesktop
+  $activeGatewayProfile.set('default')
+})
+
+describe('OpenDesignView', () => {
+  it('shows a starting indicator while the bridge reports starting', async () => {
+    const { api } = installBridge()
+
+    render(<OpenDesignView />)
+
+    await waitFor(() => expect(api.start).toHaveBeenCalled())
+    expect(screen.getByRole('status')).not.toBeNull()
+  })
+
+  it('shows a retry action in the unavailable state and invokes retry() on click', async () => {
+    const { emit } = installBridge()
+
+    render(<OpenDesignView />)
+    await emit({ state: 'unavailable', reason: 'runtime_not_installed' })
+
+    const retryButton = await screen.findByRole('button', { name: 'Retry' })
+
+    expect(screen.getByText(/isn.t available/i)).not.toBeNull()
+    expect(retryButton).not.toBeNull()
+  })
+
+  it('shows a retry action in the crashed state', async () => {
+    const { emit } = installBridge()
+
+    render(<OpenDesignView />)
+    await emit({ state: 'crashed', reason: 'load_failed' })
+
+    expect(await screen.findByRole('button', { name: 'Retry' })).not.toBeNull()
+    expect(screen.getByText(/stopped unexpectedly/i)).not.toBeNull()
+  })
+
+  it('shows the unsupported state with no retry action (retrying cannot help)', async () => {
+    const { emit } = installBridge()
+
+    render(<OpenDesignView />)
+    await emit({ state: 'unsupported', reason: 'platform_unsupported' })
+
+    expect(await screen.findByText(/isn.t supported/i)).not.toBeNull()
+    expect(screen.queryByRole('button', { name: 'Retry' })).toBeNull()
+  })
+
+  it('surfaces the bounded diagnostic reason code, never a raw error', async () => {
+    const { emit } = installBridge()
+
+    render(<OpenDesignView />)
+    await emit({ state: 'error', reason: 'invalid_status' })
+
+    expect(await screen.findByText('Diagnostic code: invalid_status')).not.toBeNull()
+  })
+
+  it('mounts the guest webview once ready, with a keyboard-accessible focus toggle', async () => {
+    const { emit } = installBridge()
+
+    const rendered = render(<OpenDesignView />);
+    await emit(READY_STATUS)
+
+    const webview = await waitForElement(() => rendered.container.querySelector('webview'))
+
+    expect(webview?.getAttribute('src')).toBe(READY_STATUS.origin)
+    expect(webview?.getAttribute('partition')).toBe(READY_STATUS.partition)
+
+    const focusButton = screen.getByRole('button', { name: 'Enter focus mode' })
+
+    expect(focusButton.getAttribute('aria-pressed')).toBe('false')
+  })
+
+  it('preserves the same webview DOM node across a focus-mode toggle', async () => {
+    const { emit } = installBridge()
+
+    const rendered = render(<OpenDesignView />);
+    await emit(READY_STATUS)
+
+    const webviewBefore = await waitForElement(() => rendered.container.querySelector('webview'))
+
+    act(() => {
+      screen.getByRole('button', { name: 'Enter focus mode' }).click()
+    })
+
+    const webviewAfter = rendered.container.querySelector('webview')
+
+    expect(webviewAfter).toBe(webviewBefore)
+    expect(screen.getByRole('button', { name: 'Exit focus mode' }).getAttribute('aria-pressed')).toBe('true')
+  })
+})
+
+async function waitForElement<T>(query: () => T | null, attempts = 20): Promise<T> {
+  for (let attempt = 0; attempt < attempts; attempt += 1) {
+    const value = query()
+
+    if (value) {
+      return value
+    }
+
+    await act(async () => {
+      await Promise.resolve()
+    })
+  }
+
+  throw new Error('element not found in time')
+}
