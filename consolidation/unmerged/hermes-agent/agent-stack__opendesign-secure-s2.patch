+// ── disposal ─────────────────────────────────────────────────────────────────
+
+test('dispose removes both webview listeners and the binding subscription', () => {
+  const win = makeFakeHostWindow()
+  const bindingReader = makeBindingReader()
+  const deps = makeDeps(bindingReader)
+
+  const dispose = installOpenDesignGuestPolicy(win, deps)
+  const before = win.webContents.listenerCount('will-attach-webview') + win.webContents.listenerCount('did-attach-webview')
+
+  dispose()
+
+  const after = win.webContents.listenerCount('will-attach-webview') + win.webContents.listenerCount('did-attach-webview')
+
+  assert.ok(before > 0)
+  assert.equal(after, 0)
+
+  // Post-dispose, will-attach-webview no longer runs, so nothing is ever
+  // approved — did-attach-webview (if it somehow still fired) must be a no-op.
+  const guest = makeFakeGuestWebContents()
+
+  win.webContents.emit('did-attach-webview', makeFakeEvent(), guest)
+  bindingReader.switchTo({ profile: 'other', partition: 'persist:open-design-other', origin: ORIGIN, generation: 2 })
+  assert.equal(guest.forcefullyCrashRenderer.mock.calls.length, 0)
+})
diff --git a/apps/desktop/electron/open-design/guest-policy.ts b/apps/desktop/electron/open-design/guest-policy.ts
new file mode 100644
index 0000000000..73bd2c0c1b
--- /dev/null
+++ b/apps/desktop/electron/open-design/guest-policy.ts
@@ -0,0 +1,300 @@
+import { isOpenDesignPartition } from './profile'
+import { isAllowedOpenDesignInitialSource, isAllowedOpenDesignNavigation, isSafeExternalPopupUrl } from './runtime-origin'
+
+/** The main-owned facts read at every attach/navigation decision point. */
+export interface OpenDesignGuestBinding {
+  profile: string
+  partition: string
+  origin: string | null
+  /** Bumps on every real authority-changing transition (profile switch OR
+   *  origin set/change/clear). Used to detect a `will-attach-webview`
+   *  approval that is no longer current by the time its matching
+   *  `did-attach-webview` arrives. */
+  generation: number
+}
+
+export interface OpenDesignBindingReader {
+  getBinding: () => OpenDesignGuestBinding | null
+  /** Fires on every real authority-changing transition. */
+  onGenerationChange: (listener: (binding: OpenDesignGuestBinding) => void) => () => void
+}
+
+export type OpenDesignGuestEvent =
+  | { type: 'crashed'; reason: string }
+  | { type: 'load-failed' }
+  | { type: 'stale-revoked' }
+
+export interface OpenDesignGuestPolicyDeps {
+  bindingReader: OpenDesignBindingReader
+  /** Main's real wiring passes `(partition) => session.fromPartition(partition)`.
+   *  Injected so the identity check below is testable without Electron, and
+   *  so THIS is the exact seam that proves a guest's session really is the
+   *  dedicated Open Design one — never a string comparison against
+   *  something `guest.session` cannot actually report back. */
+  resolveSessionForPartition: (partition: string) => unknown
+  isBlockedAnalyticsRequest: (url: string) => boolean
+  openExternalUrl: (url: string) => void
+  onGuestEvent?: (event: OpenDesignGuestEvent) => void
+}
+
+/** Minimal structural surface of the attach-time preferences bag. Mutated in
+ *  place — Electron applies whatever this object holds when the event
+ *  handler returns. */
+interface MutableWebPreferences {
+  sandbox?: boolean
+  contextIsolation?: boolean
+  nodeIntegration?: boolean
+  nodeIntegrationInSubFrames?: boolean
+  webSecurity?: boolean
+  allowRunningInsecureContent?: boolean
+  partition?: string
+  preload?: string
+  additionalArguments?: string[]
+  [key: string]: unknown
+}
+
+interface MutableWebviewParams {
+  src?: unknown
+  partition?: unknown
+  preload?: string
+  allowpopups?: string
+  webpreferences?: string
+  [key: string]: unknown
+}
+
+interface ElectronEventLike {
+  preventDefault: () => void
+}
+
+interface GuestSessionLike {
+  on: (event: 'will-download', listener: (event: ElectronEventLike, item: unknown) => void) => void
+  setPermissionRequestHandler: (
+    handler: (webContents: unknown, permission: string, callback: (granted: boolean) => void) => void
+  ) => void
+  setPermissionCheckHandler: (handler: (...args: unknown[]) => boolean) => void
+  setDevicePermissionHandler?: (handler: (...args: unknown[]) => boolean) => void
+  setDisplayMediaRequestHandler?: (handler: (request: unknown, callback: (streams: unknown) => void) => void) => void
+  webRequest: {
+    onBeforeRequest: (listener: (details: { url: string }, callback: (response: { cancel: boolean }) => void) => void) => void
+  }
+}
+
+interface GuestWebContentsLike {
+  session: GuestSessionLike
+  isDestroyed: () => boolean
+  on: (event: string, listener: (...args: any[]) => void) => void
+  once: (event: string, listener: (...args: any[]) => void) => void
+  removeListener?: (event: string, listener: (...args: any[]) => void) => void
+  setWindowOpenHandler: (handler: (details: { url: string; disposition: string }) => { action: 'allow' | 'deny' }) => void
+  forcefullyCrashRenderer?: () => void
+}
+
+export interface OpenDesignHostWindowLike {
+  webContents: {
+    on: (
+      event: 'did-attach-webview' | 'will-attach-webview',
+      listener: (...args: any[]) => void
+    ) => void
+    removeListener?: (event: string, listener: (...args: any[]) => void) => void
+  }
+}
+
+/** Bounds the pending-approval map so an attach that Electron aborts after
+ *  `will-attach-webview` (never reaching a matching `did-attach-webview`)
+ *  cannot accumulate forever. Ordinary usage never approaches this — Hermes
+ *  attaches at most one Open Design guest per window at a time. */
+const MAX_PENDING_APPROVALS = 8
+
+function safeTeardown(guest: GuestWebContentsLike): void {
+  try {
+    if (!guest.isDestroyed()) {
+      guest.forcefullyCrashRenderer?.()
+    }
+  } catch {
+    // Best-effort: the guest is already being treated as unauthorized.
+  }
+}
+
+/**
+ * Focused, injectable module implementing OD-07: `will-attach-webview`
+ * hardening plus every attached-guest control (navigation, popups,
+ * downloads, permissions, telemetry, crash/load-failure signaling, and
+ * stale-binding revocation). Scoped ONLY to partitions shaped like
+ * `persist:open-design-*` — an unrelated preview/session webview is never
+ * inspected, let alone mutated. Install once per Hermes host window.
+ */
+export function installOpenDesignGuestPolicy(win: OpenDesignHostWindowLike, deps: OpenDesignGuestPolicyDeps): () => void {
+  const { bindingReader, resolveSessionForPartition, isBlockedAnalyticsRequest, openExternalUrl, onGuestEvent } = deps
+  const trackedGuests = new Set<GuestWebContentsLike>()
+  // Sessions that already have the dedicated-partition policy installed
+  // (permission/download/telemetry handlers) — see installSessionPolicyOnce.
+  // A `persist:` partition's session outlives any one guest attach/detach
+  // cycle, so this must be keyed by session identity, not re-run per attach.
+  const sessionsWithPolicyInstalled = new WeakSet<GuestSessionLike>()
+  // Pending will-attach-webview approvals awaiting their matching
+  // did-attach-webview, keyed by the EXACT dedicated session object identity
+  // (never a partition string guest.session cannot report back) so an
+  // interleaved unrelated attach can never consume or be mistaken for this
+  // approval. Bounded — see MAX_PENDING_APPROVALS.
+  const pendingApprovals = new Map<unknown, { generation: number }>()
+
+  function emit(event: OpenDesignGuestEvent): void {
+    onGuestEvent?.(event)
+  }
+
+  function onWillAttach(event: ElectronEventLike, webPreferences: MutableWebPreferences, params: MutableWebviewParams): void {
+    if (!isOpenDesignPartition(params.partition)) {
+      return
+    }
+
+    const binding = bindingReader.getBinding()
+
+    if (!binding || params.partition !== binding.partition || !binding.origin || !isAllowedOpenDesignInitialSource(params.src, binding.origin)) {
+      event.preventDefault()
+
+      return
+    }
+
+    const expectedSession = resolveSessionForPartition(binding.partition)
+
+    pendingApprovals.set(expectedSession, { generation: binding.generation })
+
+    if (pendingApprovals.size > MAX_PENDING_APPROVALS) {
+      const oldestKey = pendingApprovals.keys().next().value
+
+      pendingApprovals.delete(oldestKey)
+    }
+
+    webPreferences.sandbox = true
+    webPreferences.contextIsolation = true
+    webPreferences.nodeIntegration = false
+    webPreferences.nodeIntegrationInSubFrames = false
+    webPreferences.webSecurity = true
+    webPreferences.allowRunningInsecureContent = false
+    webPreferences.partition = binding.partition
+    delete webPreferences.preload
+    delete webPreferences.additionalArguments
+
+    params.preload = ''
+    // `allowpopups` is deliberately NOT touched here: verified against real
+    // Electron (security-harness.ts) that a `will-attach-webview` mutation
+    // of `params.allowpopups` has no effect — Electron reads the flag from
+    // the webview tag's OWN attribute on the renderer side, not from this
+    // event. The trusted renderer (src/app/open-design/webview-host.tsx)
+    // sets `allowpopups="true"` directly so a popup request reaches
+    // `setWindowOpenHandler` at all; that handler unconditionally returning
+    // `{action:'deny'}` below is the actual security boundary regardless of
+    // this flag's value, so leaving it unenforceable here is not a
+    // weakening — main was never able to enforce it at this seam.
+    delete params.webpreferences
+  }
+
+  function installSessionPolicyOnce(guestSession: GuestSessionLike): void {
+    if (sessionsWithPolicyInstalled.has(guestSession)) {
+      return
+    }
+
+    sessionsWithPolicyInstalled.add(guestSession)
+
+    guestSession.on('will-download', downloadEvent => {
+      downloadEvent.preventDefault()
+    })
+
+    guestSession.setPermissionRequestHandler((_webContents, _permission, callback) => callback(false))
+    guestSession.setPermissionCheckHandler(() => false)
+    guestSession.setDevicePermissionHandler?.(() => false)
+    guestSession.setDisplayMediaRequestHandler?.((_request, callback) => callback({}))
+
+    guestSession.webRequest.onBeforeRequest((details, callback) => {
+      callback({ cancel: isBlockedAnalyticsRequest(details.url) })
+    })
+  }
+
+  function installAttachedGuestPolicy(guest: GuestWebContentsLike, binding: OpenDesignGuestBinding): void {
+    trackedGuests.add(guest)
+    installSessionPolicyOnce(guest.session)
+
+    guest.setWindowOpenHandler(details => {
+      if (isSafeExternalPopupUrl(details.url)) {
+        openExternalUrl(details.url)
+      }
+
+      return { action: 'deny' }
+    })
+
+    guest.on('will-navigate', (navEvent: ElectronEventLike, url: string) => {
+      if (!binding.origin || !isAllowedOpenDesignNavigation(url, binding.origin)) {
+        navEvent.preventDefault()
+      }
+    })
+
+    guest.on('will-redirect', (navEvent: ElectronEventLike, url: string) => {
+      if (!binding.origin || !isAllowedOpenDesignNavigation(url, binding.origin)) {
+        navEvent.preventDefault()
+      }
+    })
+
+    guest.on('render-process-gone', (_event: unknown, details: { reason?: string }) => {
+      trackedGuests.delete(guest)
+      emit({ type: 'crashed', reason: String(details?.reason || 'unknown') })
+    })
+
+    guest.on('did-fail-load', (_event: unknown, errorCode: number, _description: string, _url: string, isMainFrame: boolean) => {
+      if (isMainFrame && errorCode !== -3) {
+        emit({ type: 'load-failed' })
+      }
+    })
+
+    guest.once('destroyed', () => {
+      trackedGuests.delete(guest)
+    })
+  }
+
+  function onDidAttach(_event: unknown, guest: GuestWebContentsLike): void {
+    const pending = pendingApprovals.get(guest.session)
+
+    if (!pending) {
+      // No will-attach-webview approval matches this EXACT session object —
+      // an unrelated guest (preview, OAuth, …). Left completely untouched;
+      // the real approval (if any is still pending for a different guest)
+      // is never consumed by this one.
+      return
+    }
+
+    pendingApprovals.delete(guest.session)
+
+    const binding = bindingReader.getBinding()
+
+    if (!binding || pending.generation !== binding.generation) {
+      // The binding moved on (a profile switch) between this attach being
+      // approved and completing — a narrow but real race. Revoke rather
+      // than trust an approval issued for a generation that is no longer
+      // current.
+      safeTeardown(guest)
+      emit({ type: 'stale-revoked' })
+
+      return
+    }
+
+    installAttachedGuestPolicy(guest, binding)
+  }
+
+  win.webContents.on('will-attach-webview', onWillAttach)
+  win.webContents.on('did-attach-webview', onDidAttach)
+
+  const unsubscribeBinding = bindingReader.onGenerationChange(() => {
+    // Every currently-tracked guest was installed under the generation that
+    // just ended — all of them are stale by definition.
+    for (const guest of [...trackedGuests]) {
+      trackedGuests.delete(guest)
+      safeTeardown(guest)
+      emit({ type: 'stale-revoked' })
+    }
+  })
+
+  return () => {
+    win.webContents.removeListener?.('will-attach-webview', onWillAttach)
+    win.webContents.removeListener?.('did-attach-webview', onDidAttach)
+    unsubscribeBinding()
+  }
+}
diff --git a/apps/desktop/electron/open-design/profile.test.ts b/apps/desktop/electron/open-design/profile.test.ts
