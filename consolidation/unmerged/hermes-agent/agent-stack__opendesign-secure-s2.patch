@@ -0,0 +1,119 @@
+import assert from 'node:assert/strict'
+
+import { test } from 'vitest'
+
+import { deriveOpenDesignPartition, isOpenDesignPartition, normalizeOpenDesignProfile } from './profile'
+
+const NBSP = String.fromCharCode(0xa0)
+const CYRILLIC_A = String.fromCharCode(0x0430) // Unicode lookalike of Latin 'a'
+
+test('normalizeOpenDesignProfile accepts a simple lowercase name', () => {
+  assert.equal(normalizeOpenDesignProfile('default'), 'default')
+})
+
+test('normalizeOpenDesignProfile accepts mixed case, digits, hyphen, underscore', () => {
+  assert.equal(normalizeOpenDesignProfile('Work-Profile_2'), 'Work-Profile_2')
+})
+
+test('normalizeOpenDesignProfile accepts a single character', () => {
+  assert.equal(normalizeOpenDesignProfile('a'), 'a')
+})
+
+test('normalizeOpenDesignProfile accepts exactly 64 characters', () => {
+  const name = 'a'.repeat(64)
+
+  assert.equal(normalizeOpenDesignProfile(name), name)
+})
+
+test('normalizeOpenDesignProfile rejects more than 64 characters', () => {
+  assert.equal(normalizeOpenDesignProfile('a'.repeat(65)), null)
+})
+
+test('normalizeOpenDesignProfile rejects the empty string', () => {
+  assert.equal(normalizeOpenDesignProfile(''), null)
+})
+
+test('normalizeOpenDesignProfile rejects leading or trailing hyphen/underscore', () => {
+  assert.equal(normalizeOpenDesignProfile('-default'), null)
+  assert.equal(normalizeOpenDesignProfile('default-'), null)
+  assert.equal(normalizeOpenDesignProfile('_default'), null)
+  assert.equal(normalizeOpenDesignProfile('default_'), null)
+})
+
+test('normalizeOpenDesignProfile rejects whitespace', () => {
+  assert.equal(normalizeOpenDesignProfile('my profile'), null)
+  assert.equal(normalizeOpenDesignProfile(' default'), null)
+  assert.equal(normalizeOpenDesignProfile('default '), null)
+  assert.equal(normalizeOpenDesignProfile(`default${NBSP}`), null)
+})
+
+test('normalizeOpenDesignProfile rejects control characters and separators', () => {
+  assert.equal(normalizeOpenDesignProfile('default\n'), null)
+  assert.equal(normalizeOpenDesignProfile('default/x'), null)
+  assert.equal(normalizeOpenDesignProfile('default.x'), null)
+  assert.equal(normalizeOpenDesignProfile('default:x'), null)
+  assert.equal(normalizeOpenDesignProfile('default\\x'), null)
+})
+
+test('normalizeOpenDesignProfile rejects Unicode lookalike characters', () => {
+  assert.equal(normalizeOpenDesignProfile(`default${CYRILLIC_A}`), null)
+})
+
+test('normalizeOpenDesignProfile rejects a remote-endpoint-shaped value', () => {
+  assert.equal(normalizeOpenDesignProfile('https://example.com'), null)
+  assert.equal(normalizeOpenDesignProfile('user@host'), null)
+})
+
+test('normalizeOpenDesignProfile rejects non-string and object input', () => {
+  assert.equal(normalizeOpenDesignProfile(undefined), null)
+  assert.equal(normalizeOpenDesignProfile(null), null)
+  assert.equal(normalizeOpenDesignProfile(42), null)
+  assert.equal(normalizeOpenDesignProfile({ profile: 'default' }), null)
+  assert.equal(normalizeOpenDesignProfile(['default']), null)
+})
+
+test('deriveOpenDesignPartition derives a persist: partition namespaced to Open Design', () => {
+  assert.equal(deriveOpenDesignPartition('default'), 'persist:open-design-default')
+})
+
+test('deriveOpenDesignPartition produces distinct partitions for distinct profiles', () => {
+  assert.notEqual(deriveOpenDesignPartition('work'), deriveOpenDesignPartition('personal'))
+})
+
+test('deriveOpenDesignPartition is deterministic — switching back restores the same partition', () => {
+  const first = deriveOpenDesignPartition('work')
+  const second = deriveOpenDesignPartition('personal')
+  const backToFirst = deriveOpenDesignPartition('work')
+
+  assert.equal(first, backToFirst)
+  assert.notEqual(first, second)
+})
+
+test('deriveOpenDesignPartition preserves case (distinct-case profiles stay distinct)', () => {
+  assert.notEqual(deriveOpenDesignPartition('Default'), deriveOpenDesignPartition('default'))
+})
+
+test('isOpenDesignPartition recognizes a well-formed Open Design partition', () => {
+  assert.equal(isOpenDesignPartition('persist:open-design-default'), true)
+  assert.equal(isOpenDesignPartition(deriveOpenDesignPartition('work')), true)
+})
+
+test('isOpenDesignPartition rejects an unrelated partition (e.g. the preview webview)', () => {
+  assert.equal(isOpenDesignPartition('persist:hermes-preview'), false)
+  assert.equal(isOpenDesignPartition('persist:hermes-remote-oauth'), false)
+})
+
+test('isOpenDesignPartition rejects a non-persistent or malformed partition', () => {
+  assert.equal(isOpenDesignPartition('open-design-default'), false)
+  assert.equal(isOpenDesignPartition(''), false)
+})
+
+test('isOpenDesignPartition rejects a pathologically long value', () => {
+  assert.equal(isOpenDesignPartition(`persist:open-design-${'a'.repeat(500)}`), false)
+})
+
+test('isOpenDesignPartition rejects non-string input', () => {
+  assert.equal(isOpenDesignPartition(undefined), false)
+  assert.equal(isOpenDesignPartition(null), false)
+  assert.equal(isOpenDesignPartition(42), false)
+})
diff --git a/apps/desktop/electron/open-design/profile.ts b/apps/desktop/electron/open-design/profile.ts
new file mode 100644
index 0000000000..c2a0aee1c7
--- /dev/null
+++ b/apps/desktop/electron/open-design/profile.ts
@@ -0,0 +1,47 @@
+/**
+ * Main-owned profile normalization and partition derivation for the Open
+ * Design guest. The renderer's `setProfile` call carries only "the active
+ * profile fact" (see preload/register-open-design-ipc.ts) — main revalidates
+ * it from scratch here and never trusts a renderer-proposed partition.
+ *
+ * Grammar: ASCII letters/digits, interior hyphen/underscore, 1-64 characters,
+ * must start and end with a letter or digit. This rejects whitespace
+ * (including Unicode look-alike spaces), path/URL separators (`/`, `.`,
+ * `:`, `\`), Unicode homoglyph letters, and objects — while still accepting
+ * the range of real Hermes profile names (case-sensitive; case is preserved,
+ * never folded, so two distinctly-cased profiles never collide on one
+ * partition).
+ */
+const OPEN_DESIGN_PROFILE_PATTERN = /^[A-Za-z0-9](?:[A-Za-z0-9_-]{0,62}[A-Za-z0-9])?$/
+
+export function normalizeOpenDesignProfile(raw: unknown): string | null {
+  if (typeof raw !== 'string') {
+    return null
+  }
+
+  return OPEN_DESIGN_PROFILE_PATTERN.test(raw) ? raw : null
+}
+
+const PARTITION_PREFIX = 'persist:open-design-'
+const MAX_PARTITION_LENGTH = PARTITION_PREFIX.length + 64
+
+/**
+ * Deterministic, profile-scoped Electron `persist:` partition. Pure function
+ * of the already-normalized profile, so distinct profiles always land on
+ * distinct partitions and the same profile always restores the same one —
+ * there is no separate persisted mapping to drift out of sync.
+ */
+export function deriveOpenDesignPartition(normalizedProfile: string): string {
+  return `${PARTITION_PREFIX}${normalizedProfile}`
+}
+
+/**
+ * Does `value` look like an Open Design partition at all (regardless of
+ * whether it is the currently ACTIVE one)? Used by the guest policy to
+ * decide whether an attach attempt is Open Design's concern in the first
+ * place — an unrelated partition (the preview webview, OAuth) must be left
+ * byte-for-byte untouched rather than merely "not matched".
+ */
+export function isOpenDesignPartition(value: unknown): value is string {
+  return typeof value === 'string' && value.length <= MAX_PARTITION_LENGTH && value.startsWith(PARTITION_PREFIX)
+}
diff --git a/apps/desktop/electron/open-design/register-open-design-ipc.test.ts b/apps/desktop/electron/open-design/register-open-design-ipc.test.ts
new file mode 100644
index 0000000000..6991d0de5e
--- /dev/null
+++ b/apps/desktop/electron/open-design/register-open-design-ipc.test.ts
@@ -0,0 +1,354 @@
+import assert from 'node:assert/strict'
+
+import { test, vi } from 'vitest'
+
+import { isTrustedOpenDesignSender, OPEN_DESIGN_IPC_CHANNELS, registerOpenDesignIpc } from './register-open-design-ipc'
+
+const READY_RAW = { state: 'ready', origin: 'http://127.0.0.1:5173', source: 'packaged', version: '0.20.0', owned: true }
+const BINDING = { profile: 'default', partition: 'persist:open-design-default' }
+const TRUSTED = { isDestroyed: false, isMainFrame: true, isTrustedHostWindow: true }
+const UNTRUSTED_NO_WINDOW = { isDestroyed: false, isMainFrame: true, isTrustedHostWindow: false }
+const UNTRUSTED_DESTROYED = { isDestroyed: true, isMainFrame: true, isTrustedHostWindow: true }
+const UNTRUSTED_SUBFRAME = { isDestroyed: false, isMainFrame: false, isTrustedHostWindow: true }
+
+function makeFakeIpcMain() {
+  const handlers = new Map<string, (event: unknown, ...args: unknown[]) => unknown>()
+
+  return {
+    ipcMain: {
+      handle: (channel: string, listener: (event: unknown, ...args: unknown[]) => unknown) => {
+        handlers.set(channel, listener)
+      }
+    },
+    invoke: (channel: string, event: unknown, ...args: unknown[]) => {
+      const handler = handlers.get(channel)
+
+      if (!handler) {
+        throw new Error(`no handler registered for ${channel}`)
+      }
+
+      return handler(event, ...args)
+    },
+    channels: () => [...handlers.keys()].sort()
+  }
+}
+
+function makeFakeRuntimePort(overrides: Record<string, (...args: never[]) => unknown> = {}) {
+  let statusListener: ((raw: unknown) => void) | null = null
+
+  return {
+    getStatus: vi.fn(async () => READY_RAW),
+    start: vi.fn(async () => READY_RAW),
+    retry: vi.fn(async () => READY_RAW),
+    stopOwned: vi.fn(async () => READY_RAW),
+    setProfile: vi.fn(async (_profile: string) => READY_RAW),
+    onStatus: vi.fn((listener: (raw: unknown) => void) => {
+      statusListener = listener
+
+      return () => {
+        statusListener = null
+      }
+    }),
+    emit: (raw: unknown) => statusListener?.(raw),
+    ...overrides
+  }
+}
+
+function makeFakeBindingStore(binding: typeof BINDING | null = BINDING) {
+  let current = binding
+
+  return {
+    setProfile: vi.fn((raw: unknown) => {
+      if (typeof raw !== 'string' || !/^[A-Za-z0-9][A-Za-z0-9_-]{0,62}[A-Za-z0-9]?$/.test(raw)) {
+        return null
+      }
+
+      current = { profile: raw, partition: `persist:open-design-${raw}` }
+
+      return current
+    }),
+    setOrigin: vi.fn((_origin: string | null) => undefined),
+    getBinding: () => current
+  }
+}
+
+function makeDeps(overrides: Record<string, unknown> = {}) {
+  const fakeIpc = makeFakeIpcMain()
+  const runtimePort = makeFakeRuntimePort()
+  const bindingStore = makeFakeBindingStore()
+  const broadcast = vi.fn()
+  let senderInfo = TRUSTED
+
+  const deps = {
+    ipcMain: fakeIpc.ipcMain,
+    resolveSenderInfo: () => senderInfo,
+    runtimePort,
+    bindingStore,
+    broadcast,
+    ...overrides
+  }
+
+  return {
+    deps,
+    fakeIpc,
+    runtimePort,
+    bindingStore,
+    broadcast,
+    setSenderInfo: (info: typeof TRUSTED) => {
+      senderInfo = info
+    }
+  }
+}
+
+// ── isTrustedOpenDesignSender ────────────────────────────────────────────────
+
