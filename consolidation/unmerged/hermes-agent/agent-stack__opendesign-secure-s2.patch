+  assert.equal(isSafeExternalPopupUrl('https://127.1/'), false)
+  assert.equal(isSafeExternalPopupUrl('https://0x7f000001/'), false)
+  assert.equal(isSafeExternalPopupUrl('https://2130706433/'), false)
+  assert.equal(isSafeExternalPopupUrl('https://[::1]/'), false)
+})
+
+test('popup: rejects malformed URLs', () => {
+  assert.equal(isSafeExternalPopupUrl('not a url'), false)
+})
+
+test('popup: rejects a raw control character (tab) and a raw backslash before parsing', () => {
+  assert.equal(isSafeExternalPopupUrl(`https://example.com/${TAB}`), false)
+  assert.equal(isSafeExternalPopupUrl('https://example.com\\@evil.com/'), false)
+})
+
+test('popup: rejects non-string input', () => {
+  assert.equal(isSafeExternalPopupUrl(undefined), false)
+  assert.equal(isSafeExternalPopupUrl(null), false)
+})
diff --git a/apps/desktop/electron/open-design/runtime-origin.ts b/apps/desktop/electron/open-design/runtime-origin.ts
index d0e5be2066..0b5a30203d 100644
--- a/apps/desktop/electron/open-design/runtime-origin.ts
+++ b/apps/desktop/electron/open-design/runtime-origin.ts
@@ -30,3 +30,159 @@ export function isValidOpenDesignRuntimeOrigin(value: string): boolean {
 
   return port >= 1 && port <= 65535
 }
+
+// Built purely from numeric code-point arithmetic (never a literal
+// invisible/whitespace character pasted into source, and never a bare `\s`
+// escape either) so the set cannot silently rot if an editor or transport
+// normalizes whitespace, and so it is trivially auditable against the
+// Unicode `White_Space` list. Covers: C0 controls plus the plain space
+// (0x00-0x20), DEL + C1 controls (0x7F-0x9F, which already contains U+0085
+// NEL — the exact character a naive `\s`-based check misses), every other
+// Unicode White_Space code point, and a literal backslash (a WHATWG URL
+// parser quirk normalizes backslashes to forward slashes for special
+// schemes, which can smuggle a host-lookalike path past a naive same-origin
+// string check performed before parsing).
+const RAW_UNSAFE_RANGES: ReadonlyArray<readonly [number, number]> = [
+  [0x00, 0x20],
+  [0x7f, 0x9f],
+  [0xa0, 0xa0],
+  [0x1680, 0x1680],
+  [0x2000, 0x200a],
+  [0x2028, 0x2029],
+  [0x202f, 0x202f],
+  [0x205f, 0x205f],
+  [0x3000, 0x3000],
+  [0xfeff, 0xfeff]
+]
+
+const BACKSLASH_CODEPOINT = 0x5c
+const MAX_RAW_URL_LENGTH = 4096
+
+function isRawUnsafeCodepoint(codepoint: number): boolean {
+  if (codepoint === BACKSLASH_CODEPOINT) {
+    return true
+  }
+
+  return RAW_UNSAFE_RANGES.some(([start, end]) => codepoint >= start && codepoint <= end)
+}
+
+/**
+ * Raw-text preflight shared by every navigation/popup guard below. Runs
+ * BEFORE `new URL()` because the parser normalizes away exactly the things
+ * that must be rejected outright — see `RAW_UNSAFE_RANGES`. Bounded length
+ * guards against pathological input reaching the URL parser at all.
+ */
+function passesRawPreflight(raw: unknown): raw is string {
+  if (typeof raw !== 'string' || raw.length === 0 || raw.length > MAX_RAW_URL_LENGTH) {
+    return false
+  }
+
+  for (let index = 0; index < raw.length; index += 1) {
+    if (isRawUnsafeCodepoint(raw.charCodeAt(index))) {
+      return false
+    }
+  }
+
+  return true
+}
+
+function hasUserinfo(parsed: URL): boolean {
+  return parsed.username.length > 0 || parsed.password.length > 0
+}
+
+/**
+ * Is `raw` an acceptable literal `<webview src>` for the initial Open Design
+ * attach? Exact-string match against the bound origin (with or without the
+ * single trailing root slash) — not a parsed-origin comparison — so an
+ * initial source carrying an extra path/query/fragment on an otherwise
+ * correct origin is rejected rather than silently trimmed down to its root.
+ */
+export function isAllowedOpenDesignInitialSource(raw: unknown, boundOrigin: string): boolean {
+  if (!passesRawPreflight(raw) || !isValidOpenDesignRuntimeOrigin(boundOrigin)) {
+    return false
+  }
+
+  return raw === boundOrigin || raw === `${boundOrigin}/`
+}
+
+/**
+ * Is `raw` an acceptable in-place top-frame navigation/redirect target for an
+ * already-attached Open Design guest? Raw preflight, then exact PARSED-origin
+ * equality against the immutable bound origin — same-origin path/query/hash
+ * (the SPA's own routing, including percent-encoded content) is allowed;
+ * anything that resolves to a different origin is not, no matter how it is
+ * spelled.
+ */
+export function isAllowedOpenDesignNavigation(raw: unknown, boundOrigin: string): boolean {
+  if (!passesRawPreflight(raw) || !isValidOpenDesignRuntimeOrigin(boundOrigin)) {
+    return false
+  }
+
+  let parsed: URL
+
+  try {
+    parsed = new URL(raw)
+  } catch {
+    return false
+  }
+
+  if (hasUserinfo(parsed)) {
+    return false
+  }
+
+  return parsed.origin === boundOrigin
+}
+
+const DECIMAL_HOST_PATTERN = /^\d{1,10}$/
+const HEX_HOST_PATTERN = /^0x[0-9a-f]+$/i
+const OCTAL_HOST_PATTERN = /^0[0-7]+$/
+const IPV4_LOOPBACK_LOOKALIKE_PATTERN = /^127(?:\.\d{1,3}){1,3}$/
+
+/**
+ * A loopback address or a well-known lookalike spelling of one (short-form
+ * `127.1`, hex/octal/decimal IPv4, IPv6 `::1` in any bracketing). Used only to
+ * keep the popup-delegation allowlist from treating "this machine" as a safe
+ * external destination — it does not need to be an exhaustive IPv4 parser,
+ * only to catch the forms that read as ordinary hostnames.
+ */
+function isLoopbackLikeHostname(hostname: string): boolean {
+  const host = hostname.toLowerCase()
+
+  return (
+    host === 'localhost' ||
+    host === '0.0.0.0' ||
+    host === '::1' ||
+    host === '[::1]' ||
+    IPV4_LOOPBACK_LOOKALIKE_PATTERN.test(host) ||
+    HEX_HOST_PATTERN.test(host) ||
+    OCTAL_HOST_PATTERN.test(host) ||
+    DECIMAL_HOST_PATTERN.test(host)
+  )
+}
+
+/**
+ * May this popup target be delegated to Hermes's external-link policy
+ * (`shell.openExternal`)? Only a well-formed `https:` URL with no embedded
+ * credentials and no loopback/lookalike host — `javascript:`, `data:`,
+ * `file:`, custom schemes, and anything else stay inside the deny-by-default
+ * popup policy.
+ */
+export function isSafeExternalPopupUrl(raw: unknown): boolean {
+  if (!passesRawPreflight(raw)) {
+    return false
+  }
+
+  let parsed: URL
+
+  try {
+    parsed = new URL(raw)
+  } catch {
+    return false
+  }
+
+  if (parsed.protocol !== 'https:' || hasUserinfo(parsed)) {
+    return false
+  }
+
+  return !isLoopbackLikeHostname(parsed.hostname)
+}
