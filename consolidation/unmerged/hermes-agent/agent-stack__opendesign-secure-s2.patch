diff --git a/apps/desktop/electron/open-design/register-open-design-ipc.ts b/apps/desktop/electron/open-design/register-open-design-ipc.ts
new file mode 100644
index 0000000000..020173f8f9
--- /dev/null
+++ b/apps/desktop/electron/open-design/register-open-design-ipc.ts
@@ -0,0 +1,149 @@
+import type { OpenDesignRuntimePort } from './runtime-port'
+import { readyOriginIfValid, sanitizeOpenDesignStatus } from './status-contract'
+import type { OpenDesignBindingFacts, OpenDesignStatus } from './status-contract'
+
+/**
+ * The exact, closed request-channel surface. No generic invoke/send channel
+ * exists for Open Design — a caller that isn't one of these five gets no
+ * handler at all. `statusBroadcast` is main -> renderer only (never
+ * `ipcMain.handle`d) and is what preload's `onStatus` subscribes to.
+ */
+export const OPEN_DESIGN_IPC_CHANNELS = {
+  getStatus: 'hermes:open-design:get-status',
+  start: 'hermes:open-design:start',
+  retry: 'hermes:open-design:retry',
+  stopOwned: 'hermes:open-design:stop-owned',
+  setProfile: 'hermes:open-design:set-profile',
+  statusBroadcast: 'hermes:open-design:status'
+} as const
+
+/** Structural facts about an IPC sender, extracted by the real Electron glue
+ *  in main.ts so the trust predicate itself stays Electron-free and testable. */
+export interface OpenDesignSenderInfo {
+  /** The sender's window is on main's explicit trusted-Hermes-host-window
+   *  registry — NOT merely "some live BrowserWindow resolves for this
+   *  sender". An OAuth/portal/foreign window existing in the process must
+   *  never count, even though it can never reach this bridge anyway (it
+   *  carries no preload) — this is the identity check that keeps it that
+   *  way even if a future window is ever given a preload without also being
+   *  added to the registry. */
+  isTrustedHostWindow: boolean
+  isDestroyed: boolean
+  /** The sender is the window's top/main frame, not a subframe. */
+  isMainFrame: boolean
+}
+
+/**
+ * The Open Design guest has no preload and so cannot invoke these channels
+ * regardless — this is defense in depth against a compromised/foreign frame
+ * inside a trusted host window impersonating the sender.
+ */
+export function isTrustedOpenDesignSender(info: OpenDesignSenderInfo): boolean {
+  return info.isTrustedHostWindow && !info.isDestroyed && info.isMainFrame
+}
+
+interface MinimalBindingStore {
+  setProfile(raw: unknown): OpenDesignBindingFacts | null
+  /** Installs (or clears, via `null`) main's validated runtime origin —
+   *  see electron/open-design/binding-store.ts. */
+  setOrigin(origin: string | null): void
+  getBinding(): OpenDesignBindingFacts | null
+}
+
+export interface RegisterOpenDesignIpcDeps {
+  ipcMain: {
+    handle: (channel: string, listener: (event: unknown, ...args: unknown[]) => unknown | Promise<unknown>) => void
+  }
+  resolveSenderInfo: (event: unknown) => OpenDesignSenderInfo
+  runtimePort: OpenDesignRuntimePort
+  bindingStore: MinimalBindingStore
+  /** Sends the sanitized status to every trusted Hermes host window. */
+  broadcast: (status: OpenDesignStatus) => void
+}
+
+const INVALID_PROFILE_STATUS: OpenDesignStatus = { state: 'error', reason: 'invalid_profile' }
+
+function assertTrusted(resolveSenderInfo: (event: unknown) => OpenDesignSenderInfo, event: unknown): void {
+  if (!isTrustedOpenDesignSender(resolveSenderInfo(event))) {
+    throw new Error('Open Design bridge: untrusted sender')
+  }
+}
+
+function assertArity(args: unknown[], expected: number): void {
+  if (args.length !== expected) {
+    throw new Error('Open Design bridge: unexpected argument count')
+  }
+}
+
+/**
+ * Registers the six-operation Open Design bridge (five requests + one
+ * broadcast subscription) with injected Electron/runtime-port/binding-store
+ * dependencies, so the module is fully testable without Electron. Every
+ * response and every broadcast is run through `sanitizeOpenDesignStatus` —
+ * nothing the runtime port returns reaches a renderer unsanitized, and the
+ * `ready` partition/profile always come from the binding store, never from
+ * the port's own payload. Every sanitize pass also atomically syncs the
+ * binding store's origin authority (`readyOriginIfValid`) BEFORE reading it
+ * back for sanitization, so `installOpenDesignGuestPolicy` (which reads the
+ * same binding store) and the renderer status always agree — a valid
+ * `ready` installs its origin; anything else (non-ready, invalid, crashed,
+ * stopped, stale) clears it. Returns a `dispose()` that unsubscribes from
+ * the runtime port's status stream.
+ */
+export function registerOpenDesignIpc(deps: RegisterOpenDesignIpcDeps): () => void {
+  const { ipcMain, resolveSenderInfo, runtimePort, bindingStore, broadcast } = deps
+
+  function sanitize(raw: unknown): OpenDesignStatus {
+    bindingStore.setOrigin(readyOriginIfValid(raw))
+
+    return sanitizeOpenDesignStatus(raw, bindingStore.getBinding())
+  }
+
+  ipcMain.handle(OPEN_DESIGN_IPC_CHANNELS.getStatus, async (event, ...args) => {
+    assertTrusted(resolveSenderInfo, event)
+    assertArity(args, 0)
+
+    return sanitize(await runtimePort.getStatus())
+  })
+
+  ipcMain.handle(OPEN_DESIGN_IPC_CHANNELS.start, async (event, ...args) => {
+    assertTrusted(resolveSenderInfo, event)
+    assertArity(args, 0)
+
+    return sanitize(await runtimePort.start())
+  })
+
+  ipcMain.handle(OPEN_DESIGN_IPC_CHANNELS.retry, async (event, ...args) => {
+    assertTrusted(resolveSenderInfo, event)
+    assertArity(args, 0)
+
+    return sanitize(await runtimePort.retry())
+  })
+
+  ipcMain.handle(OPEN_DESIGN_IPC_CHANNELS.stopOwned, async (event, ...args) => {
+    assertTrusted(resolveSenderInfo, event)
+    assertArity(args, 0)
+
+    return sanitize(await runtimePort.stopOwned())
+  })
+
+  ipcMain.handle(OPEN_DESIGN_IPC_CHANNELS.setProfile, async (event, ...args) => {
+    assertTrusted(resolveSenderInfo, event)
+    assertArity(args, 1)
+
+    const [rawProfile] = args
+    const binding = bindingStore.setProfile(rawProfile)
+
+    if (!binding) {
+      return sanitize(INVALID_PROFILE_STATUS)
+    }
+
+    return sanitize(await runtimePort.setProfile(binding.profile))
+  })
+
+  const unsubscribe = runtimePort.onStatus(raw => broadcast(sanitize(raw)))
+
+  return () => {
+    unsubscribe()
+  }
+}
