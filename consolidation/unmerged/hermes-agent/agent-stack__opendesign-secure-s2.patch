@@ -0,0 +1,69 @@
+import assert from 'node:assert/strict'
+
+import { test } from 'vitest'
+
+import { createOpenDesignOwnerCoordinator } from './owner-coordinator'
+
+test('the first trusted acquirer becomes owner', () => {
+  const coordinator = createOpenDesignOwnerCoordinator()
+  const windowA = Symbol('A')
+
+  assert.equal(coordinator.acquire(windowA), true)
+  assert.equal(coordinator.isOwner(windowA), true)
+  assert.equal(coordinator.getOwner(), windowA)
+})
+
+test('a second window cannot acquire ownership while the first still owns', () => {
+  const coordinator = createOpenDesignOwnerCoordinator()
+  const windowA = Symbol('A')
+  const windowB = Symbol('B')
+
+  coordinator.acquire(windowA)
+
+  assert.equal(coordinator.acquire(windowB), false)
+  assert.equal(coordinator.isOwner(windowB), false)
+  assert.equal(coordinator.getOwner(), windowA)
+})
+
+test('the owner re-acquiring is idempotent and still reports ownership', () => {
+  const coordinator = createOpenDesignOwnerCoordinator()
+  const windowA = Symbol('A')
+
+  coordinator.acquire(windowA)
+
+  assert.equal(coordinator.acquire(windowA), true)
+  assert.equal(coordinator.getOwner(), windowA)
+})
+
+test('a non-owner cannot release the owner', () => {
+  const coordinator = createOpenDesignOwnerCoordinator()
+  const windowA = Symbol('A')
+  const windowB = Symbol('B')
+
+  coordinator.acquire(windowA)
+
+  assert.equal(coordinator.release(windowB), false)
+  assert.equal(coordinator.getOwner(), windowA)
+})
+
+test('releasing when nobody owns is a no-op', () => {
+  const coordinator = createOpenDesignOwnerCoordinator()
+  const windowA = Symbol('A')
+
+  assert.equal(coordinator.release(windowA), false)
+  assert.equal(coordinator.getOwner(), null)
+})
+
+test('the owner releasing allows a different trusted window to acquire', () => {
+  const coordinator = createOpenDesignOwnerCoordinator()
+  const windowA = Symbol('A')
+  const windowB = Symbol('B')
+
+  coordinator.acquire(windowA)
+  assert.equal(coordinator.release(windowA), true)
+  assert.equal(coordinator.getOwner(), null)
+
+  assert.equal(coordinator.acquire(windowB), true)
+  assert.equal(coordinator.isOwner(windowB), true)
+  assert.equal(coordinator.isOwner(windowA), false)
+})
