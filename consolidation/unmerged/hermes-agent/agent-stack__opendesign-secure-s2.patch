+import { useStore } from '@nanostores/react'
+import { useEffect, useState } from 'react'
+
+import { PageLoader } from '@/components/page-loader'
+import { Button } from '@/components/ui/button'
+import { Codicon } from '@/components/ui/codicon'
+import { ErrorState } from '@/components/ui/error-state'
+import type { OpenDesignStatus } from '@/global'
+import { type Translations, useI18n } from '@/i18n'
+import { cn } from '@/lib/utils'
+import { $activeGatewayProfile, normalizeProfileKey } from '@/store/profile'
+
+import { UNINTEGRATED_THEME_SEAM } from './theme-seam'
+import { useOpenDesignStatus } from './use-open-design-status'
+import { type OpenDesignGuestFailure, OpenDesignGuestHost } from './webview-host'
+
+type OpenDesignCopy = Translations['openDesign']
+
+/** Sanitized `reason` codes are the only diagnostic surface — never a raw
+ *  message/log/stack. `guestFailure` maps to the same shape so a local
+ *  webview crash/load-failure reads identically to a main-reported one. */
+function displayFailure(
+  status: OpenDesignStatus,
+  guestFailure: null | OpenDesignGuestFailure
+): { state: 'crashed' | 'error' | 'unavailable' | 'unsupported'; reason?: string } | null {
+  if (guestFailure) {
+    return { state: 'crashed', reason: guestFailure === 'theme-rejected' ? 'theme_seam_rejected' : undefined }
+  }
+
+  if (status.state === 'unavailable' || status.state === 'unsupported' || status.state === 'crashed' || status.state === 'error') {
+    return { reason: status.reason, state: status.state }
+  }
+
+  return null
+}
+
+function OpenDesignFailureState({
+  od,
+  onRetry,
+  reason,
+  state
+}: {
+  od: OpenDesignCopy
+  onRetry: () => void
+  reason?: string
+  state: 'crashed' | 'error' | 'unavailable' | 'unsupported'
+}) {
+  const copy =
+    state === 'crashed'
+      ? { description: od.crashedDescription, title: od.crashedTitle }
+      : state === 'unavailable'
+        ? { description: od.unavailableDescription, title: od.unavailableTitle }
+        : state === 'unsupported'
+          ? { description: od.unsupportedDescription, title: od.unsupportedTitle }
+          : { description: od.errorDescription, title: od.errorTitle }
+
+  return (
+    <ErrorState
+      description={
+        <>
+          {copy.description}
+          {reason && <div className="mt-1 text-xs text-muted-foreground/70">{od.diagnostic(reason)}</div>}
+        </>
+      }
+      title={copy.title}
+    >
+      {/* Retrying an unsupported platform cannot help — no action offered. */}
+      {state !== 'unsupported' && (
+        <Button onClick={onRetry} type="button">
+          {od.retry}
+        </Button>
+      )}
+    </ErrorState>
+  )
+}
+
+/**
+ * The built-in `/design` workspace (OD-01, OD-09). Full-bleed, chrome-free
+ * host for the sandboxed Open Design guest. Renders the bounded state
+ * machine (starting/migrating/unavailable/unsupported/retrying/crashed/
+ * error/ready) from the sanitized bridge status alone — never a raw
+ * upstream object.
+ */
+export function OpenDesignView() {
+  const { t } = useI18n()
+  const od = t.openDesign
+  const profile = normalizeProfileKey(useStore($activeGatewayProfile))
+  const { retry, status } = useOpenDesignStatus(profile)
+  const [focused, setFocused] = useState(false)
+  const [guestFailure, setGuestFailure] = useState<null | OpenDesignGuestFailure>(null)
+  const [reloadNonce, setReloadNonce] = useState(0)
+  const readyOrigin = status.state === 'ready' ? status.origin : null
+
+  // A genuinely fresh `ready` (a new origin, or the first one) clears any
+  // earlier guest-local failure so the webview gets a real chance.
+  useEffect(() => {
+    setGuestFailure(null)
+  }, [readyOrigin])
+
+  const failure = displayFailure(status, guestFailure)
+  const showGuest = status.state === 'ready' && !failure
+
+  const handleRetry = () => {
+    setGuestFailure(null)
+    setReloadNonce(nonce => nonce + 1)
+    void retry()
+  }
+
+  return (
+    <div className="relative size-full overflow-hidden bg-background" data-open-design-root>
+      {showGuest && status.state === 'ready' && (
+        <div
+          className={cn(
+            'absolute inset-0',
+            focused && 'fixed inset-0 z-(--z-modal) bg-background'
+          )}
+        >
+          <OpenDesignGuestHost
+            applyInitialTheme={UNINTEGRATED_THEME_SEAM}
+            key={reloadNonce}
+            onFailure={setGuestFailure}
+            origin={status.origin}
+            partition={status.partition}
+          />
+          <Button
+            aria-label={focused ? od.exitFocus : od.enterFocus}
+            aria-pressed={focused}
+            className="absolute top-3 right-3"
+            onClick={() => setFocused(next => !next)}
+            size="icon-sm"
+            type="button"
+            variant="secondary"
+          >
+            <Codicon name={focused ? 'screen-normal' : 'screen-full'} />
+          </Button>
+        </div>
+      )}
+
+      {!showGuest && (
+        <div className="grid h-full place-items-center p-6">
+          {failure ? (
+            <OpenDesignFailureState od={od} onRetry={handleRetry} reason={failure.reason} state={failure.state} />
+          ) : (
+            <PageLoader
+              label={status.state === 'migrating' ? od.migrating : status.state === 'retrying' ? od.retrying : od.starting}
+            />
+          )}
+        </div>
+      )}
+    </div>
+  )
+}
