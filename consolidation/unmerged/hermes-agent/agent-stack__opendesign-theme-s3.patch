+ * Pass the public `theme` field from ThemeContext. A raw preset's `colors`
+ * field is not necessarily the palette ThemeContext paints in light mode.
+ */
+export function captureOpenDesignHostThemeSnapshot(
+  { theme, renderedMode }: CaptureOpenDesignHostThemeSnapshotInput,
+  providedEnvironment?: OpenDesignHostSnapshotEnvironment
+): OpenDesignHostThemeSnapshot {
+  const environment = providedEnvironment ?? defaultEnvironment()
+  const fallback = FALLBACK_COLORS[renderedMode]
+  let probe: HTMLElement | null = null
+
+  if (environment) {
+    try {
+      probe = environment.document.createElement('span')
+      probe.hidden = true
+      const parent = environment.document.body ?? environment.document.documentElement
+      parent.appendChild(probe)
+    } catch {
+      probe?.remove()
+      probe = null
+    }
+  }
+
+  const resolveColor = (value: string | undefined, staticFallback: string, backdrop: string): string => {
+    if (!isSafeColorCandidate(value)) {
+      return staticFallback
+    }
+
+    if (!probe || !environment) {
+      return staticColor(value, staticFallback, backdrop)
+    }
+
+    try {
+      probe.style.color = ''
+      probe.style.color = value
+
+      if (!probe.style.color) {
+        return staticFallback
+      }
+
+      return parseComputedColor(environment.getComputedStyle(probe).color, backdrop) ?? staticFallback
+    } catch {
+      return staticFallback
+    }
+  }
+
+  try {
+    const c = theme.colors
+    const background = resolveColor(c.background, fallback.background, fallback.background)
+    const foreground = resolveColor(c.foreground, fallback.foreground, background)
+    const card = resolveColor(c.card, fallback.card, background)
+    const popover = resolveColor(c.popover, fallback.popover, background)
+    const primary = resolveColor(c.primary, fallback.primary, background)
+    const border = resolveColor(c.border, fallback.border, background)
+    const ring = resolveColor(c.ring, fallback.ring, background)
+    const midground = resolveColor(c.midground ?? c.ring, fallback.midground, background)
+    const destructive = resolveColor(c.destructive, fallback.destructive, background)
+
+    const resolvedColors: DesktopThemeColors = {
+      background,
+      foreground,
+      card,
+      cardForeground: resolveColor(c.cardForeground, fallback.cardForeground, background),
+      muted: resolveColor(c.muted, fallback.muted, background),
+      mutedForeground: resolveColor(c.mutedForeground, fallback.mutedForeground, background),
+      popover,
+      popoverForeground: resolveColor(c.popoverForeground, fallback.popoverForeground, background),
+      primary,
+      primaryForeground: resolveColor(
+        c.primaryForeground,
+        fallback.primaryForeground,
+        background
+      ),
+      secondary: resolveColor(c.secondary, fallback.secondary, background),
+      secondaryForeground: resolveColor(
+        c.secondaryForeground,
+        fallback.secondaryForeground,
+        background
+      ),
+      accent: resolveColor(c.accent, fallback.accent, background),
+      accentForeground: resolveColor(c.accentForeground, fallback.accentForeground, background),
+      border,
+      input: resolveColor(c.input, fallback.input, background),
+      ring,
+      midground,
+      midgroundForeground: resolveColor(
+        c.midgroundForeground ?? readableOn(midground),
+        fallback.midgroundForeground,
+        background
+      ),
+      composerRing: resolveColor(
+        c.composerRing ?? c.midground ?? c.ring,
+        fallback.composerRing,
+        background
+      ),
+      destructive,
+      destructiveForeground: resolveColor(
+        c.destructiveForeground,
+        fallback.destructiveForeground,
+        background
+      ),
+      sidebarBackground: resolveColor(
+        c.sidebarBackground ?? c.background,
+        fallback.sidebarBackground,
+        background
+      ),
+      sidebarBorder: resolveColor(
+        c.sidebarBorder ?? c.border,
+        fallback.sidebarBorder,
+        background
+      ),
+      userBubble: resolveColor(c.userBubble ?? c.popover, fallback.userBubble, background),
+      userBubbleBorder: resolveColor(
+        c.userBubbleBorder ?? c.border,
+        fallback.userBubbleBorder,
+        background
+      )
+    }
+
+    const hostGeometry = captureGeometry(environment)
+
+    return {
+      resolvedColors,
+      resolvedTypography: resolveThemeTypography(theme),
+      ...(hostGeometry ? { hostGeometry } : {})
+    }
+  } finally {
+    probe?.remove()
+  }
+}
