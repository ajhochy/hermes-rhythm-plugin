@@ -0,0 +1,47 @@
+/**
+ * Serializes an `OpenDesignThemePayload` into the CSS text injected into the
+ * guest document. A single `:root` rule covers every non-terminal var — Open
+ * Design's own `tokens.css` only ever (re)defines these on `:root` /
+ * `[data-theme]`, both specificity (0,1,0); ours wins on source order alone
+ * once appended after the page's own stylesheet, so no `!important` is
+ * needed there.
+ *
+ * `--terminal-*` is the one exception: `TerminalViewer.module.css` scopes
+ * those vars to its own component root class (a CSS Module, so its compiled
+ * name is unstable and must never be targeted directly). That local rule has
+ * equal specificity to `:root` and may load after us, so it can win the
+ * cascade on source order — the narrow, documented reason these vars alone
+ * carry `!important`.
+ *
+ * Defense in depth: every var name/value is re-validated here even though
+ * `token-map.ts` already guarantees safe output, so a future bug in the
+ * mapper fails closed (the var is dropped) instead of leaking into the guest
+ * stylesheet.
+ */
+
+import { OPEN_DESIGN_TERMINAL_VAR_NAMES, type OpenDesignThemePayload } from './types'
+
+const SAFE_VAR_NAME = /^--[a-z][a-z0-9-]*$/
+const SAFE_VALUE = /^[a-z0-9#.,%()\s"'-]+$/i
+const FORBIDDEN_VALUE = /[{}<>;]|javascript:|expression\(/i
+
+const TERMINAL_VAR_NAMES = new Set<string>(OPEN_DESIGN_TERMINAL_VAR_NAMES)
+
+function isSafeDeclaration(name: string, value: string): boolean {
+  return SAFE_VAR_NAME.test(name) && SAFE_VALUE.test(value) && !FORBIDDEN_VALUE.test(value)
+}
+
+export function buildOpenDesignThemeCss(payload: OpenDesignThemePayload): string {
+  const lines: string[] = []
+
+  for (const [name, value] of Object.entries(payload.vars)) {
+    if (!isSafeDeclaration(name, value)) {
+      continue
+    }
+
+    const important = TERMINAL_VAR_NAMES.has(name) ? ' !important' : ''
+    lines.push(`  ${name}: ${value}${important};`)
+  }
+
+  return `:root {\n${lines.join('\n')}\n}\n`
+}
