+import { describe, expect, it } from 'vitest'
+
+import { nousTheme } from '@/themes/presets'
+
+import { buildOpenDesignThemeCss } from './css'
+import { buildOpenDesignThemePayload } from './token-map'
+import { OPEN_DESIGN_TERMINAL_VAR_NAMES } from './types'
+
+describe('buildOpenDesignThemeCss', () => {
+  const payload = buildOpenDesignThemePayload(nousTheme, 'light')
+
+  it('emits a single :root rule with every var as a custom property', () => {
+    const css = buildOpenDesignThemeCss(payload)
+
+    expect(css).toContain(':root {')
+    expect(css).toContain(`--bg: ${payload.vars['--bg']};`)
+    expect(css).toContain(`--accent: ${payload.vars['--accent']};`)
+  })
+
+  it('marks only the terminal ANSI vars !important, narrowly, to win over a scoped component class', () => {
+    const css = buildOpenDesignThemeCss(payload)
+
+    for (const name of OPEN_DESIGN_TERMINAL_VAR_NAMES) {
+      expect(css).toMatch(new RegExp(`${name}:\\s*[^;]+!important;`))
+    }
+
+    // Non-terminal vars must NOT carry !important — they already win on source order.
+    expect(css).not.toMatch(/--bg:[^;]*!important/)
+    expect(css).not.toMatch(/--accent:[^;]*!important/)
+  })
+
+  it('never emits a class selector, an iframe/webview traversal, or a blanket * rule', () => {
+    const css = buildOpenDesignThemeCss(payload)
+
+    expect(css).not.toMatch(/\.[a-zA-Z][\w-]*\s*\{/)
+    expect(css).not.toContain('*')
+    expect(css.toLowerCase()).not.toContain('iframe')
+    expect(css.toLowerCase()).not.toContain('<script')
+  })
+
+  it('drops any var whose name or value fails CSS-safety validation instead of emitting it', () => {
+    const hostile = {
+      ...payload,
+      vars: {
+        ...payload.vars,
+        '--bg': '#ffffff; } body { background: red',
+        'not-a-var; injected': '#000000'
+      }
+    }
+
+    const css = buildOpenDesignThemeCss(hostile)
+
+    expect(css).not.toContain('injected')
+    expect(css).not.toMatch(/--bg:\s*#ffffff; \}/)
+  })
+
+  it('is deterministic for the same payload', () => {
+    expect(buildOpenDesignThemeCss(payload)).toBe(buildOpenDesignThemeCss(payload))
+  })
+})
