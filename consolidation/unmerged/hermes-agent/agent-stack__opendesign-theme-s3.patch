+const canonicalColor = (value: string): string => {
+  const element = document.createElement('span')
+  element.style.color = value
+
+  return element.style.color
+}
+
+function fakeEnvironment(
+  computedByCandidate: ReadonlyMap<string, string> = new Map(),
+  geometry: Readonly<Record<string, string>> = {},
+  computedRadii: Readonly<Record<string, string>> = {}
+) {
+  const readRootProperty = vi.fn((name: string) => geometry[name] ?? '')
+
+  const readProbeColors: string[] = []
+
+  const getComputedStyle = vi.fn((element: Element) => {
+    if (element === document.documentElement) {
+      return { borderRadius: '', color: '', getPropertyValue: readRootProperty }
+    }
+
+    const assigned = (element as HTMLElement).style.color
+
+    const radiusVariable = /var\((--radius-[a-z]+)\)/.exec(
+      (element as HTMLElement).style.borderRadius
+    )?.[1]
+
+    if (!radiusVariable) {
+      readProbeColors.push(assigned)
+    }
+
+    return {
+      borderRadius: radiusVariable ? (computedRadii[radiusVariable] ?? '') : '',
+      color: computedByCandidate.get(assigned) ?? assigned,
+      getPropertyValue: () => ''
+    }
+  })
+
+  return {
+    environment: { document, getComputedStyle } as OpenDesignHostSnapshotEnvironment,
+    getComputedStyle,
+    readProbeColors,
+    readRootProperty
+  }
+}
+
+function exactColorEntries(colors: DesktopThemeColors): Array<[keyof DesktopThemeColors, string]> {
+  return (Object.entries(colors) as Array<[keyof DesktopThemeColors, string | undefined]>).filter(
+    (entry): entry is [keyof DesktopThemeColors, string] => typeof entry[1] === 'string'
+  )
+}
+
+const opaqueNousMix = (percentage: number): string => {
