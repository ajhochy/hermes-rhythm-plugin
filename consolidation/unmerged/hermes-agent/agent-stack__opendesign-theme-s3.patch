+import { describe, expect, it } from 'vitest'
+
+import { isAllowedOpenDesignOrigin } from './origin'
+
+const EXPECTED = 'http://127.0.0.1:4823'
+
+describe('isAllowedOpenDesignOrigin', () => {
+  it('accepts an exact origin match', () => {
+    expect(isAllowedOpenDesignOrigin('http://127.0.0.1:4823/', EXPECTED)).toBe(true)
+    expect(isAllowedOpenDesignOrigin('http://127.0.0.1:4823/design/some/path?x=1', EXPECTED)).toBe(true)
+  })
+
+  it('rejects a different port', () => {
+    expect(isAllowedOpenDesignOrigin('http://127.0.0.1:9999/', EXPECTED)).toBe(false)
+  })
+
+  it('rejects a different hostname, including a lookalike subdomain', () => {
+    expect(isAllowedOpenDesignOrigin('http://localhost:4823/', EXPECTED)).toBe(false)
+    expect(isAllowedOpenDesignOrigin('http://evil-127.0.0.1.attacker.example:4823/', EXPECTED)).toBe(false)
+  })
+
+  it('rejects a different protocol', () => {
+    expect(isAllowedOpenDesignOrigin('https://127.0.0.1:4823/', EXPECTED)).toBe(false)
+  })
+
+  it('rejects a path- or string-prefix match that is not an exact origin', () => {
+    expect(isAllowedOpenDesignOrigin('http://127.0.0.1:48230/', EXPECTED)).toBe(false)
+    expect(isAllowedOpenDesignOrigin('http://attacker.example/http://127.0.0.1:4823/', EXPECTED)).toBe(false)
+  })
+
+  it('rejects a malformed candidate URL', () => {
+    expect(isAllowedOpenDesignOrigin('not a url', EXPECTED)).toBe(false)
+    expect(isAllowedOpenDesignOrigin('', EXPECTED)).toBe(false)
+    expect(isAllowedOpenDesignOrigin('about:blank', EXPECTED)).toBe(false)
+  })
+
+  it('rejects when the expected origin itself is malformed', () => {
+    expect(isAllowedOpenDesignOrigin('http://127.0.0.1:4823/', 'not a url')).toBe(false)
+  })
+})
diff --git a/apps/desktop/src/lib/open-design-theme/origin.ts b/apps/desktop/src/lib/open-design-theme/origin.ts
new file mode 100644
index 0000000000..2c4c5a63d8
--- /dev/null
+++ b/apps/desktop/src/lib/open-design-theme/origin.ts
@@ -0,0 +1,21 @@
+/**
+ * Exact-origin gate for theme injection into the Open Design guest webview.
+ *
+ * `URL.origin` equality (protocol + hostname + port) is the only check —
+ * never a path/string prefix, which a lookalike host (`127.0.0.1.attacker
+ * .example`) or an embedded query string could defeat.
+ */
+
+export function isAllowedOpenDesignOrigin(candidateUrl: string, expectedOrigin: string): boolean {
+  let candidate: URL
+  let expected: URL
+
+  try {
+    candidate = new URL(candidateUrl)
+    expected = new URL(expectedOrigin)
+  } catch {
+    return false
+  }
+
+  return candidate.origin === expected.origin
+}
diff --git a/apps/desktop/src/lib/open-design-theme/script.test.ts b/apps/desktop/src/lib/open-design-theme/script.test.ts
new file mode 100644
index 0000000000..596cbecdd6
--- /dev/null
+++ b/apps/desktop/src/lib/open-design-theme/script.test.ts
@@ -0,0 +1,91 @@
+import { beforeEach, describe, expect, it } from 'vitest'
+
+import { nousTheme } from '@/themes/presets'
+
+import { buildOpenDesignThemeInjectionScript } from './script'
+import { buildOpenDesignThemePayload } from './token-map'
+import { OPEN_DESIGN_THEME_STYLE_ID } from './types'
+
+/**
+ * Evaluate the generated script against the live jsdom `document`, mirroring
+ * how Electron's `executeJavaScript` returns the completion value of the
+ * script (an indirect `eval` runs in global scope and does the same).
+ */
+function run(script: string): unknown {
+  const indirectEval = globalThis.eval
+
+  return indirectEval(script)
+}
+
+describe('buildOpenDesignThemeInjectionScript', () => {
+  beforeEach(() => {
+    document.documentElement.removeAttribute('data-theme')
+    document.documentElement.removeAttribute('data-hermes-open-design-theme')
+    document.head.innerHTML = ''
+  })
+
+  it('never contains iframe traversal, a compiled CSS Module class selector, or a global bridge', () => {
+    const payload = buildOpenDesignThemePayload(nousTheme, 'light')
+    const script = buildOpenDesignThemeInjectionScript(payload)
+
+    expect(script.toLowerCase()).not.toContain('iframe')
+    expect(script.toLowerCase()).not.toContain('contentwindow')
+    expect(script).not.toMatch(/window\.__hermes/)
+    expect(script).not.toMatch(/\.[A-Za-z]+_[A-Za-z]+__[a-z0-9]+/) // typical CSS-module hash shape
+  })
+
+  it('creates exactly one <style> element with a versioned id and sets data-theme on the root', () => {
+    const payload = buildOpenDesignThemePayload(nousTheme, 'light')
+    const script = buildOpenDesignThemeInjectionScript(payload)
+
+    run(script)
+
+    const styles = document.querySelectorAll(`#${OPEN_DESIGN_THEME_STYLE_ID}`)
+
+    expect(styles.length).toBe(1)
+    expect(document.documentElement.getAttribute('data-theme')).toBe('light')
+    expect(document.documentElement.hasAttribute('data-hermes-open-design-theme')).toBe(true)
+    expect(styles[0].textContent).toContain('--bg:')
+  })
+
+  it('updates in place on repeated calls without accumulating style nodes', () => {
+    const light = buildOpenDesignThemeInjectionScript(buildOpenDesignThemePayload(nousTheme, 'light'))
+    const dark = buildOpenDesignThemeInjectionScript(buildOpenDesignThemePayload(nousTheme, 'dark'))
+
+    run(light)
+    run(light)
+    run(dark)
+
+    const styles = document.querySelectorAll(`#${OPEN_DESIGN_THEME_STYLE_ID}`)
+
+    expect(styles.length).toBe(1)
+    expect(document.documentElement.getAttribute('data-theme')).toBe('dark')
+    expect(styles[0].textContent).toContain(buildOpenDesignThemePayload(nousTheme, 'dark').vars['--bg'])
+  })
+
+  it('returns a small deterministic result object', () => {
+    const payload = buildOpenDesignThemePayload(nousTheme, 'light')
+    const script = buildOpenDesignThemeInjectionScript(payload)
+
+    const result = run(script) as { ok: boolean; styleId: string }
+
+    expect(result.ok).toBe(true)
+    expect(result.styleId).toBe(OPEN_DESIGN_THEME_STYLE_ID)
+  })
+
+  it('does not throw when <head> is not yet available and falls back to <html>', () => {
+    const head = document.head
+
+    document.documentElement.removeChild(head)
+
+    try {
+      const payload = buildOpenDesignThemePayload(nousTheme, 'light')
+      const script = buildOpenDesignThemeInjectionScript(payload)
+
+      expect(() => run(script)).not.toThrow()
+      expect(document.documentElement.querySelector(`#${OPEN_DESIGN_THEME_STYLE_ID}`)).toBeTruthy()
+    } finally {
+      document.documentElement.appendChild(head)
+    }
+  })
+})
diff --git a/apps/desktop/src/lib/open-design-theme/script.ts b/apps/desktop/src/lib/open-design-theme/script.ts
new file mode 100644
index 0000000000..095124f89b
--- /dev/null
+++ b/apps/desktop/src/lib/open-design-theme/script.ts
@@ -0,0 +1,53 @@
+/**
+ * Builds the self-contained script executed inside the Open Design guest via
+ * `webview.executeJavaScript`. Mirrors the idempotent inject-a-`<style>`
+ * pattern `preview-tour.ts` uses for its driver.js bundle, but scoped to the
+ * top document only (no iframe traversal — Open Design's user-generated
+ * preview/artifact document must never see this), and — unlike the tour
+ * bridge — it parks nothing on `window`: no callable bridge/global is exposed
+ * to the guest.
+ *
+ * The script creates or updates exactly one `<style>` element (a stable,
+ * versioned id) and stamps `data-theme` + a host-only marker attribute on
+ * `<html>`. It tolerates `<head>` not existing yet by falling back to
+ * `<html>` itself, and always returns a small JSON-serializable result so the
+ * caller can tell success from failure without throwing across the IPC
+ * boundary.
+ */
+
+import { buildOpenDesignThemeCss } from './css'
+import { OPEN_DESIGN_THEME_STYLE_ID, type OpenDesignThemePayload } from './types'
+
+export function buildOpenDesignThemeInjectionScript(payload: OpenDesignThemePayload): string {
+  const css = buildOpenDesignThemeCss(payload)
+  const styleId = JSON.stringify(OPEN_DESIGN_THEME_STYLE_ID)
+  const cssText = JSON.stringify(css)
+  const dataTheme = JSON.stringify(payload.dataTheme)
+
+  return `(function () {
+  try {
+    var doc = document;
+    var root = doc.documentElement;
+
+    if (!root) {
+      return { ok: false, reason: 'no-document-element' };
+    }
+
+    var style = doc.getElementById(${styleId});
+
+    if (!style) {
+      style = doc.createElement('style');
+      style.id = ${styleId};
+      (doc.head || root).appendChild(style);
+    }
+
+    style.textContent = ${cssText};
+    root.setAttribute('data-theme', ${dataTheme});
+    root.setAttribute('data-hermes-open-design-theme', '1');
+
+    return { ok: true, styleId: ${styleId} };
+  } catch (err) {
+    return { ok: false, reason: 'exception' };
+  }
+})()`
+}
diff --git a/apps/desktop/src/lib/open-design-theme/token-map.test.ts b/apps/desktop/src/lib/open-design-theme/token-map.test.ts
