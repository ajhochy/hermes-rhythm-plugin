+const MAX_SHADOW_LENGTH = 4096
+const MAX_SHADOW_LAYERS = 16
+const CSS_NUMBER = '[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:e[+-]?\\d+)?'
+const CSS_CHANNEL = `(${CSS_NUMBER}%?)`
+const CSS_ALPHA = `(${CSS_NUMBER}%?)`
+
+const COMMA_RGB = new RegExp(
+  `^rgba?\\(\\s*${CSS_CHANNEL}\\s*,\\s*${CSS_CHANNEL}\\s*,\\s*${CSS_CHANNEL}(?:\\s*,\\s*${CSS_ALPHA})?\\s*\\)$`,
+  'i'
+)
+
+const SPACE_RGB = new RegExp(
+  `^rgba?\\(\\s*${CSS_CHANNEL}\\s+${CSS_CHANNEL}\\s+${CSS_CHANNEL}(?:\\s*\\/\\s*${CSS_ALPHA})?\\s*\\)$`,
+  'i'
+)
+
+const SRGB_COLOR = new RegExp(
+  `^color\\(\\s*srgb\\s+(${CSS_NUMBER})\\s+(${CSS_NUMBER})\\s+(${CSS_NUMBER})(?:\\s*\\/\\s*${CSS_ALPHA})?\\s*\\)$`,
+  'i'
+)
+
+const CSS_LENGTH = new RegExp(
+  `^(${CSS_NUMBER})(px|rem|em|ex|ch|vw|vh|vmin|vmax|cm|mm|q|in|pt|pc)?$`,
+  'i'
+)
+
+const RADIUS_LENGTH = new RegExp(
+  `^(${CSS_NUMBER})(px|rem|em|ex|ch|vw|vh|vmin|vmax|cm|mm|q|in|pt|pc|%)?$`,
+  'i'
+)
+
+const FORBIDDEN_SHADOW =
+  /[{};]|\/\*|\*\/|url\s*\(|var\s*\(|javascript:|expression\s*\(/i
+
+function hasAsciiControl(value: string): boolean {
+  for (let index = 0; index < value.length; index += 1) {
+    const code = value.charCodeAt(index)
+
+    if (code <= 0x1f || code === 0x7f) {
+      return true
+    }
+  }
+
+  return false
+}
+
+function boundedUnit(value: string, scale: number): number | null {
+  const percentage = value.endsWith('%')
+  const parsed = Number(percentage ? value.slice(0, -1) : value)
+  const unit = percentage ? parsed / 100 : parsed / scale
+
+  return Number.isFinite(unit) && unit >= 0 && unit <= 1 ? unit : null
+}
+
+function isBoundedRgbColor(value: string): boolean {
+  const match = COMMA_RGB.exec(value) ?? SPACE_RGB.exec(value)
+
+  if (!match) {
+    return false
+  }
+
+  const channels = match.slice(1, 4).map(channel => boundedUnit(channel, 255))
+  const alpha = match[4] === undefined ? 1 : boundedUnit(match[4], 1)
+
+  return channels.every(channel => channel !== null) && alpha !== null
+}
+
+function isBoundedSrgbColor(value: string): boolean {
+  const match = SRGB_COLOR.exec(value)
+
+  if (!match) {
+    return false
+  }
+
+  const channels = match.slice(1, 4).map(channel => boundedUnit(channel, 1))
+  const alpha = match[4] === undefined ? 1 : boundedUnit(match[4], 1)
+
+  return channels.every(channel => channel !== null) && alpha !== null
+}
+
+function isShadowColor(value: string): boolean {
+  return (
+    /^#(?:[0-9a-f]{3}|[0-9a-f]{4}|[0-9a-f]{6}|[0-9a-f]{8})$/i.test(value) ||
+    value.toLowerCase() === 'transparent' ||
+    isBoundedRgbColor(value) ||
+    isBoundedSrgbColor(value)
+  )
+}
+
+function parseShadowLength(value: string): number | null {
+  const match = CSS_LENGTH.exec(value)
+
+  if (!match) {
+    return null
+  }
+
+  const numeric = Number(match[1])
+
+  if (!Number.isFinite(numeric) || (!match[2] && numeric !== 0)) {
+    return null
+  }
+
+  return numeric
+}
+
+function splitShadowLayers(value: string): string[] | null {
+  const layers: string[] = []
+  let depth = 0
+  let start = 0
+
+  for (let index = 0; index < value.length; index += 1) {
+    const character = value[index]
+
+    if (character === '(') {
+      depth += 1
+    } else if (character === ')') {
+      depth -= 1
+
+      if (depth < 0) {
+        return null
+      }
+    } else if (character === ',' && depth === 0) {
+      const layer = value.slice(start, index).trim()
+
+      if (!layer) {
+        return null
+      }
+
+      layers.push(layer)
+      start = index + 1
+    }
+  }
+
+  if (depth !== 0) {
+    return null
+  }
+
+  const finalLayer = value.slice(start).trim()
+
+  if (!finalLayer) {
+    return null
+  }
+
+  layers.push(finalLayer)
+
+  return layers.length <= MAX_SHADOW_LAYERS ? layers : null
+}
+
+function tokenizeShadowLayer(layer: string): string[] | null {
+  const tokens: string[] = []
+  let depth = 0
+  let start = 0
+
+  const push = (end: number) => {
+    const token = layer.slice(start, end).trim()
+
+    if (token) {
+      tokens.push(token)
+    }
+  }
+
+  for (let index = 0; index < layer.length; index += 1) {
+    const character = layer[index]
+
+    if (character === '(') {
+      depth += 1
+    } else if (character === ')') {
+      depth -= 1
+
+      if (depth < 0) {
+        return null
+      }
+    } else if (/\s/u.test(character) && depth === 0) {
+      push(index)
+      start = index + 1
+    }
+  }
+
+  if (depth !== 0) {
+    return null
+  }
+
+  push(layer.length)
+
+  return tokens
+}
+
+function isShadowLayer(layer: string): boolean {
+  const tokens = tokenizeShadowLayer(layer)
+
+  if (!tokens) {
+    return false
+  }
+
+  const lengths: number[] = []
+  let hasColor = false
+  let hasInset = false
+
+  for (const token of tokens) {
+    if (token.toLowerCase() === 'inset') {
+      if (hasInset) {
+        return false
+      }
+
+      hasInset = true
+
+      continue
+    }
+
+    if (isShadowColor(token)) {
+      if (hasColor) {
+        return false
+      }
+
+      hasColor = true
+
+      continue
+    }
+
+    const length = parseShadowLength(token)
+
+    if (length === null) {
+      return false
+    }
+
+    lengths.push(length)
+  }
+
+  return hasColor && lengths.length >= 2 && lengths.length <= 4 && (lengths[2] ?? 0) >= 0
+}
+
+/** Radius values never share the shadow grammar; notably, `/` is not accepted. */
+export function isSafeRadiusValue(value: string | undefined): value is string {
+  if (typeof value !== 'string') {
+    return false
+  }
+
+  const match = RADIUS_LENGTH.exec(value.trim())
+
+  if (!match) {
+    return false
+  }
+
+  const numeric = Number(match[1])
+
+  return Number.isFinite(numeric) && numeric >= 0 && (Boolean(match[2]) || numeric === 0)
+}
+
+/**
+ * Validate a computed box-shadow while preserving Chromium's serialized value.
+ * Raw custom-property references, declaration syntax, comments, controls, and
+ * malformed/unbounded layer lists fail closed.
+ */
+export function normalizeComputedShadow(value: string | undefined): string | null {
+  if (typeof value !== 'string' || value.length === 0 || value.length > MAX_SHADOW_LENGTH) {
+    return null
+  }
+
+  const normalized = value.trim()
+
+  if (
+    !normalized ||
+    normalized.toLowerCase() === 'none' ||
+    hasAsciiControl(normalized) ||
+    FORBIDDEN_SHADOW.test(normalized)
+  ) {
+    return null
+  }
+
+  const layers = splitShadowLayers(normalized)
+
+  return layers?.every(isShadowLayer) ? normalized : null
+}
