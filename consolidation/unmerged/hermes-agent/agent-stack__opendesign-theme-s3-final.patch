+import { describe, expect, it, vi } from 'vitest'
+
+import { nousTheme } from '@/themes/presets'
+
+import { injectOpenDesignTheme } from './inject'
+import { buildOpenDesignThemePayload } from './token-map'
+
+const EXPECTED_ORIGIN = 'http://127.0.0.1:4823'
+
+function fakeWebview(url: string) {
+  return {
+    getURL: vi.fn(() => url),
+    executeJavaScript: vi.fn(async (_code: string) => ({ ok: true }))
+  }
+}
+
+describe('injectOpenDesignTheme', () => {
+  const payload = buildOpenDesignThemePayload(nousTheme, 'light')
+
+  it('executes the injection script when the webview URL is exactly the expected origin', async () => {
+    const webview = fakeWebview('http://127.0.0.1:4823/design')
+
+    const result = await injectOpenDesignTheme(webview, payload, EXPECTED_ORIGIN)
+
+    expect(webview.executeJavaScript).toHaveBeenCalledTimes(1)
+    expect(result.ok).toBe(true)
+
+    const [script] = webview.executeJavaScript.mock.calls[0]
+    expect(script).toContain('--bg:')
+  })
+
+  it('no-ops on a hostname/port/protocol mismatch', async () => {
+    for (const url of ['http://localhost:4823/', 'http://127.0.0.1:9999/', 'https://127.0.0.1:4823/']) {
+      const webview = fakeWebview(url)
+
+      const result = await injectOpenDesignTheme(webview, payload, EXPECTED_ORIGIN)
+
+      expect(webview.executeJavaScript).not.toHaveBeenCalled()
+      expect(result.ok).toBe(false)
+    }
+  })
+
+  it('no-ops on a malformed URL instead of throwing', async () => {
+    const webview = fakeWebview('not a url')
+
+    const result = await injectOpenDesignTheme(webview, payload, EXPECTED_ORIGIN)
+
+    expect(webview.executeJavaScript).not.toHaveBeenCalled()
+    expect(result.ok).toBe(false)
+  })
+
+  it('reports failure without throwing when executeJavaScript rejects', async () => {
+    const webview = {
+      getURL: vi.fn(() => 'http://127.0.0.1:4823/'),
+      executeJavaScript: vi.fn(async () => {
+        throw new Error('guest navigated away')
+      })
+    }
+
+    const result = await injectOpenDesignTheme(webview, payload, EXPECTED_ORIGIN)
+
+    expect(result.ok).toBe(false)
+  })
+})
diff --git a/apps/desktop/src/lib/open-design-theme/inject.ts b/apps/desktop/src/lib/open-design-theme/inject.ts
new file mode 100644
index 0000000000..22be68bad5
--- /dev/null
+++ b/apps/desktop/src/lib/open-design-theme/inject.ts
@@ -0,0 +1,45 @@
+/**
+ * Origin-gated, idempotent theme injection into a live Open Design webview.
+ *
+ * Accepts only the small Webview-like surface this needs (`getURL`,
+ * `executeJavaScript`) so it has no compile-time dependency on Electron's
+ * `WebviewTag` — the caller (S2) wires it to the real preview-pane webview.
+ * This module owns no subscription to skin/theme changes; the caller decides
+ * when to invoke it (on ThemeContext change, `did-navigate`, and
+ * `did-navigate-in-page`), mirroring `preview-tour.ts`'s runner pattern.
+ */
+
+import { isAllowedOpenDesignOrigin } from './origin'
+import { buildOpenDesignThemeInjectionScript } from './script'
+import type { OpenDesignThemePayload } from './types'
+
+/** The minimal subset of Electron's `WebviewTag` this helper depends on. */
+export interface OpenDesignWebviewLike {
+  getURL(): string
+  executeJavaScript(code: string): Promise<unknown>
+}
+
+export interface InjectOpenDesignThemeResult {
+  ok: boolean
+  reason?: 'invalid-url' | 'origin-mismatch' | 'exec-failed'
+}
+
+export async function injectOpenDesignTheme(
+  webview: OpenDesignWebviewLike,
+  payload: OpenDesignThemePayload,
+  expectedOrigin: string
+): Promise<InjectOpenDesignThemeResult> {
+  const url = webview.getURL()
+
+  if (!isAllowedOpenDesignOrigin(url, expectedOrigin)) {
+    return { ok: false, reason: url ? 'origin-mismatch' : 'invalid-url' }
+  }
+
+  try {
+    await webview.executeJavaScript(buildOpenDesignThemeInjectionScript(payload))
+
+    return { ok: true }
+  } catch {
+    return { ok: false, reason: 'exec-failed' }
+  }
+}
