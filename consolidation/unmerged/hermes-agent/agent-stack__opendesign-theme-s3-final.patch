+/**
+ * Capture the exact host-side values that the Open Design token mapper needs.
+ *
+ * ThemeContext's public `theme` is mode-resolved, but some of its color fields
+ * are still CSS expressions such as `color-mix(...)`. This helper resolves
+ * those expressions with the renderer's own CSS engine through one hidden,
+ * connected element whose only assigned CSS property is `style.color`. It
+ * returns flat six-digit hex values so no host CSS expression crosses into the
+ * guest. Geometry is read separately from a fixed eight-property allowlist.
+ */
+
+import { hexToRgb, normalizeHex, readableOn, rgbToHex } from '@/themes/color'
+import type { DesktopTheme, DesktopThemeColors, DesktopThemeTypography } from '@/themes/types'
+import { resolveThemeTypography } from '@/themes/typography'
+
+import type { HostGeometrySnapshot } from './types'
+
+const CSS_NUMBER = '[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:e[+-]?\\d+)?'
+const CSS_CHANNEL = `(${CSS_NUMBER}%?)`
+const CSS_ALPHA = `(${CSS_NUMBER}%?)`
+
+const COMMA_RGB = new RegExp(
+  `^rgba?\\(\\s*${CSS_CHANNEL}\\s*,\\s*${CSS_CHANNEL}\\s*,\\s*${CSS_CHANNEL}(?:\\s*,\\s*${CSS_ALPHA})?\\s*\\)$`,
+  'i'
+)
+
+const SPACE_RGB = new RegExp(
+  `^rgba?\\(\\s*${CSS_CHANNEL}\\s+${CSS_CHANNEL}\\s+${CSS_CHANNEL}(?:\\s*\\/\\s*${CSS_ALPHA})?\\s*\\)$`,
+  'i'
+)
+
+const SRGB_COLOR = new RegExp(
+  `^color\\(\\s*srgb\\s+(${CSS_NUMBER})\\s+(${CSS_NUMBER})\\s+(${CSS_NUMBER})(?:\\s*\\/\\s*${CSS_ALPHA})?\\s*\\)$`,
+  'i'
+)
+
+const UNSAFE_COLOR_CANDIDATE = /[\\{}<>;]|url\s*\(|javascript:|expression\s*\(/i
+const MAX_COLOR_CANDIDATE_LENGTH = 512
+
+function hasAsciiControl(value: string): boolean {
+  for (let index = 0; index < value.length; index += 1) {
+    const code = value.charCodeAt(index)
+
+    if (code <= 0x1f || code === 0x7f) {
+      return true
+    }
+  }
+
+  return false
+}
+
+interface ParsedColor {
+  channels: [number, number, number]
+  alpha: number
+}
+
+function unitChannel(value: string, scale: number): number | null {
+  const percentage = value.endsWith('%')
+  const parsed = Number(percentage ? value.slice(0, -1) : value)
+  const unit = percentage ? parsed / 100 : parsed / scale
+
+  return Number.isFinite(unit) && unit >= 0 && unit <= 1 ? unit : null
+}
+
+function alphaChannel(value: string | undefined): number | null {
+  return value === undefined ? 1 : unitChannel(value, 1)
+}
+
+function parseRgbFunction(value: string): ParsedColor | null {
+  const match = COMMA_RGB.exec(value) ?? SPACE_RGB.exec(value)
+
+  if (!match) {
+    return null
+  }
+
+  const channels = match.slice(1, 4).map(channel => unitChannel(channel, 255))
+  const alpha = alphaChannel(match[4])
+
+  if (channels.some(channel => channel === null) || alpha === null) {
+    return null
+  }
+
+  return {
+    channels: channels as [number, number, number],
+    alpha
+  }
+}
+
+function parseSrgbFunction(value: string): ParsedColor | null {
+  const match = SRGB_COLOR.exec(value)
+
+  if (!match) {
+    return null
+  }
+
+  const channels = match.slice(1, 4).map(channel => unitChannel(channel, 1))
+  const alpha = alphaChannel(match[4])
+
+  if (channels.some(channel => channel === null) || alpha === null) {
+    return null
+  }
+
+  return {
+    channels: channels as [number, number, number],
+    alpha
+  }
+}
+
+/**
+ * Parse Chromium's computed color formats and flatten alpha over `backdrop`.
+ * Non-finite or out-of-range output is rejected rather than clamped.
+ */
+export function parseComputedColor(computed: string, backdrop: string): string | null {
+  if (typeof computed !== 'string') {
+    return null
+  }
+
+  const parsed = parseRgbFunction(computed.trim()) ?? parseSrgbFunction(computed.trim())
+  const base = hexToRgb(backdrop)
+
+  if (!parsed || !base) {
+    return null
+  }
+
+  return rgbToHex(
+    parsed.channels.map(
+      (channel, index) => base[index] + (channel * 255 - base[index]) * parsed.alpha
+    ) as [number, number, number]
+  )
+}
+
+export const HERMES_GEOMETRY_SOURCE_VARS = {
+  radiusSmall: '--radius-sm',
+  radiusMedium: '--radius-md',
+  radiusLarge: '--radius-lg',
+  radiusXlarge: '--radius-xl',
+  shadowXs: '--shadow-xs',
+  shadowSm: '--shadow-sm',
+  shadowMd: '--shadow-md',
+  shadowLg: '--shadow-lg'
+} as const satisfies Record<keyof HostGeometrySnapshot, string>
+
+export interface OpenDesignHostThemeSnapshot {
+  /** Every present host color flattened to a safe six-digit hex value. */
+  resolvedColors: DesktopThemeColors
+  /** The same merged font stacks ThemeContext writes to `--dt-font-*`. */
+  resolvedTypography: DesktopThemeTypography
+  /** Fixed allowlist only; the pure mapper performs final geometry validation. */
+  hostGeometry?: HostGeometrySnapshot
+}
+
+export interface CaptureOpenDesignHostThemeSnapshotInput {
+  /** The public, already mode-resolved `theme` returned by `useTheme()`. */
+  theme: DesktopTheme
+  /** The mode ThemeContext actually painted (`useTheme().renderedMode`). */
+  renderedMode: 'light' | 'dark'
+}
+
+export interface OpenDesignHostSnapshotEnvironment {
+  document: Document
+  getComputedStyle(
+    element: Element
+  ): Pick<CSSStyleDeclaration, 'borderRadius' | 'color' | 'getPropertyValue'>
+}
+
+const FALLBACK_COLORS = {
+  light: {
+    background: '#ffffff',
+    foreground: '#202020',
+    card: '#fafafa',
+    cardForeground: '#202020',
+    muted: '#ededed',
+    mutedForeground: '#5c5c5c',
+    popover: '#fafafa',
+    popoverForeground: '#202020',
+    primary: '#353535',
+    primaryForeground: '#fafafa',
+    secondary: '#dbdbdb',
+    secondaryForeground: '#202020',
+    accent: '#ededed',
+    accentForeground: '#202020',
+    border: '#dbdbdb',
+    input: '#bdbdbd',
+    ring: '#353535',
+    midground: '#353535',
+    midgroundForeground: '#fafafa',
+    composerRing: '#353535',
+    destructive: '#f04142',
+    destructiveForeground: '#ffffff',
+    sidebarBackground: '#ffffff',
+    sidebarBorder: '#dbdbdb',
+    userBubble: '#fafafa',
+    userBubbleBorder: '#dbdbdb'
+  },
+  dark: {
+    background: '#202020',
+    foreground: '#fafafa',
+    card: '#353535',
+    cardForeground: '#fafafa',
+    muted: '#494949',
+    mutedForeground: '#bdbdbd',
+    popover: '#353535',
+    popoverForeground: '#fafafa',
+    primary: '#ededed',
+    primaryForeground: '#202020',
+    secondary: '#5c5c5c',
+    secondaryForeground: '#fafafa',
+    accent: '#494949',
+    accentForeground: '#fafafa',
+    border: '#5c5c5c',
+    input: '#848484',
+    ring: '#ededed',
+    midground: '#ededed',
+    midgroundForeground: '#202020',
+    composerRing: '#ededed',
+    destructive: '#ff5e5e',
+    destructiveForeground: '#202020',
+    sidebarBackground: '#202020',
+    sidebarBorder: '#5c5c5c',
+    userBubble: '#353535',
+    userBubbleBorder: '#5c5c5c'
+  }
+} as const satisfies Record<'light' | 'dark', Record<keyof DesktopThemeColors, string>>
+
+function defaultEnvironment(): OpenDesignHostSnapshotEnvironment | null {
+  if (typeof document === 'undefined' || typeof getComputedStyle !== 'function') {
+    return null
+  }
+
+  return {
+    document,
+    getComputedStyle: element => getComputedStyle(element)
+  }
+}
+
+function isSafeColorCandidate(value: string | undefined): value is string {
+  return (
+    typeof value === 'string' &&
+    value.length > 0 &&
+    value.length <= MAX_COLOR_CANDIDATE_LENGTH &&
+    !hasAsciiControl(value) &&
+    !UNSAFE_COLOR_CANDIDATE.test(value)
+  )
+}
+
+function staticColor(value: string | undefined, fallback: string, backdrop: string): string {
+  if (!isSafeColorCandidate(value)) {
+    return fallback
+  }
+
+  return normalizeHex(value, backdrop) ?? fallback
+}
+
+function captureGeometry(
+  environment: OpenDesignHostSnapshotEnvironment | null
+): HostGeometrySnapshot | undefined {
+  if (!environment) {
+    return undefined
+  }
+
+  try {
+    const computed = environment.getComputedStyle(environment.document.documentElement)
+    const geometry: HostGeometrySnapshot = {}
+
+    const sources = (Object.entries(HERMES_GEOMETRY_SOURCE_VARS) as Array<
+      [keyof HostGeometrySnapshot, string]
+    >).map(([field, variable]) => ({
+      field,
+      value: computed.getPropertyValue(variable).trim(),
+      variable
+    }))
+
+    let radiusProbe: HTMLElement | null = null
+
+    try {
+      if (sources.some(({ field, value }) => field.startsWith('radius') && value)) {
+        radiusProbe = environment.document.createElement('span')
+        radiusProbe.hidden = true
+        const parent = environment.document.body ?? environment.document.documentElement
+
+        parent.appendChild(radiusProbe)
+      }
+
+      for (const { field, value, variable } of sources) {
+        if (!value) {
+          continue
+        }
+
+        if (!field.startsWith('radius') || !radiusProbe) {
+          geometry[field] = value
+
+          continue
+        }
+
+        try {
+          // The source name is from the constant allowlist above; raw custom
+          // property text is never interpolated into a declaration.
+          radiusProbe.style.borderRadius = ''
+          radiusProbe.style.borderRadius = `var(${variable})`
+          geometry[field] =
+            environment.getComputedStyle(radiusProbe).borderRadius.trim() || value
+        } catch {
+          // Preserve the raw value only for the mapper's strict validator to
+          // accept or drop; never broaden the geometry grammar here.
+          geometry[field] = value
+        }
+      }
+
+      return Object.keys(geometry).length > 0 ? geometry : undefined
+    } finally {
+      radiusProbe?.remove()
+    }
+  } catch {
+    return undefined
+  }
+}
+
+/**
+ * Snapshot the exact values needed by `buildOpenDesignThemePayload`.
+ *
+ * Typical S2 wiring:
+ *
+ * ```ts
+ * const { theme, renderedMode } = useTheme()
+ * const snapshot = captureOpenDesignHostThemeSnapshot({ theme, renderedMode })
+ * const payload = buildOpenDesignThemePayload({ theme, renderedMode, ...snapshot })
+ * ```
