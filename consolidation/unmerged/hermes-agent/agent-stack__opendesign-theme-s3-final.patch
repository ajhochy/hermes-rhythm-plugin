@@ -0,0 +1,114 @@
+/**
+ * Hermes skin -> Open Design semantic-token bridge — shared shapes.
+ *
+ * `OpenDesignThemePayload` is the versioned wire shape between the pure
+ * `DesktopTheme -> tokens` mapping (`token-map.ts`) and everything that
+ * consumes it (`css.ts`, `script.ts`). Bump `OPEN_DESIGN_THEME_SCHEMA_VERSION`
+ * (and the style element id, which embeds it) whenever the var list or its
+ * meaning changes, so a stale cached script never collides with a new one.
+ *
+ * Var names are Open Design's own documented `tokens.css` custom properties
+ * (apps/web/src/styles/tokens.css) plus the `--terminal-*` set consumed by
+ * `TerminalViewer.tsx`'s xterm `ITheme` builder — never a compiled/hashed CSS
+ * Module class. `--radius-*` and `--shadow-*` are deliberately left alone:
+ * `DesktopTheme` carries no per-skin geometry, and Open Design's own
+ * `[data-theme]` blocks already vary shadow intensity correctly once we set
+ * the real `data-theme` attribute, so there is nothing for a skin adapter to
+ * override.
+ */
+
+export const OPEN_DESIGN_THEME_SCHEMA_VERSION = 1
+
+export const OPEN_DESIGN_THEME_STYLE_ID = `hermes-open-design-theme-v${OPEN_DESIGN_THEME_SCHEMA_VERSION}` as const
+
+/** Surface/text/border/accent/selection/status/font vars set on `:root`. */
+export const OPEN_DESIGN_ROOT_VAR_NAMES = [
+  '--bg',
+  '--bg-app',
+  '--bg-panel',
+  '--bg-subtle',
+  '--bg-muted',
+  '--bg-fill-tertiary',
+  '--bg-fill-secondary',
+  '--bg-fill',
+  '--bg-elevated',
+  '--border',
+  '--border-strong',
+  '--border-selected',
+  '--border-soft',
+  '--text',
+  '--text-strong',
+  '--text-muted',
+  '--text-soft',
+  '--text-faint',
+  '--accent',
+  '--accent-contrast',
+  '--accent-strong',
+  '--accent-soft',
+  '--accent-tint',
+  '--accent-hover',
+  '--selected',
+  '--selected-soft',
+  '--green',
+  '--green-bg',
+  '--green-border',
+  '--blue',
+  '--blue-bg',
+  '--blue-border',
+  '--purple',
+  '--purple-bg',
+  '--purple-border',
+  '--red',
+  '--red-bg',
+  '--red-border',
+  '--amber',
+  '--amber-bg',
+  '--sans',
+  '--mono'
+] as const
+
+/** `--terminal-*` vars consumed by `TerminalViewer.tsx`'s xterm `ITheme` builder. */
+export const OPEN_DESIGN_TERMINAL_VAR_NAMES = [
+  '--terminal-fg',
+  '--terminal-bg',
+  '--terminal-cursor',
+  '--terminal-cursor-accent',
+  '--terminal-selection-bg',
+  '--terminal-selection-fg',
+  '--terminal-selection-inactive-bg',
+  '--terminal-banner-bg',
+  '--terminal-banner-border',
+  '--terminal-button-bg',
+  '--terminal-button-bg-hover',
+  '--terminal-button-border',
+  '--terminal-button-border-hover',
+  '--terminal-ansi-black',
+  '--terminal-ansi-red',
+  '--terminal-ansi-green',
+  '--terminal-ansi-yellow',
+  '--terminal-ansi-blue',
+  '--terminal-ansi-magenta',
+  '--terminal-ansi-cyan',
+  '--terminal-ansi-white',
+  '--terminal-ansi-bright-black',
+  '--terminal-ansi-bright-red',
+  '--terminal-ansi-bright-green',
+  '--terminal-ansi-bright-yellow',
+  '--terminal-ansi-bright-blue',
+  '--terminal-ansi-bright-magenta',
+  '--terminal-ansi-bright-cyan',
+  '--terminal-ansi-bright-white'
+] as const
+
+export type OpenDesignRootVarName = (typeof OPEN_DESIGN_ROOT_VAR_NAMES)[number]
+export type OpenDesignTerminalVarName = (typeof OPEN_DESIGN_TERMINAL_VAR_NAMES)[number]
+export type OpenDesignThemeVarName = OpenDesignRootVarName | OpenDesignTerminalVarName
+
+export type OpenDesignThemeVars = Record<OpenDesignThemeVarName, string>
+
+export interface OpenDesignThemePayload {
+  schemaVersion: typeof OPEN_DESIGN_THEME_SCHEMA_VERSION
+  /** The mode actually painted — mirrors `ThemeContext`'s `renderedMode`. */
+  dataTheme: 'light' | 'dark'
+  vars: OpenDesignThemeVars
+}
