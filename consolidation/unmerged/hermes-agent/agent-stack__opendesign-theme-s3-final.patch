+    ['RGBA(0, 255, 0, 25%)', '#0040bf'],
+    ['color(srgb 0.92 0.946039 0.999373)', '#ebf1ff'],
+    ['COLOR(SRGB 1 0 0 / 0.5)', '#800080']
