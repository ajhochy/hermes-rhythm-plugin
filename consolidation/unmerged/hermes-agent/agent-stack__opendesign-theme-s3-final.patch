+    'rgb(Infinity, 0, 0)',
+    'rgb(256, 0, 0)',
+    'rgb(-1, 0, 0)',
+    'rgba(0, 0, 0, 1.01)',
+    'color(srgb 1.0001 0 0)',
+    'color(srgb -0.0001 0 0)',
