index 0000000000..3cab3f1f4e
--- /dev/null
+++ b/apps/desktop/src/lib/open-design-theme/token-map.test.ts
@@ -0,0 +1,141 @@
+import { describe, expect, it } from 'vitest'
+
+import { cyberpunkTheme, midnightTheme, monoTheme, nousTheme } from '@/themes/presets'
+import { skinToDesktopTheme } from '@/themes/skin'
+import type { DesktopTheme } from '@/themes/types'
+
+import { buildOpenDesignThemePayload } from './token-map'
+import {
+  OPEN_DESIGN_ROOT_VAR_NAMES,
+  OPEN_DESIGN_TERMINAL_VAR_NAMES,
+  OPEN_DESIGN_THEME_SCHEMA_VERSION,
+  type OpenDesignRootVarName
+} from './types'
+
+const HEX_OR_SAFE_CSS_VALUE = /^(#[0-9a-f]{6}|rgba?\([0-9.,%\s]+\)|color-mix\(in srgb[a-z0-9#.,%\s]+\))$/i
+const FONT_VAR_NAMES = new Set<OpenDesignRootVarName>(['--sans', '--mono'])
+const COLOR_ROOT_VAR_NAMES = OPEN_DESIGN_ROOT_VAR_NAMES.filter(name => !FONT_VAR_NAMES.has(name))
+const UNSAFE_CSS_CHARS = /[{}<>;]/
+
+describe('buildOpenDesignThemePayload', () => {
+  it('is versioned and tags the resolved mode', () => {
+    const payload = buildOpenDesignThemePayload(nousTheme, 'light')
+
+    expect(payload.schemaVersion).toBe(OPEN_DESIGN_THEME_SCHEMA_VERSION)
+    expect(payload.dataTheme).toBe('light')
+  })
+
+  it('is a pure/deterministic function of its inputs', () => {
+    const a = buildOpenDesignThemePayload(midnightTheme, 'dark')
+    const b = buildOpenDesignThemePayload(midnightTheme, 'dark')
+
+    expect(a).toEqual(b)
+  })
+
+  it.each([
+    ['nous (light-leaning brand)', nousTheme, 'light'],
+    ['midnight (dark)', midnightTheme, 'dark'],
+    ['mono (grayscale)', monoTheme, 'dark'],
+    ['cyberpunk (high-saturation)', cyberpunkTheme, 'dark']
+  ] as const)('emits every required root + terminal var for %s', (_label, theme, mode) => {
+    const payload = buildOpenDesignThemePayload(theme, mode)
+
+    for (const name of COLOR_ROOT_VAR_NAMES) {
+      expect(payload.vars[name], `missing ${name}`).toMatch(HEX_OR_SAFE_CSS_VALUE)
+    }
+
+    for (const name of OPEN_DESIGN_TERMINAL_VAR_NAMES) {
+      expect(payload.vars[name], `missing ${name}`).toMatch(HEX_OR_SAFE_CSS_VALUE)
+    }
+
+    for (const name of FONT_VAR_NAMES) {
+      expect(payload.vars[name], `missing ${name}`).toBeTruthy()
+      expect(payload.vars[name]).not.toMatch(UNSAFE_CSS_CHARS)
+    }
+  })
+
+  it('falls back to base surface colors when a theme carries no terminal palette', () => {
+    expect(nousTheme.terminal).toBeUndefined()
+
+    const payload = buildOpenDesignThemePayload(nousTheme, 'light')
+
+    expect(payload.vars['--terminal-bg']).toMatch(HEX_OR_SAFE_CSS_VALUE)
+    expect(payload.vars['--terminal-fg']).toMatch(HEX_OR_SAFE_CSS_VALUE)
+  })
+
+  it('prefers darkTerminal over terminal in dark rendered mode, and terminal otherwise', () => {
+    const withBoth: DesktopTheme = {
+      ...midnightTheme,
+      terminal: { foreground: '#111111', black: '#222222' },
+      darkTerminal: { foreground: '#eeeeee', black: '#dddddd' }
+    }
+
+    const dark = buildOpenDesignThemePayload(withBoth, 'dark')
+    const light = buildOpenDesignThemePayload(withBoth, 'light')
+
+    expect(dark.vars['--terminal-fg'].toLowerCase()).toBe('#eeeeee')
+    expect(dark.vars['--terminal-ansi-black'].toLowerCase()).toBe('#dddddd')
+    expect(light.vars['--terminal-fg'].toLowerCase()).toBe('#111111')
+    expect(light.vars['--terminal-ansi-black'].toLowerCase()).toBe('#222222')
+  })
+
+  it('falls back to terminal when darkTerminal is absent in dark mode', () => {
+    const onlyLight: DesktopTheme = { ...midnightTheme, terminal: { foreground: '#abcabc' } }
+
+    const dark = buildOpenDesignThemePayload(onlyLight, 'dark')
+
+    expect(dark.vars['--terminal-fg'].toLowerCase()).toBe('#abcabc')
+  })
+
+  it('derives accent-contrast, selection, and status colors so nothing collapses to background', () => {
+    const payload = buildOpenDesignThemePayload(monoTheme, 'dark')
+
+    expect(payload.vars['--accent']).not.toBe(payload.vars['--bg'])
+    expect(payload.vars['--selected']).not.toBe(payload.vars['--bg'])
+    expect(payload.vars['--red']).toBeTruthy()
+  })
+
+  it('maps destructive to the red status token when present', () => {
+    const payload = buildOpenDesignThemePayload(nousTheme, 'light')
+
+    expect(payload.vars['--red'].toLowerCase()).toBe(nousTheme.colors.destructive.toLowerCase())
+  })
+
+  it('fails closed on malformed/unsafe color values instead of throwing or leaking them into vars', () => {
+    const hostile: DesktopTheme = {
+      ...nousTheme,
+      colors: {
+        ...nousTheme.colors,
+        background: '#fff; } body { background: url(javascript:alert(1))',
+        accent: '<script>alert(1)</script>'
+      }
+    }
+
+    expect(() => buildOpenDesignThemePayload(hostile, 'light')).not.toThrow()
+
+    const payload = buildOpenDesignThemePayload(hostile, 'light')
+
+    for (const name of [...COLOR_ROOT_VAR_NAMES, ...OPEN_DESIGN_TERMINAL_VAR_NAMES]) {
+      expect(payload.vars[name]).toMatch(HEX_OR_SAFE_CSS_VALUE)
+    }
+
+    for (const name of FONT_VAR_NAMES) {
+      expect(payload.vars[name]).not.toMatch(UNSAFE_CSS_CHARS)
+    }
+  })
+
+  it('works for a skin-derived theme (imported/custom/backend skins), not just presets', () => {
+    const skinTheme = skinToDesktopTheme({
+      name: 'custom-skin',
+      colors: { background: '#101018', ui_accent: '#33ccff', ui_error: '#ff5566' }
+    })
+
+    expect(skinTheme).not.toBeNull()
+
+    const payload = buildOpenDesignThemePayload(skinTheme!, 'dark')
+
+    for (const name of COLOR_ROOT_VAR_NAMES) {
+      expect(payload.vars[name]).toMatch(HEX_OR_SAFE_CSS_VALUE)
+    }
+  })
+})
diff --git a/apps/desktop/src/lib/open-design-theme/token-map.ts b/apps/desktop/src/lib/open-design-theme/token-map.ts
new file mode 100644
index 0000000000..495b50660e
--- /dev/null
+++ b/apps/desktop/src/lib/open-design-theme/token-map.ts
@@ -0,0 +1,166 @@
+/**
+ * Pure `DesktopTheme -> OpenDesignThemePayload` mapping.
+ *
+ * Targets only the stable, documented semantic custom properties in Open
+ * Design 0.20.0's `apps/web/src/styles/tokens.css` (never a compiled/hashed
+ * CSS Module class). Every color that could originate from an untrusted
+ * custom/imported theme is normalized through `normalizeHex` first, so a
+ * malformed or hostile value (a CSS-injection string, a non-hex literal)
+ * always falls back to one of Open Design's own default tokens instead of
+ * reaching the generated stylesheet.
+ *
+ * Terminal ANSI colors mirror the exact fallback the desktop terminal pane
+ * itself uses (`use-terminal-session.ts`): dark mode prefers `darkTerminal`,
+ * falling back to `terminal`; light mode always uses `terminal`. When a theme
+ * carries no terminal palette at all (true for every built-in preset today),
+ * the ANSI slots derive from the resolved surface/accent colors so xterm still
+ * reads as an extension of the app chrome rather than Open Design's default.
+ */
+
+import { mix, normalizeHex, readableOn } from '@/themes/color'
+import type { DesktopTerminalPalette, DesktopTheme } from '@/themes/types'
+
+import { OPEN_DESIGN_THEME_SCHEMA_VERSION, type OpenDesignThemePayload, type OpenDesignThemeVars } from './types'
+
+// Open Design's own light-mode defaults (tokens.css) — the safe fallback for
+// a color field a theme fails to provide as valid hex.
+const FALLBACK = {
+  background: '#ffffff',
+  panel: '#fafafa',
+  textStrong: '#202020',
+  border: '#dbdbdb',
+  accent: '#353535',
+  red: '#f04142',
+  green: '#00aa54',
+  blue: '#1a74ff',
+  amber: '#ff7528'
+} as const
+
+const DEFAULT_SANS = '"Albert Sans", "PingFang SC", "Microsoft YaHei", sans-serif'
+const DEFAULT_MONO = '"JiduMono Pro", ui-monospace, "SFMono-Regular", monospace'
+
+/** Normalize to a safe `#rrggbb`, falling back when the input is missing/unsafe. */
+const hex = (value: string | undefined, fallback: string): string => normalizeHex(value) ?? fallback
+
+const tint = (color: string, pct: number, into: string) => `color-mix(in srgb, ${color} ${pct}%, ${into})`
+const fade = (color: string, pct: number) => `color-mix(in srgb, ${color} ${pct}%, transparent)`
+
+/** A font-family value is never a color; only guard against CSS-breaking chars. */
+const safeFontStack = (value: string | undefined, fallback: string): string =>
+  value && !/[{}<>;]/.test(value) ? value : fallback
+
+function resolveTerminalPalette(theme: DesktopTheme, renderedMode: 'light' | 'dark'): DesktopTerminalPalette {
+  return (renderedMode === 'dark' ? (theme.darkTerminal ?? theme.terminal) : theme.terminal) ?? {}
+}
+
+export function buildOpenDesignThemePayload(theme: DesktopTheme, renderedMode: 'light' | 'dark'): OpenDesignThemePayload {
+  const c = theme.colors
+  const terminal = resolveTerminalPalette(theme, renderedMode)
+  const isDark = renderedMode === 'dark'
+
+  const background = hex(c.background, FALLBACK.background)
+  const foreground = hex(c.foreground, FALLBACK.textStrong)
+  const panel = hex(c.card, FALLBACK.panel)
+  const border = hex(c.border, FALLBACK.border)
+  const accent = hex(c.ring, FALLBACK.accent)
+  const accentContrast = hex(c.primaryForeground, readableOn(accent))
+  const mutedForeground = hex(c.mutedForeground, mix(foreground, background, 0.45))
+  const destructive = hex(c.destructive, FALLBACK.red)
+  const green = hex(terminal.green, FALLBACK.green)
+  const blue = hex(terminal.blue, FALLBACK.blue)
+  const amber = hex(terminal.yellow, FALLBACK.amber)
+
+  const terminalFg = hex(terminal.foreground, foreground)
+  const terminalCursor = hex(terminal.cursor, accent)
+  const terminalBrightBlack = hex(terminal.brightBlack, mix(mutedForeground, background, 0.2))
+
+  const vars: OpenDesignThemeVars = {
+    // Surfaces
+    '--bg': background,
+    '--bg-app': background,
+    '--bg-panel': panel,
+    '--bg-subtle': hex(c.muted, mix(background, foreground, isDark ? 0.08 : 0.05)),
+    '--bg-muted': hex(c.secondary, mix(background, foreground, isDark ? 0.16 : 0.1)),
+    '--bg-fill-tertiary': fade(foreground, isDark ? 6 : 3),
+    '--bg-fill-secondary': fade(foreground, isDark ? 10 : 6),
+    '--bg-fill': fade(foreground, isDark ? 16 : 12),
+    '--bg-elevated': hex(c.popover, panel),
+    // Borders
+    '--border': border,
+    '--border-strong': mix(border, foreground, 0.3),
+    '--border-selected': accent,
+    '--border-soft': mix(border, background, 0.4),
+    // Text
+    '--text': mutedForeground,
+    '--text-strong': foreground,
+    '--text-muted': mix(mutedForeground, background, 0.12),
+    '--text-soft': mix(mutedForeground, background, 0.3),
+    '--text-faint': border,
+    // Accent
+    '--accent': accent,
+    '--accent-contrast': accentContrast,
+    '--accent-strong': mix(accent, foreground, 0.25),
+    '--accent-soft': hex(c.accent, mix(accent, background, 0.85)),
+    '--accent-tint': mix(accent, background, 0.92),
