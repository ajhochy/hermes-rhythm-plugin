 /**
  * Exact-origin gate for theme injection into the Open Design guest webview.
  *
- * `URL.origin` string equality alone is not enough: `new URL('blob:http://
- * 127.0.0.1:4823/<uuid>').origin` is `'http://127.0.0.1:4823'` even though
- * the candidate is a `blob:` document, not the actual top-level HTTP
- * response — so a same-origin-looking blob/filesystem artifact (e.g. an
- * in-page preview/export render) must be rejected independently of the
- * string comparison. Both the candidate and the expected origin are required
- * to be exact, credential-free, `http:` loopback origins with an explicit
- * port before the origin strings are even compared — never a path/string
- * prefix, which a lookalike host (`127.0.0.1.attacker.example`) or an
- * embedded query string could otherwise defeat.
+ * `URL.origin` string equality alone is not enough for two independent
+ * reasons:
+ *
+ * 1. `new URL('blob:http://127.0.0.1:4823/<uuid>').origin` is
+ *    `'http://127.0.0.1:4823'` even though the candidate is a `blob:`
+ *    document, not the actual top-level HTTP response — so a same-origin-
+ *    looking blob/filesystem artifact (e.g. an in-page preview/export
+ *    render) must be rejected independently of the string comparison.
+ * 2. WHATWG URL host parsing normalizes shorthand/hex/integer IPv4 literals
+ *    — `127.1`, `0x7f000001`, `2130706433` — into `127.0.0.1` *before*
+ *    `.hostname` can be read, so validating only the parsed `URL` would let
+ *    those raw forms trade on the loopback allowlist. `parseRawLoopbackAuthority`
+ *    matches the literal, unparsed authority text first — only the exact
+ *    strings `127.0.0.1` and `[::1]` are ever accepted as a host — before
+ *    `new URL()` is even called.
+ *
+ * Both the candidate and the expected origin are required to be exact,
+ * credential-free, `http:` loopback origins with an explicit port — never a
+ * path/string prefix, which a lookalike host (`127.0.0.1.attacker.example`)
+ * or an embedded query string could otherwise defeat. The expected origin
+ * must be a root origin (optional trailing slash); the candidate may carry
+ * a same-origin path/query/hash.
+ */
+
+const RAW_LOOPBACK_HOST = '(127\\.0\\.0\\.1|\\[::1\\])'
+const RAW_EXPECTED_ORIGIN = new RegExp(`^http://${RAW_LOOPBACK_HOST}:(\\d{1,5})/?$`)
+const RAW_CANDIDATE_ORIGIN = new RegExp(`^http://${RAW_LOOPBACK_HOST}:(\\d{1,5})(?:[/?#].*)?$`)
+
+interface RawAuthority {
+  host: string
+  port: number
+}
+
+/**
+ * Matches the literal authority text of a `http:` loopback URL — never via
+ * `new URL()`, whose host-parsing step normalizes shorthand/hex/integer IPv4
+ * literals into `127.0.0.1` before a caller could ever see the raw form.
  */
+function parseRawLoopbackAuthority(raw: string, pattern: RegExp): RawAuthority | null {
+  const match = pattern.exec(raw)
+
+  if (!match) {
+    return null
+  }
+
+  const port = Number(match[2])
+
+  if (!Number.isInteger(port) || port < 1 || port > 65535) {
+    return null
+  }
+
+  return { host: match[1], port }
+}
 
 const LOOPBACK_HOSTNAME = /^(127\.(?:25[0-5]|2[0-4]\d|[01]?\d?\d)(?:\.(?:25[0-5]|2[0-4]\d|[01]?\d?\d)){2}|\[::1\])$/
 
@@ -20,6 +62,15 @@ function isExactLoopbackHttpOrigin(url: URL): boolean {
 }
 
 export function isAllowedOpenDesignOrigin(candidateUrl: string, expectedOrigin: string): boolean {
+  const rawExpected = parseRawLoopbackAuthority(expectedOrigin, RAW_EXPECTED_ORIGIN)
+  const rawCandidate = parseRawLoopbackAuthority(candidateUrl, RAW_CANDIDATE_ORIGIN)
+
+  if (!rawExpected || !rawCandidate || rawExpected.host !== rawCandidate.host || rawExpected.port !== rawCandidate.port) {
+    return false
+  }
+
+  // Defense in depth: re-validate through the parsed `URL` too, even though
+  // the raw-text precheck above already guarantees an exact loopback host.
   let candidate: URL
   let expected: URL
 
