+import { DEFAULT_TYPOGRAPHY, nousTheme } from './presets'
+import type { DesktopTheme, DesktopThemeTypography } from './types'
+
+/**
+ * Resolve the exact typography stack ThemeContext paints for a theme.
+ *
+ * Most skins override only one font (or neither). Keeping this merge in one
+ * pure helper prevents embedded surfaces from silently falling back to their
+ * own product fonts when Hermes itself is painting the shared system stack.
+ */
+export function resolveThemeTypography(
+  theme: Pick<DesktopTheme, 'typography'>
+): DesktopThemeTypography {
+  return {
+    ...DEFAULT_TYPOGRAPHY,
+    ...nousTheme.typography,
+    ...theme.typography
+  }
+}
