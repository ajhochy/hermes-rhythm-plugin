+import assert from 'node:assert/strict'
+import path from 'node:path'
+
+import { test } from 'vitest'
+
+import { openDesignNamespacePaths, toOpenDesignNamespace } from './namespace'
+
+test('toOpenDesignNamespace is deterministic for the same profile name', () => {
+  assert.equal(toOpenDesignNamespace('default'), toOpenDesignNamespace('default'))
+  assert.equal(toOpenDesignNamespace('acme-team'), toOpenDesignNamespace('acme-team'))
+})
+
+test('toOpenDesignNamespace produces different namespaces for different profiles', () => {
+  assert.notEqual(toOpenDesignNamespace('default'), toOpenDesignNamespace('acme-team'))
+})
+
+test('toOpenDesignNamespace contains no path separators or traversal sequences', () => {
+  for (const profile of ['default', 'acme-team', 'a_b', 'x'.repeat(64)]) {
+    const namespace = toOpenDesignNamespace(profile)
+
+    assert.doesNotMatch(namespace, /[/\\]/)
+    assert.doesNotMatch(namespace, /\.\./)
+    assert.match(namespace, /^[a-z0-9-]+$/)
+  }
+})
+
+test('toOpenDesignNamespace stays short enough for the Windows path budget', () => {
+  const namespace = toOpenDesignNamespace('x'.repeat(64))
+
+  // Namespace itself must be short; it is later embedded several directories
+  // deep under a Windows install root (see scout report: NSIS long-namespace
+  // path-length issue), so keep a wide margin below the 260-char MAX_PATH.
+  assert.ok(namespace.length <= 32, `namespace too long: ${namespace.length}`)
+})
+
+test('toOpenDesignNamespace rejects an empty profile name', () => {
+  assert.throws(() => toOpenDesignNamespace(''), /profile/i)
+})
+
+test('openDesignNamespacePaths builds the namespace tree under a Hermes-owned root', () => {
+  const root = openDesignNamespacePaths('/hermes-home', 'hz-abc123')
+
+  assert.equal(root.root, path.join('/hermes-home', 'open-design', 'hz-abc123'))
+  assert.equal(root.runtimeDir, path.join(root.root, 'runtime'))
+  assert.equal(root.cacheDir, path.join(root.root, 'cache'))
+  assert.equal(root.dataDir, path.join(root.root, 'data'))
+  assert.equal(root.logsDir, path.join(root.root, 'logs'))
+  assert.equal(root.userDataDir, path.join(root.root, 'user-data'))
+  assert.equal(root.identity.headless, path.join(root.runtimeDir, 'headless-root.json'))
+  assert.equal(root.identity.web, path.join(root.runtimeDir, 'web-root.json'))
+  assert.equal(root.identity.desktop, path.join(root.runtimeDir, 'desktop-root.json'))
+})
diff --git a/apps/desktop/electron/open-design/namespace.ts b/apps/desktop/electron/open-design/namespace.ts
new file mode 100644
index 0000000000..a9e87c06dc
--- /dev/null
+++ b/apps/desktop/electron/open-design/namespace.ts
@@ -0,0 +1,81 @@
+/**
+ * namespace.ts — deterministic, safe Open Design namespace derivation and
+ * the Hermes-owned profile-scoped runtime path tree.
+ *
+ * Open Design's own namespace regex (packages/sidecar-proto) is
+ * `^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$`. We derive a much narrower namespace
+ * than that ceiling allows: lowercase alnum + hyphen only (no dot, no
+ * traversal-adjacent characters), short and bounded, because a long
+ * namespace string is a documented NSIS install path-length hazard on
+ * Windows (MAX_PATH 260).
+ */
+
+import crypto from 'node:crypto'
+import path from 'node:path'
+
+const NAMESPACE_PREFIX = 'hz-'
+const SLUG_MAX_LEN = 12
+const HASH_LEN = 10
+
+function slugify(profile: string): string {
+  return profile
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '')
+    .slice(0, SLUG_MAX_LEN)
+    .replace(/-+$/g, '')
+}
+
+/**
+ * Derive a short, deterministic, filesystem/namespace-safe identifier for a
+ * Hermes profile. Two different profile names never collide (a content hash
+ * of the *original* name is appended) even if their slugs truncate to the
+ * same prefix.
+ */
+export function toOpenDesignNamespace(profileName: string): string {
+  if (!profileName || typeof profileName !== 'string' || !profileName.trim()) {
+    throw new Error('[open-design namespace] profile name must be a non-empty string')
+  }
+
+  const hash = crypto.createHash('sha256').update(profileName).digest('hex').slice(0, HASH_LEN)
+  const slug = slugify(profileName)
+
+  return slug ? `${NAMESPACE_PREFIX}${slug}-${hash}` : `${NAMESPACE_PREFIX}${hash}`
+}
+
+export interface OpenDesignNamespacePaths {
+  root: string
+  runtimeDir: string
+  cacheDir: string
+  dataDir: string
+  logsDir: string
+  userDataDir: string
+  identity: {
+    desktop: string
+    headless: string
+    web: string
+  }
+}
+
+/**
+ * The Hermes-owned profile-scoped root for a namespace: `<hermesHome>/open-design/<namespace>`.
+ * Never shared with a standalone Open Design install's own namespace root.
+ */
+export function openDesignNamespacePaths(hermesHome: string, namespace: string): OpenDesignNamespacePaths {
+  const root = path.join(hermesHome, 'open-design', namespace)
+  const runtimeDir = path.join(root, 'runtime')
+
+  return {
+    root,
+    runtimeDir,
+    cacheDir: path.join(root, 'cache'),
+    dataDir: path.join(root, 'data'),
+    logsDir: path.join(root, 'logs'),
+    userDataDir: path.join(root, 'user-data'),
+    identity: {
+      desktop: path.join(runtimeDir, 'desktop-root.json'),
+      headless: path.join(runtimeDir, 'headless-root.json'),
+      web: path.join(runtimeDir, 'web-root.json')
+    }
+  }
+}
