+    'stop-start-concurrency',
+    'concurrent-child-launch-pressure-and-sole-writer-inheritance'
+  ]
+
+  assert.deepEqual(WINDOWS_GUARDIAN_LIFECYCLE_SCENARIOS.map(scenario => scenario.id), required)
+
+  const plan = createWindowsGuardianContractPlan({ sourceCommit: 'a'.repeat(40) })
+  const lifecycle = plan.steps.find(step => step.id === 'native-lifecycle-contract')
+
+  assert.ok(lifecycle)
+  assert.equal(lifecycle.blocking, true)
