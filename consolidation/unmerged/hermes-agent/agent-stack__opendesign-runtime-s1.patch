+import assert from 'node:assert/strict'
+
+import { test } from 'vitest'
+
+import { waitForOpenDesignReady } from './readiness'
+
+const VALID_IDENTITY = {
+  version: 1,
+  namespace: 'hz-default-abc123',
+  pid: 4242,
+  url: 'http://127.0.0.1:53211'
+}
+
+function immediateSleep() {
+  return Promise.resolve()
+}
+
+test('resolves with the validated loopback origin once identity and health both succeed', async () => {
+  const result = await waitForOpenDesignReady({
+    readIdentity: () => VALID_IDENTITY,
+    expectedNamespace: 'hz-default-abc123',
+    expectedPid: 4242,
+    fetchHealth: async () => ({ ok: true }),
+    sleep: immediateSleep
+  })
+
+  assert.deepEqual(result, { origin: 'http://127.0.0.1:53211' })
+})
+
+test('keeps polling while the identity file has not appeared yet, then succeeds', async () => {
+  let calls = 0
+
+  const result = await waitForOpenDesignReady({
+    readIdentity: () => {
+      calls += 1
+
+      return calls < 3 ? null : VALID_IDENTITY
+    },
+    expectedNamespace: 'hz-default-abc123',
+    expectedPid: 4242,
+    fetchHealth: async () => ({ ok: true }),
+    sleep: immediateSleep
+  })
+
+  assert.equal(calls, 3)
+  assert.deepEqual(result, { origin: 'http://127.0.0.1:53211' })
+})
+
+test('rejects with a bounded timeout when the identity never appears', async () => {
+  let now = 0
+  await assert.rejects(
+    waitForOpenDesignReady({
+      readIdentity: () => null,
+      expectedNamespace: 'hz-default-abc123',
+      expectedPid: 4242,
+      fetchHealth: async () => ({ ok: true }),
+      timeoutMs: 1000,
+      pollMs: 100,
+      now: () => now,
+      sleep: async () => {
+        now += 100
+      }
+    }),
+    /timed out/i
+  )
+})
+
+test('rejects immediately on a namespace/pid mismatch without waiting for the timeout', async () => {
+  let sleepCalls = 0
+  await assert.rejects(
+    waitForOpenDesignReady({
+      readIdentity: () => ({ ...VALID_IDENTITY, namespace: 'hz-someone-else' }),
+      expectedNamespace: 'hz-default-abc123',
+      expectedPid: 4242,
+      fetchHealth: async () => ({ ok: true }),
+      sleep: async () => {
+        sleepCalls += 1
+      }
+    }),
+    /namespace/i
+  )
+  assert.equal(sleepCalls, 0)
+})
+
+test('rejects immediately on a non-loopback identity url', async () => {
+  await assert.rejects(
+    waitForOpenDesignReady({
+      readIdentity: () => ({ ...VALID_IDENTITY, url: 'http://evil.example.com:1' }),
+      expectedNamespace: 'hz-default-abc123',
+      expectedPid: 4242,
+      fetchHealth: async () => ({ ok: true }),
+      sleep: immediateSleep
+    }),
+    /loopback/i
+  )
+})
+
+test('rejects with a bounded timeout when identity is valid but the health probe never succeeds', async () => {
+  let now = 0
+  await assert.rejects(
+    waitForOpenDesignReady({
+      readIdentity: () => VALID_IDENTITY,
+      expectedNamespace: 'hz-default-abc123',
+      expectedPid: 4242,
+      fetchHealth: async () => {
+        throw new Error('ECONNREFUSED')
+      },
+      timeoutMs: 500,
+      pollMs: 100,
+      now: () => now,
+      sleep: async () => {
+        now += 100
+      }
+    }),
+    /timed out/i
+  )
+})
diff --git a/apps/desktop/electron/open-design/readiness.ts b/apps/desktop/electron/open-design/readiness.ts
new file mode 100644
index 0000000000..a66a5a7814
--- /dev/null
+++ b/apps/desktop/electron/open-design/readiness.ts
@@ -0,0 +1,75 @@
+/**
+ * readiness.ts — bounded readiness probe combining Open Design's on-disk
+ * identity (web-root.json) with a loopback HTTP health check.
+ *
+ * A malformed/missing identity file keeps polling (it may not have been
+ * written yet by a still-starting child); an identity that parses but fails
+ * validation (wrong namespace/pid, non-loopback url) fails immediately —
+ * that is not a transient state, it is a different runtime answering.
+ */
+
+import { isLoopbackHttpUrl, parseOpenDesignWebIdentity, validateOpenDesignWebIdentity } from './identity'
+
+export const DEFAULT_READINESS_TIMEOUT_MS = 30_000
+export const DEFAULT_READINESS_POLL_MS = 200
+
+export interface WaitForOpenDesignReadyOptions {
+  /** Reads the raw (parsed-JSON-or-not) contents of web-root.json, or null if absent. */
+  readIdentity: () => unknown
+  expectedNamespace: string
+  expectedPid: number
+  fetchHealth: (url: string, options: { timeoutMs: number }) => Promise<unknown>
+  timeoutMs?: number
+  pollMs?: number
+  healthProbeTimeoutMs?: number
+  now?: () => number
+  sleep?: (ms: number) => Promise<void>
+}
+
+export interface OpenDesignReadyResult {
+  origin: string
+}
+
+export async function waitForOpenDesignReady(options: WaitForOpenDesignReadyOptions): Promise<OpenDesignReadyResult> {
+  const timeoutMs = options.timeoutMs ?? DEFAULT_READINESS_TIMEOUT_MS
+  const pollMs = options.pollMs ?? DEFAULT_READINESS_POLL_MS
+  const healthProbeTimeoutMs = options.healthProbeTimeoutMs ?? Math.min(5_000, timeoutMs)
+  const now = options.now ?? Date.now
+  const sleep = options.sleep ?? ((ms: number) => new Promise<void>(resolve => setTimeout(resolve, ms)))
+
+  const deadline = now() + timeoutMs
+  let lastError: unknown = null
+
+  while (now() < deadline) {
+    const raw = options.readIdentity()
+    const identity = parseOpenDesignWebIdentity(raw)
+
+    if (identity) {
+      const validation = validateOpenDesignWebIdentity(identity, {
+        expectedNamespace: options.expectedNamespace,
+        expectedPid: options.expectedPid
+      })
+
+      if (!validation.ok) {
+        throw new Error(`[open-design readiness] identity validation failed: ${validation.reason}`)
+      }
+
+      try {
+        await options.fetchHealth(`${identity.url}/api/health`, { timeoutMs: healthProbeTimeoutMs })
+
+        return { origin: identity.url }
+      } catch (error) {
+        lastError = error
+      }
+    }
+
+    await sleep(pollMs)
+  }
+
+  const detail = lastError instanceof Error ? lastError.message : 'no healthy identity observed'
+  throw new Error(`[open-design readiness] timed out after ${timeoutMs}ms waiting for Open Design to become ready: ${detail}`)
+}
+
+// Re-exported for callers that only need the loopback check (e.g. a
+// pre-flight guard before ever touching the identity file).
+export { isLoopbackHttpUrl }
