+/**
+ * The single source of truth for the Windows-only Open Design guardian gates.
+ *
+ * This is deliberately data, rather than comments in a workflow: the CI lane
+ * consumes each command as a failing shell step and this module's tests make a
+ * removed scenario immediately visible on every host.  The PowerShell scripts
+ * contain the real Win32/installer work; macOS and Linux can only validate
+ * this plan and must not pretend to execute it.
+ */
+
+export const WINDOWS_GUARDIAN_LIFECYCLE_SCENARIOS = Object.freeze([
+  { id: 'assign-before-resume', title: 'target observes Job membership at its first instruction' },
+  { id: 'parent-child-grandchild-membership', title: 'forced guardian shutdown empties descendants' },
+  { id: 'breakaway-denial', title: 'CREATE_BREAKAWAY_FROM_JOB is rejected' },
+  { id: 'parent-control-eof', title: 'guardian stdin EOF forces the owned Job empty' },
+  { id: 'helper-crash', title: 'guardian crash terminates the owned Job' },
+  { id: 'guest-parent-crash-with-descendants', title: 'guest parent crash leaves no stubborn descendant' },
+  { id: 'graceful-and-forced-empty', title: 'graceful and forced requests report an empty Job' },
+  { id: 'nested-outer-job', title: 'guardian behaves correctly when its parent is in an outer Job' },
+  { id: 'assignment-failure', title: 'unassignable target fails before READY' },
+  { id: 'pid-churn', title: 'PID reuse cannot satisfy the guardian identity binding' },
+  { id: 'two-namespaces', title: 'two independent namespaces do not cross-own a Job' },
+  { id: 'stop-start-concurrency', title: 'concurrent start/stop converges without orphaning a Job' },
+  { id: 'concurrent-child-launch-pressure-and-sole-writer-inheritance', title: 'launch pressure retains sole writer ownership' }
+])
+
+function powershell(script, args = '') {
+  return `powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/open-design/${script}${args}`
+}
+
+/**
+ * Returns the blocking commands the Windows workflow executes. Keeping this
+ * pure makes the definition testable on non-Windows hosts while the workflow
+ * remains the only place that claims real Win32 evidence.
+ */
+export function createWindowsGuardianContractPlan({ sourceCommit }) {
+  if (typeof sourceCommit !== 'string' || !/^[0-9a-f]{40}$/i.test(sourceCommit)) {
+    throw new Error('sourceCommit must be an exact 40-character hexadecimal commit')
+  }
+
+  const quotedCommit = sourceCommit.toLowerCase()
+
+  return {
+    sourceCommit: quotedCommit,
+    steps: [
+      {
+        id: 'compile-guardian',
+        blocking: true,
+        command: `node apps/desktop/scripts/open-design/build-windows-job-guardian.mjs ${quotedCommit}`
+      },
+      {
+        id: 'real-adapter-lifecycle',
+        blocking: true,
+        command: 'npm --prefix apps/desktop exec vitest run --project electron electron/open-design/windows-job-guardian.real-exe.test.ts'
+      },
+      {
+        id: 'native-lifecycle-contract',
+        blocking: true,
+        command: powershell('windows-guardian-native-harness.ps1', ` -GuardianExe apps/desktop/build/native/win32-x64/hermes-open-design-job.exe -SourceCommit ${quotedCommit}`)
+      },
+      {
+        id: 'guardian-trust-contract',
+        blocking: true,
+        command: powershell('windows-guardian-trust-smoke.ps1', ` -GuardianExe apps/desktop/build/native/win32-x64/hermes-open-design-job.exe -SourceCommit ${quotedCommit}`)
+      },
+      {
+        id: 'installed-nsis-smoke',
+        blocking: true,
+        command: powershell('windows-installer-smoke.ps1', ' -Kind nsis')
+      },
+      {
+        id: 'installed-msi-smoke',
+        blocking: true,
+        command: powershell('windows-installer-smoke.ps1', ' -Kind msi')
+      }
+    ]
+  }
+}
