diff --git a/apps/desktop/scripts/open-design/windows-installer-smoke.ps1 b/apps/desktop/scripts/open-design/windows-installer-smoke.ps1
new file mode 100644
index 0000000000..20c25e4a7c
--- /dev/null
+++ b/apps/desktop/scripts/open-design/windows-installer-smoke.ps1
@@ -0,0 +1,104 @@
+[CmdletBinding()]
+param(
+  [Parameter(Mandatory = $true)][ValidateSet('nsis', 'msi')][string]$Kind
+)
+
+$ErrorActionPreference = 'Stop'
+
+function Wait-ForFile([string]$Path, [int]$TimeoutSeconds = 30) {
+  $deadline = (Get-Date).AddSeconds($TimeoutSeconds)
+  while ((Get-Date) -lt $deadline) {
+    if (Test-Path -LiteralPath $Path -PathType Leaf) { return }
+    Start-Sleep -Milliseconds 250
+  }
+  throw "[windows-installer-smoke] timed out waiting for $Path"
+}
+
+function Assert-NoInstalledProcess([string]$InstallRoot) {
+  $live = Get-CimInstance Win32_Process | Where-Object {
+    $_.ExecutablePath -and $_.ExecutablePath.StartsWith($InstallRoot, [System.StringComparison]::OrdinalIgnoreCase)
+  }
+  if ($live) {
+    $live | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }
+    throw "[windows-installer-smoke] installed process residue remained under $InstallRoot"
+  }
+}
+
+$desktop = Join-Path $PSScriptRoot '..\\..'
+$release = Join-Path $desktop 'release'
+$work = Join-Path ([System.IO.Path]::GetTempPath()) ("hermes-open-design-installer-" + [Guid]::NewGuid().ToString('N'))
+$installRoot = Join-Path $work 'installed-hermes'
+New-Item -ItemType Directory -Path $work | Out-Null
+
+try {
+  Push-Location $desktop
+  $package = Get-Content -LiteralPath 'package.json' -Raw | ConvertFrom-Json
+  $extension = if ($Kind -eq 'nsis') { 'exe' } else { 'msi' }
+  # electron-builder's configured artifactName is deliberately explicit.
+  # Never select "the newest .exe/.msi": an unrelated or stale package in
+  # release/ would make an installer smoke appear green while testing the
+  # wrong artifact.
+  $installer = Join-Path $release ("Hermes-$($package.version)-win-x64.$extension")
+  $buildStarted = [DateTime]::UtcNow
+  if ($Kind -eq 'nsis') { & npm run dist:win:nsis } else { & npm run dist:win:msi }
+  if ($LASTEXITCODE -ne 0) { throw "[windows-installer-smoke] failed to build $Kind installer" }
+  if (-not (Test-Path -LiteralPath $installer -PathType Leaf)) {
+    throw "[windows-installer-smoke] the exact generated $Kind artifact is missing: $installer"
+  }
+  if ((Get-Item -LiteralPath $installer).LastWriteTimeUtc -lt $buildStarted) {
+    throw "[windows-installer-smoke] refusing stale $Kind artifact not written by this build: $installer"
+  }
+  Pop-Location
+
+  if ($Kind -eq 'nsis') {
+    $install = Start-Process -FilePath $installer -ArgumentList @('/S', "/D=$installRoot") -Wait -PassThru
+  } else {
+    $install = Start-Process -FilePath 'msiexec.exe' -ArgumentList @('/i', $installer, "INSTALLDIR=$installRoot", '/qn', '/norestart') -Wait -PassThru
+  }
+  if ($install.ExitCode -ne 0) { throw "[windows-installer-smoke] $Kind install failed: exit $($install.ExitCode)" }
+
+  $app = Join-Path $installRoot 'Hermes.exe'
+  Wait-ForFile $app
+  $runtimeRoot = Join-Path $installRoot 'resources\\open-design-runtime'
+  $bundledOpenDesign = Join-Path $runtimeRoot 'app\\Open Design.exe'
+  Wait-ForFile (Join-Path $runtimeRoot 'provenance.json')
+  Wait-ForFile $bundledOpenDesign
+  Wait-ForFile (Join-Path $installRoot 'resources\\native\\win32-x64\\hermes-open-design-job.exe')
+
+  # Launch the installed image, never an unpacked build. A fast exit is a
+  # failure; cleanup is unconditional so this cannot leave a GUI/process tree.
+  $process = Start-Process -FilePath $app -PassThru
+  Start-Sleep -Seconds 5
+  if ($process.HasExited) { throw "[windows-installer-smoke] installed Hermes.exe exited immediately: $($process.ExitCode)" }
+  Stop-Process -Id $process.Id -Force -ErrorAction SilentlyContinue
+  Wait-Process -Id $process.Id -Timeout 15 -ErrorAction SilentlyContinue
+  Assert-NoInstalledProcess $installRoot
+
+  # This asserts the actual bundled runtime owned by the installed package,
+  # rather than merely checking a directory name. It is intentionally
+  # launched directly here because S1 correctly leaves Electron route/IPC
+  # composition to S2; the package smoke must not pretend that an unowned
+  # route can prove runtime ownership before that downstream seam exists.
+  $bundledRuntime = Start-Process -FilePath $bundledOpenDesign -PassThru
+  Start-Sleep -Seconds 5
+  if ($bundledRuntime.HasExited) { throw "[windows-installer-smoke] installed bundled Open Design.exe exited immediately: $($bundledRuntime.ExitCode)" }
+  Stop-Process -Id $bundledRuntime.Id -Force -ErrorAction SilentlyContinue
+  Wait-Process -Id $bundledRuntime.Id -Timeout 15 -ErrorAction SilentlyContinue
+  Assert-NoInstalledProcess $installRoot
+
+  if ($Kind -eq 'nsis') {
+    $uninstaller = Join-Path $installRoot 'Uninstall Hermes.exe'
+    Wait-ForFile $uninstaller
+    $uninstall = Start-Process -FilePath $uninstaller -ArgumentList '/S' -Wait -PassThru
+  } else {
+    $uninstall = Start-Process -FilePath 'msiexec.exe' -ArgumentList @('/x', $installer, '/qn', '/norestart') -Wait -PassThru
+  }
+  if ($uninstall.ExitCode -ne 0) { throw "[windows-installer-smoke] $Kind uninstall failed: exit $($uninstall.ExitCode)" }
+  if (Test-Path -LiteralPath $app) { throw "[windows-installer-smoke] installed executable remained after $Kind uninstall" }
+  Assert-NoInstalledProcess $installRoot
+} finally {
+  if (Get-Location | Where-Object { $_.Path -eq $desktop }) { Pop-Location }
+  Remove-Item -LiteralPath $work -Recurse -Force -ErrorAction SilentlyContinue
+}
+
+Write-Host "[windows-installer-smoke] $Kind install-launch-uninstall completed without installed runtime residue"
diff --git a/apps/desktop/scripts/utils.mjs b/apps/desktop/scripts/utils.mjs
index 7010213ec3..b74f9a533d 100644
--- a/apps/desktop/scripts/utils.mjs
+++ b/apps/desktop/scripts/utils.mjs
@@ -1,8 +1,49 @@
 
+import { chmodSync, readdirSync, statSync } from 'node:fs';
+import { join } from 'node:path';
 import { pathToFileURL } from 'node:url';
 
 // returns true if the passsed file is being invoked from node,
 // not imported.
 export function isMain(importMetaUrl) {
     return   importMetaUrl === pathToFileURL(process.argv[1]).href;
+}
+
+/**
+ * Recursively strips the write bit from every FILE under rootPath (directory
+ * write bits are left untouched, so `rm -rf`/legitimate cleanup of the whole
+ * tree still works -- POSIX unlink() only requires write permission on the
+ * containing directory, never on the file itself).
+ *
+ * Narrows -- but does not fully close -- the gap between a build script
+ * validating staged content and a LATER, separate process (e.g.
+ * electron-builder's own extraResources copy, which runs after this script's
+ * beforePack hook returns, entirely outside this script's control) reading
+ * it: a same-or-lower-privileged writer can no longer overwrite a staged
+ * file in place after this call; a privileged/root attacker, or one willing
+ * to delete-then-recreate the file, still can. That residual is inherent to
+ * POSIX filesystem permissions without a dedicated immutable-file API
+ * (chattr +i on Linux, uchg on macOS) or a lock this build already doesn't
+ * hold; this is the defensible mitigation available from Node here.
+ */
+export function markPathTreeFilesReadOnly(rootPath) {
+    let stat;
+
+    try {
+        stat = statSync(rootPath);
+    } catch {
+        return;
+    }
+
+    if (stat.isDirectory()) {
+        for (const entry of readdirSync(rootPath)) {
+            markPathTreeFilesReadOnly(join(rootPath, entry));
+        }
+
+        return;
+    }
+
+    if (stat.isFile()) {
+        chmodSync(rootPath, stat.mode & ~0o222);
+    }
 }
\ No newline at end of file
