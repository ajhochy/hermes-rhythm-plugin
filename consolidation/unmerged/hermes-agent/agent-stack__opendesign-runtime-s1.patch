--- /dev/null
+++ b/apps/desktop/electron/open-design/windows-owned-runtime.ts
@@ -0,0 +1,124 @@
+/**
+ * windows-owned-runtime.ts — the Windows graceful-then-force stop sequence
+ * (P1-3 "Hermes runtime termination must"). Callers must only invoke this
+ * for a runtime Hermes itself owns via a live WindowsJobGuardianHandle --
+ * never for an attached external runtime, which has no guardian handle and
+ * must never be signalled or stopped.
+ *
+ * Sequence:
+ * 1. Ask the guardian whether its retained original target handle is live.
+ * 2. If live, connect to the exact pinned desktop sidecar IPC for the
+ *    validated namespace and request `status`, requiring pid/state/url to
+ *    match the owned runtime before trusting it.
+ * 3. Only then request `shutdown` (`accepted:true` means scheduled, not
+ *    completed).
+ * 4. Wait up to `gracefulTimeoutMs` (default 20s) for the guardian to prove
+ *    `EMPTY`, whether that arrives as a direct response or a spontaneous
+ *    notification once the Job actually becomes empty.
+ * 5. If IPC failed, was skipped, or the graceful wait times out, request
+ *    `FORCE`: the guardian calls `TerminateJobObject` and only reports
+ *    `EMPTY forced` after `QueryInformationJobObject` proves
+ *    `ActiveProcesses === 0` (bounded to `forceTimeoutMs`, default 10s).
+ *    Completion-port notifications are never sufficient proof by themselves;
+ *    only a guardian-reported EMPTY (of either kind) permits the caller to
+ *    dispose ownership state or retry.
+ */
+
+import { isLoopbackHttpUrl } from './identity'
+import { resolveOpenDesignDesktopIpcEndpoint } from './ipc-endpoint'
+import { requestOpenDesignIpc } from './json-ipc-client'
+
+export interface WindowsOwnedGuardianLike {
+  requestStatus: (timeoutMs?: number) => Promise<{ state: 'live' | 'exited'; pid: number; creationFiletime: string }>
+  requestForce: (timeoutMs?: number) => Promise<'graceful' | 'forced'>
+  waitForEmpty: (timeoutMs?: number) => Promise<'graceful' | 'forced'>
+}
+
+export type OpenDesignIpcRequester = (options: Parameters<typeof requestOpenDesignIpc>[0]) => Promise<unknown>
+
+export interface StopWindowsOwnedRuntimeOptions {
+  guardian: WindowsOwnedGuardianLike
+  namespace: string
+  expectedGuardianTargetPid: number
+  /** Binds the graceful IPC leg to the exact retained owned runtime, not merely a matching pid (defends PID reuse). */
+  expectedGuardianTargetCreationFiletime: string
+  requestIpc?: OpenDesignIpcRequester
+  gracefulTimeoutMs?: number
+  statusTimeoutMs?: number
+  forceTimeoutMs?: number
+}
+
+export interface StopWindowsOwnedRuntimeResult {
+  forced: boolean
+  parentExited: boolean
+  treeExited: boolean
+}
+
+const DEFAULT_GRACEFUL_TIMEOUT_MS = 20_000
+const DEFAULT_STATUS_TIMEOUT_MS = 1_500
+const DEFAULT_FORCE_TIMEOUT_MS = 10_000
+
+export async function stopWindowsOwnedRuntime(
+  options: StopWindowsOwnedRuntimeOptions
+): Promise<StopWindowsOwnedRuntimeResult> {
+  const requestIpc = options.requestIpc ?? requestOpenDesignIpc
+  const gracefulTimeoutMs = options.gracefulTimeoutMs ?? DEFAULT_GRACEFUL_TIMEOUT_MS
+  const statusTimeoutMs = options.statusTimeoutMs ?? DEFAULT_STATUS_TIMEOUT_MS
+  const forceTimeoutMs = options.forceTimeoutMs ?? DEFAULT_FORCE_TIMEOUT_MS
+
+  try {
+    const guardianStatus = await options.guardian.requestStatus(statusTimeoutMs)
+
+    if (
+      guardianStatus.state === 'live'
+      && guardianStatus.creationFiletime === options.expectedGuardianTargetCreationFiletime
+    ) {
+      // Never a renderer/guest-supplied endpoint: always derived from the
+      // already-validated namespace via the pinned resolver.
+      const endpoint = resolveOpenDesignDesktopIpcEndpoint(options.namespace, { platform: 'win32' })
+
+      const odStatus = await requestIpc({
+        endpoint,
+        payload: { type: 'status' },
+        responseTimeoutMs: statusTimeoutMs
+      }) as { pid?: number; state?: string; url?: string } | null
+
+      if (
+        odStatus?.pid === options.expectedGuardianTargetPid
+        && odStatus?.state === 'running'
+        && isLoopbackHttpUrl(String(odStatus?.url))
+      ) {
+        const shutdownResult = await requestIpc({
+          endpoint,
+          payload: { type: 'shutdown' },
+          responseTimeoutMs: statusTimeoutMs
+        }) as { accepted?: boolean } | null
+
+        if (shutdownResult?.accepted !== true) {
+          // "accepted" means Hermes may trust graceful shutdown was actually
+          // scheduled -- anything else (missing/false) means it was not, so
+          // this falls through to the catch below exactly like a failed
+          // request: the guardian's own EMPTY proof remains authoritative.
+          throw new Error('[open-design windows-owned-runtime] Open Design did not accept the graceful shutdown request')
+        }
+      }
+    }
+  } catch {
+    // Graceful IPC is a best-effort accelerant, not a requirement: the
+    // guardian's own EMPTY proof (awaited unconditionally below) is the
+    // authoritative signal either way. A status/shutdown failure here (IPC
+    // not up yet, wrong pid, guardian says already exited, ...) just means
+    // graceful shutdown was never actually requested over IPC, so the wait
+    // below will most likely time out and fall through to FORCE.
+  }
+
+  try {
+    const kind = await options.guardian.waitForEmpty(gracefulTimeoutMs)
+
+    return { forced: kind === 'forced', parentExited: true, treeExited: true }
+  } catch {
+    await options.guardian.requestForce(forceTimeoutMs)
+
+    return { forced: true, parentExited: true, treeExited: true }
+  }
+}
