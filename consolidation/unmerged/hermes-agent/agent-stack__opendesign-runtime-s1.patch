--- /dev/null
+++ b/apps/desktop/electron/open-design/windows-supervisor-deps.ts
@@ -0,0 +1,313 @@
+/**
+ * windows-supervisor-deps.ts — the typed Windows owned-runtime abstraction
+ * that wires `OpenDesignRuntimeSupervisor` to the Job guardian instead of a
+ * direct `child_process.spawn()` of Open Design. This is the seam a prior
+ * review found missing entirely: the guardian/protocol/stop modules existed
+ * but nothing ever constructed a real `OpenDesignSupervisorDeps` that used
+ * them, so a real Windows launch would have spawned Open Design directly
+ * and bypassed the guardian altogether.
+ *
+ * `createWindowsOwnedRuntimeDeps()` returns matched `spawn` / `waitForReady`
+ * / `terminateOwnedTree` implementations sharing private per-child state
+ * (the bound readiness origin), so:
+ *
+ * - `spawn` NEVER launches `candidate.executablePath` directly on Windows --
+ *   it becomes the guardian's TARGET argument. Only the exact,
+ *   canonicalized, hash/PE/signature-validated guardian executable is ever
+ *   spawned (`shell:false`). Readiness/lifecycle bind to the guardian's
+ *   retained TARGET pid, never the guardian's own pid.
+ * - `waitForReady` binds identity validation to that same target identity
+ *   and records the exact resolved origin for the stop leg to require
+ *   exactly (never merely "any loopback URL").
+ * - `terminateOwnedTree` always routes through `stopWindowsOwnedRuntime` --
+ *   never `terminateOwnedProcessTree` (which throws on win32 by design).
+ *
+ * The wrapped child's 'exit' event fires whenever the guardian proves the
+ * owned tree gone (a real EMPTY, spontaneous or stop-driven) or ownership is
+ * lost abnormally -- `OpenDesignRuntimeSupervisor`'s own existing
+ * intentional/unintentional bookkeeping (set BEFORE an intentional stop)
+ * already disambiguates a normal stop from an unexpected exit, exactly as
+ * it does for the POSIX child today; this module does not need to
+ * reimplement that distinction. 'error' intentionally never fires on the
+ * wrapped child: every real failure mode (spawn failure, handshake
+ * mismatch, protocol integrity loss, abnormal close) is already converted
+ * into either a rejected `spawn()` promise (before ownership publishes) or
+ * a sticky `ownership_lost` signal (after), matching what the supervisor's
+ * existing race/retry logic already expects.
+ */
+
+import path from 'node:path'
+
+import { resolveOpenDesignDesktopIpcEndpoint } from './ipc-endpoint'
+import { requestOpenDesignIpc } from './json-ipc-client'
+import type { OpenDesignRuntimeCandidate } from './resolver'
+import type { OpenDesignSpawnedChild, OpenDesignSupervisorDeps } from './supervisor'
+import {
+  createProductionGuardianArtifactResolver,
+  type CreateProductionGuardianArtifactResolverOptions
+} from './windows-guardian-resolver'
+import {
+  spawnWindowsJobGuardian,
+  type SpawnWindowsJobGuardianDeps,
+  type WindowsJobGuardianHandle
+} from './windows-job-guardian'
+import { type OpenDesignIpcRequester, stopWindowsOwnedRuntime } from './windows-owned-runtime'
+import { waitForOpenDesignReadyWindows, type WaitForOpenDesignReadyWindowsOptions } from './windows-readiness'
+
+export interface WindowsOwnedRuntimeChild extends OpenDesignSpawnedChild {
+  guardian: WindowsJobGuardianHandle
+}
+
+export interface WindowsReadinessExpectations {
+  expectedNamespaceRoot: string
+  expectedGuardianHelperPpid: number
+  expectedExecutablePath: string
+  expectedLogPath: string
+}
+
+/**
+ * Default identity-expectation derivation from a resolved candidate and the
+ * validated guardian handle, matching namespace.ts's own namespace-root
+ * convention and the desktop per-app log layout. The target's PPID is
+ * expected to equal the guardian's own pid: the guardian directly
+ * CreateProcess()s the target as its immediate child, and CREATE_SUSPENDED
+ * does not break that parent linkage.
+ */
+export function defaultWindowsReadinessExpectations(
+  candidate: OpenDesignRuntimeCandidate,
+  guardian: WindowsJobGuardianHandle
+): WindowsReadinessExpectations {
+  const namespaceRoot = path.win32.join(candidate.namespaceBaseRoot, candidate.namespace)
+
+  return {
+    expectedNamespaceRoot: namespaceRoot,
+    expectedGuardianHelperPpid: guardian.guardianPid,
+    expectedExecutablePath: candidate.executablePath,
+    expectedLogPath: path.win32.join(namespaceRoot, 'logs', 'desktop', 'latest.log')
+  }
+}
+
+export interface CreateWindowsOwnedRuntimeDepsOptions {
+  namespace: string
+  expectedSourceCommit: string
+  /**
+   * Resolves, canonicalizes, and hash/PE/signature-validates the staged
+   * guardian executable immediately before every launch; throws
+   * (ownership_unavailable) on any failure. Never trust a cached prior
+   * result -- a tampered/replaced artifact between launches must be caught.
+   *
+   * Supply this directly for full control (e.g. tests), or supply
+   * `guardianDir` below to get the real production resolver
+   * (windows-guardian-resolver.ts, performing real ACL/canonical-path/
+   * hash/PE/signature checks against real files) built for you. Exactly one
+   * of the two must be supplied; a production caller (the eventual
+   * composition root) normally only needs `guardianDir`.
+   */
+  resolveValidatedGuardianExePath?: () => string
+  /** Directory containing the staged hermes-open-design-job.exe + its sibling manifest (see windows-guardian-resolver.ts). Ignored when resolveValidatedGuardianExePath is supplied directly. */
+  guardianDir?: string
+  /**
+   * Advanced overrides forwarded verbatim to `createProductionGuardianArtifactResolver()`
+   * when `guardianDir` builds the default resolver -- e.g. `isPackaged` (defaults to
+   * production/`true`), or `platform`/`checkAcl`/`verifySignature` for tests that need
+   * to exercise the win32-shaped resolver on a non-Windows host. Ignored when
+   * `resolveValidatedGuardianExePath` is supplied directly.
+   */
+  guardianArtifactResolverOptions?: Omit<CreateProductionGuardianArtifactResolverOptions, 'guardianDir' | 'expectedSourceCommit'>
+  spawnGuardian: SpawnWindowsJobGuardianDeps['spawn']
+  generateNonce?: () => string
+  readHeadlessIdentity: WaitForOpenDesignReadyWindowsOptions['readHeadlessIdentity']
+  fetchHealth: WaitForOpenDesignReadyWindowsOptions['fetchHealth']
+  requestIpc?: OpenDesignIpcRequester
+  buildReadinessExpectations?: (
+    candidate: OpenDesignRuntimeCandidate,
+    guardian: WindowsJobGuardianHandle
+  ) => WindowsReadinessExpectations
+  readinessTimeoutMs?: number
+  readinessPollMs?: number
+  gracefulStopTimeoutMs?: number
+  forceStopTimeoutMs?: number
+}
+
+// Effectively unbounded background EMPTY watch without risking the ~24.8-day
+// int32 setTimeout overflow: the guardian's own bounded FORCE/graceful
+// budgets are what actually govern any real stop; this is only a passive
+// "did the tree become empty on its own" observer for the handle's lifetime.
+const BACKGROUND_EMPTY_WATCH_MS = 2_147_000_000
+
+/**
+ * Exactly one of `resolveValidatedGuardianExePath` / `guardianDir` must be
+ * supplied. Resolved eagerly (at composition time, before any spawn) so a
+ * missing/misconfigured production caller fails closed immediately, the
+ * same way the supervisor itself already fails closed on a missing Windows
+ * ownership bundle -- never deferred until the first launch attempt.
+ */
+function resolveGuardianExePathResolver(options: CreateWindowsOwnedRuntimeDepsOptions): () => string {
+  if (options.resolveValidatedGuardianExePath) {
+    return options.resolveValidatedGuardianExePath
+  }
+
+  if (!options.guardianDir) {
+    throw new Error(
+      '[open-design windows-supervisor-deps] supply exactly one of resolveValidatedGuardianExePath or guardianDir'
+    )
+  }
+
+  return createProductionGuardianArtifactResolver({
+    platform: 'win32',
+    ...options.guardianArtifactResolverOptions,
+    guardianDir: options.guardianDir,
+    expectedSourceCommit: options.expectedSourceCommit
+  })
+}
+
+/**
+ * Builds matched `spawn` / `waitForReady` / `terminateOwnedTree`
+ * implementations for `OpenDesignSupervisorDeps` on win32. Every dependency
+ * is injected so this is fully testable without a real Windows host or
+ * native guardian binary.
+ */
+export function createWindowsOwnedRuntimeDeps(
+  options: CreateWindowsOwnedRuntimeDepsOptions
+): Pick<OpenDesignSupervisorDeps, 'spawn' | 'waitForReady' | 'terminateOwnedTree'> {
+  const buildExpectations = options.buildReadinessExpectations ?? defaultWindowsReadinessExpectations
+  const resolveValidatedGuardianExePath = resolveGuardianExePathResolver(options)
+  const requestIpc = options.requestIpc ?? requestOpenDesignIpc
+  const originByChild = new WeakMap<WindowsOwnedRuntimeChild, string>()
+
+  const spawn: OpenDesignSupervisorDeps['spawn'] = async (command, args) => {
+    // `command` is `candidate.executablePath`: on Windows this becomes the
+    // guardian's TARGET argument, never spawned directly.
+    const guardianExePath = resolveValidatedGuardianExePath()
+
+    const guardian = await spawnWindowsJobGuardian({
+      guardianExePath,
+      targetExecutablePath: command,
+      targetArgs: args,
+      expectedSourceCommit: options.expectedSourceCommit,
+      platform: 'win32',
+      spawn: options.spawnGuardian,
+      generateNonce: options.generateNonce
+    })
+
+    let exitListeners = new Set<(...eventArgs: unknown[]) => void>()
+    let exited = false
+
+    const fireExit = () => {
+      if (exited) {return}
+      exited = true
+      const listeners = exitListeners
+      exitListeners = new Set()
+
+      for (const listener of listeners) {
+        listener(null, null)
+      }
+    }
+
+    // Sticky and delivered exactly once, even if this fires before the
+    // supervisor ever registers its own listener (onOwnershipLost() itself
+    // replays a loss that already happened -- see windows-job-guardian.ts).
+    guardian.onOwnershipLost(() => fireExit())
+
+    // Passive background awareness: a spontaneous EMPTY while otherwise idle
+    // (the guest exited via IPC shutdown Hermes didn't itself request) is
+    // itself an unexpected runtime exit. The supervisor's own
+    // intentionalChildren bookkeeping (set BEFORE an intentional stop calls
+    // reapOwnedTree) disambiguates a normal stop from this, exactly as it
+    // already does for the POSIX child's 'exit' event -- this watch does not
+    // need to know which case it is. A timeout/rejection from this
+    // best-effort watch is not itself meaningful and is swallowed.
+    guardian.waitForEmpty(BACKGROUND_EMPTY_WATCH_MS).then(fireExit, () => {})
+
+    const child: WindowsOwnedRuntimeChild = {
+      pid: guardian.targetPid,
+      exitCode: null,
+      signalCode: null,
+      guardian,
+      kill: () => {
+        // Best-effort only: real cleanup always routes through
+        // terminateOwnedTree/stopWindowsOwnedRuntime, which is proof-backed.
+        // This exists solely for OpenDesignSpawnedChild interface parity;
+        // the supervisor never calls it when terminateOwnedTree is supplied.
+        guardian.requestForce().catch(() => {})
+      },
+      on: (event, listener) => {
+        if (event === 'exit') {exitListeners.add(listener)}
+      },
+      once: (event, listener) => {
+        if (event !== 'exit') {return}
+
