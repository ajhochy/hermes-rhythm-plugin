diff --git a/apps/desktop/electron/open-design/fixtures/fake-job-guardian.mjs b/apps/desktop/electron/open-design/fixtures/fake-job-guardian.mjs
new file mode 100644
index 0000000000..a2beef0400
--- /dev/null
+++ b/apps/desktop/electron/open-design/fixtures/fake-job-guardian.mjs
@@ -0,0 +1,102 @@
+#!/usr/bin/env node
+// Real (non-mock) child process speaking the exact ODJOB/1 stdio protocol,
+// used to test windows-job-guardian.ts's TS-side state machine for real
+// (spawn, error/exit handling, request/response correlation, protocol
+// parsing) on any OS -- it does not touch real Win32 Job Objects, which
+// only the native guardian.cpp does.
+//
+// Argv contract mirrors guardian.cpp exactly: argv[2] is the fresh launch
+// nonce, argv[3] is the target executable path (unused here -- this fixture
+// never actually spawns a target, it only speaks the protocol).
+//
+// Controlled entirely via env vars so each test scenario is a plain spawn:
+//   FAKE_GUARDIAN_PID                  - reported target pid (default 4321)
+//   FAKE_GUARDIAN_FILETIME             - reported target creation FILETIME (default a fixed value)
+//   FAKE_GUARDIAN_COMMIT               - reported source commit (default a fixed value)
+//   FAKE_GUARDIAN_SELF_PID_OVERRIDE    - reported guardian pid (default: this process's real pid)
+//   FAKE_GUARDIAN_SELF_FILETIME        - reported guardian creation FILETIME (default a fixed value)
+//   FAKE_GUARDIAN_NONCE_OVERRIDE       - echo a DIFFERENT nonce than the one supplied via argv (simulates a stale/wrong handshake)
+//   FAKE_GUARDIAN_CRASH_BEFORE_READY=1 - exit(1) immediately, never emit READY
+//   FAKE_GUARDIAN_MALFORMED_READY=1    - emit a truncated/invalid READY line
+//   FAKE_GUARDIAN_CRASH_AFTER_READY=1  - emit READY, then exit(1) with no EMPTY
+//   FAKE_GUARDIAN_TARGET_STATE         - state STATUS reports (default "live")
+//   FAKE_GUARDIAN_GUEST_STDERR_LINE    - relay this text through stderr once, after READY
+//   FAKE_GUARDIAN_SPONTANEOUS_EMPTY_MS - after this delay, emit "EMPTY graceful"
+//                                        unsolicited (no STATUS/FORCE needed), simulating
+//                                        the Job becoming empty via IPC-driven guest shutdown
+
+const nonce = process.argv[2] ?? ''
+
+const pid = Number(process.env.FAKE_GUARDIAN_PID ?? 4321)
+const filetime = process.env.FAKE_GUARDIAN_FILETIME ?? '133700000000000000'
+const commit = process.env.FAKE_GUARDIAN_COMMIT ?? 'fa3cb4cdf3d1703e984a5655bd9654f8d44c493b'
+const targetState = process.env.FAKE_GUARDIAN_TARGET_STATE ?? 'live'
+const guardianPid = process.env.FAKE_GUARDIAN_SELF_PID_OVERRIDE
+  ? Number(process.env.FAKE_GUARDIAN_SELF_PID_OVERRIDE)
+  : process.pid
+const guardianFiletime = process.env.FAKE_GUARDIAN_SELF_FILETIME ?? '111222333444555666'
+const echoedNonce = process.env.FAKE_GUARDIAN_NONCE_OVERRIDE ?? nonce
+
+function writeStdout(line) {
+  process.stdout.write(`${line}\n`)
+}
+
+if (process.env.FAKE_GUARDIAN_CRASH_BEFORE_READY === '1') {
+  process.exitCode = 1
+  process.exit(1)
+}
+
+if (process.env.FAKE_GUARDIAN_MALFORMED_READY === '1') {
+  writeStdout('ODJOB/1 READY not-enough-fields')
+  process.exit(1)
+}
+
+writeStdout(`ODJOB/1 READY ${guardianPid} ${guardianFiletime} ${pid} ${filetime} ${commit} ${echoedNonce}`)
+
+if (process.env.FAKE_GUARDIAN_GUEST_STDERR_LINE) {
+  process.stderr.write(`${process.env.FAKE_GUARDIAN_GUEST_STDERR_LINE}\n`)
+}
+
+if (process.env.FAKE_GUARDIAN_SPONTANEOUS_EMPTY_MS) {
+  setTimeout(() => {
+    writeStdout('ODJOB/1 EMPTY graceful')
+  }, Number(process.env.FAKE_GUARDIAN_SPONTANEOUS_EMPTY_MS))
+}
+
+if (process.env.FAKE_GUARDIAN_CRASH_AFTER_READY === '1') {
+  setTimeout(() => {
+    process.exitCode = 1
+    process.exit(1)
+  }, 20)
+} else {
+  let buffer = ''
+
+  process.stdin.on('data', chunk => {
+    buffer += chunk.toString('utf8')
+    let newlineIndex
+
+    while ((newlineIndex = buffer.indexOf('\n')) >= 0) {
+      const line = buffer.slice(0, newlineIndex)
+      buffer = buffer.slice(newlineIndex + 1)
+
+      if (line === 'STATUS') {
+        writeStdout(`ODJOB/1 TARGET ${targetState} ${pid} ${filetime}`)
+      } else if (line === 'FORCE') {
+        writeStdout('ODJOB/1 EMPTY forced')
+        process.exit(0)
+      } else if (line.length > 0) {
+        // Mirrors guardian.cpp's fail-closed behavior: a malformed command on
+        // the trusted control channel forces cleanup rather than continuing.
+        writeStdout('ODJOB/1 ERROR BadCommand 87')
+        writeStdout('ODJOB/1 EMPTY forced')
+        process.exit(0)
+      }
+    }
+  })
+
+  process.stdin.on('end', () => {
+    // Parent's control pipe closed (Hermes died) -- kill-on-job-close analog.
+    writeStdout('ODJOB/1 EMPTY forced')
+    process.exit(0)
+  })
+}
diff --git a/apps/desktop/electron/open-design/hermes-bin.test.ts b/apps/desktop/electron/open-design/hermes-bin.test.ts
