+#!/usr/bin/env node
+// Compiles apps/desktop/native/open-design-job/guardian.cpp into
+// hermes-open-design-job.exe with MSVC on a real Windows x64 host, embeds
+// the exact source commit + protocol version in PE metadata (guardian.rc)
+// and the runtime protocol handshake, and writes a manifest
+// (native-guardian-manifest.ts's shape) the runtime hashes and validates
+// before ever spawning the guardian. Must run ON Windows -- cross-compiling
+// this guardian from another host is unsupported; before-pack.mjs instead
+// requires an explicitly supplied, checksum-verified same-commit signed
+// artifact when packaging for win32 from a non-Windows build host.
+
+import { execFile } from 'node:child_process'
+import crypto from 'node:crypto'
+import fs from 'node:fs'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { promisify } from 'node:util'
+
+import { isMain } from '../utils.mjs'
+
+const execFileAsync = promisify(execFile)
+const here = path.dirname(fileURLToPath(import.meta.url))
+const desktopRoot = path.resolve(here, '..', '..')
+const NATIVE_SOURCE_DIR = path.join(desktopRoot, 'native', 'open-design-job')
+const PROTOCOL_VERSION = 1
+const TARGET = 'win32-x64'
+// Staged under the existing git-ignored build output tree (see .gitignore's
+// `apps/desktop/build/`), never committed. package.json's win.extraResources
+// copies this into the packaged app's `resources/native/win32-x64/` at pack
+// time, staying outside ASAR like the Open Design runtime itself.
+export const DEFAULT_OUTPUT_RELATIVE = path.join('build', 'native', 'win32-x64', 'hermes-open-design-job.exe')
+const COMMIT_RE = /^[0-9a-f]{40}$/i
+
+export function computeSha256(filePath) {
+  return crypto.createHash('sha256').update(fs.readFileSync(filePath)).digest('hex')
+}
+
+export function requireGitCommitFormat(commit) {
+  if (typeof commit !== 'string' || !COMMIT_RE.test(commit)) {
+    throw new Error(`[build-windows-job-guardian] source commit must be a 40-character hex SHA, got: ${JSON.stringify(commit)}`)
+  }
+
+  return commit.toLowerCase()
+}
+
+function defaultRun(command, args) {
+  return execFileAsync(command, args, { shell: false })
+}
+
+export async function buildWindowsJobGuardian({
+  sourceCommit,
+  platform = process.platform,
+  outputPath,
+  run = defaultRun,
+  writeFile = fs.writeFileSync,
+  mkdir = destPath => fs.mkdirSync(destPath, { recursive: true })
+}) {
+  if (platform !== 'win32') {
+    throw new Error(
+      '[build-windows-job-guardian] must run on a real Windows x64 host with MSVC installed; cross-compiling the guardian is unsupported'
+    )
+  }
+
+  const commit = requireGitCommitFormat(sourceCommit)
+  const resolvedOutput = outputPath ?? path.join(desktopRoot, DEFAULT_OUTPUT_RELATIVE)
+  mkdir(path.dirname(resolvedOutput))
+
+  const rcOutput = `${resolvedOutput}.res`
+  const objOutput = `${resolvedOutput}.obj`
+
+  // Embeds the source commit + protocol version into PE VERSIONINFO.
+  await run('rc.exe', [
+    `/DODJOB_SOURCE_COMMIT_STR="${commit}"`,
+    `/DODJOB_PROTOCOL_VERSION_STR="${PROTOCOL_VERSION}"`,
+    `/fo${rcOutput}`,
+    path.join(NATIVE_SOURCE_DIR, 'guardian.rc')
+  ])
+
+  // /MT (static CRT, no separate runtime dependency), /W4 /WX (warnings as
+  // errors), /guard:cf (Control Flow Guard) at both compile and link time,
+  // /DYNAMICBASE (ASLR) + /NXCOMPAT (DEP/NX) at link time. No CLR, no
+  // third-party runtime.
+  await run('cl.exe', [
+    '/nologo',
+    '/W4',
+    '/WX',
+    '/MT',
+    '/O2',
+    '/EHsc',
+    '/std:c++17',
+    '/guard:cf',
+    '/DUNICODE',
+    '/D_UNICODE',
+    `/DODJOB_SOURCE_COMMIT=L"${commit}"`,
+    path.join(NATIVE_SOURCE_DIR, 'guardian.cpp'),
+    rcOutput,
+    `/Fe${resolvedOutput}`,
+    `/Fo${objOutput}`,
+    '/link',
+    '/SUBSYSTEM:CONSOLE',
+    '/guard:cf',
+    '/DYNAMICBASE',
+    '/NXCOMPAT',
+    '/HIGHENTROPYVA'
+  ])
+
+  const sha256 = computeSha256(resolvedOutput)
+  const manifest = { protocolVersion: PROTOCOL_VERSION, sourceCommit: commit, target: TARGET, sha256 }
+  const manifestPath = `${resolvedOutput}.manifest.json`
+
+  writeFile(manifestPath, `${JSON.stringify(manifest, null, 2)}\n`)
+
+  return { outputPath: resolvedOutput, manifestPath, manifest }
