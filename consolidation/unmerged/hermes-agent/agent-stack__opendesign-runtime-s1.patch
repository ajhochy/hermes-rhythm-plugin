+/**
+ * hermes-bin.ts — the reusable resolver/validator seam for `HERMES_BIN`.
+ *
+ * Root cause this repairs: the pinned Open Design guest
+ * (`apps/daemon/src/runtimes/executables.ts` in the Open Design source, see
+ * `executableFilePath()`) only honors an override that resolves to an
+ * absolute, existing, executable regular file. A bare command name or a
+ * relative path is silently ignored, after which Open Design falls back to
+ * searching PATH and may launch no Hermes, or an unrelated/incompatible one.
+ *
+ * This module mirrors that exact acceptance algorithm so whatever Hermes
+ * supplies is guaranteed to be the executable Open Design actually selects,
+ * never a value it silently discards. Callers (the future S2 integration
+ * wiring this to Desktop's existing active backend/CLI resolution) must run
+ * this before constructing the child environment; `child-env.ts` also
+ * enforces the absolute-path shape as a last, defense-in-depth gate.
+ */
+
+import { accessSync, constants as fsConstants, statSync } from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+
+export interface ResolveValidatedHermesBinOptions {
+  platform?: NodeJS.Platform
+  /** Defaults to the real `PATHEXT` env var, then Windows' own built-in default. */
+  pathExt?: string
+  stat?: (candidatePath: string) => { isFile(): boolean }
+  access?: (candidatePath: string, mode: number) => void
+  homedir?: () => string
+}
+
+const DEFAULT_WINDOWS_PATHEXT = '.EXE;.CMD;.BAT'
+// eslint-disable-next-line no-control-regex -- deliberately reject NUL/control characters in HERMES_BIN
+const CONTROL_CHAR_RE = /[\0-\x1f]/
+
+function expandHomePrefix(raw: string, homedir: () => string): string {
+  if (raw === '~') {
+    return homedir()
+  }
+
+  if (raw.startsWith('~/') || raw.startsWith('~\\')) {
+    return path.join(homedir(), raw.slice(2))
+  }
+
+  return raw
+}
+
+function isAbsoluteOnEitherConvention(candidatePath: string): boolean {
+  return path.posix.isAbsolute(candidatePath) || path.win32.isAbsolute(candidatePath)
+}
+
+function looksExecutableOnWindows(filePath: string, pathExt: string): boolean {
+  const ext = path.extname(filePath).trim().toUpperCase()
+
+  if (!ext) {
+    return false
+  }
+
+  const executableExts = pathExt.split(';').map(value => value.trim().toUpperCase()).filter(Boolean)
+
+  return executableExts.includes(ext)
+}
+
+/**
+ * Resolves and validates a `HERMES_BIN` candidate against the exact rule the
+ * pinned Open Design guest applies, so the returned path is guaranteed to be
+ * the executable Open Design actually launches -- never a value it silently
+ * falls through on. Throws a descriptive error for every rejected shape
+ * (extensionless/bare/relative/directory/missing/non-executable/control
+ * character/incompatible-extension); never returns a value derived from an
+ * unvalidated candidate.
+ */
+export function resolveValidatedHermesBin(
+  candidate: unknown,
+  options: ResolveValidatedHermesBinOptions = {}
+): string {
+  const platform = options.platform ?? process.platform
+  const stat = options.stat ?? statSync
+  const access = options.access ?? accessSync
+  const homedir = options.homedir ?? os.homedir
+
+  if (typeof candidate !== 'string' || candidate.trim().length === 0) {
+    throw new Error(`[open-design hermes-bin] HERMES_BIN must be a non-empty absolute path, got: ${JSON.stringify(candidate)}`)
+  }
+
+  if (CONTROL_CHAR_RE.test(candidate)) {
+    throw new Error(`[open-design hermes-bin] HERMES_BIN must not contain control characters, got: ${JSON.stringify(candidate)}`)
+  }
+
+  const trimmed = candidate.trim()
+
+  if (trimmed !== candidate) {
+    throw new Error(`[open-design hermes-bin] HERMES_BIN must not have leading/trailing whitespace, got: ${JSON.stringify(candidate)}`)
+  }
+
+  const expanded = expandHomePrefix(trimmed, homedir)
+
+  if (!isAbsoluteOnEitherConvention(expanded)) {
+    throw new Error(
+      `[open-design hermes-bin] HERMES_BIN must be an absolute path -- Open Design silently ignores a bare command or relative path and falls back to searching PATH, got: ${JSON.stringify(candidate)}`
+    )
+  }
+
+  const resolved = path.resolve(expanded)
+
+  let stats: { isFile(): boolean }
+
+  try {
+    stats = stat(resolved)
+  } catch {
+    throw new Error(`[open-design hermes-bin] HERMES_BIN does not exist or is inaccessible: ${resolved}`)
+  }
+
+  if (!stats.isFile()) {
+    throw new Error(`[open-design hermes-bin] HERMES_BIN must be a regular executable file, not a directory or special file: ${resolved}`)
+  }
+
+  if (platform === 'win32') {
+    const pathExt = options.pathExt ?? DEFAULT_WINDOWS_PATHEXT
+
+    if (!looksExecutableOnWindows(resolved, pathExt)) {
+      throw new Error(
+        `[open-design hermes-bin] HERMES_BIN must have a PATHEXT-recognized executable extension (${pathExt}): ${resolved}`
+      )
+    }
+
+    return resolved
+  }
+
+  try {
+    access(resolved, fsConstants.X_OK)
+  } catch {
+    throw new Error(`[open-design hermes-bin] HERMES_BIN is not executable: ${resolved}`)
+  }
+
+  return resolved
+}
