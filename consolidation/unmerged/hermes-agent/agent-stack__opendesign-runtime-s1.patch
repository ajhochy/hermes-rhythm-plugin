+import assert from 'node:assert/strict'
+
+import { test } from 'vitest'
+
+import { buildOpenDesignChildEnv } from './child-env'
+
+const SECRET_BASE_ENV = {
+  PATH: '/usr/bin:/bin',
+  HOME: '/Users/me',
+  ANTHROPIC_API_KEY: 'sk-ant-secret',
+  OPENAI_API_KEY: 'sk-openai-secret',
+  HERMES_HOME: '/Users/me/.hermes',
+  SOME_RANDOM_VAR: 'leak-me-not'
+}
+
+test('forwards HERMES_BIN by value but never provider secret keys', () => {
+  const env = buildOpenDesignChildEnv({
+    baseEnv: SECRET_BASE_ENV,
+    hermesBin: '/usr/local/bin/hermes',
+    namespace: 'hz-default-abc123',
+    dataDir: '/Users/me/.hermes/open-design/hz-default-abc123/data',
+    resourceRoot: '/Users/me/.hermes/open-design-runtime/Resources'
+  })
+
+  assert.equal(env.HERMES_BIN, '/usr/local/bin/hermes')
+  assert.equal(env.OD_PACKAGED_NAMESPACE, 'hz-default-abc123')
+  assert.ok(!('ANTHROPIC_API_KEY' in env))
+  assert.ok(!('OPENAI_API_KEY' in env))
+  assert.ok(!('SOME_RANDOM_VAR' in env))
+})
+
+test('forwards only an allowlisted set of base environment keys (PATH, HOME, etc)', () => {
+  const env = buildOpenDesignChildEnv({
+    baseEnv: SECRET_BASE_ENV,
+    hermesBin: 'hermes',
+    namespace: 'hz-default-abc123',
+    dataDir: '/tmp/data',
+    resourceRoot: '/tmp/resources'
+  })
+
+  assert.equal(env.PATH, '/usr/bin:/bin')
+  assert.equal(env.HOME, '/Users/me')
+})
+
+test('accepts a bare command name for HERMES_BIN (PATH lookup), not just an absolute path', () => {
+  const env = buildOpenDesignChildEnv({
+    baseEnv: SECRET_BASE_ENV,
+    hermesBin: 'hermes',
+    namespace: 'hz-default-abc123',
+    dataDir: '/tmp/data',
+    resourceRoot: '/tmp/resources'
+  })
+
+  assert.equal(env.HERMES_BIN, 'hermes')
+})
+
+test('rejects a HERMES_BIN value that is not a bare name or plain path (shell metacharacters)', () => {
+  assert.throws(
+    () =>
+      buildOpenDesignChildEnv({
+        baseEnv: SECRET_BASE_ENV,
+        hermesBin: 'hermes; rm -rf /',
+        namespace: 'hz-default-abc123',
+        dataDir: '/tmp/data',
+        resourceRoot: '/tmp/resources'
+      }),
+    /HERMES_BIN/
+  )
+})
+
+test('sets the namespace, data dir, and resource root env vars Open Design headless expects', () => {
+  const env = buildOpenDesignChildEnv({
+    baseEnv: {},
+    hermesBin: 'hermes',
+    namespace: 'hz-default-abc123',
+    dataDir: '/tmp/data',
+    resourceRoot: '/tmp/resources'
+  })
+
+  assert.equal(env.OD_PACKAGED_NAMESPACE, 'hz-default-abc123')
+  assert.equal(env.OD_DATA_DIR, '/tmp/data')
+  assert.equal(env.OD_RESOURCE_ROOT, '/tmp/resources')
+})
diff --git a/apps/desktop/electron/open-design/child-env.ts b/apps/desktop/electron/open-design/child-env.ts
new file mode 100644
index 0000000000..c5d06a8593
--- /dev/null
+++ b/apps/desktop/electron/open-design/child-env.ts
@@ -0,0 +1,60 @@
+/**
+ * child-env.ts — builds the allowlisted, sanitized environment for a
+ * spawned Open Design child process.
+ *
+ * Never spreads the parent's full `process.env`: that would copy every
+ * provider API key (ANTHROPIC_API_KEY, OPENAI_API_KEY, ...) into Open
+ * Design's process/logs. Only a small allowlist of base keys plus the
+ * Open Design-specific vars this integration needs are forwarded.
+ */
+
+const ALLOWED_BASE_ENV_KEYS = [
+  'PATH',
+  'HOME',
+  'USERPROFILE',
+  'TEMP',
+  'TMP',
+  'TMPDIR',
+  'SystemRoot',
+  'APPDATA',
+  'LOCALAPPDATA'
+]
+
+// Argument-array spawn (never a shell), so this is not shell-injection
+// hardening — it is a sanity fence against a config value that was clearly
+// never meant to be a binary name/path (and would otherwise silently no-op
+// or confuse anyone reading Open Design's logs).
+const SAFE_BIN_RE = /^[^\s;|&$`<>"']+$/
+
+export interface BuildOpenDesignChildEnvOptions {
+  baseEnv: NodeJS.ProcessEnv | Record<string, string | undefined>
+  hermesBin: string
+  namespace: string
+  dataDir: string
+  resourceRoot: string
+}
+
+export function buildOpenDesignChildEnv(options: BuildOpenDesignChildEnvOptions): Record<string, string> {
+  const { baseEnv, hermesBin, namespace, dataDir, resourceRoot } = options
+
+  if (!hermesBin || typeof hermesBin !== 'string' || !SAFE_BIN_RE.test(hermesBin)) {
+    throw new Error(`[open-design child-env] HERMES_BIN must be a bare command name or plain path, got: ${JSON.stringify(hermesBin)}`)
+  }
+
+  const env: Record<string, string> = {}
+
+  for (const key of ALLOWED_BASE_ENV_KEYS) {
+    const value = baseEnv?.[key]
+
+    if (typeof value === 'string' && value.length > 0) {
+      env[key] = value
+    }
+  }
+
+  env.HERMES_BIN = hermesBin
+  env.OD_PACKAGED_NAMESPACE = namespace
+  env.OD_DATA_DIR = dataDir
+  env.OD_RESOURCE_ROOT = resourceRoot
+
+  return env
+}
diff --git a/apps/desktop/electron/open-design/identity.test.ts b/apps/desktop/electron/open-design/identity.test.ts
new file mode 100644
index 0000000000..7a5eb70340
--- /dev/null
+++ b/apps/desktop/electron/open-design/identity.test.ts
@@ -0,0 +1,84 @@
+import assert from 'node:assert/strict'
+
+import { test } from 'vitest'
+
+import { isLoopbackHttpUrl, parseOpenDesignWebIdentity, validateOpenDesignWebIdentity } from './identity'
+
+test('parseOpenDesignWebIdentity accepts a well-formed web-root.json payload', () => {
+  const identity = parseOpenDesignWebIdentity({
+    version: 1,
+    namespace: 'hz-default-abc123',
+    pid: 4242,
+    url: 'http://127.0.0.1:53211',
+    startedAt: 1700000000000
+  })
+
+  assert.deepEqual(identity, {
+    version: 1,
+    namespace: 'hz-default-abc123',
+    pid: 4242,
+    url: 'http://127.0.0.1:53211',
+    startedAt: 1700000000000
+  })
+})
+
+test('parseOpenDesignWebIdentity returns null for malformed/missing fields', () => {
+  assert.equal(parseOpenDesignWebIdentity(null), null)
+  assert.equal(parseOpenDesignWebIdentity('not json'), null)
+  assert.equal(parseOpenDesignWebIdentity({}), null)
+  assert.equal(parseOpenDesignWebIdentity({ version: 1, namespace: 'x', pid: 1 }), null) // missing url
+  assert.equal(parseOpenDesignWebIdentity({ version: 2, namespace: 'x', pid: 1, url: 'http://127.0.0.1:1' }), null)
+  assert.equal(parseOpenDesignWebIdentity({ version: 1, namespace: 'x', pid: -1, url: 'http://127.0.0.1:1' }), null)
+})
+
+test('isLoopbackHttpUrl accepts loopback http origins with a numeric port', () => {
+  assert.equal(isLoopbackHttpUrl('http://127.0.0.1:53211'), true)
+  assert.equal(isLoopbackHttpUrl('http://localhost:3000'), true)
+  assert.equal(isLoopbackHttpUrl('http://[::1]:3000'), true)
+})
+
+test('isLoopbackHttpUrl rejects non-loopback, non-http, or malformed URLs', () => {
+  assert.equal(isLoopbackHttpUrl('http://example.com:80'), false)
+  assert.equal(isLoopbackHttpUrl('https://127.0.0.1:443'), false) // scheme not allowlisted
+  assert.equal(isLoopbackHttpUrl('file:///etc/passwd'), false)
+  assert.equal(isLoopbackHttpUrl('http://127.0.0.1.evil.com'), false)
+  assert.equal(isLoopbackHttpUrl('not a url'), false)
+  assert.equal(isLoopbackHttpUrl(''), false)
+})
+
+test('validateOpenDesignWebIdentity accepts a matching, loopback identity', () => {
+  const identity = {
+    version: 1 as const,
+    namespace: 'hz-default-abc123',
+    pid: 4242,
+    url: 'http://127.0.0.1:53211'
+  }
+
+  const result = validateOpenDesignWebIdentity(identity, { expectedNamespace: 'hz-default-abc123', expectedPid: 4242 })
+
+  assert.equal(result.ok, true)
+})
+
+test('validateOpenDesignWebIdentity rejects a namespace mismatch', () => {
+  const identity = { version: 1 as const, namespace: 'hz-other', pid: 1, url: 'http://127.0.0.1:1' }
+  const result = validateOpenDesignWebIdentity(identity, { expectedNamespace: 'hz-default-abc123', expectedPid: 1 })
+
+  assert.equal(result.ok, false)
+  assert.match(result.reason ?? '', /namespace/i)
+})
+
+test('validateOpenDesignWebIdentity rejects a pid mismatch', () => {
+  const identity = { version: 1 as const, namespace: 'hz-default-abc123', pid: 999, url: 'http://127.0.0.1:1' }
+  const result = validateOpenDesignWebIdentity(identity, { expectedNamespace: 'hz-default-abc123', expectedPid: 1 })
+
+  assert.equal(result.ok, false)
+  assert.match(result.reason ?? '', /pid/i)
+})
+
+test('validateOpenDesignWebIdentity rejects a non-loopback url', () => {
+  const identity = { version: 1 as const, namespace: 'hz-default-abc123', pid: 1, url: 'http://evil.example.com:1' }
+  const result = validateOpenDesignWebIdentity(identity, { expectedNamespace: 'hz-default-abc123', expectedPid: 1 })
+
+  assert.equal(result.ok, false)
+  assert.match(result.reason ?? '', /loopback/i)
+})
diff --git a/apps/desktop/electron/open-design/identity.ts b/apps/desktop/electron/open-design/identity.ts
new file mode 100644
index 0000000000..b77268873b
--- /dev/null
+++ b/apps/desktop/electron/open-design/identity.ts
@@ -0,0 +1,134 @@
+/**
+ * identity.ts — validates Open Design's on-disk `web-root.json` identity
+ * file (see apps/packaged/src/identity.ts + paths.ts in the Open Design
+ * source), which is the no-IPC readiness/discovery mechanism: the web
+ * sidecar's own HTTP origin, written once after startup.
+ *
+ * Pure/testable: no fs access here. Callers read the file and pass the
+ * parsed (or raw) value in.
+ */
+
+export interface OpenDesignWebIdentity {
+  version: 1
+  namespace: string
+  pid: number
+  url: string
+  startedAt?: number
+}
+
+function isPositiveInt(value: unknown): value is number {
+  return Number.isInteger(value) && (value as number) > 0
+}
+
+function isNonEmptyString(value: unknown): value is string {
+  return typeof value === 'string' && value.length > 0
+}
+
+/**
+ * Structural validation only — does not check loopback-ness or matching
+ * namespace/pid. Returns null for anything malformed rather than throwing,
+ * since a partially-written identity file (mid-heartbeat-write) is an
+ * expected transient state while polling.
+ */
+export function parseOpenDesignWebIdentity(raw: unknown): OpenDesignWebIdentity | null {
+  if (!raw || typeof raw !== 'object') {
+    return null
+  }
+
+  const candidate = raw as Partial<OpenDesignWebIdentity>
+
+  if (candidate.version !== 1) {
+    return null
+  }
+
+  if (!isNonEmptyString(candidate.namespace)) {
+    return null
+  }
+
+  if (!isPositiveInt(candidate.pid)) {
+    return null
+  }
+
+  if (!isNonEmptyString(candidate.url)) {
+    return null
+  }
+
+  const identity: OpenDesignWebIdentity = {
+    version: 1,
+    namespace: candidate.namespace,
+    pid: candidate.pid,
+    url: candidate.url
+  }
+
+  if (Number.isFinite(candidate.startedAt)) {
+    identity.startedAt = candidate.startedAt
+  }
+
+  return identity
+}
+
+const LOOPBACK_HOSTNAMES = new Set(['127.0.0.1', 'localhost', '[::1]', '::1'])
+
+/**
+ * True only for an `http:` URL whose hostname is an exact loopback literal
+ * and whose port is a well-formed number. Deliberately conservative: no
+ * wildcard suffix match (rejects "127.0.0.1.evil.com"), no https (Open
+ * Design's local sidecar is plain http on loopback; accepting https here
+ * would just as happily accept a same-hostname MITM-able scheme confusion).
+ */
+export function isLoopbackHttpUrl(url: string): boolean {
+  if (!url || typeof url !== 'string') {
+    return false
+  }
+
+  let parsed: URL
+
+  try {
+    parsed = new URL(url)
+  } catch {
+    return false
+  }
+
+  if (parsed.protocol !== 'http:') {
+    return false
+  }
+
+  if (!LOOPBACK_HOSTNAMES.has(parsed.hostname)) {
+    return false
+  }
+
+  if (!parsed.port || !/^\d+$/.test(parsed.port)) {
+    return false
+  }
+
+  return true
+}
+
+export interface ValidateOpenDesignWebIdentityOptions {
+  expectedNamespace: string
+  expectedPid: number
+}
+
+export interface ValidateOpenDesignWebIdentityResult {
+  ok: boolean
+  reason?: string
+}
+
+export function validateOpenDesignWebIdentity(
+  identity: OpenDesignWebIdentity,
+  options: ValidateOpenDesignWebIdentityOptions
+): ValidateOpenDesignWebIdentityResult {
+  if (identity.namespace !== options.expectedNamespace) {
+    return { ok: false, reason: `namespace mismatch: expected ${options.expectedNamespace}, got ${identity.namespace}` }
+  }
+
+  if (identity.pid !== options.expectedPid) {
+    return { ok: false, reason: `pid mismatch: expected ${options.expectedPid}, got ${identity.pid}` }
+  }
+
+  if (!isLoopbackHttpUrl(identity.url)) {
+    return { ok: false, reason: `identity url is not a valid loopback http origin: ${identity.url}` }
+  }
+
+  return { ok: true }
+}
