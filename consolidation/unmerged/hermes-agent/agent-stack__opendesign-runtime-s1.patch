--- /dev/null
+++ b/apps/desktop/electron/open-design/process-tree.ts
@@ -0,0 +1,211 @@
+import { execFile } from 'node:child_process'
+
+export interface OwnedProcessChild {
+  pid?: number
+  exitCode?: number | null
+  signalCode?: string | null
+  kill: (signal?: number | NodeJS.Signals) => boolean | void
+  once: (event: 'exit', listener: (code: number | null, signal: string | null) => void) => unknown
+  off?: (event: 'exit', listener: (code: number | null, signal: string | null) => void) => unknown
+}
+
+export interface OwnedProcessSpawnOptions {
+  detached: boolean
+  windowsHide?: boolean
+}
+
+export interface TerminateOwnedProcessTreeOptions {
+  platform?: NodeJS.Platform
+  gracefulTimeoutMs?: number
+  forceTimeoutMs?: number
+  now?: () => number
+  sleep?: (ms: number) => Promise<void>
+  killProcessGroup?: (pid: number, signal: NodeJS.Signals | 0) => void
+  runTaskkill?: (args: string[]) => Promise<void>
+}
+
+export interface TerminateOwnedProcessTreeResult {
+  forced: boolean
+  parentExited: boolean
+  treeExited: boolean
+}
+
+const DEFAULT_GRACEFUL_TIMEOUT_MS = 5_000
+const DEFAULT_FORCE_TIMEOUT_MS = 5_000
+const EXIT_POLL_MS = 20
+
+export function ownedProcessSpawnOptions(platform: NodeJS.Platform = process.platform): OwnedProcessSpawnOptions {
+  return platform === 'win32'
+    ? { detached: false, windowsHide: true }
+    : { detached: true }
+}
+
+function requireOwnedPid(pid: number | undefined): number {
+  if (!Number.isSafeInteger(pid) || (pid as number) <= 0) {
+    throw new Error(`[open-design process-tree] owned child pid must be a positive integer, got ${String(pid)}`)
+  }
+
+  return pid as number
+}
+
+export function windowsTaskkillArgs(pid: number): string[] {
+  return ['/PID', String(requireOwnedPid(pid)), '/T', '/F']
+}
+
+function defaultTaskkill(args: string[]): Promise<void> {
+  return new Promise((resolve, reject) => {
+    execFile('taskkill', args, { windowsHide: true, shell: false }, error => {
+      if (error) {
+        reject(error)
+      } else {
+        resolve()
+      }
+    })
+  })
+}
+
+function childHasExited(child: OwnedProcessChild): boolean {
+  return child.exitCode !== undefined && child.exitCode !== null
+    || child.signalCode !== undefined && child.signalCode !== null
+}
+
+async function waitUntil(
+  predicate: () => boolean,
+  timeoutMs: number,
+  now: () => number,
+  sleep: (ms: number) => Promise<void>
+): Promise<boolean> {
+  if (predicate()) {
+    return true
+  }
+
+  const deadline = now() + Math.max(0, timeoutMs)
+
+  while (now() < deadline) {
+    await sleep(Math.max(1, Math.min(EXIT_POLL_MS, deadline - now())))
+
+    if (predicate()) {
+      return true
+    }
+  }
+
+  return predicate()
+}
+
+function isMissingProcessError(error: unknown): boolean {
+  return (error as NodeJS.ErrnoException | undefined)?.code === 'ESRCH'
+}
+
+/**
+ * Terminates only a process tree whose direct child was spawned by Hermes.
+ * POSIX children own a detached process group: the direct parent first gets a
+ * graceful SIGTERM so Open Design can relay shutdown, then any residual group
+ * is force-killed by negative pid. Windows uses taskkill /T /F directly while
+ * the owned PID can still identify descendants; Node's Windows SIGTERM would
+ * otherwise invalidate that tree anchor. The promise resolves only after the
+ * owned tree is gone.
+ */
+export async function terminateOwnedProcessTree(
+  child: OwnedProcessChild,
+  options: TerminateOwnedProcessTreeOptions = {}
+): Promise<TerminateOwnedProcessTreeResult> {
+  const pid = requireOwnedPid(child.pid)
+  const platform = options.platform ?? process.platform
+  const gracefulTimeoutMs = options.gracefulTimeoutMs ?? DEFAULT_GRACEFUL_TIMEOUT_MS
+  const forceTimeoutMs = options.forceTimeoutMs ?? DEFAULT_FORCE_TIMEOUT_MS
+  const now = options.now ?? Date.now
+  const sleep = options.sleep ?? ((ms: number) => new Promise<void>(resolve => setTimeout(resolve, ms)))
+  const killProcessGroup = options.killProcessGroup ?? ((groupPid, signal) => process.kill(groupPid, signal))
+  const runTaskkill = options.runTaskkill ?? defaultTaskkill
+  let observedExit = childHasExited(child)
+
+  const onExit = () => {
+    observedExit = true
+  }
+
+  child.once('exit', onExit)
+
+  try {
+    if (platform === 'win32') {
+      if (observedExit || childHasExited(child)) {
+        throw new Error(
+          '[open-design process-tree] Windows child already exited; refusing to target a reusable PID because descendant cleanup cannot be proven'
+        )
+      }
+
+      await runTaskkill(windowsTaskkillArgs(pid))
+
+      const parentExited = await waitUntil(
+        () => observedExit || childHasExited(child),
+        forceTimeoutMs,
+        now,
+        sleep
+      )
+
+      return { forced: true, parentExited, treeExited: parentExited }
+    }
+
+    if (!observedExit) {
+      try {
+        child.kill('SIGTERM')
+      } catch (error) {
+        if (!isMissingProcessError(error)) {
+          throw error
+        }
+
+        observedExit = true
+      }
+    }
+
+    let parentExited = await waitUntil(
+      () => observedExit || childHasExited(child),
+      gracefulTimeoutMs,
+      now,
+      sleep
+    )
+
+    let forced = false
+
+    const groupPid = -pid
+
+    const groupExists = (): boolean => {
+      try {
+        killProcessGroup(groupPid, 0)
+
+        return true
+      } catch (error) {
+        if (isMissingProcessError(error)) {
+          return false
+        }
+
+        throw error
+      }
+    }
+
+    // A graceful parent may exit before a stubborn sidecar. Always inspect and
+    // clean the owned process group; this is the residual-group guarantee.
+    if (!parentExited || groupExists()) {
+      forced = true
+
+      try {
+        killProcessGroup(groupPid, 'SIGKILL')
+      } catch (error) {
+        if (!isMissingProcessError(error)) {
+          throw error
+        }
+      }
+    }
+
+    parentExited = parentExited || await waitUntil(
+      () => observedExit || childHasExited(child),
+      forceTimeoutMs,
+      now,
+      sleep
+    )
+    const treeExited = await waitUntil(() => !groupExists(), forceTimeoutMs, now, sleep)
+
+    return { forced, parentExited, treeExited }
+  } finally {
+    child.off?.('exit', onExit)
+  }
+}
