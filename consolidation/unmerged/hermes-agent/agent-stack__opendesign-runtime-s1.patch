@@ -0,0 +1,395 @@
+/**
+ * windows-guardian-resolver.ts — the concrete, production-shaped default for
+ * `CreateWindowsOwnedRuntimeDepsOptions.resolveValidatedGuardianExePath`
+ * (windows-supervisor-deps.ts). Before this module, that option was
+ * caller-injected only: `native-guardian-manifest.ts`'s
+ * `validateNativeGuardianArtifact()` existed and was unit-tested, but no real
+ * caller anywhere read the manifest off disk, hashed the exe, resolved its
+ * canonical path, parsed its PE header, checked its ACL, or verified its
+ * signature -- a production composition root had nothing real to call.
+ *
+ * Layout matches `package.json`'s `build.win.extraResources` exactly: the
+ * staged guardian and its sibling manifest live at
+ * `<resourcesPath>/native/win32-x64/hermes-open-design-job.exe[.manifest.json]`.
+ *
+ * `createProductionGuardianArtifactResolver()` re-reads and re-validates
+ * every field from disk on EVERY call -- it never caches a prior result. A
+ * path-based `child_process.spawn()` can never fully close the gap between
+ * validating a file and the OS loading it (only a handle-based launch could);
+ * re-validating immediately before each launch, combined with the ACL check
+ * below (which rejects any staging directory an untrusted principal could
+ * write to in the first place), is the defensible mitigation available from
+ * Node on this API surface -- not a claim of a stronger guarantee than that.
+ */
+
+import { execFileSync as nodeExecFileSync } from 'node:child_process'
+import crypto from 'node:crypto'
+import fs from 'node:fs'
+import path from 'node:path'
+
+import {
+  type NativeGuardianManifest,
+  parseNativeGuardianManifest,
+  validateNativeGuardianArtifact
+} from './native-guardian-manifest'
+
+export const GUARDIAN_EXE_FILENAME = 'hermes-open-design-job.exe'
+export const GUARDIAN_MANIFEST_SUFFIX = '.manifest.json'
+
+export interface GuardianArtifactPaths {
+  exePath: string
+  manifestPath: string
+}
+
+/** Pure path derivation -- no fs access. Mirrors package.json's win.extraResources layout exactly. */
+export function resolveGuardianArtifactPaths(guardianDir: string): GuardianArtifactPaths {
+  const exePath = path.join(guardianDir, GUARDIAN_EXE_FILENAME)
+
+  return { exePath, manifestPath: `${exePath}${GUARDIAN_MANIFEST_SUFFIX}` }
+}
+
+function detailFor(error: unknown): string {
+  return error instanceof Error ? error.message : String(error ?? 'unknown error')
+}
+
+// ── PE COFF machine parsing (pure) ──────────────────────────────────────────
+
+const PE_HEADER_PROBE_BYTES = 4096
+const DOS_HEADER_MIN_BYTES = 0x40
+
+/**
+ * Parses the exact on-disk DOS/PE header: `MZ` signature, `e_lfanew` pointer
+ * at 0x3C, the `PE\0\0` signature at that offset, and the 2-byte COFF Machine
+ * field immediately after. Returns the raw machine value found (e.g. 0x8664
+ * for x64) or `null` for anything short, non-PE, or malformed -- comparing
+ * that value against the one required machine type is the caller's job (see
+ * `validateNativeGuardianArtifact`'s own `REQUIRED_GUARDIAN_PE_MACHINE`
+ * check), exactly like the existing `readPeMachine` contract already
+ * declares.
+ */
+export function parsePeMachineFromBuffer(buffer: Buffer): number | null {
+  if (buffer.length < DOS_HEADER_MIN_BYTES) {
+    return null
+  }
+
+  if (buffer[0] !== 0x4d || buffer[1] !== 0x5a) {
+    return null
+  }
+
+  const peHeaderOffset = buffer.readUInt32LE(0x3c)
+
+  if (peHeaderOffset < DOS_HEADER_MIN_BYTES || peHeaderOffset + 6 > buffer.length) {
+    return null
+  }
+
+  if (
+    buffer[peHeaderOffset] !== 0x50
+    || buffer[peHeaderOffset + 1] !== 0x45
+    || buffer[peHeaderOffset + 2] !== 0x00
+    || buffer[peHeaderOffset + 3] !== 0x00
+  ) {
+    return null
+  }
+
+  return buffer.readUInt16LE(peHeaderOffset + 4)
+}
+
+function defaultReadHeaderBytes(filePath: string, length: number): Buffer {
+  const fd = fs.openSync(filePath, 'r')
+
+  try {
+    const buffer = Buffer.alloc(length)
+    const bytesRead = fs.readSync(fd, buffer, 0, length, 0)
+
+    return buffer.subarray(0, bytesRead)
+  } finally {
+    fs.closeSync(fd)
+  }
+}
+
+/** Real fs-backed wrapper: reads only a bounded header prefix, never the whole (possibly large) file. */
+export function readPeMachineFromFile(
+  filePath: string,
+  options: { readHeaderBytes?: (filePath: string, length: number) => Buffer } = {}
+): number | null {
+  const readHeaderBytes = options.readHeaderBytes ?? defaultReadHeaderBytes
+
+  try {
+    return parsePeMachineFromBuffer(readHeaderBytes(filePath, PE_HEADER_PROBE_BYTES))
+  } catch {
+    return null
+  }
+}
+
+// ── Canonical path / regular-file checks (real fs, thin) ───────────────────
+
+/** realpath()-equivalent; a result different from the input means a symlink/junction/reparse-point swap. */
+export function resolveCanonicalFilePath(filePath: string): string {
+  return fs.realpathSync(filePath)
+}
+
+/** lstat (never follows a symlink) so a symlink pointing at an otherwise-valid file is still rejected here. */
+export function isRegularFileStrict(filePath: string): boolean {
+  try {
+    return fs.lstatSync(filePath).isFile()
+  } catch {
+    return false
+  }
+}
+
+export function computeSha256OfFile(filePath: string): string {
+  return crypto.createHash('sha256').update(fs.readFileSync(filePath)).digest('hex')
+}
+
+// ── ACL / secure ownership (Windows-only OS call, pure decision logic) ─────
+
+export interface AclGrant {
+  principal: string
+  /** Raw rights-group text, e.g. "F", "M", "RX", or a comma list like "RX,W". */
+  rightsToken: string
+  deny: boolean
+}
+
+const SUCCESS_SUMMARY_RE = /^(?:successfully processed|failed processing)/i
+
+/**
+ * Parses the documented `icacls <path>` textual listing format: a first line
+ * echoing the exact queried path followed by `PRINCIPAL:(GROUP)(GROUP)...`,
+ * then indented continuation lines in the same shape, terminated by a blank
+ * line and a "Successfully processed..." summary. `queriedPath` is used to
+ * strip the echoed path from the first line without guessing where a
+ * (possibly space-containing) principal name starts. Validated against
+ * representative fixtures in this module's tests; real-host output nuances
+ * beyond the documented format are only provable on a real Windows host.
+ */
+export function parseIcaclsOutput(raw: string, queriedPath: string): AclGrant[] {
+  const grants: AclGrant[] = []
+  const firstLinePrefix = `${queriedPath} `
+
+  for (const rawLine of raw.split(/\r?\n/)) {
+    const line = (rawLine.startsWith(firstLinePrefix) ? rawLine.slice(firstLinePrefix.length) : rawLine).trim()
+
+    if (line.length === 0 || SUCCESS_SUMMARY_RE.test(line)) {
+      continue
+    }
+
+    const separatorIndex = line.indexOf(':(')
+
+    if (separatorIndex < 0) {
+      continue
+    }
+
+    const principal = line.slice(0, separatorIndex).trim()
+    const groups = [...line.slice(separatorIndex + 1).matchAll(/\(([^)]*)\)/g)].map(match => match[1])
+
+    if (principal.length === 0 || groups.length === 0) {
+      continue
+    }
+
+    grants.push({
+      principal,
+      rightsToken: groups[groups.length - 1],
+      deny: groups.includes('DENY')
+    })
+  }
+
+  return grants
+}
+
+const WRITE_CAPABLE_RIGHTS_RE = /\b(?:F|M|W|WD|WDAC|WO)\b/
