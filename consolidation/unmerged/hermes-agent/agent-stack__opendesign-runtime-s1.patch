+test('rejects an embedded CR that is not a trailing frame terminator (a CRLF frame terminator is stripped upstream by the adapter\'s framing layer, never here)', () => {
+  // The adapter (windows-job-guardian.ts) trims exactly one legitimate
+  // trailing \r left by a CRLF frame terminator before ever calling this
+  // parser -- this parser must keep failing closed on any \r it actually
+  // receives, whether trailing (a framing bug upstream) or embedded mid-line
+  // (real corruption), since neither is a canonical single-space-delimited
+  // protocol line.
+  for (const line of [
+    'ODJOB/1 EMPTY graceful\r', // a trailing \r reaching the parser at all is a framing bug
+    'ODJOB/1\rEMPTY graceful', // embedded immediately after the prefix
+    'ODJOB/1 EMPTY\rgraceful', // embedded mid-field
+    'ODJOB/1 EMPTY graceful\r\r' // doubled trailing CR
+  ]) {
+    assert.throws(() => parseGuardianProtocolLine(line), /noncanonical|whitespace/i)
+  }
+})
+
