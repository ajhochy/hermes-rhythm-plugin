new file mode 100644
index 0000000000..cd49fed49e
--- /dev/null
+++ b/apps/desktop/scripts/open-design/stage.mjs
@@ -0,0 +1,319 @@
+#!/usr/bin/env node
+// stage.mjs — checksum-pinned Open Design runtime staging CLI.
+//
+// Resolves the supported platform+arch, downloads the official GitHub
+// release asset pinned in apps/desktop/docs/open-design-integration.contract.json,
+// verifies its SHA-256 before extraction, and stages the packaged Resources
+// tree plus an upstream LICENSE copy and a provenance manifest. Never
+// commits installer bytes to Git — everything lands in an OS cache dir and
+// a gitignored build/ output.
+//
+// Usage:
+//   node scripts/open-design/stage.mjs                 # host platform/arch
+//   node scripts/open-design/stage.mjs darwin arm64     # explicit target
+//
+// Fails closed: a checksum mismatch, an unsupported platform, or a missing
+// extractor (7-Zip on Windows) throws rather than silently degrading.
+
+import crypto from 'node:crypto'
+import { execFile } from 'node:child_process'
+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { promisify } from 'node:util'
+
+import { isMain } from '../utils.mjs'
+
+const here = path.dirname(fileURLToPath(import.meta.url))
+const desktopRoot = path.resolve(here, '..', '..')
+const execFileAsync = promisify(execFile)
+
+const SUPPORTED_KEYS = new Set(['darwin-arm64', 'darwin-x64', 'win32-x64'])
+
+// ─── platform/asset resolution ──────────────────────────────────────
+
+export function detectPlatformArch(platform = process.platform, arch = process.arch) {
+  return { platform, arch, key: `${platform}-${arch}` }
+}
+
+/**
+ * Returns the pinned asset for a supported platform/arch, or null.
+ * Linux and any arch outside the contract's asset map return null —
+ * deterministic "no bundled asset" behavior, never a guess.
+ */
+export function resolveAssetForPlatform(manifest, platform, arch) {
+  const { key } = detectPlatformArch(platform, arch)
+
+  if (!SUPPORTED_KEYS.has(key)) {
+    return null
+  }
+
+  return manifest.assets?.[key] ?? null
+}
+
+function buildReleaseAssetUrl(manifest, asset) {
+  return `https://github.com/${manifest.repository}/releases/download/${manifest.tag}/${asset.name}`
+}
+
+// ─── checksum verification (fail closed) ───────────────────────────
+
+export function computeSha256(filePath) {
+  return new Promise((resolve, reject) => {
+    const hash = crypto.createHash('sha256')
+    const stream = fs.createReadStream(filePath)
+    stream.on('error', reject)
+    stream.on('data', chunk => hash.update(chunk))
+    stream.on('end', () => resolve(hash.digest('hex')))
+  })
+}
+
+export async function verifyChecksumOrThrow(filePath, expectedSha256) {
+  const actual = await computeSha256(filePath)
+
+  if (actual.toLowerCase() !== String(expectedSha256).toLowerCase()) {
+    throw new Error(
+      `[open-design stage] checksum mismatch for ${filePath}: expected ${expectedSha256}, got ${actual}. ` +
+        'Refusing to extract an unverified payload.'
+    )
+  }
+}
+
+// ─── provenance manifest ────────────────────────────────────────────
+
+export function writeProvenanceManifest({ destRoot, manifest, asset, platform, arch, now = Date.now, writeFile = fs.writeFileSync }) {
+  const provenance = {
+    version: manifest.version,
+    tag: manifest.tag,
+    commit: manifest.commit,
+    repository: manifest.repository,
+    license: manifest.license,
+    platform: `${platform}-${arch}`,
+    assetName: asset.name,
+    sha256: asset.sha256,
+    stagedAt: now()
+  }
+
+  writeFile(path.join(destRoot, 'provenance.json'), JSON.stringify(provenance, null, 2))
+}
+
+// ─── macOS extraction: hdiutil attach/copy/detach ──────────────────
+
+function defaultRun(command, args) {
+  return execFileAsync(command, args)
+}
+
+function parseAttachMountPoint(stdout) {
+  const lastLine = String(stdout ?? '')
+    .trim()
+    .split('\n')
+    .filter(Boolean)
+    .pop()
+
+  if (!lastLine) {
+    throw new Error('[open-design stage] could not parse a mount point from hdiutil attach output')
+  }
+
+  const fields = lastLine.trim().split(/\s+/)
+
+  return fields[fields.length - 1]
+}
+
+/**
+ * Mounts a .dmg read-only/without adding it to Finder, copies the packaged
+ * Resources tree via the caller-supplied `copyResources`, and ALWAYS
+ * detaches the mount afterward -- including when `copyResources` throws.
+ * A dangling mounted volume is a real-machine side effect that must never
+ * survive a failed staging run.
+ */
+export async function extractDmg({ dmgPath, destRoot, run = defaultRun, copyResources }) {
+  const attachResult = await run('hdiutil', ['attach', dmgPath, '-nobrowse', '-readonly'])
+  const mountPoint = parseAttachMountPoint(attachResult.stdout)
+
+  try {
+    await copyResources({ mountPoint, destRoot })
+  } finally {
+    await run('hdiutil', ['detach', mountPoint, '-quiet'])
+  }
+}
+
+// ─── Windows extraction: NSIS via 7-Zip ────────────────────────────
+
+/**
+ * Extracts an NSIS installer .exe with 7-Zip. Fails with a clear,
+ * unambiguous error (rather than a cryptic spawn ENOENT) when no 7z
+ * executable can be found.
+ */
+export async function extractNsis({ exePath, destRoot, resolveSevenZip, run = defaultRun }) {
+  const sevenZip = resolveSevenZip()
+
+  if (!sevenZip) {
+    throw new Error(
+      '[open-design stage] extracting the Windows NSIS installer requires 7-Zip (7z), which was not found. ' +
+        'Install 7-Zip (https://www.7-zip.org/) and ensure 7z is on PATH, or set HERMES_OPEN_DESIGN_7Z to its path.'
+    )
+  }
+
+  await run(sevenZip, ['x', exePath, `-o${destRoot}`, '-y'])
+}
+
+export function resolveSevenZipPath({ env = process.env, which } = {}) {
+  if (env.HERMES_OPEN_DESIGN_7Z) {
+    return env.HERMES_OPEN_DESIGN_7Z
+  }
+
+  const candidates = [
+    'C:\\Program Files\\7-Zip\\7z.exe',
+    'C:\\Program Files (x86)\\7-Zip\\7z.exe'
+  ]
+
+  for (const candidate of candidates) {
+    if (fs.existsSync(candidate)) {
+      return candidate
+    }
+  }
+
+  if (typeof which === 'function') {
+    const found = which('7z')
+
+    if (found) {
+      return found
+    }
+  }
+
+  return null
+}
+
+// ─── orchestration ──────────────────────────────────────────────────
+
+const LICENSE_SOURCE_PATH = path.join(here, 'OPEN_DESIGN_LICENSE')
+
+/**
+ * Full staging pipeline: resolve asset -> download -> verify checksum
+ * (fail closed) -> extract -> copy license -> write provenance manifest.
+ *
+ * `download` and `extract` are injected so this is testable without
+ * network or a real .dmg/.exe. Real CLI usage wires them to an actual
+ * fetch and to extractDmg/extractNsis.
+ */
+export async function stageOpenDesignRuntime({
+  manifest,
+  platform,
+  arch,
+  cacheDir,
+  destRoot,
+  download,
+  extract,
+  now = Date.now
+}) {
+  const asset = resolveAssetForPlatform(manifest, platform, arch)
+
+  if (!asset) {
+    throw new Error(
+      `[open-design stage] no bundled Open Design release exists for ${platform}-${arch}. ` +
+        'Supported: darwin-arm64, darwin-x64, win32-x64.'
+    )
+  }
+
+  fs.mkdirSync(cacheDir, { recursive: true })
+  const downloadPath = path.join(cacheDir, asset.name)
+
+  await download({ url: buildReleaseAssetUrl(manifest, asset), destPath: downloadPath, asset })
+
+  // Fail closed: verify before ever touching the extractor. A mismatch
+  // throws here and `extract` is never invoked.
+  await verifyChecksumOrThrow(downloadPath, asset.sha256)
+
+  fs.rmSync(destRoot, { recursive: true, force: true })
+  fs.mkdirSync(destRoot, { recursive: true })
+
+  await extract({ assetPath: downloadPath, destRoot, platform, arch })
+
+  fs.copyFileSync(LICENSE_SOURCE_PATH, path.join(destRoot, 'LICENSE'))
+  writeProvenanceManifest({ destRoot, manifest, asset, platform, arch, now })
+
+  return destRoot
+}
+
+// ─── real CLI wiring (network fetch + real extractors) ─────────────
+
+async function realDownload({ url, destPath }) {
+  const response = await fetch(url)
+
+  if (!response.ok || !response.body) {
+    throw new Error(`[open-design stage] failed to download ${url}: HTTP ${response.status}`)
+  }
+
+  const buffer = Buffer.from(await response.arrayBuffer())
+  fs.writeFileSync(destPath, buffer)
+}
+
+async function realExtract({ assetPath, destRoot, platform }) {
+  if (platform === 'darwin') {
+    await extractDmg({
+      dmgPath: assetPath,
+      destRoot,
+      copyResources: async ({ mountPoint }) => {
+        const appBundle = fs
+          .readdirSync(mountPoint)
+          .find(entry => entry.endsWith('.app'))
+
+        if (!appBundle) {
+          throw new Error(`[open-design stage] no .app bundle found in mounted volume ${mountPoint}`)
+        }
+
+        const resourcesSrc = path.join(mountPoint, appBundle, 'Contents', 'Resources')
+        fs.cpSync(resourcesSrc, path.join(destRoot, 'Resources'), { recursive: true })
+      }
+    })
+
+    return
+  }
+
+  if (platform === 'win32') {
+    await extractNsis({ exePath: assetPath, destRoot, resolveSevenZip: () => resolveSevenZipPath() })
+
+    return
+  }
+
+  throw new Error(`[open-design stage] no extractor implemented for platform ${platform}`)
+}
+
+function defaultCacheDir() {
+  return path.join(os.homedir(), '.cache', 'hermes-desktop', 'open-design')
+}
+
+function defaultDestRoot(platform, arch) {
+  return path.join(desktopRoot, 'build', 'open-design-runtime', `${platform}-${arch}`)
+}
+
+export function loadContractManifest(contractPath = path.join(desktopRoot, 'docs', 'open-design-integration.contract.json')) {
+  const contract = JSON.parse(fs.readFileSync(contractPath, 'utf8'))
+  const tagMatch = /^open-design-v(\d+\.\d+\.\d+)$/.exec(contract.openDesign.tag)
+
+  return {
+    version: tagMatch ? tagMatch[1] : contract.openDesign.tag,
+    tag: contract.openDesign.tag,
+    commit: contract.openDesign.commit,
+    repository: contract.openDesign.repository,
+    license: contract.openDesign.license,
+    assets: contract.openDesign.assets
+  }
+}
+
+if (isMain(import.meta.url)) {
+  const [platformArg, archArg] = process.argv.slice(2)
+  const { platform, arch } = detectPlatformArch(platformArg, archArg)
+  const manifest = loadContractManifest()
+  const cacheDir = path.join(defaultCacheDir(), manifest.version, `${platform}-${arch}`)
+  const destRoot = defaultDestRoot(platform, arch)
+
+  stageOpenDesignRuntime({ manifest, platform, arch, cacheDir, destRoot, download: realDownload, extract: realExtract })
+    .then(root => {
+      console.log(`[open-design stage] staged Open Design ${manifest.version} (${platform}-${arch}) -> ${root}`)
+    })
+    .catch(error => {
+      console.error(error.message || error)
+      process.exitCode = 1
+    })
+}
diff --git a/apps/desktop/scripts/open-design/stage.test.mjs b/apps/desktop/scripts/open-design/stage.test.mjs
new file mode 100644
index 0000000000..de0ab949b4
--- /dev/null
+++ b/apps/desktop/scripts/open-design/stage.test.mjs
@@ -0,0 +1,291 @@
+import assert from 'node:assert/strict'
+import crypto from 'node:crypto'
+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+
+import { test } from 'vitest'
+
+import {
+  computeSha256,
+  detectPlatformArch,
+  extractDmg,
+  extractNsis,
+  resolveAssetForPlatform,
+  stageOpenDesignRuntime,
+  verifyChecksumOrThrow,
+  writeProvenanceManifest
+} from './stage.mjs'
+
+const MANIFEST = {
+  version: '0.20.0',
+  tag: 'open-design-v0.20.0',
+  commit: 'fa3cb4cdf3d1703e984a5655bd9654f8d44c493b',
+  repository: 'nexu-io/open-design',
+  license: 'Apache-2.0',
+  assets: {
+    'darwin-arm64': { name: 'open-design-0.20.0-mac-arm64.dmg', sha256: 'a'.repeat(64) },
+    'darwin-x64': { name: 'open-design-0.20.0-mac-x64.dmg', sha256: 'b'.repeat(64) },
+    'win32-x64': { name: 'open-design-0.20.0-win-x64-setup.exe', sha256: 'c'.repeat(64) }
+  }
+}
+
+function tmpdir() {
+  return fs.mkdtempSync(path.join(os.tmpdir(), 'hermes-od-stage-'))
+}
+
+// ─── platform/arch resolution ──────────────────────────────────────
+
+test('detectPlatformArch recognizes every contract-supported platform', () => {
+  assert.deepEqual(detectPlatformArch('darwin', 'arm64'), { platform: 'darwin', arch: 'arm64', key: 'darwin-arm64' })
+  assert.deepEqual(detectPlatformArch('darwin', 'x64'), { platform: 'darwin', arch: 'x64', key: 'darwin-x64' })
+  assert.deepEqual(detectPlatformArch('win32', 'x64'), { platform: 'win32', arch: 'x64', key: 'win32-x64' })
+})
+
+test('resolveAssetForPlatform returns the pinned asset for a supported platform', () => {
+  const asset = resolveAssetForPlatform(MANIFEST, 'darwin', 'arm64')
+  assert.deepEqual(asset, MANIFEST.assets['darwin-arm64'])
+})
+
+test('resolveAssetForPlatform returns null (no bundled asset) for linux, deterministically', () => {
+  assert.equal(resolveAssetForPlatform(MANIFEST, 'linux', 'x64'), null)
+  assert.equal(resolveAssetForPlatform(MANIFEST, 'linux', 'arm64'), null)
+})
+
+test('resolveAssetForPlatform returns null for an unpinned arch on a supported platform', () => {
+  assert.equal(resolveAssetForPlatform(MANIFEST, 'darwin', 'ia32'), null)
+  assert.equal(resolveAssetForPlatform(MANIFEST, 'win32', 'arm64'), null)
+})
+
+// ─── checksum verification (fail closed) ───────────────────────────
+
+test('computeSha256 matches Node crypto for a real file', async () => {
+  const dir = tmpdir()
+  try {
+    const file = path.join(dir, 'payload.bin')
+    const contents = Buffer.from('open design payload bytes')
+    fs.writeFileSync(file, contents)
+
+    const expected = crypto.createHash('sha256').update(contents).digest('hex')
+    const actual = await computeSha256(file)
+
+    assert.equal(actual, expected)
+  } finally {
+    fs.rmSync(dir, { recursive: true, force: true })
+  }
+})
+
+test('verifyChecksumOrThrow passes for a matching checksum', async () => {
+  const dir = tmpdir()
+  try {
+    const file = path.join(dir, 'payload.bin')
+    const contents = Buffer.from('good payload')
+    fs.writeFileSync(file, contents)
+    const sha256 = crypto.createHash('sha256').update(contents).digest('hex')
+
+    await assert.doesNotReject(verifyChecksumOrThrow(file, sha256))
+  } finally {
+    fs.rmSync(dir, { recursive: true, force: true })
+  }
+})
+
+test('verifyChecksumOrThrow throws (fail closed) on a checksum mismatch — the mutation test', async () => {
+  const dir = tmpdir()
+  try {
+    const file = path.join(dir, 'payload.bin')
+    fs.writeFileSync(file, Buffer.from('good payload'))
+    // Mutate a single byte after computing the expected checksum for the
+    // original bytes: the classic "download was tampered/corrupted" case.
+    const expectedForOriginal = crypto.createHash('sha256').update('good payload').digest('hex')
+    fs.writeFileSync(file, Buffer.from('gpod payload'))
+
+    await assert.rejects(verifyChecksumOrThrow(file, expectedForOriginal), /checksum mismatch/i)
+  } finally {
+    fs.rmSync(dir, { recursive: true, force: true })
+  }
+})
+
+// ─── provenance manifest ────────────────────────────────────────────
+
+test('writeProvenanceManifest records tag, commit, version, platform, and asset checksum', () => {
+  const dir = tmpdir()
+  try {
+    const writes = []
+    writeProvenanceManifest({
+      destRoot: dir,
+      manifest: MANIFEST,
+      asset: MANIFEST.assets['darwin-arm64'],
+      platform: 'darwin',
+      arch: 'arm64',
+      now: () => 1_700_000_000_000,
+      writeFile: (file, contents) => writes.push({ file, contents })
+    })
+
+    assert.equal(writes.length, 1)
+    const provenance = JSON.parse(writes[0].contents)
+    assert.equal(provenance.version, '0.20.0')
+    assert.equal(provenance.tag, 'open-design-v0.20.0')
+    assert.equal(provenance.commit, MANIFEST.commit)
+    assert.equal(provenance.platform, 'darwin-arm64')
+    assert.equal(provenance.sha256, MANIFEST.assets['darwin-arm64'].sha256)
+    assert.equal(provenance.stagedAt, 1_700_000_000_000)
+  } finally {
+    fs.rmSync(dir, { recursive: true, force: true })
+  }
+})
+
+// ─── macOS extraction: safe hdiutil use, always detach ─────────────
+
+test('extractDmg mounts, copies the Resources tree, and always detaches — even when the copy step throws', async () => {
+  const calls = []
+  const run = async (command, args) => {
+    calls.push({ command, args })
+    if (command === 'hdiutil' && args[0] === 'attach') {
+      return { stdout: '/Volumes/OpenDesignFixture\n' }
+    }
+    return { stdout: '' }
+  }
+  const copyResources = async () => {
+    throw new Error('boom: copy failed')
+  }
+
+  await assert.rejects(
+    extractDmg({ dmgPath: '/tmp/fake.dmg', destRoot: '/tmp/dest', run, copyResources }),
+    /boom: copy failed/
+  )
+
+  const detachCall = calls.find(c => c.command === 'hdiutil' && c.args[0] === 'detach')
+  assert.ok(detachCall, 'hdiutil detach must run even after a failure')
+  assert.deepEqual(detachCall.args, ['detach', '/Volumes/OpenDesignFixture', '-quiet'])
+})
+
+test('extractDmg detaches the exact mount point it attached, then copies Resources on success', async () => {
+  const calls = []
+  const run = async (command, args) => {
+    calls.push({ command, args })
+    if (command === 'hdiutil' && args[0] === 'attach') {
+      return { stdout: '/Volumes/OpenDesignFixture2\n' }
+    }
+    return { stdout: '' }
+  }
+  let copiedFrom = null
+  const copyResources = async ({ mountPoint, destRoot }) => {
+    copiedFrom = mountPoint
+    assert.equal(destRoot, '/tmp/dest')
+  }
+
+  await extractDmg({ dmgPath: '/tmp/fake.dmg', destRoot: '/tmp/dest', run, copyResources })
+
+  assert.equal(copiedFrom, '/Volumes/OpenDesignFixture2')
+  const attachCall = calls.find(c => c.command === 'hdiutil' && c.args[0] === 'attach')
+  assert.ok(attachCall.args.includes('-nobrowse'))
+  assert.ok(attachCall.args.includes('-readonly'))
+})
+
+// ─── Windows extraction: NSIS via 7z, clear failure when unavailable ─
+
+test('extractNsis fails with a clear "unsupported extractor" error when 7z is unavailable', async () => {
+  await assert.rejects(
+    extractNsis({ exePath: '/tmp/fake-setup.exe', destRoot: '/tmp/dest', resolveSevenZip: () => null, run: async () => ({}) }),
+    /7-?zip/i
+  )
+})
+
+test('extractNsis invokes 7z when available', async () => {
+  const calls = []
+  const run = async (command, args) => {
+    calls.push({ command, args })
+    return { stdout: '' }
+  }
+
+  await extractNsis({
+    exePath: '/tmp/fake-setup.exe',
