+import assert from 'node:assert/strict'
+
+import { test } from 'vitest'
+
+import { requireHermesAgentCatalog } from './live-smoke.mjs'
+
+const DETECTOR_BUDGET_MS = 15_000
+const MEASURED_DETECTOR_LATENCY_MS = 12_312
+const OVERALL_CATALOG_DEADLINE_MS = 45_000
+
+test('keeps one /api/agents request alive beyond 10 seconds for the pinned ACP detector, below the overall deadline', async () => {
+  let nowMs = 0
+  const requestTimeouts = []
+
+  const summary = await requireHermesAgentCatalog('http://127.0.0.1:8787', '/opt/hermes', {
+    now: () => nowMs,
+    sleep: async delayMs => { nowMs += delayMs },
+    fetchJson: async (url, timeoutMs) => {
+      assert.equal(url, 'http://127.0.0.1:8787/api/agents')
+      requestTimeouts.push(timeoutMs)
+
+      if (timeoutMs < MEASURED_DETECTOR_LATENCY_MS) {
+        nowMs += timeoutMs
+        const error = new Error('request aborted before detector finished')
+        error.name = 'AbortError'
+        throw error
+      }
+
+      nowMs += MEASURED_DETECTOR_LATENCY_MS
+      return {
+        agents: [{
+          id: 'hermes',
+          available: true,
+          path: '/opt/hermes',
+          models: ['model-a'],
+          modelsSource: 'live'
+        }]
+      }
+    },
+    log: () => undefined,
+    platform: 'darwin'
+  })
+
+  assert.equal(summary.modelCount, 1)
+  assert.equal(requestTimeouts.length, 1)
+  assert.ok(requestTimeouts[0] >= DETECTOR_BUDGET_MS)
+  assert.ok(requestTimeouts[0] > 10_000)
+  assert.ok(requestTimeouts[0] < OVERALL_CATALOG_DEADLINE_MS)
+})
