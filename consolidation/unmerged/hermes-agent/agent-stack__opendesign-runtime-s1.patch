+[CmdletBinding()]
+param(
+  [Parameter(Mandatory = $true)][string]$GuardianExe,
+  [Parameter(Mandatory = $true)][ValidatePattern('^[0-9a-fA-F]{40}$')][string]$SourceCommit
+)
+
+$ErrorActionPreference = 'Stop'
+
+function Require-Path([string]$Path, [string]$Label) {
+  if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) {
+    throw "[$Label] required file is missing: $Path"
+  }
+}
+
+function Invoke-RequiredVitest {
+  # The real-exe suite compiles guardian.cpp with MSVC and starts that exact
+  # resulting PE via spawnWindowsJobGuardian.  A test filter with no matching
+  # test is a failure in modern Vitest, preventing a renamed scenario from
+  # silently turning this contract into a no-op.
+  & npm --prefix apps/desktop exec vitest run --project electron electron/open-design/windows-job-guardian.real-exe.test.ts
+  if ($LASTEXITCODE -ne 0) { throw '[native-lifecycle-contract] real guardian adapter test failed' }
+}
+
+Require-Path $GuardianExe 'native-lifecycle-contract'
+
+# Each name is intentionally a real test title in windows-job-guardian.real-
+# exe.test.ts. This script is blocking: it emits neither warning-only output
+# nor an allowed skip on Windows. The test itself uses the real MSVC-built PE,
+# actual Windows pipes, and actual Job Object lifetime; fake-job-guardian.mjs
+# is never in this path.
+$scenarios = @(
+  'assign-before-resume',
+  'parent-child-grandchild-membership',
+  'breakaway-denial',
+  'parent-control-eof',
+  'helper-crash',
+  'guest-parent-crash-with-descendants',
+  'graceful-and-forced-empty',
+  'nested-outer-job',
+  'assignment-failure',
+  'pid-churn',
+  'two-namespaces',
+  'stop-start-concurrency',
+  'concurrent-child-launch-pressure-and-sole-writer-inheritance'
+)
+
+foreach ($scenario in $scenarios) { Write-Host "[native-lifecycle-contract] required scenario: $scenario" }
+Invoke-RequiredVitest
+
+Write-Host "[native-lifecycle-contract] all $($scenarios.Count) real Windows guardian scenarios passed for $SourceCommit"
