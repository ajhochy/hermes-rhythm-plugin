+import assert from 'node:assert/strict'
+import crypto from 'node:crypto'
+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+
+import { test } from 'vitest'
+
+import { buildWindowsJobGuardian, computeSha256, requireGitCommitFormat } from './build-windows-job-guardian.mjs'
+
+const GOOD_COMMIT = 'fa3cb4cdf3d1703e984a5655bd9654f8d44c493b'
+
+test('requireGitCommitFormat accepts a 40-char hex sha and lowercases it', () => {
+  assert.equal(requireGitCommitFormat(GOOD_COMMIT.toUpperCase()), GOOD_COMMIT)
+})
+
+test('requireGitCommitFormat rejects malformed commits', () => {
+  for (const bad of [undefined, '', 'not-a-sha', GOOD_COMMIT.slice(0, 39), `${GOOD_COMMIT}f`]) {
+    assert.throws(() => requireGitCommitFormat(bad), /commit/i)
+  }
+})
+
+test('computeSha256 matches real Node crypto for a fixture file', () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'hermes-od-guardian-build-'))
+
+  try {
+    const filePath = path.join(dir, 'fixture.bin')
+    const contents = Buffer.from('fixture guardian binary contents')
+    fs.writeFileSync(filePath, contents)
+
+    assert.equal(computeSha256(filePath), crypto.createHash('sha256').update(contents).digest('hex'))
+  } finally {
+    fs.rmSync(dir, { recursive: true, force: true })
+  }
+})
+
+test('buildWindowsJobGuardian fails closed on any non-win32 host -- cross-compiling the guardian is unsupported', async () => {
+  for (const platform of ['darwin', 'linux']) {
+    await assert.rejects(
+      buildWindowsJobGuardian({ sourceCommit: GOOD_COMMIT, platform, run: async () => {
+        throw new Error('must never invoke the compiler on a non-Windows host')
+      } }),
+      /win32|windows/i
+    )
+  }
+})
+
+test('buildWindowsJobGuardian rejects a malformed source commit before ever invoking the compiler', async () => {
+  let runCalled = false
+
+  await assert.rejects(
+    buildWindowsJobGuardian({
+      sourceCommit: 'not-a-sha',
+      platform: 'win32',
+      run: async () => {
+        runCalled = true
+      }
+    }),
+    /commit/i
+  )
+
+  assert.equal(runCalled, false)
+})
+
+test('buildWindowsJobGuardian invokes rc.exe then cl.exe with hardening flags, embeds the source commit, and writes a manifest matching the real compiled output checksum', async () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'hermes-od-guardian-build-'))
+
+  try {
+    const outputPath = path.join(dir, 'hermes-open-design-job.exe')
+    const calls = []
+    const compiledContents = Buffer.from('fake compiled PE binary')
+
+    const result = await buildWindowsJobGuardian({
+      sourceCommit: GOOD_COMMIT,
+      platform: 'win32',
+      outputPath,
+      run: async (command, args) => {
+        calls.push({ command, args })
+
+        if (command === 'cl.exe') {
+          fs.writeFileSync(outputPath, compiledContents)
+        }
+      }
+    })
+
+    const clCall = calls.find(call => call.command === 'cl.exe')
+    assert.ok(clCall, 'must invoke cl.exe')
+    assert.ok(clCall.args.includes('/W4'))
+    assert.ok(clCall.args.includes('/WX'))
+    assert.ok(clCall.args.includes('/MT'))
+    assert.ok(clCall.args.includes('/guard:cf'))
+    assert.ok(!clCall.args.includes('/CLR'), 'must never build a CLR-dependent binary')
+    assert.ok(clCall.args.some(arg => arg.includes(GOOD_COMMIT)), 'must embed the exact source commit')
+
+    const rcCall = calls.find(call => call.command === 'rc.exe')
+    assert.ok(rcCall, 'must invoke rc.exe to embed PE VERSIONINFO metadata')
+
+    assert.equal(result.outputPath, outputPath)
+    assert.equal(result.manifest.protocolVersion, 1)
+    assert.equal(result.manifest.sourceCommit, GOOD_COMMIT)
+    assert.equal(result.manifest.target, 'win32-x64')
+    assert.equal(result.manifest.sha256, crypto.createHash('sha256').update(compiledContents).digest('hex'))
+
+    const writtenManifest = JSON.parse(fs.readFileSync(result.manifestPath, 'utf8'))
+    assert.deepEqual(writtenManifest, result.manifest)
+  } finally {
+    fs.rmSync(dir, { recursive: true, force: true })
+  }
+})
