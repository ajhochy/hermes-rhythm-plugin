+import assert from 'node:assert/strict'
+
+import { test } from 'vitest'
+
+import { parseAgentCatalogResponse, validateHermesAgentEntry } from './agent-catalog'
+
+test('parseAgentCatalogResponse requires the exact {agents: AgentInfo[]} shape', () => {
+  const parsed = parseAgentCatalogResponse({ agents: [{ id: 'hermes' }] })
+  assert.deepEqual(parsed, { agents: [{ id: 'hermes' }] })
+
+  for (const bad of [null, {}, { agents: 'nope' }, { agents: null }, []]) {
+    assert.throws(() => parseAgentCatalogResponse(bad), /agents/i)
+  }
+})
+
+function hermesAgent(overrides: Partial<any> = {}) {
+  return {
+    id: 'hermes',
+    available: true,
+    path: '/Users/me/.local/bin/hermes',
+    models: ['claude-sonnet-5', 'claude-opus-5'],
+    modelsSource: 'live',
+    version: '1.2.3',
+    authStatus: 'ok',
+    ...overrides
+  }
+}
+
+test('validateHermesAgentEntry accepts a fully valid hermes entry and returns only safe aggregate facts', () => {
+  const summary = validateHermesAgentEntry({ agents: [hermesAgent()] }, {
+    expectedPath: '/Users/me/.local/bin/hermes',
+    platform: 'darwin'
+  })
+
+  assert.deepEqual(summary, {
+    id: 'hermes',
+    available: true,
+    pathMatches: true,
+    modelCount: 2,
+    modelsSource: 'live',
+    version: '1.2.3',
+    authStatus: 'ok'
+  })
+  assert.ok(!('models' in summary), 'must never surface the raw model list')
+  assert.ok(!('path' in summary), 'must never surface the raw path, only a match boolean')
+})
+
+test('throws when no agent with id "hermes" exists', () => {
+  assert.throws(
+    () => validateHermesAgentEntry({ agents: [{ id: 'other', available: true }] }, { expectedPath: '/x/hermes' }),
+    /hermes/i
+  )
+})
+
+test('throws when available is not exactly true', () => {
+  for (const available of [false, 'true', 1, undefined]) {
+    assert.throws(
+      () => validateHermesAgentEntry({ agents: [hermesAgent({ available })] }, { expectedPath: '/Users/me/.local/bin/hermes' }),
+      /available/i
+    )
+  }
+})
+
+test('throws when the returned path does not match the supplied validated absolute executable', () => {
+  assert.throws(
+    () => validateHermesAgentEntry({ agents: [hermesAgent({ path: '/some/other/hermes' })] }, {
+      expectedPath: '/Users/me/.local/bin/hermes'
+    }),
+    /path/i
+  )
+})
+
+test('path comparison is case-insensitive on win32 but strict elsewhere', () => {
+  const summary = validateHermesAgentEntry({ agents: [hermesAgent({ path: 'C:\\Users\\Me\\hermes.exe' })] }, {
+    expectedPath: 'c:\\users\\me\\HERMES.EXE',
+    platform: 'win32'
+  })
+
+  assert.equal(summary.pathMatches, true)
+
+  assert.throws(
+    () => validateHermesAgentEntry({ agents: [hermesAgent({ path: '/Users/ME/.local/bin/hermes' })] }, {
+      expectedPath: '/Users/me/.local/bin/hermes',
+      platform: 'darwin'
+    }),
+    /path/i
+  )
+})
+
+test('throws when models is missing or empty', () => {
+  for (const models of [undefined, [], null]) {
+    assert.throws(
+      () => validateHermesAgentEntry({ agents: [hermesAgent({ models })] }, { expectedPath: '/Users/me/.local/bin/hermes' }),
+      /model/i
+    )
+  }
+})
+
+test('throws unless modelsSource is exactly "live"', () => {
+  for (const modelsSource of ['cached', 'fallback', undefined, '']) {
+    assert.throws(
+      () => validateHermesAgentEntry({ agents: [hermesAgent({ modelsSource })] }, { expectedPath: '/Users/me/.local/bin/hermes' }),
+      /modelsSource|live/i
+    )
+  }
+})
diff --git a/apps/desktop/electron/open-design/agent-catalog.ts b/apps/desktop/electron/open-design/agent-catalog.ts
new file mode 100644
index 0000000000..558a71c973
--- /dev/null
+++ b/apps/desktop/electron/open-design/agent-catalog.ts
@@ -0,0 +1,105 @@
+/**
+ * agent-catalog.ts — validates the pinned guest's `/api/agents` response for
+ * OD-05 (Hermes ACP credential reuse). Pure/testable: no fs/network here.
+ *
+ * `HermesAgentSummary` is deliberately the ONLY allowlist boundary the live
+ * smoke (or any future caller) may print or log -- it carries a match
+ * boolean and aggregate counts, never the raw `path`, `models` list, or any
+ * provider/config detail the real agent entry might also carry.
+ */
+
+import path from 'node:path'
+
+export interface AgentInfo {
+  id: string
+  available?: boolean
+  path?: string | null
+  models?: unknown
+  modelsSource?: string
+  version?: string
+  authStatus?: string
+}
+
+export interface AgentCatalogResponse {
+  agents: AgentInfo[]
+}
+
+export function parseAgentCatalogResponse(raw: unknown): AgentCatalogResponse {
+  if (!raw || typeof raw !== 'object' || Array.isArray(raw) || !Array.isArray((raw as { agents?: unknown }).agents)) {
+    throw new Error('[open-design agent-catalog] /api/agents response must be shaped {agents: AgentInfo[]}')
+  }
+
+  return raw as AgentCatalogResponse
+}
+
+export interface ValidateHermesAgentOptions {
+  expectedPath: string
+  platform?: NodeJS.Platform
+}
+
+export interface HermesAgentSummary {
+  id: string
+  available: true
+  pathMatches: boolean
+  modelCount: number
+  modelsSource: string
+  version?: string
+  authStatus?: string
+}
+
+function pathsMatch(pathModule: typeof path.posix | typeof path.win32, left: string, right: string): boolean {
+  const normalizedLeft = pathModule.resolve(left)
+  const normalizedRight = pathModule.resolve(right)
+
+  return pathModule === path.win32
+    ? normalizedLeft.toLowerCase() === normalizedRight.toLowerCase()
+    : normalizedLeft === normalizedRight
+}
+
+/**
+ * Finds the exact `id === "hermes"` entry and requires `available === true`,
+ * a `path` matching the supplied validated absolute executable (under
+ * platform comparison rules), a nonempty `models` list, and
+ * `modelsSource === "live"`. Throws with a safe, non-sensitive message for
+ * every failure; the returned summary never carries the raw path or models.
+ */
+export function validateHermesAgentEntry(
+  catalog: AgentCatalogResponse,
+  options: ValidateHermesAgentOptions
+): HermesAgentSummary {
+  const hermes = catalog.agents.find(agent => agent?.id === 'hermes')
+
+  if (!hermes) {
+    throw new Error('[open-design agent-catalog] no agent with id "hermes" was found in the /api/agents response')
+  }
+
+  if (hermes.available !== true) {
+    throw new Error('[open-design agent-catalog] hermes agent is not available')
+  }
+
+  const platform = options.platform ?? process.platform
+  const pathModule = platform === 'win32' ? path.win32 : path.posix
+  const pathMatches = typeof hermes.path === 'string' && pathsMatch(pathModule, hermes.path, options.expectedPath)
+
+  if (!pathMatches) {
+    throw new Error('[open-design agent-catalog] hermes agent path does not match the supplied validated absolute executable')
+  }
+
+  if (!Array.isArray(hermes.models) || hermes.models.length === 0) {
+    throw new Error('[open-design agent-catalog] hermes agent reports no models')
+  }
+
+  if (hermes.modelsSource !== 'live') {
+    throw new Error(`[open-design agent-catalog] hermes agent modelsSource must be "live", got ${JSON.stringify(hermes.modelsSource)}`)
+  }
+
+  return {
+    id: hermes.id,
+    available: true,
+    pathMatches,
+    modelCount: hermes.models.length,
+    modelsSource: hermes.modelsSource,
+    ...(hermes.version === undefined ? {} : { version: hermes.version }),
+    ...(hermes.authStatus === undefined ? {} : { authStatus: hermes.authStatus })
+  }
+}
