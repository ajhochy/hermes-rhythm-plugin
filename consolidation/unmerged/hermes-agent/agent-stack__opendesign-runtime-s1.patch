+  const config = buildSafePackagedConfig(OFFICIAL_CONFIG_WITH_TELEMETRY, CONTEXT)
+
+  assert.equal(config.appVersion, '0.20.0')
+  assert.equal(config.daemonCliEntryRelative, 'open-design/app/daemon-cli.js')
+  assert.equal(config.daemonSidecarEntryRelative, 'open-design/app/daemon-sidecar.js')
+  assert.equal(config.webSidecarEntryRelative, 'open-design/app/web-sidecar.js')
+  assert.equal(config.nodeCommandRelative, 'open-design/bin/node')
+  assert.equal(config.namespace, 'hz-default-abc123')
+  assert.equal(config.namespaceBaseRoot, CONTEXT.namespaceBaseRoot)
+  assert.equal(config.resourceRoot, OFFICIAL_CONFIG_WITH_TELEMETRY.resourceRoot)
+  assert.equal(config.webStandaloneRoot, OFFICIAL_CONFIG_WITH_TELEMETRY.webStandaloneRoot)
+  assert.equal(config.webOutputMode, 'standalone')
+  assert.equal(config.amrProfile, 'prod')
+})
+
+test('omits PostHog, telemetry relay/host, update metadata, and Vela even though the official config had them', () => {
+  const config = buildSafePackagedConfig(OFFICIAL_CONFIG_WITH_TELEMETRY, CONTEXT)
+  const serialized = JSON.stringify(config)
+
+  for (const forbidden of ['posthogKey', 'posthogHost', 'telemetryRelayUrl', 'updateMetadataUrl', 'velaWebUrl', 'velaWebUrls', 'phc_leak_me_not', 'telemetry.example.com', 'updates.example.com', 'vela.example.com']) {
+    assert.ok(!serialized.includes(forbidden), `must be omitted: ${forbidden}`)
+  }
+})
+
+test('handles an official config missing optional entries without throwing', () => {
+  const config = buildSafePackagedConfig({}, CONTEXT)
+
+  assert.equal(config.appVersion, null)
+  assert.equal(config.daemonCliEntryRelative, null)
+  assert.equal(config.resourceRoot, null)
+  assert.equal(config.webOutputMode, 'standalone')
+  assert.equal(config.amrProfile, 'prod')
+})
+
+test('writeSafePackagedConfigFile writes atomically (tmp + rename) with 0600 permissions', async () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'hermes-od-config-'))
+  try {
+    const destPath = path.join(dir, 'od-packaged-config.json')
+    const config = buildSafePackagedConfig(OFFICIAL_CONFIG_WITH_TELEMETRY, CONTEXT)
+
+    await writeSafePackagedConfigFile(destPath, config)
+
+    assert.ok(fs.existsSync(destPath))
+    const written = JSON.parse(fs.readFileSync(destPath, 'utf8'))
+    assert.equal(written.appVersion, '0.20.0')
+    assert.ok(!('posthogKey' in written))
+
+    const mode = fs.statSync(destPath).mode & 0o777
+    assert.equal(mode, 0o600)
+
+    // No leftover temp file.
+    const entries = fs.readdirSync(dir)
+    assert.deepEqual(entries, ['od-packaged-config.json'])
+  } finally {
+    fs.rmSync(dir, { recursive: true, force: true })
+  }
+})
+
+test('writeSafePackagedConfigFile never leaves a partial file if the write step fails', async () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'hermes-od-config-fail-'))
+  try {
+    const destPath = path.join(dir, 'od-packaged-config.json')
+    const config = buildSafePackagedConfig(OFFICIAL_CONFIG_WITH_TELEMETRY, CONTEXT)
+
+    await assert.rejects(
+      writeSafePackagedConfigFile(destPath, config, {
+        writeFile: () => {
+          throw new Error('disk full')
+        }
+      })
+    )
+
+    assert.deepEqual(fs.readdirSync(dir), [])
+  } finally {
+    fs.rmSync(dir, { recursive: true, force: true })
+  }
+})
