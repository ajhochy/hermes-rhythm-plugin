@@ -0,0 +1,92 @@
+# .github/workflows/desktop-node22-checks.yml
+name: Desktop checks (Node 22)
+
+# apps/desktop's frozen Open Design contract
+# (apps/desktop/docs/open-design-integration.contract.json, criterion OD-13)
+# requires "Focused tests, desktop typecheck, lint, renderer tests, Electron
+# tests, production build... pass under Node 22.22.0 or newer Node 22".
+#
+# js-tests.yml's shared dynamic matrix discovers and runs every workspace's
+# `check:*` scripts under one repo-wide Node version (26) -- that does not
+# satisfy OD-13 for apps/desktop's checks. This dedicated lane runs the exact
+# same discovered check:* scripts for apps/desktop only, under the exact
+# version pinned in the root .nvmrc. js-tests.yml's own workspace-discovery
+# step excludes apps/desktop so these scripts run exactly once, never a
+# second time under the wrong Node version.
+
+on:
+  workflow_call:
+
+jobs:
+  discover:
+    name: List apps/desktop check scripts
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    outputs:
+      checks: ${{ steps.set-matrix.outputs.checks }}
+    steps:
+      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
+      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
+        with:
+          node-version-file: '.nvmrc'
+          cache: npm
+
+      - name: grab npm 12
+        run: |
+          npm --version | grep -q '^12\.' || npm i -g npm@12
+
+      - id: set-matrix
+        working-directory: apps/desktop
+        run: |
+          node -e '
+          const { execSync } = require("child_process");
+          const scripts = JSON.parse(execSync("npm pkg get scripts", { encoding: "utf-8" }));
+          const checks = Object.keys(scripts).filter(s => /^check:.+$/.test(s));
+          if (checks.length === 0) {
+            console.error("::error::apps/desktop has no check:* scripts — refusing to emit a zero-length matrix (would skip every desktop contract gate silently).");
+            process.exit(1);
+          }
+          process.stdout.write("checks=" + JSON.stringify(checks) + "\n");
+          ' >> "$GITHUB_OUTPUT"
+
+  check:
+    name: apps/desktop / ${{ matrix.script }}
+    needs: discover
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    strategy:
+      matrix:
+        script: ${{ fromJson(needs.discover.outputs.checks) }}
+      fail-fast: false # report all failures, not just the first one
+    steps:
+      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
+      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
+        with:
+          node-version-file: '.nvmrc'
+          cache: npm
+
+      - name: grab npm 12
+        run: |
+          npm --version | grep -q '^12\.' || npm i -g npm@12
+
+      # Distinct cache key from js-tests.yml's own Node-26 caches (never
+      # shared): a node_modules tree installed/postinstalled under a
+      # different host Node major must never be reused across the two.
+      - name: Restore node_modules
+        id: node-modules-cache
+        uses: actions/cache@0400d5f644dc74513175e3cd8d07132dd4860809 # v4.2.4
+        with:
+          path: |
+            node_modules
+            apps/*/node_modules
+            ui-tui/node_modules
+            ui-tui/packages/*/node_modules
+            tests-js/node_modules
+            web/node_modules
+          key: node-modules-scripts-${{ runner.os }}-node22-npm12-${{ hashFiles('package-lock.json') }}
+
+      - uses: ./.github/actions/retry
+        if: steps.node-modules-cache.outputs.cache-hit != 'true'
+        with:
+          command: npm ci
+      - run: npm run --prefix apps/desktop ${{ matrix.script }}
