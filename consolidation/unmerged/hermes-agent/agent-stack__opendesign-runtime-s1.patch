+import assert from 'node:assert/strict'
+import { spawn } from 'node:child_process'
+import crypto from 'node:crypto'
+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+import { test } from 'vitest'
+
+import { resolveOpenDesignDesktopIpcEndpoint } from './ipc-endpoint'
+import type { OpenDesignRuntimeCandidate } from './resolver'
+import { resolveGuardianArtifactPaths } from './windows-guardian-resolver'
+import { createWindowsOwnedRuntimeDeps, defaultWindowsReadinessExpectations } from './windows-supervisor-deps'
+
+const FIXTURE_PATH = fileURLToPath(new URL('./fixtures/fake-job-guardian.mjs', import.meta.url))
+const EXPECTED_COMMIT = 'fa3cb4cdf3d1703e984a5655bd9654f8d44c493b'
+/** fake-job-guardian.mjs's own FAKE_GUARDIAN_PID default. */
+const FIXTURE_TARGET_PID = 4321
+
+const CANDIDATE: OpenDesignRuntimeCandidate = {
+  source: 'packaged',
+  version: '0.20.0',
+  appRoot: 'C:\\Open Design',
+  executablePath: 'C:\\Open Design\\Open Design.exe',
+  resourcesRoot: 'C:\\Open Design\\resources',
+  configPath: 'C:\\Open Design\\resources\\config.json',
+  mainCjsPath: 'C:\\Open Design\\resources\\app\\main.cjs',
+  resourceRoot: 'C:\\Open Design\\resources\\open-design',
+  daemonCliPath: 'C:\\Open Design\\resources\\daemon.mjs',
+  daemonSidecarPath: 'C:\\Open Design\\resources\\daemon-sidecar.mjs',
+  webSidecarPath: 'C:\\Open Design\\resources\\web-sidecar.mjs',
+  webStandaloneRoot: 'C:\\Open Design\\resources\\web',
+  packagedNodePath: 'C:\\Open Design\\Open Design.exe',
+  nativeModulePaths: [],
+  namespace: 'hz-default-abc',
+  namespaceBaseRoot: 'C:\\Hermes\\open-design\\namespaces',
+  dataDir: 'C:\\Hermes\\open-design\\namespaces\\hz-default-abc\\data',
+  provenance: {
+    tag: 'open-design-v0.20.0',
+    commit: EXPECTED_COMMIT,
+    platform: 'win32-x64',
+    assetName: 'open-design-0.20.0-win-x64.exe',
+    sha256: '9788a6a7a3ff1c6e31b41756fb1ecd631b54307acfed5937bfe5b1bd0000d9b8'
+  }
+}
+
+function buildFakePe(): Buffer {
+  const peOffset = 0x80
+  const buffer = Buffer.alloc(peOffset + 24 + 32, 0)
+  buffer.write('MZ', 0, 'latin1')
+  buffer.writeUInt32LE(peOffset, 0x3c)
+  buffer.write('PE\0\0', peOffset, 'latin1')
+  buffer.writeUInt16LE(0x8664, peOffset + 4)
+  crypto.randomFillSync(buffer, peOffset + 24, 32)
+
+  return buffer
+}
+
+/** A real staged guardianDir fixture: production resolveValidatedGuardianExePath (built from guardianDir) validates this for real, no injected fake. */
+function makeStagedGuardianDir(overrides: { commit?: string } = {}): { guardianDir: string; exePath: string } {
+  const guardianDir = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), 'hermes-windows-supervisor-deps-')))
+  const { exePath, manifestPath } = resolveGuardianArtifactPaths(guardianDir)
+  const peBytes = buildFakePe()
+
+  fs.writeFileSync(exePath, peBytes)
+  fs.writeFileSync(manifestPath, JSON.stringify({
+    protocolVersion: 1,
+    sourceCommit: overrides.commit ?? EXPECTED_COMMIT,
+    target: 'win32-x64',
+    sha256: crypto.createHash('sha256').update(peBytes).digest('hex')
+  }))
+
+  return { guardianDir, exePath }
+}
+
+function realSpawnGuardian(guardianExePath: string, extraEnv: Record<string, string> = {}) {
+  return (command: string, args: string[]) => spawn(process.execPath, [FIXTURE_PATH, ...args], {
+    env: { ...process.env, FAKE_GUARDIAN_SELF_IMAGE_PATH: guardianExePath, ...extraEnv }
+  })
+}
+
+function baseCreateOptions(guardianDir: string, overrides: Partial<Parameters<typeof createWindowsOwnedRuntimeDeps>[0]> = {}) {
+  return {
+    namespace: CANDIDATE.namespace,
+    expectedSourceCommit: EXPECTED_COMMIT,
+    guardianDir,
+    guardianArtifactResolverOptions: {
+      // The real icacls/signtool OS calls this module would otherwise make
+      // cannot run on this host; every other check (manifest parse,
+      // canonical path, SHA-256, PE machine) still runs for real against
+      // real files -- see windows-guardian-resolver.test.ts for those in
+      // isolation, and the "fails production validation" test below for a
+      // real end-to-end rejection through this exact composition.
+      checkAcl: () => {},
+      verifySignature: () => true,
+      isPackaged: () => false
+    },
+    spawnGuardian: realSpawnGuardian(resolveGuardianArtifactPaths(guardianDir).exePath),
+    readHeadlessIdentity: () => null,
+    fetchHealth: async () => ({ status: 200, body: { ok: true, version: '0.20.0' } }),
+    readinessTimeoutMs: 500,
+    readinessPollMs: 5,
+    gracefulStopTimeoutMs: 300,
+    forceStopTimeoutMs: 1_000,
+    ...overrides
+  } as Parameters<typeof createWindowsOwnedRuntimeDeps>[0]
+}
+
+test('throws a clear configuration error when neither resolveValidatedGuardianExePath nor guardianDir is supplied', () => {
+  assert.throws(
+    () => createWindowsOwnedRuntimeDeps({
+      namespace: CANDIDATE.namespace,
+      expectedSourceCommit: EXPECTED_COMMIT,
+      spawnGuardian: () => { throw new Error('must not spawn') },
+      readHeadlessIdentity: () => null,
+      fetchHealth: async () => ({ status: 200, body: {} })
+    } as any),
+    /resolveValidatedGuardianExePath|guardianDir/
+  )
+})
+
+test('spawn() uses the real production resolver built from guardianDir: it validates and passes the exact staged exe path as the guardian executable, never candidate.executablePath', async () => {
+  const { guardianDir, exePath } = makeStagedGuardianDir()
+  const spawnCalls: { command: string; args: string[] }[] = []
+
+  const deps = createWindowsOwnedRuntimeDeps(baseCreateOptions(guardianDir, {
+    spawnGuardian: (command, args) => {
+      spawnCalls.push({ command, args })
+
+      return realSpawnGuardian(exePath)(command, args)
+    }
+  }))
+
+  const child = await deps.spawn(CANDIDATE.executablePath, ['--headless'], {
+    env: {}, shell: false, detached: false, windowsHide: true
+  })
+
+  assert.equal(spawnCalls.length, 1)
+  assert.equal(spawnCalls[0].command, exePath, 'the guardian executable must be the real resolved+validated path from guardianDir')
+  assert.equal(spawnCalls[0].args[1], CANDIDATE.executablePath, 'candidate.executablePath is forwarded only as the guardian\'s TARGET argument')
+  assert.equal(child.pid, 4321, 'the wrapped child\'s pid must be the guardian-retained TARGET pid, never the guardian\'s own pid')
+  ;(child as any).guardian.dispose()
+})
+
+test('spawn() rejects before ever calling spawnGuardian when the staged artifact fails production validation (wrong source commit)', async () => {
+  const { guardianDir } = makeStagedGuardianDir({ commit: '0'.repeat(40) })
+  let spawnGuardianCalled = false
+
+  const deps = createWindowsOwnedRuntimeDeps(baseCreateOptions(guardianDir, {
+    spawnGuardian: () => {
+      spawnGuardianCalled = true
+      throw new Error('must not be called')
+    }
+  }))
+
+  await assert.rejects(
+    async () => { await deps.spawn(CANDIDATE.executablePath, ['--headless'], { env: {}, shell: false, detached: false, windowsHide: true }) },
+    /ownership_unavailable|commit/
+  )
+  assert.equal(spawnGuardianCalled, false)
+})
+
+test('full real composition: spawn -> waitForReady binds the target identity and records the exact origin -> terminateOwnedTree requires that exact origin, never an empty-string fallback', async () => {
+  const { guardianDir, exePath } = makeStagedGuardianDir()
+  const namespaceRoot = path.win32.join(CANDIDATE.namespaceBaseRoot, CANDIDATE.namespace)
+  const expectedIpc = resolveOpenDesignDesktopIpcEndpoint(CANDIDATE.namespace, { platform: 'win32' })
+  const requestedPayloads: unknown[] = []
+
+  // readHeadlessIdentity is read on every poll, so this may start null and be
+  // filled in once guardian.guardianPid (the real spawned pid) is known --
+  // readHeadlessIdentity itself is fixed at construction time, matching how
+  // the real headless-root.json file would appear on disk sometime after
+  // spawn, not necessarily before the first poll.
+  let identity: unknown = null
+
+  const deps = createWindowsOwnedRuntimeDeps(baseCreateOptions(guardianDir, {
+    spawnGuardian: realSpawnGuardian(exePath),
+    readHeadlessIdentity: () => identity,
+    requestIpc: async ({ endpoint, payload }: any) => {
+      requestedPayloads.push({ endpoint, payload })
+
+      if (payload.type === 'status') {
+        return { pid: FIXTURE_TARGET_PID, state: 'running', windowVisible: false, url: 'http://127.0.0.1:53987' }
+      }
+
+      throw new Error('no real shutdown IPC in this test -- fall through to guardian FORCE')
+    }
+  }))
+
+  const child = await deps.spawn(CANDIDATE.executablePath, ['--headless'], {
+    env: {}, shell: false, detached: false, windowsHide: true
+  })
+
+  const guardian = (child as any).guardian
+  const expectations = defaultWindowsReadinessExpectations(CANDIDATE, guardian)
+  assert.equal(expectations.expectedNamespaceRoot, namespaceRoot)
+  assert.equal(expectations.expectedGuardianHelperPpid, guardian.guardianPid)
+
+  identity = {
+    version: 1,
+    namespaceRoot,
+    pid: guardian.targetPid,
+    ppid: guardian.guardianPid,
+    executablePath: CANDIDATE.executablePath,
+    logPath: expectations.expectedLogPath,
+    startedAt: new Date().toISOString(),
+    updatedAt: new Date().toISOString(),
+    stamp: { app: 'desktop', mode: 'runtime', namespace: CANDIDATE.namespace, source: 'packaged', ipc: expectedIpc }
+  }
+
+  const ready = await deps.waitForReady(CANDIDATE, child, new AbortController().signal)
+  assert.equal(ready.origin, 'http://127.0.0.1:53987', 'the origin bound at readiness comes from the desktop sidecar IPC status response, not the guardian\'s own protocol status')
+  assert.ok(requestedPayloads.some((entry: any) => entry.payload.type === 'status'), 'readiness must query the desktop sidecar over IPC, not merely the guardian protocol')
+
+  const result = await deps.terminateOwnedTree!(child, { gracefulTimeoutMs: 300, forceTimeoutMs: 1_000 })
+  assert.equal(result.treeExited, true)
+
+  const shutdownAttempt = requestedPayloads.find((entry: any) => entry.payload.type === 'shutdown')
+  assert.ok(shutdownAttempt, 'terminateOwnedTree must have attempted graceful shutdown against the exact recorded origin')
+})
+
+test('terminateOwnedTree never requests shutdown (falls straight through to the guardian force path) when waitForReady never recorded an origin for this child', async () => {
+  const { guardianDir, exePath } = makeStagedGuardianDir()
+  let shutdownRequested = false
+
+  const deps = createWindowsOwnedRuntimeDeps(baseCreateOptions(guardianDir, {
+    spawnGuardian: realSpawnGuardian(exePath),
+    requestIpc: async ({ payload }: any) => {
+      if (payload.type === 'shutdown') {shutdownRequested = true}
+
+      // A real sidecar url, but it can never equal the empty-string
+      // "recorded origin" fallback below -- shutdown must still never fire.
+      return payload.type === 'status'
+        ? { pid: FIXTURE_TARGET_PID, state: 'running', windowVisible: false, url: 'http://127.0.0.1:53987' }
+        : { accepted: true }
+    }
+  }))
+
+  const child = await deps.spawn(CANDIDATE.executablePath, ['--headless'], {
+    env: {}, shell: false, detached: false, windowsHide: true
+  })
+
+  const result = await deps.terminateOwnedTree!(child, { gracefulTimeoutMs: 300, forceTimeoutMs: 1_000 })
+
+  assert.equal(result.forced, true)
+  assert.equal(shutdownRequested, false, 'an empty-string recorded origin (waitForReady never ran) can never equal a real sidecar url, so shutdown is never requested')
+})
