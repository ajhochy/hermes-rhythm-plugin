new file mode 100644
index 0000000000..1451738252
--- /dev/null
+++ b/apps/desktop/electron/open-design/packaged-config.ts
@@ -0,0 +1,126 @@
+/**
+ * packaged-config.ts — derives and atomically writes the
+ * `OD_PACKAGED_CONFIG_PATH` JSON file Open Design's packaged config loader
+ * reads (see apps/packaged/src/config.ts `readPackagedConfig` in the Open
+ * Design source).
+ *
+ * The candidate's own official `open-design-config.json` may carry a
+ * PostHog ingest key, a telemetry relay URL, an update-metadata URL, and
+ * Vela workspace-console origins. None of those are Hermes's to forward:
+ * Hermes generates a fresh, minimal config containing only the fields the
+ * headless runtime actually needs to locate its own resources and
+ * namespace, hard-pinned to a no-telemetry, standalone, prod profile.
+ * Written atomically (temp file + rename) at mode 0600 so a half-written
+ * config is never observed and the file is unreadable by other users on
+ * shared machines.
+ */
+
+import { chmod as fsChmod, rename as fsRename, rm as fsRm, writeFile as fsWriteFile } from 'node:fs/promises'
+import path from 'node:path'
+
+export interface OfficialPackagedConfigLike {
+  appVersion?: string | null
+  daemonCliEntryRelative?: string | null
+  daemonSidecarEntryRelative?: string | null
+  webSidecarEntryRelative?: string | null
+  nodeCommandRelative?: string | null
+  resourceRoot?: string | null
+  webStandaloneRoot?: string | null
+  // Deliberately not read by buildSafePackagedConfig, listed here only so
+  // callers that pass the full official config shape typecheck cleanly:
+  posthogKey?: string | null
+  posthogHost?: string | null
+  telemetryRelayUrl?: string | null
+  updateMetadataUrl?: string | null
+  velaWebUrl?: string | null
+  velaWebUrls?: Record<string, string>
+}
+
+export interface SafePackagedConfigContext {
+  namespace: string
+  /** The PARENT of the namespace root (see namespace.ts), never namespace-scoped itself. */
+  namespaceBaseRoot: string
+}
+
+export interface SafePackagedConfig {
+  amrProfile: 'prod'
+  appVersion: string | null
+  daemonCliEntryRelative: string | null
+  daemonSidecarEntryRelative: string | null
+  webSidecarEntryRelative: string | null
+  nodeCommandRelative: string | null
+  namespace: string
+  /** The PARENT of the namespace root (see namespace.ts), never namespace-scoped itself. */
+  namespaceBaseRoot: string
+  resourceRoot: string | null
+  webStandaloneRoot: string | null
+  webOutputMode: 'standalone'
+}
+
+function safeOptionalString(value: string | null | undefined): string | null {
+  return typeof value === 'string' && value.length > 0 ? value : null
+}
+
+/**
+ * Builds the safe config. Only reads the allowlisted fields off `official`
+ * — telemetry/update/Vela fields on the input are never even referenced,
+ * so a future field added to the official shape can't accidentally leak
+ * through by falling into a spread.
+ */
+export function buildSafePackagedConfig(
+  official: OfficialPackagedConfigLike,
+  context: SafePackagedConfigContext
+): SafePackagedConfig {
+  return {
+    amrProfile: 'prod',
+    appVersion: safeOptionalString(official.appVersion),
+    daemonCliEntryRelative: safeOptionalString(official.daemonCliEntryRelative),
+    daemonSidecarEntryRelative: safeOptionalString(official.daemonSidecarEntryRelative),
+    webSidecarEntryRelative: safeOptionalString(official.webSidecarEntryRelative),
+    nodeCommandRelative: safeOptionalString(official.nodeCommandRelative),
+    namespace: context.namespace,
+    namespaceBaseRoot: context.namespaceBaseRoot,
+    resourceRoot: safeOptionalString(official.resourceRoot),
+    webStandaloneRoot: safeOptionalString(official.webStandaloneRoot),
+    webOutputMode: 'standalone'
+  }
+}
+
+export interface WriteSafePackagedConfigDeps {
+  writeFile?: (path: string, contents: string) => Promise<void> | void
+  rename?: (from: string, to: string) => Promise<void> | void
+  chmod?: (path: string, mode: number) => Promise<void> | void
+  rm?: (path: string) => Promise<void> | void
+  tmpSuffix?: string
+}
+
+const CONFIG_MODE = 0o600
+
+/**
+ * Writes `config` to `destPath` atomically: serialize -> write a sibling
+ * `.tmp-<suffix>` file -> chmod 0600 -> rename over destPath. A failure at
+ * any step removes the temp file so no partial artifact is left behind.
+ */
+export async function writeSafePackagedConfigFile(
+  destPath: string,
+  config: SafePackagedConfig,
+  deps: WriteSafePackagedConfigDeps = {}
+): Promise<string> {
+  const writeFile = deps.writeFile ?? ((p: string, c: string) => fsWriteFile(p, c, 'utf8'))
+  const rename = deps.rename ?? ((from: string, to: string) => fsRename(from, to))
+  const chmod = deps.chmod ?? ((p: string, mode: number) => fsChmod(p, mode))
+  const rm = deps.rm ?? ((p: string) => fsRm(p, { force: true }))
+  const suffix = deps.tmpSuffix ?? `${process.pid}-${Math.random().toString(36).slice(2)}`
+  const tmpPath = path.join(path.dirname(destPath), `.${path.basename(destPath)}.tmp-${suffix}`)
+
+  try {
+    await writeFile(tmpPath, JSON.stringify(config, null, 2))
+    await chmod(tmpPath, CONFIG_MODE)
+    await rename(tmpPath, destPath)
+  } catch (error) {
+    await Promise.resolve(rm(tmpPath)).catch(() => undefined)
+    throw error
+  }
+
+  return destPath
+}
