+
+test('the frozen verification-report path contains a machine-readable downstream composition dependency, never a false production-execution claim', () => {
+  const report = JSON.parse(fs.readFileSync(path.join(desktopRoot, 'docs', 'open-design-integration.verification.json'), 'utf8'))
+  assert.equal(report.status, 'pending-downstream-composition')
+  assert.deepEqual(report.downstreamDependencies, [{
