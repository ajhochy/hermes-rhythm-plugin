+    // bypassing the supervisor) -- keep it short so this test's real
+    // graceful-then-forced stop stays fast.
+    deps: { ...baseDeps(genericSpawn), stopTimeoutMs: 500 },
+    windows: {
+      namespace: CANDIDATE.namespace,
+      expectedSourceCommit: CANDIDATE.provenance.commit,
