+  if (!asset) {
+    throw new Error('[open-design live-smoke] no darwin-arm64 asset pinned in the contract')
+  }
+
+  const dmgPath = findCachedDmg(manifest, asset)
+
+  if (!dmgPath) {
+    throw new Error(
