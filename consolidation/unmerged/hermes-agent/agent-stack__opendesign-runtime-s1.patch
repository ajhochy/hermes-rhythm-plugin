+  assert.match(plan.steps.find(step => step.id === 'installed-nsis-smoke').command, /windows-installer-smoke\.ps1.*nsis/i)
+  assert.match(plan.steps.find(step => step.id === 'installed-msi-smoke').command, /windows-installer-smoke\.ps1.*msi/i)
