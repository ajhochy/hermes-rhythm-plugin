+    // process.kill(pid, 0) throws ESRCH-equivalent on Windows for a dead pid.
+    assert.throws(() => process.kill(handle.targetPid, 0))
+  },
+  20_000
+)
+
+test.skipIf(process.platform !== 'win32')(
+  'real compiled guardian: rejects a source-commit mismatch instead of trusting an unverified real binary',
+  async () => {
+    await assert.rejects(
+      spawnWindowsJobGuardian({
+        guardianExePath,
+        targetExecutablePath: process.execPath,
+        targetArgs: IDLE_TARGET_ARGS,
+        expectedSourceCommit: OTHER_COMMIT,
+        platform: 'win32',
+        spawn: realSpawn as any,
+        readyTimeoutMs: 10_000,
+        handshakeCleanupTimeoutMs: 10_000
+      }),
+      /commit|mismatch/i
+    )
+  },
+  20_000
+)
+
+test.skipIf(process.platform !== 'win32')(
+  'real compiled guardian: a missing target executable reports a real ERROR line and never reports READY',
+  async () => {
