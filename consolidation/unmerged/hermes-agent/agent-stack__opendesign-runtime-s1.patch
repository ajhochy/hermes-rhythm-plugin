@@ -0,0 +1,391 @@
+import assert from 'node:assert/strict'
+import crypto from 'node:crypto'
+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+
+import { test } from 'vitest'
+
+import {
+  assertSecureGuardianAcl,
+  createProductionGuardianArtifactResolver,
+  evaluateGuardianAcl,
+  parseIcaclsOutput,
+  parsePeMachineFromBuffer,
+  readPeMachineFromFile,
+  resolveGuardianArtifactPaths,
+  verifyAuthenticodeSignature
+} from './windows-guardian-resolver'
+
+const GOOD_COMMIT = 'fa3cb4cdf3d1703e984a5655bd9654f8d44c493b'
+const OTHER_COMMIT = '0'.repeat(40)
+
+function buildFakePe(machine = 0x8664, tailBytes = 64): Buffer {
+  const peOffset = 0x80
+  const buffer = Buffer.alloc(peOffset + 24 + tailBytes, 0)
+  buffer.write('MZ', 0, 'latin1')
+  buffer.writeUInt32LE(peOffset, 0x3c)
+  buffer.write('PE\0\0', peOffset, 'latin1')
+  buffer.writeUInt16LE(machine, peOffset + 4)
+  crypto.randomFillSync(buffer, peOffset + 24, tailBytes)
+
+  return buffer
+}
+
+function sha256Of(buffer: Buffer): string {
+  return crypto.createHash('sha256').update(buffer).digest('hex')
+}
+
+function makeTempDir(): string {
+  return fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), 'hermes-guardian-resolver-')))
+}
+
+function writeGoodArtifact(guardianDir: string, overrides: { peBytes?: Buffer; commit?: string; target?: string } = {}) {
+  const { exePath, manifestPath } = resolveGuardianArtifactPaths(guardianDir)
+  const peBytes = overrides.peBytes ?? buildFakePe()
+
+  fs.writeFileSync(exePath, peBytes)
+  fs.writeFileSync(manifestPath, JSON.stringify({
+    protocolVersion: 1,
+    sourceCommit: overrides.commit ?? GOOD_COMMIT,
+    target: overrides.target ?? 'win32-x64',
+    sha256: sha256Of(peBytes)
+  }))
+
+  return { exePath, manifestPath, peBytes }
+}
+
+// ── resolveGuardianArtifactPaths ────────────────────────────────────────────
+
+test('resolveGuardianArtifactPaths derives the exact staged exe + sibling manifest layout from package.json extraResources', () => {
+  const { exePath, manifestPath } = resolveGuardianArtifactPaths(path.join('C:\\Hermes', 'resources', 'native', 'win32-x64'))
+
+  assert.equal(exePath, path.join('C:\\Hermes', 'resources', 'native', 'win32-x64', 'hermes-open-design-job.exe'))
+  assert.equal(manifestPath, `${exePath}.manifest.json`)
+})
+
+// ── parsePeMachineFromBuffer / readPeMachineFromFile ────────────────────────
+
+test('parsePeMachineFromBuffer reads the exact COFF machine field of a well-formed PE header', () => {
+  assert.equal(parsePeMachineFromBuffer(buildFakePe(0x8664)), 0x8664)
+  assert.equal(parsePeMachineFromBuffer(buildFakePe(0x014c)), 0x014c, 'returns whatever machine is present -- comparison against the required value is the caller\'s job')
+})
+
+test('parsePeMachineFromBuffer returns null for anything that is not a well-formed PE image', () => {
+  assert.equal(parsePeMachineFromBuffer(Buffer.alloc(0)), null, 'empty buffer')
+  assert.equal(parsePeMachineFromBuffer(Buffer.from('not-an-exe-at-all-just-text')), null, 'no MZ signature')
+  assert.equal(parsePeMachineFromBuffer(Buffer.from([0x4d, 0x5a])), null, 'MZ present but truncated before e_lfanew')
+
+  const badPeSig = buildFakePe()
+  badPeSig.write('XX\0\0', 0x80, 'latin1')
+  assert.equal(parsePeMachineFromBuffer(badPeSig), null, 'MZ present but the PE signature at e_lfanew is wrong')
+
+  const outOfRange = Buffer.alloc(0x40)
+  outOfRange.write('MZ', 0, 'latin1')
+  outOfRange.writeUInt32LE(0xffffff, 0x3c)
+  assert.equal(parsePeMachineFromBuffer(outOfRange), null, 'e_lfanew points past the end of the buffer')
+})
+
+test('readPeMachineFromFile reads the real on-disk header and returns null for a missing file', () => {
+  const dir = makeTempDir()
+  const exePath = path.join(dir, 'guardian.exe')
+  fs.writeFileSync(exePath, buildFakePe(0x8664))
+
+  assert.equal(readPeMachineFromFile(exePath), 0x8664)
+  assert.equal(readPeMachineFromFile(path.join(dir, 'missing.exe')), null)
+})
+
+// ── icacls parsing / ACL decision ───────────────────────────────────────────
+
+test('parseIcaclsOutput parses principal + rights groups, stripping the echoed path from the first line', () => {
+  const queriedPath = 'C:\\Hermes\\resources\\native\\win32-x64\\hermes-open-design-job.exe'
+
+  const raw = [
+    `${queriedPath} NT AUTHORITY\\SYSTEM:(F)`,
+    '                                     BUILTIN\\Administrators:(F)',
+    '                                     BUILTIN\\Users:(RX)',
+    '',
+    'Successfully processed 1 files; Failed processing 0 files'
+  ].join('\r\n')
+
+  assert.deepEqual(parseIcaclsOutput(raw, queriedPath), [
+    { principal: 'NT AUTHORITY\\SYSTEM', rightsToken: 'F', deny: false },
+    { principal: 'BUILTIN\\Administrators', rightsToken: 'F', deny: false },
+    { principal: 'BUILTIN\\Users', rightsToken: 'RX', deny: false }
+  ])
+})
+
+test('parseIcaclsOutput handles inheritance-flag groups and DENY groups', () => {
+  const queriedPath = 'C:\\Hermes\\resources\\native\\win32-x64'
+
+  const raw = [
+    `${queriedPath} BUILTIN\\Administrators:(OI)(CI)(F)`,
+    '                BUILTIN\\Users:(OI)(CI)(DENY)(W)'
+  ].join('\r\n')
+
+  assert.deepEqual(parseIcaclsOutput(raw, queriedPath), [
+    { principal: 'BUILTIN\\Administrators', rightsToken: 'F', deny: false },
+    { principal: 'BUILTIN\\Users', rightsToken: 'W', deny: true }
+  ])
+})
+
+test('evaluateGuardianAcl accepts a listing where only trusted principals hold write-capable rights', () => {
+  const grants = [
+    { principal: 'NT AUTHORITY\\SYSTEM', rightsToken: 'F', deny: false },
+    { principal: 'BUILTIN\\Administrators', rightsToken: 'F', deny: false },
+    { principal: 'BUILTIN\\Users', rightsToken: 'RX', deny: false }
+  ]
+
+  assert.deepEqual(
+    evaluateGuardianAcl(grants, ['NT AUTHORITY\\SYSTEM', 'BUILTIN\\Administrators']),
+    { ok: true }
+  )
+})
+
+test('evaluateGuardianAcl rejects write-capable rights (Full/Modify/Write) held by an untrusted principal', () => {
+  for (const rightsToken of ['F', 'M', 'W', 'RX,W']) {
+    const grants = [{ principal: 'BUILTIN\\Users', rightsToken, deny: false }]
+    const result = evaluateGuardianAcl(grants, ['NT AUTHORITY\\SYSTEM'])
+    assert.equal(result.ok, false, `rightsToken=${rightsToken} must be rejected`)
+    assert.match((result as { reason: string }).reason, /BUILTIN\\Users/)
+  }
+})
+
+test('evaluateGuardianAcl ignores a DENY entry even for an untrusted principal (a deny only narrows access)', () => {
+  const grants = [{ principal: 'BUILTIN\\Users', rightsToken: 'W', deny: true }]
+  assert.deepEqual(evaluateGuardianAcl(grants, ['NT AUTHORITY\\SYSTEM']), { ok: true })
+})
+
+test('evaluateGuardianAcl accepts read-only rights (RX/R) held by an untrusted principal', () => {
+  const grants = [{ principal: 'BUILTIN\\Users', rightsToken: 'RX', deny: false }]
+  assert.deepEqual(evaluateGuardianAcl(grants, ['NT AUTHORITY\\SYSTEM']), { ok: true })
+})
+
+test('assertSecureGuardianAcl is a no-op off win32 and never invokes the OS ACL query', () => {
+  let called = false
+
+  assertSecureGuardianAcl('/whatever/path', {
+    platform: 'darwin',
+    execFileSync: () => {
+      called = true
+
+      return ''
+    }
+  })
+
+  assert.equal(called, false)
+})
+
+test('assertSecureGuardianAcl throws when either the file or its containing directory grants write-capable rights to an untrusted principal', () => {
+  assert.throws(
+    () => assertSecureGuardianAcl('C:\\Hermes\\resources\\native\\win32-x64\\hermes-open-design-job.exe', {
+      platform: 'win32',
+      execFileSync: queriedPath => `${queriedPath} Everyone:(F)\r\n\r\nSuccessfully processed 1 files; Failed processing 0 files`
+    }),
+    /insecure|acl/i
+  )
+})
+
+test('assertSecureGuardianAcl passes when only trusted principals and read/execute-only grants are present', () => {
+  assert.doesNotThrow(() => assertSecureGuardianAcl('C:\\Hermes\\resources\\native\\win32-x64\\hermes-open-design-job.exe', {
+    platform: 'win32',
+    execFileSync: queriedPath => [
+      `${queriedPath} NT AUTHORITY\\SYSTEM:(F)`,
+      '                BUILTIN\\Administrators:(F)',
+      '                BUILTIN\\Users:(RX)',
+      '',
+      'Successfully processed 1 files; Failed processing 0 files'
+    ].join('\r\n')
+  }))
+})
+
+// ── Authenticode ─────────────────────────────────────────────────────────────
+
+test('verifyAuthenticodeSignature is false off win32 and never invokes signtool', () => {
+  let called = false
+
+  const result = verifyAuthenticodeSignature('/whatever/path', {
+    platform: 'darwin',
+    execFileSync: () => {
+      called = true
+
+      return ''
+    }
+  })
+
+  assert.equal(result, false)
+  assert.equal(called, false)
+})
+
+test('verifyAuthenticodeSignature is true only when the injected signtool call succeeds', () => {
+  assert.equal(
+    verifyAuthenticodeSignature('C:\\Hermes\\hermes-open-design-job.exe', { platform: 'win32', execFileSync: () => '' }),
+    true
+  )
+
+  assert.equal(
+    verifyAuthenticodeSignature('C:\\Hermes\\hermes-open-design-job.exe', {
+      platform: 'win32',
+      execFileSync: () => { throw new Error('SignerCert not found') }
+    }),
+    false
+  )
+})
+
