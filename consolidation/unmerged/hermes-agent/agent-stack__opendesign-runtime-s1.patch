+import assert from 'node:assert/strict'
+import { spawn } from 'node:child_process'
+import { fileURLToPath } from 'node:url'
+
+import { test } from 'vitest'
+
+import { spawnWindowsJobGuardian, type SpawnWindowsJobGuardianDeps } from './windows-job-guardian'
+
+const FIXTURE_PATH = fileURLToPath(new URL('./fixtures/fake-job-guardian.mjs', import.meta.url))
+const EXPECTED_COMMIT = 'fa3cb4cdf3d1703e984a5655bd9654f8d44c493b'
+const TARGET_EXECUTABLE_PATH = 'C:\\staged\\Open Design\\Open Design.exe'
+
+function realSpawn(env: Record<string, string> = {}) {
+  return (command: string, args: string[], _options?: unknown) => spawn(process.execPath, [FIXTURE_PATH, ...args], {
+    env: { ...process.env, ...env }
+  })
+}
+
+function baseDeps(overrides: Partial<SpawnWindowsJobGuardianDeps> = {}): SpawnWindowsJobGuardianDeps {
+  return {
+    guardianExePath: 'unused-in-tests',
+    targetExecutablePath: TARGET_EXECUTABLE_PATH,
+    expectedSourceCommit: EXPECTED_COMMIT,
+    platform: 'win32',
+    spawn: realSpawn(),
+    readyTimeoutMs: 2_000,
+    ...overrides
+  }
+}
+
+test('spawns the guardian with [nonce, targetExecutablePath, ...targetArgs] argv, installs an error listener before any other branch/await, and resolves READY target/guardian identity', async () => {
+  const spawnCalls: { command: string; args: string[] }[] = []
+
+  const handle = await spawnWindowsJobGuardian(baseDeps({
+    targetArgs: ['--headless'],
+    spawn: (command, args, options) => {
+      spawnCalls.push({ command, args })
+
+      return realSpawn({ FAKE_GUARDIAN_PID: '5555', FAKE_GUARDIAN_FILETIME: '999888777' })(command, args, options)
+    }
+  }))
+
+  assert.equal(handle.targetPid, 5555)
+  assert.equal(handle.creationFiletime, '999888777')
+  assert.equal(handle.guardianPid, handle.process.pid)
+  assert.equal(spawnCalls.length, 1)
+  assert.equal(spawnCalls[0].command, 'unused-in-tests')
+  assert.equal(spawnCalls[0].args[1], TARGET_EXECUTABLE_PATH, 'the target executable path must be forwarded to the guardian, not spawned with no args')
+  assert.deepEqual(spawnCalls[0].args.slice(2), ['--headless'])
+  assert.match(spawnCalls[0].args[0], /^[0-9a-f]{8,64}$/i, 'a fresh hex nonce must be the first argv entry, never the target path or its args')
+  await handle.requestForce()
+})
+
+test('generates a fresh nonce per launch by default (never a fixed/predictable value)', async () => {
+  const seen = new Set<string>()
+
+  for (let i = 0; i < 3; i += 1) {
+    const spawnCalls: { args: string[] }[] = []
+
+    const handle = await spawnWindowsJobGuardian(baseDeps({
+      spawn: (command, args, options) => {
+        spawnCalls.push({ args })
+
+        return realSpawn()(command, args, options)
+      }
+    }))
+
+    seen.add(spawnCalls[0].args[0])
+    await handle.requestForce()
+  }
+
+  assert.equal(seen.size, 3, 'each launch must use an independent nonce')
+})
+
+test('refuses to spawn on any platform other than win32 (ownership_unavailable)', async () => {
+  await assert.rejects(
+    spawnWindowsJobGuardian(baseDeps({ platform: 'darwin' })),
+    /win32|windows|ownership_unavailable/i
+  )
+})
+
+test('rejects a protocol/source-commit mismatch instead of trusting an unverified guardian binary', async () => {
+  await assert.rejects(
+    spawnWindowsJobGuardian(baseDeps({ spawn: realSpawn({ FAKE_GUARDIAN_COMMIT: '0'.repeat(40) }) })),
+    /commit|mismatch/i
+  )
+})
+
+test('rejects a stale/wrong nonce in the READY handshake', async () => {
+  await assert.rejects(
+    spawnWindowsJobGuardian(baseDeps({ spawn: realSpawn({ FAKE_GUARDIAN_NONCE_OVERRIDE: 'deadbeefdeadbeef' }) })),
+    /nonce/i
+  )
+})
+
+test('rejects a guardian self-reported pid that does not match the exact retained child process', async () => {
+  await assert.rejects(
+    spawnWindowsJobGuardian(baseDeps({ spawn: realSpawn({ FAKE_GUARDIAN_SELF_PID_OVERRIDE: '999999' }) })),
+    /pid/i
+  )
+})
+
+test('rejects when the guardian exits before ever reporting READY (real child_process.spawn, no crash)', async () => {
+  await assert.rejects(
+    spawnWindowsJobGuardian(baseDeps({ spawn: realSpawn({ FAKE_GUARDIAN_CRASH_BEFORE_READY: '1' }) })),
+    /closed|ready/i
+  )
+})
+
+test('rejects a malformed READY line rather than accepting a partially-parsed handshake', async () => {
+  await assert.rejects(
+    spawnWindowsJobGuardian(baseDeps({ spawn: realSpawn({ FAKE_GUARDIAN_MALFORMED_READY: '1' }) })),
+    /malformed|protocol|closed/i
+  )
+})
+
+test('requestStatus() sends the exact bounded STATUS command and resolves the parsed TARGET response', async () => {
+  const handle = await spawnWindowsJobGuardian(baseDeps())
+  const status = await handle.requestStatus()
+
+  assert.deepEqual(status, { state: 'live', pid: 4321, creationFiletime: '133700000000000000' })
+  await handle.requestForce()
+})
+
+test('requestStatus() reports an exited target state', async () => {
+  const handle = await spawnWindowsJobGuardian(baseDeps({
+    spawn: realSpawn({ FAKE_GUARDIAN_TARGET_STATE: 'exited' })
+  }))
+
+  const status = await handle.requestStatus()
+
+  assert.equal(status.state, 'exited')
+  await handle.requestForce()
+})
+
+test('requestForce() sends the exact bounded FORCE command and resolves once EMPTY forced is reported', async () => {
+  const handle = await spawnWindowsJobGuardian(baseDeps())
+  const result = await handle.requestForce()
+
+  assert.equal(result, 'forced')
+})
+
+test('a guardian crash after READY with no client-requested FORCE surfaces ownership_lost exactly once, without crashing the process', async () => {
+  const handle = await spawnWindowsJobGuardian(baseDeps({
+    spawn: realSpawn({ FAKE_GUARDIAN_CRASH_AFTER_READY: '1' })
+  }))
+
+  const losses: string[] = []
+  handle.onOwnershipLost(detail => losses.push(detail))
+
+  await new Promise(resolve => setTimeout(resolve, 200))
+
+  assert.equal(losses.length, 1)
+})
+
+test('an ERROR line immediately followed by EMPTY (the native fail-closed response to a malformed command) still resolves a pending waitForEmpty() and never surfaces ownership_lost', async () => {
+  // guardian.cpp fails closed on a malformed control command by reporting an
+  // ERROR and then forcing cleanup with a proven EMPTY -- exercised here via
+  // the fixture, which mirrors that exact two-line sequence. This is also
+  // the regression case for the original double-stdout-listener bug: two
+  // protocol lines can arrive in the same flush and must both be parsed by
+  // the single state machine, in order, off one shared buffer.
+  const handle = await spawnWindowsJobGuardian(baseDeps())
+
+  const losses: string[] = []
+  handle.onOwnershipLost(detail => losses.push(detail))
+
+  const waiting = handle.waitForEmpty(2_000)
+  handle.process.stdin.write('BOGUS\n')
+
+  const kind = await waiting
+  await new Promise(resolve => setTimeout(resolve, 100))
+
+  assert.equal(kind, 'forced')
+  assert.deepEqual(losses, [])
+})
+
+test('guest stdout/stderr never reaches the trusted protocol channel -- only the guardian process\'s own stdout is parsed', async () => {
+  const handle = await spawnWindowsJobGuardian(baseDeps({
+    spawn: realSpawn({ FAKE_GUARDIAN_GUEST_STDERR_LINE: 'ODJOB/1 EMPTY forced (forged by guest)' })
+  }))
+
+  // The forged line arrived on stderr, not stdout -- it must never be parsed
+  // as a real protocol message. The handle must still be live and respond
+  // normally to a real STATUS request.
+  const status = await handle.requestStatus()
+  assert.equal(status.state, 'live')
+  await handle.requestForce()
+})
+
+test('waitForEmpty() resolves on a spontaneous/unsolicited EMPTY graceful notification (the Job became empty via IPC-driven shutdown, not a FORCE response)', async () => {
+  const handle = await spawnWindowsJobGuardian(baseDeps({
+    spawn: realSpawn({ FAKE_GUARDIAN_SPONTANEOUS_EMPTY_MS: '30' })
+  }))
+
+  const kind = await handle.waitForEmpty(2_000)
+  assert.equal(kind, 'graceful')
+  await handle.requestForce()
+})
+
+test('a spontaneous graceful EMPTY does not itself count as ownership_lost when the guardian keeps running', async () => {
+  const handle = await spawnWindowsJobGuardian(baseDeps({
+    spawn: realSpawn({ FAKE_GUARDIAN_SPONTANEOUS_EMPTY_MS: '30' })
+  }))
+
+  const losses: string[] = []
+  handle.onOwnershipLost(detail => losses.push(detail))
+
+  await handle.waitForEmpty(2_000)
+  await new Promise(resolve => setTimeout(resolve, 100))
+
+  assert.deepEqual(losses, [])
+  await handle.requestForce()
+})
+
+test('parent stdin EOF is treated as the control-token loss signal (handle sees the guardian close)', async () => {
+  const handle = await spawnWindowsJobGuardian(baseDeps())
+  let closed = false
+  handle.process.once('close', () => {
+    closed = true
+  })
+
+  handle.process.stdin.end()
+  await new Promise(resolve => setTimeout(resolve, 200))
+
+  assert.equal(closed, true)
+})
