+import assert from 'node:assert/strict'
+
+import { test } from 'vitest'
+
+import { REQUIRED_OPEN_DESIGN_VERSION, resolveOpenDesignRuntime } from './resolver'
+
+const PACKAGED_PROVENANCE = {
+  version: '0.20.0',
+  tag: 'open-design-v0.20.0',
+  commit: 'fa3cb4cdf3d1703e984a5655bd9654f8d44c493b',
+  platform: 'darwin-arm64'
+}
+
+test('REQUIRED_OPEN_DESIGN_VERSION is pinned to 0.20.0', () => {
+  assert.equal(REQUIRED_OPEN_DESIGN_VERSION, '0.20.0')
+})
+
+test('prefers a valid packaged candidate over an installed one', () => {
+  const result = resolveOpenDesignRuntime({
+    readPackagedProvenance: () => PACKAGED_PROVENANCE,
+    readInstalledCandidate: () => ({ version: '0.20.0', appPath: '/Applications/Open Design.app' })
+  })
+
+  assert.equal(result.candidate?.source, 'packaged')
+  assert.equal(result.candidate?.version, '0.20.0')
+})
+
+test('falls back to a compatible installed runtime when no packaged resources are staged', () => {
+  const result = resolveOpenDesignRuntime({
+    readPackagedProvenance: () => null,
+    readInstalledCandidate: () => ({ version: '0.20.0', appPath: '/Applications/Open Design.app' })
+  })
+
+  assert.equal(result.candidate?.source, 'installed')
+  assert.equal(result.candidate?.version, '0.20.0')
+})
+
+test('refuses a packaged candidate whose staged provenance version does not match exactly', () => {
+  const result = resolveOpenDesignRuntime({
+    readPackagedProvenance: () => ({ ...PACKAGED_PROVENANCE, version: '0.19.9' }),
+    readInstalledCandidate: () => null
+  })
+
+  assert.equal(result.candidate, null)
+  assert.match(result.reason ?? '', /0\.20\.0/)
+})
+
+test('never silently falls back to an incompatible installed version (e.g. 0.18.1)', () => {
+  const result = resolveOpenDesignRuntime({
+    readPackagedProvenance: () => null,
+    readInstalledCandidate: () => ({ version: '0.18.1', appPath: '/Applications/Open Design.app' })
+  })
+
+  assert.equal(result.candidate, null)
+  assert.match(result.reason ?? '', /0\.18\.1/)
+  assert.match(result.reason ?? '', /incompatible/i)
+})
+
+test('returns null with a clear reason when neither packaged nor installed resources exist', () => {
+  const result = resolveOpenDesignRuntime({
+    readPackagedProvenance: () => null,
+    readInstalledCandidate: () => null
+  })
+
+  assert.equal(result.candidate, null)
+  assert.match(result.reason ?? '', /no packaged or compatible open design runtime/i)
+})
+
+test('rejects a packaged provenance missing required fields (fail closed on corrupt manifest)', () => {
+  const result = resolveOpenDesignRuntime({
+    readPackagedProvenance: () => ({ version: '0.20.0' }), // missing tag/commit/platform
+    readInstalledCandidate: () => null
+  })
+
+  assert.equal(result.candidate, null)
+  assert.match(result.reason ?? '', /provenance/i)
+})
diff --git a/apps/desktop/electron/open-design/resolver.ts b/apps/desktop/electron/open-design/resolver.ts
new file mode 100644
index 0000000000..444c681a5a
--- /dev/null
+++ b/apps/desktop/electron/open-design/resolver.ts
@@ -0,0 +1,89 @@
+/**
+ * resolver.ts — pure precedence logic for choosing an Open Design runtime
+ * candidate: packaged staged Resources first, then a compatible installed
+ * Open Design app for development.
+ *
+ * Compatibility policy (documented, not vibes): a candidate is accepted
+ * only when its version matches REQUIRED_OPEN_DESIGN_VERSION *exactly*.
+ * There is no known-compatible range yet for the installed fallback — the
+ * Hermes ACP adapter contract (agentId "hermes", `hermes acp --accept-hooks`)
+ * is pinned against 0.20.0 specifically, and an older install (e.g. 0.18.1)
+ * must never be silently accepted in its place. Widening this to a range
+ * requires an explicit compatibility matrix, not a version-string relax.
+ */
+
+export const REQUIRED_OPEN_DESIGN_VERSION = '0.20.0'
+
+export interface PackagedProvenance {
+  version?: string
+  tag?: string
+  commit?: string
+  platform?: string
+}
+
+export interface InstalledCandidateInfo {
+  version?: string
+  appPath?: string
+  entryPath?: string
+}
+
+export interface ResolveOpenDesignRuntimeDeps {
+  /** Reads the staged packaged provenance manifest, or null if unstaged. */
+  readPackagedProvenance: () => PackagedProvenance | null
+  /** Discovers a compatible installed Open Design app for dev, or null. */
+  readInstalledCandidate: () => InstalledCandidateInfo | null
+}
+
+export interface OpenDesignRuntimeCandidate {
+  source: 'packaged' | 'installed'
+  version: string
+}
+
+export interface ResolveOpenDesignRuntimeResult {
+  candidate: OpenDesignRuntimeCandidate | null
+  reason?: string
+}
+
+function isCompleteProvenance(provenance: PackagedProvenance): boolean {
+  return Boolean(provenance.version && provenance.tag && provenance.commit && provenance.platform)
+}
+
+export function resolveOpenDesignRuntime(deps: ResolveOpenDesignRuntimeDeps): ResolveOpenDesignRuntimeResult {
+  const packaged = deps.readPackagedProvenance()
+
+  if (packaged) {
+    if (!isCompleteProvenance(packaged)) {
+      return {
+        candidate: null,
+        reason: 'staged packaged provenance manifest is incomplete (missing version/tag/commit/platform); refusing an unverified runtime'
+      }
+    }
+
+    if (packaged.version !== REQUIRED_OPEN_DESIGN_VERSION) {
+      return {
+        candidate: null,
+        reason: `staged packaged Open Design runtime is version ${packaged.version}, but ${REQUIRED_OPEN_DESIGN_VERSION} is required`
+      }
+    }
+
+    return { candidate: { source: 'packaged', version: packaged.version } }
+  }
+
+  const installed = deps.readInstalledCandidate()
+
+  if (installed) {
+    if (installed.version !== REQUIRED_OPEN_DESIGN_VERSION) {
+      return {
+        candidate: null,
+        reason: `installed Open Design runtime is version ${installed.version}, which is incompatible (requires exactly ${REQUIRED_OPEN_DESIGN_VERSION})`
+      }
+    }
+
+    return { candidate: { source: 'installed', version: installed.version } }
+  }
+
+  return {
+    candidate: null,
+    reason: `no packaged or compatible open design runtime found (requires exactly ${REQUIRED_OPEN_DESIGN_VERSION})`
+  }
+}
