+  options: ValidateOpenDesignHeadlessIdentityOptions
+): ValidateOpenDesignHeadlessIdentityResult {
+  const pathModule = pathApiFor(options.platform)
+
+  if (!pathsMatch(pathModule, identity.namespaceRoot, options.expectedNamespaceRoot)) {
+    return {
+      ok: false,
+      code: 'namespace_root_mismatch',
+      reason: `namespaceRoot mismatch: expected ${options.expectedNamespaceRoot}, got ${identity.namespaceRoot}`
+    }
+  }
+
+  if (identity.pid !== options.expectedGuardianTargetPid) {
+    return {
+      ok: false,
+      code: 'pid_mismatch',
+      reason: `pid mismatch: expected guardian target pid ${options.expectedGuardianTargetPid}, got ${identity.pid}`
+    }
+  }
+
+  if (identity.ppid !== options.expectedGuardianHelperPpid) {
+    return {
+      ok: false,
+      code: 'ppid_mismatch',
+      reason: `ppid mismatch: expected guardian helper pid ${options.expectedGuardianHelperPpid}, got ${identity.ppid}`
+    }
+  }
+
+  if (!pathsMatch(pathModule, identity.executablePath, options.expectedExecutablePath)) {
+    return {
+      ok: false,
+      code: 'executable_path_mismatch',
+      reason: `executablePath mismatch: expected ${options.expectedExecutablePath}, got ${identity.executablePath}`
+    }
+  }
+
+  if (!pathsMatch(pathModule, identity.logPath, options.expectedLogPath)) {
+    return {
+      ok: false,
+      code: 'log_path_mismatch',
+      reason: `logPath mismatch: expected ${options.expectedLogPath}, got ${identity.logPath}`
+    }
+  }
+
+  if (
+    identity.stamp.namespace !== options.expectedNamespace
+    || identity.stamp.ipc !== options.expectedIpc
+  ) {
+    return {
+      ok: false,
+      code: 'stamp_mismatch',
+      reason: `stamp mismatch: expected namespace ${options.expectedNamespace} / ipc ${options.expectedIpc}, `
+        + `got namespace ${identity.stamp.namespace} / ipc ${identity.stamp.ipc}`
+    }
+  }
+
+  const now = options.now ?? Date.now
+  const maxAgeMs = options.maxAgeMs ?? DEFAULT_HEADLESS_IDENTITY_MAX_AGE_MS
+  const updatedAtMs = Date.parse(identity.updatedAt)
+  const ageMs = now() - updatedAtMs
+
+  if (!Number.isFinite(updatedAtMs) || ageMs < 0 || ageMs > maxAgeMs) {
+    return {
+      ok: false,
+      code: 'stale',
+      reason: `identity heartbeat is stale: updatedAt=${identity.updatedAt}, ageMs=${ageMs}, maxAgeMs=${maxAgeMs}`
+    }
+  }
+
+  return { ok: true }
+}
