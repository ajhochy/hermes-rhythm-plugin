+import assert from 'node:assert/strict'
+import { execFileSync } from 'node:child_process'
+import crypto from 'node:crypto'
+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+
+import { afterAll, beforeAll, test } from 'vitest'
+
+import { buildWindowsJobGuardian } from '../../scripts/open-design/build-windows-job-guardian.mjs'
+
+import {
+  assertSecureGuardianAcl,
+  createProductionGuardianArtifactResolver,
+  isRegularFileStrict,
+  resolveCanonicalFilePath,
+  verifyAuthenticodeSignature
+} from './windows-guardian-resolver'
+
+const COMMIT = '1234567890abcdef1234567890abcdef12345678'
+let root = ''
+let exePath = ''
+
+beforeAll(async () => {
+  if (process.platform !== 'win32') {
+    return
+  }
+
+  root = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), 'hermes-guardian-trust-')))
+  exePath = (await buildWindowsJobGuardian({
+    sourceCommit: COMMIT,
+    platform: 'win32',
+    outputPath: path.join(root, 'hermes-open-design-job.exe')
+  })).outputPath
+}, 60_000)
+
+afterAll(() => {
+  if (root) {
+    fs.rmSync(root, { recursive: true, force: true })
+  }
+})
+
+test.skipIf(process.platform !== 'win32')('real Windows ACL query rejects a writable temporary guardian directory instead of trusting its valid PE bytes', () => {
+  assert.throws(() => assertSecureGuardianAcl(exePath), /insecure ACL|ownership_unavailable/i)
+})
+
+test.skipIf(process.platform !== 'win32')('real Windows filesystem reparse point is never accepted as a guardian executable', () => {
+  const linkPath = path.join(root, 'guardian-link.exe')
+  fs.symlinkSync(exePath, linkPath, 'file')
+
+  assert.notEqual(resolveCanonicalFilePath(linkPath), linkPath)
+  assert.equal(isRegularFileStrict(linkPath), false)
+})
+
+test.skipIf(process.platform !== 'win32')('real signtool verification observes the unsigned CI helper and packaged resolver fails closed without an approved signature', () => {
+  // Do not let verifyAuthenticodeSignature() return false merely because the
+  // Windows SDK tool is absent: this is a real host contract, so its required
+  // executable must exist and reject the exact unsigned PE we just compiled.
+  assert.doesNotThrow(() => execFileSync('where.exe', ['signtool.exe'], { windowsHide: true }))
+  assert.throws(() => execFileSync('signtool.exe', ['verify', '/pa', '/q', exePath], { windowsHide: true }))
+  assert.equal(verifyAuthenticodeSignature(exePath), false, 'the CI-built helper must not be mistaken for release-signed')
+  const manifestPath = `${exePath}.manifest.json`
+  const resolver = createProductionGuardianArtifactResolver({
+    guardianDir: root,
+    expectedSourceCommit: COMMIT,
+    platform: 'win32',
+    isPackaged: () => true,
+    // This test isolates the signature policy after the separate ACL test
+    // above; a temp directory is intentionally ACL-insecure by design.
+    checkAcl: () => {},
+    computeSha256: target => crypto.createHash('sha256').update(fs.readFileSync(target)).digest('hex')
+  })
+
+  assert.ok(fs.existsSync(manifestPath))
+  assert.throws(() => resolver(), /signed|signature/i)
+})
