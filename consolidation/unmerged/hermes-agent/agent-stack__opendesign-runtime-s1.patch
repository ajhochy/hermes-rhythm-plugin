+    const bigEndian = magic === MACHO_MAGIC_64_BE
+    const cpuType = bigEndian ? buffer.readUInt32BE(4) : buffer.readUInt32LE(4)
+    return [cpuTypeToArchitecture(cpuType)]
+  }
