+// ─── end-to-end orchestration (fake network/extraction) ────────────
+
+test('stageOpenDesignRuntime fails closed and never extracts when the checksum does not match', async () => {
+  const dir = tmpdir()
+  try {
+    let extractCalled = false
+    await assert.rejects(
+      stageOpenDesignRuntime({
+        manifest: MANIFEST,
+        platform: 'darwin',
+        arch: 'arm64',
+        cacheDir: dir,
+        destRoot: path.join(dir, 'staged'),
+        download: async ({ destPath }) => fs.writeFileSync(destPath, Buffer.from('not the real payload')),
+        extract: async () => {
+          extractCalled = true
+        }
+      }),
+      /checksum mismatch/i
+    )
+    assert.equal(extractCalled, false, 'must never extract an unverified payload')
+  } finally {
+    fs.rmSync(dir, { recursive: true, force: true })
+  }
+})
+
+test('stageOpenDesignRuntime stages Resources + LICENSE + provenance manifest on a verified payload', async () => {
+  const dir = tmpdir()
+  try {
+    const destRoot = path.join(dir, 'staged')
+    const contents = Buffer.from('verified payload')
+    const sha256 = crypto.createHash('sha256').update(contents).digest('hex')
+    const manifest = { ...MANIFEST, assets: { ...MANIFEST.assets, 'darwin-arm64': { name: 'fixture.dmg', sha256 } } }
+
+    await stageOpenDesignRuntime({
+      manifest,
+      platform: 'darwin',
+      arch: 'arm64',
+      cacheDir: dir,
+      destRoot,
+      download: async ({ destPath }) => fs.writeFileSync(destPath, contents),
+      extract: async ({ destRoot: root }) => {
+        fs.mkdirSync(path.join(root, 'Resources'), { recursive: true })
+        fs.writeFileSync(path.join(root, 'Resources', 'app-marker.txt'), 'staged')
+      }
+    })
+
+    assert.ok(fs.existsSync(path.join(destRoot, 'Resources', 'app-marker.txt')))
+    assert.ok(fs.existsSync(path.join(destRoot, 'LICENSE')))
+    const license = fs.readFileSync(path.join(destRoot, 'LICENSE'), 'utf8')
+    assert.match(license, /Apache License/)
