@@ -0,0 +1,48 @@
+import { OpenDesignRuntimeSupervisor, type OpenDesignSupervisorDeps } from './supervisor'
+import {
+  createWindowsOwnedRuntimeDeps,
+  type CreateWindowsOwnedRuntimeDepsOptions
+} from './windows-supervisor-deps'
+
+export interface CreateOpenDesignRuntimeSupervisorOptions {
+  /** Generic cross-platform dependencies. A caller cannot inject or bypass the
+   * Windows ownership bundle through this bag; the factory owns that choice. */
+  deps: Omit<OpenDesignSupervisorDeps, 'windowsOwnedRuntime'>
+  /** Required only when the selected platform is win32. */
+  windows?: CreateWindowsOwnedRuntimeDepsOptions
+  /** Injectable only so behavior tests can prove exact composition without a
+   * Windows host. Production callers omit it and use the real guardian bundle. */
+  createWindowsOwnedRuntime?: typeof createWindowsOwnedRuntimeDeps
+}
+
+/**
+ * Production composition boundary for Open Design runtime supervision.
+ *
+ * Windows can never silently inherit the generic direct-spawn/process-tree
+ * seams: this factory requires guardian composition options, builds one
+ * matched spawn/readiness/termination bundle, and the supervisor constructor
+ * independently fails closed if that bundle is absent. macOS/Linux keep the
+ * existing generic owned-process implementation.
+ */
+export function createOpenDesignRuntimeSupervisor(
+  options: CreateOpenDesignRuntimeSupervisorOptions
+): OpenDesignRuntimeSupervisor {
+  const platform = options.deps.platform ?? process.platform
+
+  if (platform === 'win32') {
+    if (!options.windows) {
+      throw new Error('[open-design supervisor-factory] Windows requires guardian owned-runtime composition options')
+    }
+
+    const createOwnedRuntime = options.createWindowsOwnedRuntime ?? createWindowsOwnedRuntimeDeps
+    const windowsOwnedRuntime = createOwnedRuntime(options.windows)
+
+    return new OpenDesignRuntimeSupervisor({
+      ...options.deps,
+      platform,
+      windowsOwnedRuntime
+    })
+  }
+
+  return new OpenDesignRuntimeSupervisor({ ...options.deps, platform })
+}
