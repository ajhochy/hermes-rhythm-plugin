+// PE VERSIONINFO resource for hermes-open-design-job.exe.
+//
+// ODJOB_SOURCE_COMMIT / ODJOB_PROTOCOL_VERSION are supplied by the build
+// script (scripts/open-design/build-windows-job-guardian.mjs) via /D command
+// line macros so the exact source commit that produced this binary is
+// embedded in PE metadata (queryable via native tooling), in addition to
+// being emitted in the ODJOB/1 READY control-output line at runtime. Both
+// must match the runtime manifest (native-guardian-manifest.ts) before
+// Hermes will spawn this binary.
+
+#include <winver.h>
+
+#ifndef ODJOB_SOURCE_COMMIT_STR
+#define ODJOB_SOURCE_COMMIT_STR "unknown"
+#endif
+#ifndef ODJOB_PROTOCOL_VERSION_STR
+#define ODJOB_PROTOCOL_VERSION_STR "1"
+#endif
+#ifndef ODJOB_FILE_VERSION
+#define ODJOB_FILE_VERSION 1,0,0,0
+#endif
+
+VS_VERSION_INFO VERSIONINFO
+ FILEVERSION ODJOB_FILE_VERSION
+ PRODUCTVERSION ODJOB_FILE_VERSION
+ FILEFLAGSMASK 0x3fL
+ FILEFLAGS 0x0L
+ FILEOS 0x40004L
+ FILETYPE 0x1L
+ FILESUBTYPE 0x0L
+BEGIN
+    BLOCK "StringFileInfo"
+    BEGIN
+        BLOCK "040904b0"
+        BEGIN
+            VALUE "CompanyName", "Nous Research"
+            VALUE "FileDescription", "Hermes Open Design Windows Job guardian"
+            VALUE "FileVersion", ODJOB_PROTOCOL_VERSION_STR
+            VALUE "InternalName", "hermes-open-design-job"
+            VALUE "OriginalFilename", "hermes-open-design-job.exe"
+            VALUE "ProductName", "Hermes"
+            VALUE "ProductVersion", ODJOB_PROTOCOL_VERSION_STR
+            VALUE "SourceCommit", ODJOB_SOURCE_COMMIT_STR
+            VALUE "ProtocolVersion", ODJOB_PROTOCOL_VERSION_STR
+        END
+    END
+    BLOCK "VarFileInfo"
+    BEGIN
+        VALUE "Translation", 0x409, 1200
+    END
+END
