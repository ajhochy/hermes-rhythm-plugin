+import assert from 'node:assert/strict'
+
+import { test } from 'vitest'
+
+import { waitForOpenDesignReadyWindows } from './windows-readiness'
+
+const NAMESPACE_ROOT = 'C:\\Users\\Jane\\AppData\\Roaming\\Hermes\\open-design\\namespaces\\hz-default-abc123'
+const EXE_PATH = 'C:\\Users\\Jane\\AppData\\Local\\Programs\\Open Design\\Open Design.exe'
+const LOG_PATH = 'C:\\Users\\Jane\\AppData\\Roaming\\Hermes\\open-design\\namespaces\\hz-default-abc123\\logs\\desktop\\latest.log'
+const IPC = '\\\\.\\pipe\\open-design-hz-default-abc123-desktop'
+
+function validIdentity(overrides: Partial<any> = {}) {
+  return {
+    version: 1,
+    namespaceRoot: NAMESPACE_ROOT,
+    pid: 4242,
+    ppid: 1010,
+    executablePath: EXE_PATH,
+    logPath: LOG_PATH,
+    startedAt: new Date().toISOString(),
+    updatedAt: new Date().toISOString(),
+    stamp: { app: 'desktop', mode: 'runtime', namespace: 'hz-default-abc123', source: 'packaged', ipc: IPC },
+    ...overrides
+  }
+}
+
+function baseOptions(overrides: Partial<any> = {}) {
+  return {
+    readHeadlessIdentity: () => validIdentity(),
+    expectedNamespace: 'hz-default-abc123',
+    expectedNamespaceRoot: NAMESPACE_ROOT,
+    expectedGuardianTargetPid: 4242,
+    expectedGuardianHelperPpid: 1010,
+    expectedExecutablePath: EXE_PATH,
+    expectedLogPath: LOG_PATH,
+    requestStatus: async () => ({ pid: 4242, state: 'running', windowVisible: false, url: 'http://127.0.0.1:53211' }),
+    fetchHealth: async () => ({ status: 200, body: { ok: true, version: '0.20.0' } }),
+    timeoutMs: 2_000,
+    pollMs: 5,
+    now: Date.now,
+    sleep: (ms: number, signal: AbortSignal) => new Promise<void>((resolve, reject) => {
+      const timer = setTimeout(resolve, ms)
+      signal.addEventListener('abort', () => {
+        clearTimeout(timer)
+        const error = new Error('aborted')
+        error.name = 'AbortError'
+        reject(error)
+      }, { once: true })
+    }),
+    ...overrides
+  }
+}
+
+test('resolves with the IPC-bound status URL once identity, status, and health all validate', async () => {
+  const result = await waitForOpenDesignReadyWindows(baseOptions())
+  assert.deepEqual(result, { origin: 'http://127.0.0.1:53211' })
+})
+
+test('accepts a Windows identity whose namespace root, executable, and log paths carry a drive letter, spaces, and non-ASCII characters', async () => {
+  const nonAsciiRoot = 'C:\\Users\\Jane Q. Ünïcode\\AppData\\Roaming\\Hermes\\open-design\\namespaces\\hz-default-abc123'
+  const nonAsciiExe = 'C:\\Users\\Jane Q. Ünïcode\\AppData\\Local\\Programs\\Open Design\\Open Design.exe'
+  const nonAsciiLog = `${nonAsciiRoot}\\logs\\desktop\\latest.log`
+
+  const result = await waitForOpenDesignReadyWindows(baseOptions({
+    readHeadlessIdentity: () => validIdentity({
+      namespaceRoot: nonAsciiRoot,
+      executablePath: nonAsciiExe,
+      logPath: nonAsciiLog
+    }),
+    expectedNamespaceRoot: nonAsciiRoot,
+    expectedExecutablePath: nonAsciiExe,
+    expectedLogPath: nonAsciiLog
+  }))
+
+  assert.deepEqual(result, { origin: 'http://127.0.0.1:53211' })
+})
+
+test('uses only the IPC-bound status URL for the health probe -- never a renderer/guest-supplied endpoint', async () => {
+  const healthCalls: string[] = []
+
+  await waitForOpenDesignReadyWindows(baseOptions({
+    requestStatus: async () => ({ pid: 4242, state: 'running', windowVisible: false, url: 'http://127.0.0.1:9999' }),
+    fetchHealth: async (url: string) => {
+      healthCalls.push(url)
+
+      return { status: 200, body: { ok: true, version: '0.20.0' } }
+    }
+  }))
+
+  assert.deepEqual(healthCalls, ['http://127.0.0.1:9999/api/health'])
+})
+
+test('retries while the headless identity file has not appeared yet, then succeeds', async () => {
+  let calls = 0
+
+  const result = await waitForOpenDesignReadyWindows(baseOptions({
+    readHeadlessIdentity: () => {
+      calls += 1
+
+      return calls < 3 ? null : validIdentity()
+    }
+  }))
+
+  assert.ok(calls >= 3)
+  assert.deepEqual(result, { origin: 'http://127.0.0.1:53211' })
+})
+
+test('treats a stale/pid-mismatched identity as transient (a previous run may not have been overwritten yet)', async () => {
+  let calls = 0
+
+  const result = await waitForOpenDesignReadyWindows(baseOptions({
+    readHeadlessIdentity: () => {
+      calls += 1
+
+      return calls < 3 ? validIdentity({ pid: 111 }) : validIdentity()
+    }
+  }))
+
+  assert.ok(calls >= 3)
+  assert.equal(result.origin, 'http://127.0.0.1:53211')
+})
+
+test('fails fast (not just a timeout) on a namespaceRoot mismatch -- never accepts an arbitrary basename/full-path alias', async () => {
+  await assert.rejects(
+    waitForOpenDesignReadyWindows(baseOptions({
+      readHeadlessIdentity: () => validIdentity({ namespaceRoot: 'C:\\Users\\Attacker\\namespaces\\hz-default-abc123' })
+    })),
+    /namespaceRoot|namespace_root/i
+  )
+})
+
+test('retries while the IPC status request itself fails (daemon IPC server not up yet)', async () => {
+  let calls = 0
+
+  const result = await waitForOpenDesignReadyWindows(baseOptions({
+    requestStatus: async () => {
+      calls += 1
+
+      if (calls < 3) {
+        throw new Error('ECONNREFUSED')
+      }
+
+      return { pid: 4242, state: 'running', windowVisible: false, url: 'http://127.0.0.1:53211' }
+    }
+  }))
+
+  assert.ok(calls >= 3)
+  assert.equal(result.origin, 'http://127.0.0.1:53211')
+})
+
+test('retries while status.state is not yet "running"', async () => {
+  let calls = 0
+
+  const result = await waitForOpenDesignReadyWindows(baseOptions({
+    requestStatus: async () => {
+      calls += 1
+
+      return { pid: 4242, state: calls < 3 ? 'starting' : 'running', windowVisible: false, url: 'http://127.0.0.1:53211' }
+    }
+  }))
+
+  assert.ok(calls >= 3)
+  assert.equal(result.origin, 'http://127.0.0.1:53211')
+})
+
+test('rejects a status whose url is not a strict raw loopback origin', async () => {
+  await assert.rejects(
+    waitForOpenDesignReadyWindows(baseOptions({
+      requestStatus: async () => ({ pid: 4242, state: 'running', windowVisible: false, url: 'http://evil.example.com:1' }),
+      timeoutMs: 60
+    }))
+  )
+})
+
+test('rejects when windowVisible is true (never treats a visible window as the headless runtime)', async () => {
+  await assert.rejects(
+    waitForOpenDesignReadyWindows(baseOptions({
+      requestStatus: async () => ({ pid: 4242, state: 'running', windowVisible: true, url: 'http://127.0.0.1:53211' }),
+      timeoutMs: 60
+    }))
+  )
+})
+
+test('rejects when the health probe never validates within the bounded timeout', async () => {
+  await assert.rejects(
+    waitForOpenDesignReadyWindows(baseOptions({
+      fetchHealth: async () => ({ status: 200, body: { ok: true, version: '0.19.0' } }),
+      timeoutMs: 60
+    })),
+    /timed out/i
+  )
+})
+
+test('aborts immediately when the signal is already aborted', async () => {
+  const controller = new AbortController()
+  controller.abort()
+
+  await assert.rejects(
+    waitForOpenDesignReadyWindows(baseOptions({ signal: controller.signal })),
+    /AbortError|cancelled/i
+  )
+})
diff --git a/apps/desktop/electron/open-design/windows-readiness.ts b/apps/desktop/electron/open-design/windows-readiness.ts
new file mode 100644
index 0000000000..9c9da2b9a9
--- /dev/null
+++ b/apps/desktop/electron/open-design/windows-readiness.ts
@@ -0,0 +1,220 @@
+/**
+ * windows-readiness.ts — the Windows-compatible readiness path (P1-2).
+ *
+ * The pinned guest derives `web-root.json`'s `namespace` field with
+ * `namespaceRoot.split("/").pop()` (apps/packaged/src/identity.ts at commit
+ * fa3cb4cdf3d1703e984a5655bd9654f8d44c493b, tag open-design-v0.20.0). On
+ * Windows, `namespaceRoot` is backslash-separated, so `.split("/")` never
+ * splits and `.pop()` returns the *entire path* instead of a short namespace
+ * -- strict `web-root.json` readiness (readiness.ts) can therefore never
+ * succeed on Windows. This module validates `headless-root.json` instead
+ * (whose `namespaceRoot` is the guest's own un-derived full path), then
+ * cross-checks the desktop sidecar's own IPC `status` response, and only
+ * then performs the exact same strict HTTP health/version probe as the
+ * POSIX path. `readiness.ts` (web-identity, macOS/Linux) is unmodified and
+ * remains the strict path there.
+ */
+
+import { isLoopbackHttpUrl, parseOpenDesignHeadlessIdentity, validateOpenDesignHeadlessIdentity } from './identity'
+import { resolveOpenDesignDesktopIpcEndpoint } from './ipc-endpoint'
+import {
+  abortableSleep,
+  type OpenDesignHealthResponse,
+  raceWithAbort,
+  throwIfAborted,
+  validateOpenDesignHealthResponse
+} from './readiness'
+
+export const DEFAULT_WINDOWS_READINESS_TIMEOUT_MS = 30_000
+export const DEFAULT_WINDOWS_READINESS_POLL_MS = 200
+export const DEFAULT_STATUS_REQUEST_TIMEOUT_MS = 1_500
+
+export interface OpenDesignDesktopStatus {
+  pid: number
+  state: string
+  windowVisible: boolean
+  url: string
+}
+
+function isValidStatusShape(value: unknown): value is OpenDesignDesktopStatus {
+  if (!value || typeof value !== 'object') {
+    return false
+  }
+
+  const status = value as Partial<OpenDesignDesktopStatus>
+
+  return typeof status.pid === 'number'
+    && typeof status.state === 'string'
+    && typeof status.windowVisible === 'boolean'
+    && typeof status.url === 'string'
+}
+
+export interface WaitForOpenDesignReadyWindowsOptions {
+  readHeadlessIdentity: () => unknown
+  expectedNamespace: string
+  expectedNamespaceRoot: string
+  expectedGuardianTargetPid: number
+  expectedGuardianHelperPpid: number
+  expectedExecutablePath: string
+  expectedLogPath: string
+  /** Requests `{type:"status"}` over the exact pinned desktop IPC endpoint for the validated namespace. */
+  requestStatus: (timeoutMs: number) => Promise<unknown>
+  fetchHealth: (
+    url: string,
+    options: { timeoutMs: number; signal: AbortSignal }
+  ) => Promise<OpenDesignHealthResponse>
+  signal?: AbortSignal
+  timeoutMs?: number
+  pollMs?: number
+  healthProbeTimeoutMs?: number
+  statusTimeoutMs?: number
+  now?: () => number
+  sleep?: (ms: number, signal: AbortSignal) => Promise<void>
+}
+
+export interface OpenDesignReadyResult {
+  origin: string
+}
+
+async function fetchHealthBounded(
+  fetchHealth: WaitForOpenDesignReadyWindowsOptions['fetchHealth'],
+  url: string,
+  timeoutMs: number,
+  parentSignal: AbortSignal
+): Promise<OpenDesignHealthResponse> {
+  const controller = new AbortController()
+  let timedOut = false
+  const onParentAbort = () => controller.abort()
+
+  const timer = setTimeout(() => {
+    timedOut = true
+    controller.abort()
+  }, timeoutMs)
+
+  parentSignal.addEventListener('abort', onParentAbort, { once: true })
+
+  try {
+    return await raceWithAbort(fetchHealth(url, { timeoutMs, signal: controller.signal }), parentSignal, timeoutMs)
+  } catch (error) {
+    if (timedOut && !parentSignal.aborted) {
+      const timeoutError = new Error(`[open-design windows-readiness] health probe timed out after ${timeoutMs}ms`)
+      timeoutError.name = 'TimeoutError'
+      throw timeoutError
+    }
+
+    throw error
+  } finally {
+    clearTimeout(timer)
+    parentSignal.removeEventListener('abort', onParentAbort)
+    controller.abort()
+  }
+}
+
+export async function waitForOpenDesignReadyWindows(
+  options: WaitForOpenDesignReadyWindowsOptions
+): Promise<OpenDesignReadyResult> {
+  const timeoutMs = options.timeoutMs ?? DEFAULT_WINDOWS_READINESS_TIMEOUT_MS
+  const pollMs = options.pollMs ?? DEFAULT_WINDOWS_READINESS_POLL_MS
+  const healthProbeTimeoutMs = options.healthProbeTimeoutMs ?? Math.min(5_000, timeoutMs)
+  const statusTimeoutMs = options.statusTimeoutMs ?? Math.min(DEFAULT_STATUS_REQUEST_TIMEOUT_MS, timeoutMs)
+  const now = options.now ?? Date.now
+  const signal = options.signal ?? new AbortController().signal
+  const sleep = options.sleep ?? abortableSleep
+
+  throwIfAborted(signal)
+
+  const deadline = now() + timeoutMs
+  let lastError: unknown = null
+  const expectedIpc = resolveOpenDesignDesktopIpcEndpoint(options.expectedNamespace, { platform: 'win32' })
+
+  while (now() < deadline) {
+    throwIfAborted(signal)
+
+    const raw = options.readHeadlessIdentity()
+    const identity = parseOpenDesignHeadlessIdentity(raw)
+
+    if (identity) {
+      const validation = validateOpenDesignHeadlessIdentity(identity, {
+        platform: 'win32',
+        expectedNamespaceRoot: options.expectedNamespaceRoot,
+        expectedNamespace: options.expectedNamespace,
+        expectedGuardianTargetPid: options.expectedGuardianTargetPid,
+        expectedGuardianHelperPpid: options.expectedGuardianHelperPpid,
+        expectedExecutablePath: options.expectedExecutablePath,
+        expectedLogPath: options.expectedLogPath,
+        expectedIpc,
+        now
+      })
+
+      // A stale heartbeat or a PID/PPID mismatch may simply be a previous
+      // run's identity file not yet overwritten -- transient, keep polling.
+      // Every other mismatch (namespace root, paths, stamp) means a
+      // different runtime entirely and is fatal immediately, exactly like
+      // readiness.ts's web-identity path.
+      const transientCodes = new Set(['pid_mismatch', 'ppid_mismatch', 'stale'])
+
+      if (!validation.ok && !transientCodes.has(validation.code ?? '')) {
+        throw new Error(`[open-design windows-readiness] identity validation failed: ${validation.reason}`)
+      }
+
+      if (validation.ok) {
+        try {
+          const remainingMs = Math.max(1, deadline - now())
+          const boundedStatusTimeoutMs = Math.min(statusTimeoutMs, remainingMs)
+          const rawStatus = await raceWithAbort(options.requestStatus(boundedStatusTimeoutMs), signal)
+
+          if (!isValidStatusShape(rawStatus)) {
+            lastError = new Error('[open-design windows-readiness] status response has an invalid shape')
+          } else if (rawStatus.pid !== options.expectedGuardianTargetPid) {
+            // Symmetric with the identity path's own pid_mismatch: transient.
+            lastError = new Error(
+              `[open-design windows-readiness] status pid mismatch: expected ${options.expectedGuardianTargetPid}, got ${rawStatus.pid}`
+            )
+          } else if (rawStatus.state !== 'running') {
+            lastError = new Error(`[open-design windows-readiness] status state is not "running": ${rawStatus.state}`)
+          } else if (rawStatus.windowVisible !== false) {
+            throw new Error('[open-design windows-readiness] status reports a visible window; refusing to treat it as the headless runtime')
+          } else if (!isLoopbackHttpUrl(rawStatus.url)) {
+            throw new Error(`[open-design windows-readiness] status url is not a valid loopback http origin: ${rawStatus.url}`)
+          } else {
+            const remainingForHealthMs = Math.max(1, deadline - now())
+            const probeTimeoutMs = Math.min(healthProbeTimeoutMs, remainingForHealthMs)
+            const health = await fetchHealthBounded(options.fetchHealth, `${rawStatus.url}/api/health`, probeTimeoutMs, signal)
+            const healthValidation = validateOpenDesignHealthResponse(health)
+
+            if ('reason' in healthValidation) {
+              lastError = new Error(healthValidation.reason)
+            } else {
+              return { origin: rawStatus.url }
+            }
+          }
+        } catch (error) {
+          if (signal.aborted || (error as { name?: unknown } | null)?.name === 'AbortError') {
+            throw error
+          }
+
+          if ((error as { name?: unknown } | null)?.name === 'TimeoutError') {
+            lastError = error
+          } else if (error instanceof Error && error.message.startsWith('[open-design windows-readiness]') && (
+            error.message.includes('visible window') || error.message.includes('loopback')
+          )) {
+            throw error
+          } else {
+            // IPC connect/status failures (daemon IPC server not up yet) are transient.
+            lastError = error
+          }
+        }
+      } else {
+        lastError = new Error(validation.reason)
+      }
+    } else {
+      lastError = new Error('[open-design windows-readiness] no headless identity observed yet')
+    }
+
+    await raceWithAbort(sleep(pollMs, signal), signal)
+  }
+
+  throwIfAborted(signal)
+  const detail = lastError instanceof Error ? lastError.message : 'no healthy identity observed'
+  throw new Error(`[open-design windows-readiness] timed out after ${timeoutMs}ms waiting for Open Design to become ready: ${detail}`)
+}
diff --git a/apps/desktop/native/open-design-job/guardian.cpp b/apps/desktop/native/open-design-job/guardian.cpp
new file mode 100644
index 0000000000..34a5d8acf9
--- /dev/null
+++ b/apps/desktop/native/open-design-job/guardian.cpp
@@ -0,0 +1,521 @@
+// hermes-open-design-job.exe -- a small standalone Windows Job Object
+// guardian for the Open Design headless runtime (P1-3).
+//
+// STATUS: PARTIAL / static-validated only. This source has been written to
+// the exact architecture in the authoritative repair brief and reviewed
+// spike, but has never been compiled or executed on a real Windows host by
+// this change. It must not be cited as verified Windows Job behavior until
+// it passes real signed Windows x64 build + lifecycle/crash tests (see
+// scripts/open-design/build-windows-job-guardian.mjs and the windows-latest
+// CI job in .github/workflows/e2e-desktop.yml).
+//
+// Responsibilities (see apps/desktop/electron/open-design/windows-job-guardian.ts
+// for the TS-side half of this protocol):
+//   1. Create an unnamed Job Object with ONLY JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE
+//      (never BREAKAWAY_OK / SILENT_BREAKAWAY_OK).
+//   2. Create the verified target executable CREATE_SUSPENDED, with only the
+//      intended stdout/stderr handles and a dedicated NUL stdin inheritable
+//      (via STARTUPINFOEXW + PROC_THREAD_ATTRIBUTE_HANDLE_LIST) -- never the
+//      Job handle or this guardian's own control pipe. Never
+//      CREATE_BREAKAWAY_FROM_JOB.
+//   3. Assign the still-suspended process to the Job, verify membership,
+//      retain the original process HANDLE, record its creation FILETIME.
+//   4. Resume only after every prior step succeeds; on any failure, terminate
+//      the still-suspended target, wait, close handles, report
+//      ODJOB/1 ERROR <stage> <win32-error>, and never fall back.
+//   5. Speak the bounded ODJOB/1 protocol over stdout/stdin; relay the
+//      target's own stdout/stderr only through this guardian's stderr, so
+//      guest output can never forge a protocol line on stdout.
+//   6. Treat the parent's stdin pipe as the control token: EOF means Hermes
+//      died or closed ownership, and is handled exactly like FORCE.
+//   7. On FORCE (or stdin EOF, or a malformed/oversized control line):
+//      TerminateJobObject, then poll
+//      QueryInformationJobObject(JobObjectBasicAccountingInformation) until
+//      ActiveProcesses == 0 (bounded to 10 seconds). Only report
+//      ODJOB/1 EMPTY forced if that bound actually proved ActiveProcesses ==
+//      0; otherwise report ODJOB/1 ERROR ForceEmptyTimeout so the adapter
+//      never mistakes an unproven Job for a clean one (the final backstop is
+//      this process's own exit: its last handle closing the non-inheritable,
+//      KILL_ON_JOB_CLOSE Job kills whatever remains, even though we could not
+//      prove it within the bounded poll).
+//   8. Monitor the target directly; if it exits on its own and the Job is
+//      already fully empty, report ODJOB/1 EMPTY graceful spontaneously
+//      (not just as a FORCE response).
+//
+// Build: see scripts/open-design/build-windows-job-guardian.mjs for the
+// exact MSVC flags (/MT /W4 /WX, CFG, ASLR, NX) and PE metadata/source-commit
+// embedding (guardian.rc).
+
+#ifndef UNICODE
+#define UNICODE
+#endif
+#ifndef _UNICODE
+#define _UNICODE
+#endif
+
+#include <windows.h>
+#include <string>
+#include <vector>
+#include <cstdio>
+#include <cstdlib>
+#include <cwchar>
+
+#ifndef ODJOB_SOURCE_COMMIT
+#define ODJOB_SOURCE_COMMIT L"unknown"
+#endif
+
+namespace {
+
+constexpr wchar_t kProtocolPrefix[] = L"ODJOB/1";
+constexpr DWORD kForceJobEmptyPollIntervalMs = 100;
+constexpr DWORD kForceJobEmptyBoundMs = 10000;
+constexpr size_t kMaxStdinLineChars = 64;
+constexpr size_t kMaxNonceChars = 64;
+
+HANDLE g_job = nullptr;
+HANDLE g_targetProcess = nullptr;
+DWORD g_targetPid = 0;
+FILETIME g_targetCreationTime{};
+DWORD g_guardianPid = 0;
+FILETIME g_guardianCreationTime{};
+volatile LONG g_emptyReported = 0;
+volatile LONG g_forceRequested = 0;
+CRITICAL_SECTION g_stdoutLock;
+
+std::wstring FileTimeToToken(const FILETIME &ft) {
+  ULARGE_INTEGER value;
+  value.LowPart = ft.dwLowDateTime;
+  value.HighPart = ft.dwHighDateTime;
+  wchar_t buffer[32];
+  swprintf_s(buffer, L"%llu", static_cast<unsigned long long>(value.QuadPart));
+  return buffer;
+}
+
+void WriteProtocolLine(const std::wstring &line) {
+  EnterCriticalSection(&g_stdoutLock);
+  std::wstring withNewline = line + L"\r\n";
+  DWORD written = 0;
+  WriteConsoleW(GetStdHandle(STD_OUTPUT_HANDLE), withNewline.c_str(),
+                static_cast<DWORD>(withNewline.size()), &written, nullptr);
+  // WriteConsoleW only works when stdout is a real console; when redirected
+  // (the normal case -- Hermes pipes this process's stdout), fall back to
+  // WriteFile against the raw handle.
+  if (written == 0) {
+    std::string narrow;
+    int needed = WideCharToMultiByte(CP_UTF8, 0, withNewline.c_str(), -1,
+                                      nullptr, 0, nullptr, nullptr);
+    if (needed > 0) {
+      narrow.resize(static_cast<size_t>(needed));
+      WideCharToMultiByte(CP_UTF8, 0, withNewline.c_str(), -1, &narrow[0],
+                          needed, nullptr, nullptr);
+      DWORD fileWritten = 0;
+      WriteFile(GetStdHandle(STD_OUTPUT_HANDLE), narrow.c_str(),
+                static_cast<DWORD>(narrow.size() > 0 ? narrow.size() - 1 : 0),
+                &fileWritten, nullptr);
+    }
+  }
+  LeaveCriticalSection(&g_stdoutLock);
+}
+
+void ReportError(const wchar_t *stage, DWORD win32Error) {
+  wchar_t buffer[256];
+  swprintf_s(buffer, L"%ls ERROR %ls %lu", kProtocolPrefix, stage, win32Error);
+  WriteProtocolLine(buffer);
+}
+
+// Relays the target's redirected stdout/stderr pipe onto THIS guardian's own
+// stderr only -- guest output must never reach the trusted stdout protocol
+// channel.
+DWORD WINAPI RelayGuestOutputThread(LPVOID param) {
+  HANDLE sourcePipe = static_cast<HANDLE>(param);
+  char buffer[4096];
+  DWORD bytesRead = 0;
+
+  while (ReadFile(sourcePipe, buffer, sizeof(buffer), &bytesRead, nullptr) &&
+         bytesRead > 0) {
+    DWORD written = 0;
+    WriteFile(GetStdHandle(STD_ERROR_HANDLE), buffer, bytesRead, &written,
+              nullptr);
+  }
+
+  CloseHandle(sourcePipe);
+  return 0;
+}
+
+bool JobIsEmpty() {
+  JOBOBJECT_BASIC_ACCOUNTING_INFORMATION info{};
+  if (!QueryInformationJobObject(g_job, JobObjectBasicAccountingInformation,
+                                 &info, sizeof(info), nullptr)) {
+    return false;
+  }
+  return info.ActiveProcesses == 0;
+}
+
+void ReportEmptyOnce(const wchar_t *kind) {
+  if (InterlockedCompareExchange(&g_emptyReported, 1, 0) != 0) {
+    return;
+  }
+  wchar_t buffer[64];
+  swprintf_s(buffer, L"%ls EMPTY %ls", kProtocolPrefix, kind);
+  WriteProtocolLine(buffer);
+}
+
+// Terminates the Job and blocks (bounded) until QueryInformationJobObject
+// proves ActiveProcesses == 0. Completion-port notifications are
+// intentionally not used as the sole proof. Never reports EMPTY unless that
+// proof was actually obtained -- a bound timeout is an ERROR, not a
+// fabricated success (the caller's own subsequent exit is the final
+// kill-on-job-close backstop for whatever could not be proven empty here).
+void ForceEmptyJob() {
+  InterlockedExchange(&g_forceRequested, 1);
+  TerminateJobObject(g_job, 1);
+
+  DWORD waited = 0;
+  while (waited < kForceJobEmptyBoundMs) {
+    if (JobIsEmpty()) {
+      ReportEmptyOnce(L"forced");
+      return;
+    }
+    Sleep(kForceJobEmptyPollIntervalMs);
+    waited += kForceJobEmptyPollIntervalMs;
+  }
+
+  ReportError(L"ForceEmptyTimeout", ERROR_TIMEOUT);
+}
+
+// Waits for the direct target to exit on its own, then confirms (bounded
+// polling, not completion-port trust) that the whole Job is empty before
+// reporting a spontaneous graceful EMPTY.
+DWORD WINAPI MonitorTargetThread(LPVOID) {
+  WaitForSingleObject(g_targetProcess, INFINITE);
+
+  if (InterlockedCompareExchange(&g_forceRequested, 0, 0) != 0) {
+    // A FORCE is already driving the EMPTY report; avoid a duplicate.
+    return 0;
+  }
+
+  DWORD waited = 0;
+  while (waited < kForceJobEmptyBoundMs) {
+    if (JobIsEmpty()) {
+      ReportEmptyOnce(L"graceful");
+      return 0;
+    }
+    Sleep(kForceJobEmptyPollIntervalMs);
+    waited += kForceJobEmptyPollIntervalMs;
+  }
+
+  // Descendants outlived the direct target beyond the bound -- this is only
+  // resolvable by an explicit FORCE (stdin) or job-handle-close teardown.
+  return 0;
+}
+
+// Reads bounded, exact stdin commands (STATUS / FORCE). A bare blank line is
+// tolerated as a no-op; anything else malformed or oversized fails closed by
+// forcing Job cleanup rather than reporting-and-continuing, since a control
+// channel that just sent garbage can no longer be trusted. EOF is handled
+// exactly like FORCE -- Hermes is the sole writer of this pipe, and its
+// closure (process death or explicit ownership release) is the
+// control-token-loss signal.
+DWORD WINAPI StdinCommandThread(LPVOID) {
+  std::wstring line;
+  DWORD bytesRead = 0;
+  HANDLE stdinHandle = GetStdHandle(STD_INPUT_HANDLE);
+
+  for (;;) {
+    char rawByte = 0;
+    if (!ReadFile(stdinHandle, &rawByte, 1, &bytesRead, nullptr) ||
+        bytesRead == 0) {
+      // EOF or broken pipe: Hermes died or released ownership.
+      ForceEmptyJob();
+      return 0;
+    }
+
+    wchar_t ch = static_cast<wchar_t>(rawByte);
+
+    if (ch == L'\n') {
+      // Trim a trailing \r.
+      if (!line.empty() && line.back() == L'\r') {
+        line.pop_back();
+      }
+
+      if (line == L"STATUS") {
+        DWORD exitCode = 0;
+        bool live = GetExitCodeProcess(g_targetProcess, &exitCode) &&
+                    exitCode == STILL_ACTIVE;
+        wchar_t buffer[128];
+        swprintf_s(buffer, L"%ls TARGET %ls %lu %ls", kProtocolPrefix,
+                   live ? L"live" : L"exited", g_targetPid,
+                   FileTimeToToken(g_targetCreationTime).c_str());
+        WriteProtocolLine(buffer);
+        line.clear();
+      } else if (line == L"FORCE") {
+        ForceEmptyJob();
+        return 0;
+      } else if (line.empty()) {
+        // Tolerate a bare blank line; not a malformed command attempt.
+      } else {
+        ReportError(L"BadCommand", ERROR_INVALID_PARAMETER);
+        ForceEmptyJob();
+        return 0;
+      }
+
+      line.clear();
+    } else {
+      line.push_back(ch);
+      if (line.size() > kMaxStdinLineChars) {
+        // Oversized input fails closed: the control channel can no longer be
+        // trusted, so force cleanup instead of dropping and continuing.
+        ReportError(L"BadCommand", ERROR_INVALID_PARAMETER);
+        ForceEmptyJob();
+        return 0;
+      }
+    }
+  }
+}
+
+// Builds the target's command line from argv[startIndex..argc-1] only --
+// never including this guardian's own image path (argv[0]) or the launch
+// nonce (argv[1]), so neither can leak into the target's own argv.
+std::wstring BuildCommandLine(int argc, wchar_t **argv, int startIndex) {
+  std::wstring commandLine;
+  for (int i = startIndex; i < argc; ++i) {
+    if (i > startIndex) {
+      commandLine += L' ';
+    }
+    commandLine += L'"';
+    commandLine += argv[i];
+    commandLine += L'"';
+  }
+  return commandLine;
+}
+
+}  // namespace
+
+int wmain(int argc, wchar_t **argv) {
+  InitializeCriticalSection(&g_stdoutLock);
+
+  g_guardianPid = GetCurrentProcessId();
+  {
+    FILETIME exitTime{}, kernelTime{}, userTime{};
+    GetProcessTimes(GetCurrentProcess(), &g_guardianCreationTime, &exitTime,
+                    &kernelTime, &userTime);
+  }
+
+  // argv[0] = this guardian's own image path (OS-supplied).
+  // argv[1] = fresh per-launch nonce Hermes generated (never forwarded to the
+  //           target's command line or environment).
+  // argv[2] = the verified target executable's absolute path.
+  // argv[3..] = the target's own arguments.
+  if (argc < 3) {
+    ReportError(L"Args", ERROR_INVALID_PARAMETER);
+    return 1;
+  }
+
+  const wchar_t *nonce = argv[1];
+  const wchar_t *targetExecutable = argv[2];
+
+  if (wcslen(nonce) == 0 || wcslen(nonce) > kMaxNonceChars) {
+    ReportError(L"Args", ERROR_INVALID_PARAMETER);
+    return 1;
+  }
+
+  DWORD targetAttributes = GetFileAttributesW(targetExecutable);
+
+  if (targetAttributes == INVALID_FILE_ATTRIBUTES) {
+    ReportError(L"TargetMissing", GetLastError());
+    return 1;
+  }
+
+  // Reject a directory or a reparse point (symlink/junction/mount-point)
+  // standing in for the verified target -- Hermes already canonicalizes and
+  // hash-validates the exact file it asked us to launch, and a reparse point
+  // here would let the on-disk target silently diverge from what was
+  // verified between validation and this CreateProcessW call.
+  if ((targetAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0) {
+    ReportError(L"TargetInvalid", ERROR_DIRECTORY_NOT_SUPPORTED);
+    return 1;
+  }
+
+  if ((targetAttributes & FILE_ATTRIBUTE_REPARSE_POINT) != 0) {
+    ReportError(L"TargetInvalid", ERROR_REPARSE_TAG_MISMATCH);
+    return 1;
+  }
+
+  // 1. Unnamed Job Object with only KILL_ON_JOB_CLOSE.
+  g_job = CreateJobObjectW(nullptr, nullptr);
+  if (g_job == nullptr) {
+    ReportError(L"CreateJobObject", GetLastError());
+    return 1;
+  }
+
+  JOBOBJECT_EXTENDED_LIMIT_INFORMATION limitInfo{};
+  limitInfo.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
+  if (!SetInformationJobObject(g_job, JobObjectExtendedLimitInformation,
+                               &limitInfo, sizeof(limitInfo))) {
+    DWORD error = GetLastError();
+    ReportError(L"SetInformationJobObject", error);
+    CloseHandle(g_job);
+    return 1;
+  }
+
+  // Dedicated NUL stdin + inherited stdout/stderr pipes for relaying guest
+  // output through this guardian's own stderr only.
+  SECURITY_ATTRIBUTES inheritable{sizeof(SECURITY_ATTRIBUTES), nullptr, TRUE};
+
+  HANDLE nulStdin =
+      CreateFileW(L"NUL", GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE,
+                  &inheritable, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+
+  HANDLE guestStdoutRead = nullptr, guestStdoutWrite = nullptr;
+  HANDLE guestStderrRead = nullptr, guestStderrWrite = nullptr;
+  CreatePipe(&guestStdoutRead, &guestStdoutWrite, &inheritable, 0);
+  CreatePipe(&guestStderrRead, &guestStderrWrite, &inheritable, 0);
+  // The read ends are for THIS process only; never let the child inherit them.
+  SetHandleInformation(guestStdoutRead, HANDLE_FLAG_INHERIT, 0);
+  SetHandleInformation(guestStderrRead, HANDLE_FLAG_INHERIT, 0);
+
+  if (nulStdin == INVALID_HANDLE_VALUE || guestStdoutWrite == nullptr ||
+      guestStderrWrite == nullptr) {
+    ReportError(L"PrepareStdio", GetLastError());
+    CloseHandle(g_job);
+    return 1;
+  }
+
+  // STARTUPINFOEXW + PROC_THREAD_ATTRIBUTE_HANDLE_LIST: the child inherits
+  // ONLY these three handles, never the Job handle or this process's own
+  // stdin control pipe, even though bInheritHandles is TRUE below.
+  SIZE_T attributeListSize = 0;
+  InitializeProcThreadAttributeList(nullptr, 1, 0, &attributeListSize);
+  std::vector<BYTE> attributeListBuffer(attributeListSize);
+  LPPROC_THREAD_ATTRIBUTE_LIST attributeList =
+      reinterpret_cast<LPPROC_THREAD_ATTRIBUTE_LIST>(attributeListBuffer.data());
+
+  if (!InitializeProcThreadAttributeList(attributeList, 1, 0,
+                                         &attributeListSize)) {
+    ReportError(L"InitializeProcThreadAttributeList", GetLastError());
+    CloseHandle(g_job);
+    return 1;
+  }
+
+  HANDLE inheritedHandles[3] = {nulStdin, guestStdoutWrite, guestStderrWrite};
+
+  if (!UpdateProcThreadAttribute(
+          attributeList, 0, PROC_THREAD_ATTRIBUTE_HANDLE_LIST,
+          inheritedHandles, sizeof(inheritedHandles), nullptr, nullptr)) {
+    ReportError(L"UpdateProcThreadAttribute", GetLastError());
+    DeleteProcThreadAttributeList(attributeList);
+    CloseHandle(g_job);
+    return 1;
+  }
+
+  STARTUPINFOEXW startupInfoEx{};
+  startupInfoEx.StartupInfo.cb = sizeof(startupInfoEx);
+  startupInfoEx.StartupInfo.dwFlags = STARTF_USESTDHANDLES;
+  startupInfoEx.StartupInfo.hStdInput = nulStdin;
+  startupInfoEx.StartupInfo.hStdOutput = guestStdoutWrite;
+  startupInfoEx.StartupInfo.hStdError = guestStderrWrite;
+  startupInfoEx.lpAttributeList = attributeList;
+
+  PROCESS_INFORMATION processInfo{};
+  std::wstring commandLine = BuildCommandLine(argc, argv, 2);
+  std::vector<wchar_t> mutableCommandLine(commandLine.begin(),
+                                           commandLine.end());
+  mutableCommandLine.push_back(L'\0');
+
+  // 2. CREATE_SUSPENDED; never CREATE_BREAKAWAY_FROM_JOB.
+  BOOL created = CreateProcessW(
+      targetExecutable, mutableCommandLine.data(), nullptr, nullptr,
+      /*bInheritHandles=*/TRUE,
+      CREATE_SUSPENDED | CREATE_UNICODE_ENVIRONMENT |
+          EXTENDED_STARTUPINFO_PRESENT,
+      nullptr, nullptr, &startupInfoEx.StartupInfo, &processInfo);
+
+  DeleteProcThreadAttributeList(attributeList);
+  CloseHandle(guestStdoutWrite);
+  CloseHandle(guestStderrWrite);
+  CloseHandle(nulStdin);
+
+  if (!created) {
+    DWORD error = GetLastError();
+    ReportError(L"CreateProcess", error);
+    CloseHandle(g_job);
+    return 1;
+  }
+
+  // 3. Assign while still suspended, verify membership, record identity.
+  if (!AssignProcessToJobObject(g_job, processInfo.hProcess)) {
+    DWORD error = GetLastError();
+    ReportError(L"AssignProcessToJobObject", error);
+    TerminateProcess(processInfo.hProcess, 1);
+    WaitForSingleObject(processInfo.hProcess, INFINITE);
+    CloseHandle(processInfo.hThread);
+    CloseHandle(processInfo.hProcess);
+    CloseHandle(g_job);
+    return 1;
+  }
+
+  BOOL inJob = FALSE;
+  if (!IsProcessInJob(processInfo.hProcess, g_job, &inJob) || !inJob) {
+    DWORD error = GetLastError();
+    ReportError(L"VerifyJobMembership", error);
+    TerminateProcess(processInfo.hProcess, 1);
+    WaitForSingleObject(processInfo.hProcess, INFINITE);
+    CloseHandle(processInfo.hThread);
+    CloseHandle(processInfo.hProcess);
+    CloseHandle(g_job);
+    return 1;
+  }
+
+  FILETIME creationTime{}, exitTime{}, kernelTime{}, userTime{};
+  GetProcessTimes(processInfo.hProcess, &creationTime, &exitTime, &kernelTime,
+                  &userTime);
+
+  g_targetProcess = processInfo.hProcess;
+  g_targetPid = processInfo.dwProcessId;
+  g_targetCreationTime = creationTime;
+
+  // 4. Only now resume.
+  if (ResumeThread(processInfo.hThread) == static_cast<DWORD>(-1)) {
+    DWORD error = GetLastError();
+    ReportError(L"ResumeThread", error);
+    TerminateProcess(processInfo.hProcess, 1);
+    WaitForSingleObject(processInfo.hProcess, INFINITE);
+    CloseHandle(processInfo.hThread);
+    CloseHandle(processInfo.hProcess);
+    CloseHandle(g_job);
+    return 1;
+  }
+
+  CloseHandle(processInfo.hThread);
+
+  wchar_t readyLine[512];
+  swprintf_s(readyLine, L"%ls READY %lu %ls %lu %ls %ls %ls", kProtocolPrefix,
+             g_guardianPid, FileTimeToToken(g_guardianCreationTime).c_str(),
+             g_targetPid, FileTimeToToken(g_targetCreationTime).c_str(),
+             ODJOB_SOURCE_COMMIT, nonce);
+  WriteProtocolLine(readyLine);
+
+  HANDLE relayThreads[2];
+  relayThreads[0] =
+      CreateThread(nullptr, 0, RelayGuestOutputThread, guestStdoutRead, 0, nullptr);
+  relayThreads[1] =
+      CreateThread(nullptr, 0, RelayGuestOutputThread, guestStderrRead, 0, nullptr);
+
+  HANDLE monitorThread =
+      CreateThread(nullptr, 0, MonitorTargetThread, nullptr, 0, nullptr);
+
+  // The stdin command loop runs on the main thread and exits the process
+  // once FORCE (explicit, via EOF, or via a fail-closed malformed/oversized
+  // command) has been fully handled.
+  StdinCommandThread(nullptr);
+
+  WaitForSingleObject(monitorThread, 2000);
+  CloseHandle(monitorThread);
+  CloseHandle(relayThreads[0]);
+  CloseHandle(relayThreads[1]);
+  CloseHandle(g_targetProcess);
+  CloseHandle(g_job);
+  DeleteCriticalSection(&g_stdoutLock);
+
+  return 0;
+}
