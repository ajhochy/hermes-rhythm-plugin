+import fs from 'node:fs'
+import path from 'node:path'
+import { spawnSync } from 'node:child_process'
+import { fileURLToPath } from 'node:url'
+
+const here = path.dirname(fileURLToPath(import.meta.url))
+const desktopRoot = path.resolve(here, '..', '..')
+const source = path.join(desktopRoot, 'native', 'open-design-job', 'lifecycle-target.cpp')
+
+export function buildWindowsJobLifecycleTarget({ outputPath } = {}) {
+  if (process.platform !== 'win32') throw new Error('Windows lifecycle target can only be compiled on win32')
+  const output = path.resolve(outputPath ?? path.join(desktopRoot, 'build', 'native', 'win32-x64', 'hermes-open-design-job-lifecycle-target.exe'))
+  fs.mkdirSync(path.dirname(output), { recursive: true })
+  const result = spawnSync('cl.exe', ['/nologo', '/W4', '/WX', '/MT', '/O2', '/EHsc', '/std:c++17', '/guard:cf', source, `/Fe${output}`, '/link', '/guard:cf', '/DYNAMICBASE', '/NXCOMPAT', '/HIGHENTROPYVA'], { encoding: 'utf8' })
+  if (result.error || result.status !== 0) throw new Error(`[build-windows-job-lifecycle-target] ${result.error?.message ?? result.stderr ?? result.stdout ?? 'cl.exe failed'}`)
+  return output
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  console.log(buildWindowsJobLifecycleTarget({ outputPath: process.argv[2] }))
+}
