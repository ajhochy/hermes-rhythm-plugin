index 0000000000..47daef2a1a
--- /dev/null
+++ b/apps/desktop/electron/open-design/native-guardian-manifest.test.ts
@@ -0,0 +1,77 @@
+import assert from 'node:assert/strict'
+
+import { test } from 'vitest'
+
+import { type NativeGuardianManifest, parseNativeGuardianManifest, validateNativeGuardianArtifact } from './native-guardian-manifest'
+
+const GOOD_MANIFEST: NativeGuardianManifest = {
+  protocolVersion: 1,
+  sourceCommit: 'fa3cb4cdf3d1703e984a5655bd9654f8d44c493b',
+  target: 'win32-x64',
+  sha256: 'a'.repeat(64)
+}
+
+test('parseNativeGuardianManifest accepts a well-formed manifest', () => {
+  assert.deepEqual(parseNativeGuardianManifest(GOOD_MANIFEST), GOOD_MANIFEST)
+})
+
+test('parseNativeGuardianManifest rejects malformed/missing fields', () => {
+  for (const mutation of [
+    { protocolVersion: 2 },
+    { protocolVersion: undefined },
+    { sourceCommit: 'not-a-sha' },
+    { sourceCommit: 'a'.repeat(39) },
+    { target: '' },
+    { target: undefined },
+    { target: 123 },
+    { sha256: 'z'.repeat(64) },
+    { sha256: 'a'.repeat(63) }
+  ]) {
+    assert.throws(() => parseNativeGuardianManifest({ ...GOOD_MANIFEST, ...mutation }), /manifest/i)
+  }
+})
+
+function makeDeps(overrides = {}) {
+  return {
+    manifest: GOOD_MANIFEST,
+    exePath: 'C:\\Hermes\\resources\\native\\win32-x64\\hermes-open-design-job.exe',
+    expectedTarget: 'win32-x64',
+    expectedProtocolVersion: 1,
+    computeSha256: () => 'a'.repeat(64),
+    ...overrides
+  }
+}
+
+test('validateNativeGuardianArtifact accepts a manifest whose checksum matches the real on-disk file', () => {
+  const result = validateNativeGuardianArtifact(makeDeps())
+  assert.deepEqual(result, { ok: true })
+})
+
+test('rejects a target/architecture mismatch', () => {
+  const result = validateNativeGuardianArtifact(makeDeps({ expectedTarget: 'win32-arm64' }))
+  assert.equal(result.ok, false)
+  assert.match(result.reason, /target|architecture/i)
+})
+
+test('rejects a protocol version mismatch', () => {
+  const result = validateNativeGuardianArtifact(makeDeps({ expectedProtocolVersion: 2 }))
+  assert.equal(result.ok, false)
+  assert.match(result.reason, /protocol/i)
+})
+
+test('rejects a tampered/wrong checksum (the exe on disk does not match its manifest)', () => {
+  const result = validateNativeGuardianArtifact(makeDeps({ computeSha256: () => 'b'.repeat(64) }))
+  assert.equal(result.ok, false)
+  assert.match(result.reason, /checksum|sha256|tamper/i)
+})
+
+test('rejects a missing exe (computeSha256 throws ENOENT-style)', () => {
+  const result = validateNativeGuardianArtifact(makeDeps({
+    computeSha256: () => {
+      throw Object.assign(new Error('ENOENT'), { code: 'ENOENT' })
+    }
+  }))
+
+  assert.equal(result.ok, false)
+  assert.match(result.reason, /missing|not found|ENOENT/i)
+})
diff --git a/apps/desktop/electron/open-design/native-guardian-manifest.ts b/apps/desktop/electron/open-design/native-guardian-manifest.ts
new file mode 100644
index 0000000000..42936db8fe
--- /dev/null
+++ b/apps/desktop/electron/open-design/native-guardian-manifest.ts
@@ -0,0 +1,104 @@
+/**
+ * native-guardian-manifest.ts — validates the staged Windows Job guardian
+ * helper (`hermes-open-design-job.exe`) manifest before the runtime ever
+ * spawns it: protocol version, source commit, target architecture, and a
+ * SHA-256 that must match the exact bytes on disk. A missing, tampered, or
+ * wrong-architecture helper must yield `ownership_unavailable` and refuse an
+ * owned launch -- this module is the fail-closed gate that decision is based
+ * on. Pure/testable: no fs access here; callers read the manifest file and
+ * hash the exe, then pass both in.
+ */
+
+const COMMIT_RE = /^[0-9a-f]{40}$/i
+const SHA256_RE = /^[0-9a-f]{64}$/i
+
+export interface NativeGuardianManifest {
+  protocolVersion: 1
+  sourceCommit: string
+  target: string
+  sha256: string
+}
+
+export function parseNativeGuardianManifest(raw: unknown): NativeGuardianManifest {
+  if (!raw || typeof raw !== 'object') {
+    throw new Error('[open-design native-guardian-manifest] manifest must be an object')
+  }
+
+  const candidate = raw as Partial<NativeGuardianManifest>
+
+  if (candidate.protocolVersion !== 1) {
+    throw new Error(`[open-design native-guardian-manifest] manifest protocolVersion must be exactly 1, got ${JSON.stringify(candidate.protocolVersion)}`)
+  }
+
+  if (typeof candidate.sourceCommit !== 'string' || !COMMIT_RE.test(candidate.sourceCommit)) {
+    throw new Error('[open-design native-guardian-manifest] manifest sourceCommit must be a 40-character hex SHA')
+  }
+
+  if (typeof candidate.target !== 'string' || candidate.target.length === 0) {
+    throw new Error('[open-design native-guardian-manifest] manifest is missing a target')
+  }
+
+  if (typeof candidate.sha256 !== 'string' || !SHA256_RE.test(candidate.sha256)) {
+    throw new Error('[open-design native-guardian-manifest] manifest sha256 must be a 64-character hex digest')
+  }
+
+  return {
+    protocolVersion: 1,
+    sourceCommit: candidate.sourceCommit.toLowerCase(),
+    target: candidate.target,
+    sha256: candidate.sha256.toLowerCase()
+  }
+}
+
+export interface ValidateNativeGuardianArtifactOptions {
+  manifest: NativeGuardianManifest
+  exePath: string
+  expectedTarget: string
+  expectedProtocolVersion: number
+  /** Synchronous SHA-256 of the exe on disk; throws (e.g. ENOENT) if it cannot be read. */
+  computeSha256: (exePath: string) => string
+}
+
+export type ValidateNativeGuardianArtifactResult =
+  | { ok: true }
+  | { ok: false; reason: string }
+
+export function validateNativeGuardianArtifact(
+  options: ValidateNativeGuardianArtifactOptions
+): ValidateNativeGuardianArtifactResult {
+  const { manifest, exePath, expectedTarget, expectedProtocolVersion, computeSha256 } = options
+
+  if (manifest.target !== expectedTarget) {
+    return {
+      ok: false,
+      reason: `guardian manifest target/architecture mismatch: expected ${expectedTarget}, got ${manifest.target}`
+    }
+  }
+
+  if (manifest.protocolVersion !== expectedProtocolVersion) {
+    return {
+      ok: false,
+      reason: `guardian manifest protocol version mismatch: expected ${expectedProtocolVersion}, got ${manifest.protocolVersion}`
+    }
+  }
+
+  let actualSha256: string
+
+  try {
+    actualSha256 = computeSha256(exePath).toLowerCase()
+  } catch (error) {
+    return {
+      ok: false,
+      reason: `guardian executable is missing or unreadable: ${error instanceof Error ? error.message : String(error)}`
+    }
+  }
+
+  if (actualSha256 !== manifest.sha256) {
+    return {
+      ok: false,
+      reason: `guardian executable checksum does not match its manifest (possible tamper): expected ${manifest.sha256}, got ${actualSha256}`
+    }
+  }
+
+  return { ok: true }
+}
