+  for (const checkedPath of [path.dirname(targetPath), targetPath]) {
+    const raw = execFileSync(checkedPath)
+    const result = evaluateGuardianAcl(parseIcaclsOutput(raw, checkedPath), trustedPrincipals)
+
+    if ('reason' in result) {
+      throw new Error(`[open-design windows-guardian-resolver] ownership_unavailable: insecure ACL on ${checkedPath}: ${result.reason}`)
+    }
+  }
+}
+
+// ── Authenticode (Windows-only OS call) ─────────────────────────────────────
+
+export interface VerifyAuthenticodeSignatureOptions {
+  platform?: NodeJS.Platform
+  execFileSync?: (filePath: string) => unknown
+}
+
+function defaultSigntoolVerify(filePath: string): unknown {
+  return nodeExecFileSync('signtool', ['verify', '/pa', '/q', filePath], { windowsHide: true, timeout: 30_000 })
+}
+
+/** True only when the injected/verified `signtool verify /pa` call succeeds. False (never throws) off win32. */
+export function verifyAuthenticodeSignature(filePath: string, options: VerifyAuthenticodeSignatureOptions = {}): boolean {
+  const platform = options.platform ?? process.platform
+
+  if (platform !== 'win32') {
+    return false
+  }
+
+  const execFileSync = options.execFileSync ?? defaultSigntoolVerify
+
+  try {
+    execFileSync(filePath)
+
+    return true
+  } catch {
+    return false
+  }
+}
+
+// ── Composed production resolver ────────────────────────────────────────────
+
+export interface CreateProductionGuardianArtifactResolverOptions {
+  guardianDir: string
+  expectedSourceCommit: string
+  expectedTarget?: string
+  platform?: NodeJS.Platform
+  /** Packaged production builds require a verified signature; unpackaged dev/CI runs stay report-only. */
+  isPackaged?: () => boolean
+  trustedAclPrincipals?: readonly string[]
+  readManifest?: (manifestPath: string) => unknown
+  computeSha256?: (exePath: string) => string
+  resolveCanonicalPath?: (exePath: string) => string
+  isRegularFile?: (exePath: string) => boolean
+  readPeMachine?: (exePath: string) => number | null
+  checkAcl?: (exePath: string) => void
+  verifySignature?: (exePath: string) => boolean
+}
+
+function defaultReadManifestFile(manifestPath: string): unknown {
+  return JSON.parse(fs.readFileSync(manifestPath, 'utf8'))
+}
+
+/**
+ * Returns a `() => string` matching
+ * `CreateWindowsOwnedRuntimeDepsOptions.resolveValidatedGuardianExePath`
+ * exactly. Every call independently re-reads the manifest, re-checks the
+ * ACL, and re-validates hash/PE/commit/signature from disk -- see this
+ * module's header comment for why no result is ever cached.
+ */
+export function createProductionGuardianArtifactResolver(
+  options: CreateProductionGuardianArtifactResolverOptions
+): () => string {
+  const expectedTarget = options.expectedTarget ?? 'win32-x64'
+  const isPackaged = options.isPackaged ?? (() => true)
+  const readManifest = options.readManifest ?? defaultReadManifestFile
+  const computeSha256 = options.computeSha256 ?? computeSha256OfFile
+  const resolveCanonicalPath = options.resolveCanonicalPath ?? resolveCanonicalFilePath
+  const isRegularFile = options.isRegularFile ?? isRegularFileStrict
+  const readPeMachine = options.readPeMachine ?? readPeMachineFromFile
+
+  const checkAcl = options.checkAcl ?? (exePath => assertSecureGuardianAcl(exePath, {
+    platform: options.platform,
+    trustedPrincipals: options.trustedAclPrincipals
+  }))
+
+  const verifySignature = options.verifySignature ?? (exePath => verifyAuthenticodeSignature(exePath, { platform: options.platform }))
+
+  return () => {
+    const platform = options.platform ?? process.platform
+
+    if (platform !== 'win32') {
+      throw new Error('[open-design windows-guardian-resolver] ownership_unavailable: the Job guardian is Windows-only')
+    }
+
+    const { exePath, manifestPath } = resolveGuardianArtifactPaths(options.guardianDir)
+
+    let manifest: NativeGuardianManifest
+
+    try {
+      manifest = parseNativeGuardianManifest(readManifest(manifestPath))
+    } catch (error) {
+      throw new Error(`[open-design windows-guardian-resolver] ownership_unavailable: ${detailFor(error)}`)
+    }
+
+    // Ordered before hash/PE/signature: an untrusted-writable staging
+    // location makes every check below meaningless, since the artifact could
+    // be swapped again immediately after passing them.
+    checkAcl(exePath)
+
+    const result = validateNativeGuardianArtifact({
+      manifest,
+      exePath,
+      expectedTarget,
+      expectedSourceCommit: options.expectedSourceCommit,
+      expectedProtocolVersion: 1,
+      computeSha256,
+      resolveCanonicalPath,
+      isRegularFile,
+      readPeMachine,
+      signingPolicy: isPackaged() ? 'required' : 'report-only',
+      verifySignature
+    })
+
+    if ('reason' in result) {
+      throw new Error(`[open-design windows-guardian-resolver] ownership_unavailable: ${result.reason}`)
+    }
+
+    return exePath
+  }
+}
