+      if (entryOffset + 8 > buffer.length) return null
+      const cpuType = bigEndian ? buffer.readUInt32BE(entryOffset) : buffer.readUInt32LE(entryOffset)
+      architectures.push(cpuTypeToArchitecture(cpuType))
+    }
+    return architectures
+  }
+
+  return null
+}
