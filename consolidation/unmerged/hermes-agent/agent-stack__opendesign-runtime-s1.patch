+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+
+import { toOpenDesignNamespace } from '../../electron/open-design/namespace.js'
+
+const PROFILE_ID_RE = /^[a-z0-9][a-z0-9_-]{0,63}$/
+
+function defaultHermesRoot({ env, homeDir, platform, pathModule }) {
+  if (platform === 'win32') {
+    const localAppData = typeof env.LOCALAPPDATA === 'string' ? env.LOCALAPPDATA.trim() : ''
+    return pathModule.join(localAppData || pathModule.join(homeDir, 'AppData', 'Local'), 'hermes')
+  }
+
+  return pathModule.join(homeDir, '.hermes')
+}
+
+function assertProfileName(value) {
+  if (!PROFILE_ID_RE.test(value)) {
+    throw new Error('[open-design live-smoke] active profile selector is invalid')
+  }
+}
+
+function resolveExistingDirectory(value, label, { isDirectory, pathModule }) {
+  if (typeof value !== 'string' || value.includes('\0') || value.includes('\r') || value.includes('\n')) {
+    throw new Error(`[open-design live-smoke] ${label} must be a trusted absolute directory`)
+  }
+
+  const candidate = value.trim()
+
+  if (!candidate || !pathModule.isAbsolute(candidate)) {
+    throw new Error(`[open-design live-smoke] ${label} must be a trusted absolute directory`)
+  }
+
+  const resolved = pathModule.resolve(candidate)
+
+  if (!isDirectory(resolved)) {
+    throw new Error(`[open-design live-smoke] ${label} must reference an existing directory`)
+  }
+
+  return resolved
+}
+
+function readActiveProfile(root, { fileExists, readText, pathModule }) {
+  const selector = pathModule.join(root, 'active_profile')
+
+  if (!fileExists(selector)) {
+    return 'default'
+  }
+
+  let value
+  try {
+    value = readText(selector)
+  } catch {
+    throw new Error('[open-design live-smoke] active profile selector could not be read')
+  }
+
+  if (typeof value !== 'string') {
+    throw new Error('[open-design live-smoke] active profile selector is invalid')
+  }
+
+  const profile = value.trim()
+
+  if (!profile || profile === 'default') {
+    return 'default'
+  }
+
+  assertProfileName(profile)
+  return profile
+}
+
+/**
+ * Mirrors Hermes CLI startup profile precedence without reading config or
+ * credentials: a profile-scoped HERMES_HOME wins; otherwise the root's
+ * sticky active_profile selects a named profile; no selector means default.
+ */
+export function resolveLiveSmokeProfileHome({
+  env = process.env,
+  homeDir = os.homedir(),
+  platform = process.platform,
+  pathModule = platform === 'win32' ? path.win32 : path.posix,
+  isDirectory = candidate => {
+    try {
+      return fs.statSync(candidate).isDirectory()
+    } catch {
+      return false
+    }
+  },
+  fileExists = candidate => fs.existsSync(candidate),
+  readText = candidate => fs.readFileSync(candidate, 'utf8')
+} = {}) {
+  const rawHermesHome = env.HERMES_HOME
+  if (rawHermesHome !== undefined && typeof rawHermesHome !== 'string') {
+    throw new Error('[open-design live-smoke] HERMES_HOME must be a trusted absolute directory')
+  }
+
+  // Keep Hermes' empty/unset default behavior, but do not silently normalize
+  // control bytes in a caller-supplied path into a trusted filesystem target.
+  const configured = rawHermesHome?.trim() ? rawHermesHome : ''
+  const rootOrProfileHome = resolveExistingDirectory(
+    configured || defaultHermesRoot({ env, homeDir, platform, pathModule }),
+    'HERMES_HOME',
+    { isDirectory, pathModule }
+  )
+  const profileParent = pathModule.dirname(rootOrProfileHome)
+
+  if (pathModule.basename(profileParent).toLowerCase() === 'profiles') {
+    const profile = pathModule.basename(rootOrProfileHome)
+    assertProfileName(profile)
+    return { hermesHome: rootOrProfileHome, profile, source: 'explicit-profile' }
+  }
+
+  const profile = readActiveProfile(rootOrProfileHome, { fileExists, readText, pathModule })
+
+  if (profile === 'default') {
+    return { hermesHome: rootOrProfileHome, profile, source: 'default' }
+  }
+
+  const profilesRoot = pathModule.join(rootOrProfileHome, 'profiles')
+  const hermesHome = pathModule.resolve(profilesRoot, profile)
+
+  if (pathModule.dirname(hermesHome) !== pathModule.resolve(profilesRoot)) {
+    throw new Error('[open-design live-smoke] active profile escaped the profile root')
+  }
+
+  if (!isDirectory(hermesHome)) {
+    throw new Error('[open-design live-smoke] selected active profile directory is unavailable')
+  }
+
+  return { hermesHome, profile, source: 'active-profile' }
+}
+
+/** A fresh opaque namespace is owned only by this smoke invocation. */
+export function createLiveSmokeNamespace(randomUUID = cryptoRandomUuid) {
+  const entropy = randomUUID()
+
+  if (typeof entropy !== 'string' || !/^[a-f0-9-]{16,}$/i.test(entropy)) {
+    throw new Error('[open-design live-smoke] namespace entropy was invalid')
+  }
+
+  return toOpenDesignNamespace(`live-smoke-${entropy}`)
+}
+
+function cryptoRandomUuid() {
+  return globalThis.crypto.randomUUID()
+}
