+  20_000
+)
+
+test.skipIf(process.platform !== 'win32')(
+  'real compiled guardian: a naturally exiting target proves graceful EMPTY, while an explicit FORCE proves forced EMPTY',
+  async () => {
+    const graceful = await spawnLifecycleTarget(path.join(guardianDir, 'graceful-empty.txt'), 'exit')
+    assert.equal(await graceful.waitForEmpty(10_000), 'graceful')
+    await waitForProcessGone(graceful.targetPid)
+
+    const forced = await spawnLifecycleTarget(path.join(guardianDir, 'forced-empty.txt'), 'pressure')
+    assert.equal(await forced.requestForce(10_000), 'forced')
+    await waitForProcessGone(forced.targetPid)
+  },
+  25_000
+)
+
+test.skipIf(process.platform !== 'win32')(
+  'real compiled guardian: two independent concurrent runtimes never cross-own each other during stop/start pressure',
+  async () => {
+    const [first, second] = await Promise.all([
+      spawnLifecycleTarget(path.join(guardianDir, 'namespace-one.txt'), 'pressure'),
+      spawnLifecycleTarget(path.join(guardianDir, 'namespace-two.txt'), 'pressure')
+    ])
+    assert.notEqual(first.targetPid, second.targetPid)
+    assert.equal(await first.requestForce(10_000), 'forced')
+    await waitForProcessGone(first.targetPid)
+    assert.equal((await second.requestStatus(5_000)).state, 'live', 'stopping one guardian must not affect another Job namespace')
+    assert.equal(await second.requestForce(10_000), 'forced')
+    await waitForProcessGone(second.targetPid)
+  },
+  25_000
+)
+
+test.skipIf(process.platform !== 'win32')(
+  'real compiled guardian: full handshake, STATUS, and FORCE lifecycle through the real adapter, no fixture involved',
+  async () => {
+    const handle = await spawnWindowsJobGuardian({
+      guardianExePath,
+      targetExecutablePath: process.execPath,
+      targetArgs: IDLE_TARGET_ARGS,
+      expectedSourceCommit: REAL_TEST_COMMIT,
+      platform: 'win32',
+      spawn: realSpawn as any,
+      readyTimeoutMs: 10_000
+    })
+
+    assert.ok(Number.isInteger(handle.targetPid) && handle.targetPid > 0)
+    assert.ok(Number.isInteger(handle.guardianPid) && handle.guardianPid > 0)
+    assert.notEqual(handle.targetPid, handle.guardianPid)
+
+    const status = await handle.requestStatus(5_000)
+    assert.equal(status.state, 'live')
+    assert.equal(status.pid, handle.targetPid)
