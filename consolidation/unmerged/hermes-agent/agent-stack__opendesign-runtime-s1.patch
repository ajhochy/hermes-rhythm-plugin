@@ -0,0 +1,76 @@
+name: Desktop Windows Job guardian
+
+# Real Windows x64 build + test lane for the Open Design Windows Job Object
+# guardian (P1-3, apps/desktop/native/open-design-job/guardian.cpp). Every
+# other desktop lane runs on Linux/macOS and can only exercise the guardian's
+# TS-side protocol/adapter logic against a Node-based fixture -- this is the
+# one lane that actually compiles the native helper with MSVC on a real
+# Windows host and runs the desktop suite under a genuine win32 runtime.
+#
+# STATUS: this lane proves the guardian compiles with the required hardening
+# flags and that the desktop test suite (including every Windows-gated
+# protocol/identity/readiness test) passes on a real Windows host. It does
+# NOT yet run the deeper native Job Object lifecycle/crash matrix (suspended
+# launch timing, parent/child/grandchild containment, breakaway denial,
+# forced/graceful EMPTY proof, nested outer Jobs, PID-churn, concurrent
+# child-launch pressure) -- those require dedicated Win32-API-level test
+# tooling that has never been exercised against a real Windows host and must
+# not be fabricated untested. That matrix, PE signing verification, and
+# installed NSIS/MSI smoke remain the mandatory follow-up gate before
+# production acceptance (see the authoritative repair brief's P1-3 section).
+
+on:
+  workflow_call:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: desktop-windows-guardian-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  guardian:
+    name: Compile guardian + desktop suite (windows-latest)
+    runs-on: windows-latest
+    timeout-minutes: 20
+    steps:
+      - name: Checkout code
+        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
+
+      # Sets up cl.exe/rc.exe/link.exe on PATH for the x64 host/target the
