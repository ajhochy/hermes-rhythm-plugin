+import assert from 'node:assert/strict'
+
+import { test } from 'vitest'
+
+import {
+  parseOpenDesignRuntimeManifest,
+  resolveOpenDesignAsset,
+  resolveOpenDesignPlatformKey
+} from './manifest'
+
+const RAW_CONTRACT = {
+  openDesign: {
+    repository: 'nexu-io/open-design',
+    license: 'Apache-2.0',
+    tag: 'open-design-v0.20.0',
+    commit: 'fa3cb4cdf3d1703e984a5655bd9654f8d44c493b',
+    assets: {
+      'darwin-arm64': {
+        name: 'open-design-0.20.0-mac-arm64.dmg',
+        sha256: '85d30826ba46729f45bf059c76e710e760e2b6bfc2c57218e311027cbb0cbcd5'
+      },
+      'darwin-x64': {
+        name: 'open-design-0.20.0-mac-x64.dmg',
+        sha256: 'b7217e661d14bc2c4d0d7bb7bb996a5bfcfa23ee3f09671385f56baa68263de3'
+      },
+      'win32-x64': {
+        name: 'open-design-0.20.0-win-x64-setup.exe',
+        sha256: '9788a6a7a3ff1c6e31b41756fb1ecd631b54307acfed5937bfe5b1bd0000d9b8'
+      }
+    }
+  }
+}
+
+test('resolveOpenDesignPlatformKey joins platform and arch with a hyphen', () => {
+  assert.equal(resolveOpenDesignPlatformKey('darwin', 'arm64'), 'darwin-arm64')
+  assert.equal(resolveOpenDesignPlatformKey('win32', 'x64'), 'win32-x64')
+})
+
+test('parseOpenDesignRuntimeManifest pins tag, commit, license, and version parsed from the tag', () => {
+  const manifest = parseOpenDesignRuntimeManifest(RAW_CONTRACT)
+
+  assert.equal(manifest.version, '0.20.0')
+  assert.equal(manifest.tag, 'open-design-v0.20.0')
+  assert.equal(manifest.commit, 'fa3cb4cdf3d1703e984a5655bd9654f8d44c493b')
+  assert.equal(manifest.repository, 'nexu-io/open-design')
+  assert.equal(manifest.license, 'Apache-2.0')
+  assert.deepEqual(manifest.assets['darwin-arm64'], RAW_CONTRACT.openDesign.assets['darwin-arm64'])
+})
+
+test('parseOpenDesignRuntimeManifest rejects a malformed tag', () => {
+  assert.throws(
+    () =>
+      parseOpenDesignRuntimeManifest({
+        openDesign: { ...RAW_CONTRACT.openDesign, tag: 'not-a-version-tag' }
+      }),
+    /tag/i
+  )
+})
+
+test('parseOpenDesignRuntimeManifest rejects a missing/short commit SHA', () => {
+  assert.throws(
+    () =>
+      parseOpenDesignRuntimeManifest({
+        openDesign: { ...RAW_CONTRACT.openDesign, commit: 'abc123' }
+      }),
+    /commit/i
+  )
+})
+
+test('parseOpenDesignRuntimeManifest rejects a non-Apache license', () => {
+  assert.throws(
+    () =>
+      parseOpenDesignRuntimeManifest({
+        openDesign: { ...RAW_CONTRACT.openDesign, license: 'MIT' }
+      }),
+    /license/i
+  )
+})
+
+test('resolveOpenDesignAsset returns the pinned asset for a supported platform/arch', () => {
+  const manifest = parseOpenDesignRuntimeManifest(RAW_CONTRACT)
+  const asset = resolveOpenDesignAsset(manifest, 'darwin', 'arm64')
+
+  assert.deepEqual(asset, RAW_CONTRACT.openDesign.assets['darwin-arm64'])
+})
+
+test('resolveOpenDesignAsset returns null for an unsupported platform/arch', () => {
+  const manifest = parseOpenDesignRuntimeManifest(RAW_CONTRACT)
+
+  assert.equal(resolveOpenDesignAsset(manifest, 'linux', 'x64'), null)
+  assert.equal(resolveOpenDesignAsset(manifest, 'darwin', 'ia32'), null)
+})
diff --git a/apps/desktop/electron/open-design/manifest.ts b/apps/desktop/electron/open-design/manifest.ts
new file mode 100644
index 0000000000..48fdd4cdbe
--- /dev/null
+++ b/apps/desktop/electron/open-design/manifest.ts
@@ -0,0 +1,104 @@
+/**
+ * manifest.ts — versioned Open Design runtime manifest sourced from the
+ * frozen `open-design-integration.contract.json`.
+ *
+ * Pure/testable: takes an already-parsed contract object (the caller reads
+ * the JSON file) and produces a validated, typed manifest. No fs/network.
+ */
+
+export interface OpenDesignAssetInfo {
+  name: string
+  sha256: string
+}
+
+export interface OpenDesignRuntimeManifest {
+  /** Semver parsed from the contract's `tag` (e.g. "0.20.0"). */
+  version: string
+  tag: string
+  commit: string
+  repository: string
+  license: string
+  assets: Record<string, OpenDesignAssetInfo>
+}
+
+export interface OpenDesignContractShape {
+  openDesign: {
+    repository: string
+    license: string
+    tag: string
+    commit: string
+    assets: Record<string, OpenDesignAssetInfo>
+  }
+}
+
+const TAG_VERSION_RE = /^open-design-v(\d+\.\d+\.\d+)$/
+const COMMIT_RE = /^[0-9a-f]{40}$/i
+
+export function resolveOpenDesignPlatformKey(platform: string, arch: string): string {
+  return `${platform}-${arch}`
+}
+
+export function parseOpenDesignRuntimeManifest(contract: OpenDesignContractShape): OpenDesignRuntimeManifest {
+  const openDesign = contract?.openDesign
+
+  if (!openDesign || typeof openDesign !== 'object') {
+    throw new Error('[open-design manifest] contract is missing an "openDesign" section')
+  }
+
+  const tagMatch = TAG_VERSION_RE.exec(String(openDesign.tag ?? ''))
+
+  if (!tagMatch) {
+    throw new Error(`[open-design manifest] invalid tag: ${JSON.stringify(openDesign.tag)} (expected "open-design-v<semver>")`)
+  }
+
+  if (!COMMIT_RE.test(String(openDesign.commit ?? ''))) {
+    throw new Error(`[open-design manifest] invalid commit SHA: ${JSON.stringify(openDesign.commit)}`)
+  }
+
+  if (String(openDesign.license ?? '') !== 'Apache-2.0') {
+    throw new Error(`[open-design manifest] unexpected license: ${JSON.stringify(openDesign.license)} (expected "Apache-2.0")`)
+  }
+
+  if (!openDesign.repository || typeof openDesign.repository !== 'string') {
+    throw new Error('[open-design manifest] missing "repository"')
+  }
+
+  if (!openDesign.assets || typeof openDesign.assets !== 'object') {
+    throw new Error('[open-design manifest] missing "assets"')
+  }
+
+  for (const [key, asset] of Object.entries(openDesign.assets)) {
+    if (!asset || typeof asset.name !== 'string' || !asset.name) {
+      throw new Error(`[open-design manifest] asset "${key}" is missing a name`)
+    }
+
+    if (typeof asset.sha256 !== 'string' || !/^[0-9a-f]{64}$/i.test(asset.sha256)) {
+      throw new Error(`[open-design manifest] asset "${key}" has an invalid sha256`)
+    }
+  }
+
+  return {
+    version: tagMatch[1],
+    tag: openDesign.tag,
+    commit: openDesign.commit,
+    repository: openDesign.repository,
+    license: openDesign.license,
+    assets: { ...openDesign.assets }
+  }
+}
+
+export function resolveOpenDesignAsset(
+  manifest: OpenDesignRuntimeManifest,
+  platform: string,
+  arch: string
+): OpenDesignAssetInfo | null {
+  return manifest.assets[resolveOpenDesignPlatformKey(platform, arch)] ?? null
+}
+
+export function isOpenDesignPlatformSupported(
+  manifest: OpenDesignRuntimeManifest,
+  platform: string,
+  arch: string
+): boolean {
+  return resolveOpenDesignAsset(manifest, platform, arch) !== null
+}
