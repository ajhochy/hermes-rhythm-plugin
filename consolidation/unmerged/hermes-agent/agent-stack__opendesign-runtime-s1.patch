+++ b/apps/desktop/electron/open-design/windows-job-guardian.real-exe.test.ts
@@ -0,0 +1,325 @@
+/**
+ * windows-job-guardian.real-exe.test.ts — drives the REAL compiled
+ * hermes-open-design-job.exe (native/open-design-job/guardian.cpp) through
+ * the real, non-injected `spawnWindowsJobGuardian` adapter end-to-end.
+ *
+ * Every other test in windows-job-guardian.test.ts spawns
+ * fixtures/fake-job-guardian.mjs -- a Node.js process that speaks the
+ * protocol but never touches a real Win32 Job Object or a real
+ * WriteConsoleW/WriteFile-backed stdout. That fixture masked the exact P0
+ * CRLF handshake defect (guardian.cpp emitted CRLF; the adapter rejected the
+ * retained \r), because the fixture always wrote bare LF. This file compiles
+ * and runs the actual native binary so that class of defect can never hide
+ * behind the fixture again.
+ *
+ * Windows-only: compiling requires a real MSVC toolchain (cl.exe/rc.exe on
+ * PATH, e.g. via ilammy/msvc-dev-cmd in .github/workflows/desktop-windows-guardian.yml)
+ * and the guardian's own Win32 APIs (CreateJobObjectW, AssignProcessToJobObject,
+ * ...) only exist on win32. An honest skip elsewhere is correct; a skip ON
+ * win32 (e.g. a missing toolchain) is not -- this suite fails loudly in that
+ * case rather than silently passing.
+ */
+
+import assert from 'node:assert/strict'
+import { spawn } from 'node:child_process'
+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+
+import { afterAll, beforeAll, test } from 'vitest'
+
+import { buildWindowsJobGuardian } from '../../scripts/open-design/build-windows-job-guardian.mjs'
+import { buildWindowsJobLifecycleTarget } from '../../scripts/open-design/build-windows-job-lifecycle-target.mjs'
+
+import { spawnWindowsJobGuardian } from './windows-job-guardian'
+
+const REAL_TEST_COMMIT = 'abcdef0123456789abcdef0123456789abcdef01'
+const OTHER_COMMIT = '0'.repeat(40)
+
+let guardianDir: string
+let guardianExePath: string
+let lifecycleTargetPath: string
+
+async function realSpawn(command: string, args: string[]) {
+  return spawn(command, args, { stdio: ['pipe', 'pipe', 'pipe'], windowsHide: true } as any) as any
+}
+
+// A trivial, real, controllable target: the same node.exe running these
+// tests, idling long enough for the test to drive the guardian's protocol
+// before it would exit on its own. This guardian only needs a valid PE it
+// can CreateProcess -- it has no dependency on a staged Open Design payload.
+const IDLE_TARGET_ARGS = ['-e', 'setTimeout(() => {}, 60000)']
+
+async function waitForReport(reportPath: string, pattern: RegExp, timeoutMs = 5_000): Promise<string> {
+  const deadline = Date.now() + timeoutMs
+  let contents = ''
+
+  while (Date.now() < deadline) {
+    try {
+      contents = fs.readFileSync(reportPath, 'utf8')
+    } catch {
+      // The target has not created its report yet.
+    }
+
+    if (pattern.test(contents)) {
+      return contents
+    }
+
+    await new Promise(resolve => setTimeout(resolve, 25))
+  }
+
+  throw new Error(`timed out waiting for ${pattern} in lifecycle report: ${contents}`)
+}
+
+async function waitForProcessGone(pid: number, timeoutMs = 10_000): Promise<void> {
+  const deadline = Date.now() + timeoutMs
+
+  while (Date.now() < deadline) {
+    try {
+      process.kill(pid, 0)
+    } catch {
+      return
+    }
+    await new Promise(resolve => setTimeout(resolve, 25))
+  }
+
+  throw new Error(`process ${pid} remained alive after ${timeoutMs}ms`)
+}
+
+function reportPids(report: string, key: string): number[] {
+  return [...report.matchAll(new RegExp(`^${key}=(\\d+)$`, 'gm'))].map(match => Number(match[1]))
+}
+
+function spawnLifecycleTarget(reportPath: string, mode: string) {
+  return spawnWindowsJobGuardian({
+    guardianExePath,
+    targetExecutablePath: lifecycleTargetPath,
+    targetArgs: ['--report', reportPath, '--mode', mode],
+    expectedSourceCommit: REAL_TEST_COMMIT,
+    platform: 'win32',
+    spawn: realSpawn as any,
+    readyTimeoutMs: 10_000
+  })
+}
+
+beforeAll(async () => {
+  if (process.platform !== 'win32') {
+    return
+  }
+
+  guardianDir = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), 'hermes-guardian-real-exe-')))
+  const outputPath = path.join(guardianDir, 'hermes-open-design-job.exe')
+
+  const result = await buildWindowsJobGuardian({
+    sourceCommit: REAL_TEST_COMMIT,
+    platform: 'win32',
+    outputPath
+  })
+
+  guardianExePath = result.outputPath
+  lifecycleTargetPath = buildWindowsJobLifecycleTarget({ outputPath: path.join(guardianDir, 'hermes-open-design-job-lifecycle-target.exe') })
+}, 60_000)
+
+afterAll(() => {
+  if (guardianDir) {
+    fs.rmSync(guardianDir, { recursive: true, force: true })
+  }
+})
+
+test.skipIf(process.platform !== 'win32')(
+  'real compiled guardian: assign-before-resume and child-launch pressure are observed by a native target through the real adapter',
+  async () => {
+    const reportPath = path.join(guardianDir, 'lifecycle.txt')
+    const handle = await spawnWindowsJobGuardian({
+      guardianExePath,
+      targetExecutablePath: lifecycleTargetPath,
+      targetArgs: ['--report', reportPath, '--mode', 'pressure'],
+      expectedSourceCommit: REAL_TEST_COMMIT,
+      platform: 'win32',
+      spawn: realSpawn as any,
+      readyTimeoutMs: 10_000
+    })
+    const report = await waitForReport(reportPath, /^in_job=1$/m)
+    assert.match(report, /^target_pid=\d+$/m)
+    await waitForReport(reportPath, /spawned_pid=\d+/)
+    assert.equal(await handle.requestForce(10_000), 'forced')
+    assert.throws(() => process.kill(handle.targetPid, 0))
+  },
+  25_000
+)
+
+test.skipIf(process.platform !== 'win32')(
+  'real compiled guardian: parent, child, and grandchild are all actual Job members and FORCE removes the complete process tree',
+  async () => {
+    const reportPath = path.join(guardianDir, 'descendants.txt')
+    const handle = await spawnLifecycleTarget(reportPath, 'descendants')
+    const report = await waitForReport(reportPath, /^grandchild_in_job=1$/m)
+    const childPids = reportPids(report, 'child_pid')
+    const grandchildPids = reportPids(report, 'grandchild_pid')
+
+    assert.match(report, /^in_job=1$/m, 'the direct target executes its first instruction as a Job member')
+    assert.match(report, /^child_in_job=1$/m, 'a real child inherits Job membership')
+    assert.match(report, /^grandchild_in_job=1$/m, 'a real grandchild inherits Job membership')
+    assert.ok(childPids.length >= 1)
+    assert.ok(grandchildPids.length >= 1)
+    assert.equal(await handle.requestForce(10_000), 'forced')
+    await Promise.all([handle.targetPid, ...childPids, ...grandchildPids].map(pid => waitForProcessGone(pid)))
+  },
+  25_000
+)
+
+test.skipIf(process.platform !== 'win32')(
+  'real compiled guardian: breakaway denial is observed by a native target through the real adapter',
+  async () => {
+    const reportPath = path.join(guardianDir, 'breakaway.txt')
+    const handle = await spawnWindowsJobGuardian({
+      guardianExePath,
+      targetExecutablePath: lifecycleTargetPath,
+      targetArgs: ['--report', reportPath, '--mode', 'breakaway'],
+      expectedSourceCommit: REAL_TEST_COMMIT,
+      platform: 'win32',
+      spawn: realSpawn as any,
+      readyTimeoutMs: 10_000
+    })
+    const report = await waitForReport(reportPath, /^breakaway_error=\d+$/m)
+    assert.doesNotMatch(report, /breakaway_pid=/)
+    await handle.requestForce(10_000)
+  },
+  20_000
+)
+
+test.skipIf(process.platform !== 'win32')(
+  'real compiled guardian: parent control EOF is fail-closed and kills the real owned Job',
+  async () => {
+    const handle = await spawnLifecycleTarget(path.join(guardianDir, 'parent-eof.txt'), 'pressure')
+    const empty = handle.waitForEmpty(10_000)
+    handle.process.stdin.end()
+    assert.equal(await empty, 'forced')
+    await waitForProcessGone(handle.targetPid)
+  },
+  20_000
+)
+
+test.skipIf(process.platform !== 'win32')(
+  'real compiled guardian: helper crash invokes KILL_ON_JOB_CLOSE and leaves no owned target alive',
+  async () => {
+    const handle = await spawnLifecycleTarget(path.join(guardianDir, 'helper-crash.txt'), 'pressure')
+    ;(handle.process as any).kill()
+    await waitForProcessGone(handle.targetPid)
+  },
+  20_000
+)
+
+test.skipIf(process.platform !== 'win32')(
+  'real compiled guardian: a crashing guest parent cannot strand stubborn descendants',
+  async () => {
+    const reportPath = path.join(guardianDir, 'guest-crash.txt')
+    const handle = await spawnLifecycleTarget(reportPath, 'crash')
+    const report = await waitForReport(reportPath, /spawned_pid=\d+/)
