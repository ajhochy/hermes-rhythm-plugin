+  telemetryRelayUrl: 'https://telemetry.example.com/relay',
+  updateMetadataUrl: 'https://updates.example.com/latest.json',
+  velaWebUrl: 'https://vela.example.com',
+  velaWebUrls: { prod: 'https://vela.example.com', test: 'https://vela-test.example.com' }
+}
+
+const CONTEXT = {
+  namespace: 'hz-default-abc123',
+  namespaceBaseRoot: '/Users/me/.hermes/open-design/hz-default-abc123/runtime'
