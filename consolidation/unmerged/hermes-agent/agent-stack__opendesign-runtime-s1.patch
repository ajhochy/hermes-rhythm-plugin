index 0000000000..d63abb015d
--- /dev/null
+++ b/apps/desktop/electron/open-design/hermes-bin.test.ts
@@ -0,0 +1,235 @@
+import assert from 'node:assert/strict'
+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+
+import { test } from 'vitest'
+
+import { resolveValidatedHermesBin } from './hermes-bin'
+
+function makeExecutableFixture(): { root: string; execPath: string } {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'hermes-od-bin-'))
+  const execPath = path.join(root, 'hermes')
+  fs.writeFileSync(execPath, '#!/bin/sh\necho hermes\n', { mode: 0o755 })
+
+  return { root, execPath }
+}
+
+test('accepts an absolute, existing, executable POSIX file and returns it unchanged', () => {
+  const { root, execPath } = makeExecutableFixture()
+
+  try {
+    const resolved = resolveValidatedHermesBin(execPath, { platform: 'darwin' })
+    assert.equal(resolved, execPath)
+  } finally {
+    fs.rmSync(root, { recursive: true, force: true })
+  }
+})
+
+test('rejects a bare command name (the exact bug: Open Design silently falls back to PATH)', () => {
+  assert.throws(() => resolveValidatedHermesBin('hermes', { platform: 'darwin' }), /absolute/i)
+})
+
+test('rejects a relative path', () => {
+  assert.throws(() => resolveValidatedHermesBin('./hermes', { platform: 'darwin' }), /absolute/i)
+  assert.throws(() => resolveValidatedHermesBin('../bin/hermes', { platform: 'darwin' }), /absolute/i)
+})
+
+test('rejects a missing file', () => {
+  assert.throws(
+    () => resolveValidatedHermesBin('/definitely/does/not/exist/hermes', { platform: 'darwin' }),
+    /does not exist/i
+  )
+})
+
+test('rejects a directory', () => {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'hermes-od-bin-dir-'))
+
+  try {
+    assert.throws(() => resolveValidatedHermesBin(root, { platform: 'darwin' }), /regular executable file/i)
+  } finally {
+    fs.rmSync(root, { recursive: true, force: true })
+  }
+})
+
+test('rejects a non-executable regular file on POSIX', () => {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'hermes-od-bin-noexec-'))
+  const filePath = path.join(root, 'hermes')
+  fs.writeFileSync(filePath, 'not a script', { mode: 0o644 })
+
+  try {
+    assert.throws(() => resolveValidatedHermesBin(filePath, { platform: 'darwin' }), /not executable/i)
+  } finally {
+    fs.rmSync(root, { recursive: true, force: true })
+  }
+})
+
+test('rejects empty, whitespace-only, and control-character-bearing candidates', () => {
+  for (const candidate of ['', '   ', 'hermes\0evil', 'hermes\nevil', 'hermes\revil']) {
+    assert.throws(() => resolveValidatedHermesBin(candidate, { platform: 'darwin' }))
+  }
+})
+
+test('Windows: accepts an absolute path with a PATHEXT-recognized extension', () => {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'hermes-od-bin-win-'))
+  const execPath = path.join(root, 'hermes.exe')
+  fs.writeFileSync(execPath, 'not really a PE binary, just needs to be a regular file')
+
+  try {
+    const resolved = resolveValidatedHermesBin(execPath, { platform: 'win32' })
+    assert.equal(resolved, path.resolve(execPath))
+  } finally {
+    fs.rmSync(root, { recursive: true, force: true })
+  }
+})
+
+test('Windows: rejects an extensionless absolute path even if it is a regular file', () => {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'hermes-od-bin-win-noext-'))
+  const execPath = path.join(root, 'hermes')
+  fs.writeFileSync(execPath, 'no extension')
+
+  try {
+    assert.throws(() => resolveValidatedHermesBin(execPath, { platform: 'win32' }), /PATHEXT/i)
+  } finally {
+    fs.rmSync(root, { recursive: true, force: true })
+  }
+})
+
+test('Windows: rejects an incompatible extension not present in PATHEXT', () => {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'hermes-od-bin-win-badext-'))
+  const execPath = path.join(root, 'hermes.txt')
+  fs.writeFileSync(execPath, 'not executable on windows')
+
+  try {
+    assert.throws(() => resolveValidatedHermesBin(execPath, { platform: 'win32' }), /PATHEXT/i)
+  } finally {
+    fs.rmSync(root, { recursive: true, force: true })
+  }
+})
+
+test('Windows: never requires POSIX X_OK access (PATHEXT alone governs executability)', () => {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'hermes-od-bin-win-cmd-'))
+  const execPath = path.join(root, 'hermes.cmd')
+  fs.writeFileSync(execPath, 'not executable bits set', { mode: 0o644 })
+
+  try {
+    const resolved = resolveValidatedHermesBin(execPath, { platform: 'win32' })
+    assert.equal(resolved, path.resolve(execPath))
+  } finally {
+    fs.rmSync(root, { recursive: true, force: true })
+  }
+})
+
+// Pinned-source contract: a faithful port of the exact acceptance algorithm
+// the checksum-pinned Open Design 0.20.0 guest applies to a HERMES_BIN-style
+// agent override -- `executableFilePath()` /  `looksExecutableOnWindows()` in
+// `apps/daemon/src/runtimes/executables.ts` at commit
+// fa3cb4cdf3d1703e984a5655bd9654f8d44c493b (tag open-design-v0.20.0). Mirrors
+// the pinned guest's exact behavior (including that it never throws -- it
+// silently returns null and Open Design then falls back to PATH), so this
+// test proves our resolver never accepts a value the guest would discard, and
+// that whatever we DO accept, the guest's own algorithm resolves to that
+// exact same absolute path -- i.e. Open Design actually selects the supplied
+// override rather than its own PATH search.
+function pinnedGuestExecutableFilePath(
+  raw: string | undefined,
+  platform: NodeJS.Platform,
+  stat: (candidatePath: string) => { isFile(): boolean } = fs.statSync,
+  access: (candidatePath: string, mode: number) => void = fs.accessSync
+): string | null {
