new file mode 100644
index 0000000000..7f0b25e200
--- /dev/null
+++ b/apps/desktop/electron/open-design/windows-job-guardian-protocol.ts
@@ -0,0 +1,163 @@
+/**
+ * windows-job-guardian-protocol.ts — the bounded, versioned wire protocol
+ * spoken over the native `hermes-open-design-job.exe` guardian's stdio (see
+ * apps/desktop/native/open-design-job/guardian.cpp).
+ *
+ * Deliberately not JSON: a native helper with no third-party runtime
+ * dependency should not need to embed a JSON library. The guest's own
+ * stdout/stderr are relayed only through the helper's stderr (never stdout),
+ * so nothing the guest prints can forge a protocol line here -- this parser
+ * is the other half of that guarantee: it accepts only the exact
+ * `ODJOB/1 <KIND> ...` shape and fails closed on anything else.
+ *
+ * Pure/testable: no process/fs access. The TS adapter (windows-job-guardian.ts)
+ * owns reading lines from the real child process and calling this parser.
+ */
+
+export const GUARDIAN_PROTOCOL_PREFIX = 'ODJOB/1'
+export const MAX_GUARDIAN_LINE_BYTES = 4096
+/** Bounded charset for the launch nonce: hex only, so it can never contain protocol-breaking whitespace. */
+const NONCE_RE = /^[0-9a-f]{8,64}$/i
+
+export interface GuardianReadyMessage {
+  type: 'ready'
+  /** The guardian's OWN pid (GetCurrentProcessId()) -- cross-checked against the exact retained Node child_process. */
+  guardianPid: number
+  /** The guardian's OWN creation FILETIME (GetProcessTimes on its own process handle). */
+  guardianCreationFiletime: string
+  /** The owned target's (Open Design's) pid. */
+  targetPid: number
+  /** The owned target's creation FILETIME. */
+  targetCreationFiletime: string
+  sourceCommit: string
+  /** Echoes the fresh per-launch nonce Hermes supplied; rejects a stale/replayed handshake. */
+  nonce: string
+}
+
+export interface GuardianTargetMessage {
+  type: 'target'
+  state: 'live' | 'exited'
+  pid: number
+  creationFiletime: string
+}
+
+export interface GuardianEmptyMessage {
+  type: 'empty'
+  kind: 'graceful' | 'forced'
+}
+
+export interface GuardianErrorMessage {
+  type: 'error'
+  stage: string
+  win32Error: string
+}
+
+export type GuardianProtocolMessage =
+  | GuardianReadyMessage
+  | GuardianTargetMessage
+  | GuardianEmptyMessage
+  | GuardianErrorMessage
+
+function requirePositivePid(raw: string, label: string): number {
+  const pid = Number(raw)
+
+  if (!Number.isSafeInteger(pid) || pid <= 0) {
+    throw new Error(`[open-design windows-job-guardian-protocol] malformed ${label} pid: ${JSON.stringify(raw)}`)
+  }
+
+  return pid
+}
+
+/**
+ * Parses one exact bounded `ODJOB/1 <KIND> ...` protocol line. Throws a
+ * descriptive error for anything malformed, oversized, or unrecognized --
+ * never returns a partially-parsed/best-effort result.
+ */
+export function parseGuardianProtocolLine(line: string): GuardianProtocolMessage {
+  if (typeof line !== 'string' || Buffer.byteLength(line, 'utf8') > MAX_GUARDIAN_LINE_BYTES) {
+    throw new Error(`[open-design windows-job-guardian-protocol] protocol line exceeds the ${MAX_GUARDIAN_LINE_BYTES}-byte bounded size`)
+  }
+
+  const parts = line.split(/\s+/).filter(part => part.length > 0)
+
+  if (parts[0] !== GUARDIAN_PROTOCOL_PREFIX) {
+    throw new Error(`[open-design windows-job-guardian-protocol] unrecognized protocol prefix: ${JSON.stringify(parts[0] ?? '')}`)
+  }
+
+  const kind = parts[1]
+
+  switch (kind) {
+    case 'READY': {
+      if (parts.length !== 8) {
+        throw new Error(`[open-design windows-job-guardian-protocol] malformed READY line: ${JSON.stringify(line)}`)
+      }
+
+      const nonce = parts[7]
+
+      if (!NONCE_RE.test(nonce)) {
+        throw new Error(`[open-design windows-job-guardian-protocol] malformed READY nonce: ${JSON.stringify(nonce)}`)
+      }
+
+      return {
+        type: 'ready',
+        guardianPid: requirePositivePid(parts[2], 'READY guardian'),
+        guardianCreationFiletime: parts[3],
+        targetPid: requirePositivePid(parts[4], 'READY target'),
+        targetCreationFiletime: parts[5],
+        sourceCommit: parts[6],
+        nonce
+      }
+    }
+
+    case 'TARGET': {
+      if (parts.length !== 5) {
+        throw new Error(`[open-design windows-job-guardian-protocol] malformed TARGET line: ${JSON.stringify(line)}`)
+      }
+
+      const state = parts[2]
+
+      if (state !== 'live' && state !== 'exited') {
+        throw new Error(`[open-design windows-job-guardian-protocol] malformed TARGET state: ${JSON.stringify(state)}`)
+      }
+
+      return {
+        type: 'target',
+        state,
+        pid: requirePositivePid(parts[3], 'TARGET'),
+        creationFiletime: parts[4]
+      }
+    }
+
+    case 'EMPTY': {
+      if (parts.length !== 3) {
+        throw new Error(`[open-design windows-job-guardian-protocol] malformed EMPTY line: ${JSON.stringify(line)}`)
+      }
+
+      const emptyKind = parts[2]
+
+      if (emptyKind !== 'graceful' && emptyKind !== 'forced') {
+        throw new Error(`[open-design windows-job-guardian-protocol] malformed EMPTY kind: ${JSON.stringify(emptyKind)}`)
+      }
+
+      return { type: 'empty', kind: emptyKind }
+    }
+
+    case 'ERROR': {
+      if (parts.length !== 4) {
+        throw new Error(`[open-design windows-job-guardian-protocol] malformed ERROR line: ${JSON.stringify(line)}`)
+      }
+
+      return { type: 'error', stage: parts[2], win32Error: parts[3] }
+    }
+
+    default:
+      throw new Error(`[open-design windows-job-guardian-protocol] unrecognized protocol message: ${JSON.stringify(kind ?? '')}`)
+  }
+}
+
+export type GuardianCommand = 'STATUS' | 'FORCE'
+
+/** The exact bounded stdin commands the guardian accepts; anything else fails closed on the native side. */
+export function formatGuardianCommand(command: GuardianCommand): string {
+  return `${command}\n`
+}
