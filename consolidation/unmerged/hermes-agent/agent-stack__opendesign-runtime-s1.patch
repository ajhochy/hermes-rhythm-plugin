+import { test } from 'vitest'
+
+import { buildSafePackagedConfig, writeSafePackagedConfigFile } from './packaged-config'
+
+const OFFICIAL_CONFIG_WITH_TELEMETRY = {
+  appVersion: '0.20.0',
+  daemonCliEntryRelative: 'open-design/app/daemon-cli.js',
+  daemonSidecarEntryRelative: 'open-design/app/daemon-sidecar.js',
+  webSidecarEntryRelative: 'open-design/app/web-sidecar.js',
+  nodeCommandRelative: 'open-design/bin/node',
+  resourceRoot: '/staged/Open Design.app/Contents/Resources/open-design',
+  webStandaloneRoot: '/staged/Open Design.app/Contents/Resources/open-design-web-standalone',
+  // Must never survive into the safe config:
