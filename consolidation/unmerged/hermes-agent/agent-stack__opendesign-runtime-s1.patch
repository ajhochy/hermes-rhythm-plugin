+++ b/apps/desktop/electron/open-design/windows-job-guardian.ts
@@ -0,0 +1,415 @@
+/**
+ * windows-job-guardian.ts — the TS-side lifecycle adapter for the native
+ * Windows Job Object guardian (`hermes-open-design-job.exe`,
+ * apps/desktop/native/open-design-job/guardian.cpp). Spawns the guardian,
+ * speaks the bounded ODJOB/1 stdio protocol (windows-job-guardian-protocol.ts),
+ * and exposes a small request/response surface: requestStatus(), requestForce(),
+ * and an ownership-lost notification for an unexpected guardian exit.
+ *
+ * Mirrors the P1-1 async-child-error pattern exactly: a permanent 'error'
+ * listener is installed synchronously the instant spawn() returns, before
+ * any other branch or await runs, so a real spawn failure can never be an
+ * unhandled 'error' event.
+ *
+ * A single bounded protocol state machine owns the child's stdout: exactly
+ * one 'data' listener exists for the lifetime of the handle, transitioning
+ * from the READY handshake to steady-state STATUS/EMPTY/ERROR handling. Two
+ * independent listeners mutating a shared buffer was the prior defect --
+ * the first could consume a line before the second (e.g. the READY
+ * handshake promise) ever saw it.
+ *
+ * Termination is detected on the child's 'close' event, not 'exit': Node
+ * only guarantees stdio streams have been fully drained (every buffered
+ * 'data' event delivered) by the time 'close' fires, whereas 'exit' can fire
+ * before a final buffered protocol line (e.g. EMPTY) is read. Using 'exit'
+ * here could races a real EMPTY into looking like an unproven ownership loss.
+ */
+
+import { randomBytes } from 'node:crypto'
+
+import {
+  formatGuardianCommand,
+  type GuardianProtocolMessage,
+  MAX_GUARDIAN_LINE_BYTES,
+  parseGuardianProtocolLine
+} from './windows-job-guardian-protocol'
+
+export interface WindowsJobGuardianProcess {
+  pid?: number
+  stdin: { write: (data: string) => unknown; end: () => unknown }
+  stdout: { on: (event: 'data', listener: (chunk: Buffer | string) => void) => unknown } | null
+  stderr: { on: (event: 'data', listener: (chunk: Buffer | string) => void) => unknown } | null
+  on: (event: 'close' | 'error', listener: (...args: any[]) => void) => unknown
+  once: (event: 'close' | 'error', listener: (...args: any[]) => void) => unknown
+  off?: (event: 'close' | 'error', listener: (...args: any[]) => void) => unknown
+}
+
+export interface SpawnWindowsJobGuardianDeps {
+  guardianExePath: string
+  /** The already canonicalized, hash-validated Open Design executable this guardian will own. */
+  targetExecutablePath: string
+  targetArgs?: string[]
+  expectedSourceCommit: string
+  platform?: NodeJS.Platform
+  readyTimeoutMs?: number
+  requestTimeoutMs?: number
+  /** Defaults to a fresh random hex nonce per launch; overridable only for deterministic tests. */
+  generateNonce?: () => string
+  spawn: (
+    command: string,
+    args: string[],
+    options: { shell: false; windowsHide: true; stdio: ['pipe', 'pipe', 'pipe'] }
+  ) => WindowsJobGuardianProcess
+}
+
+export interface WindowsJobGuardianStatus {
+  state: 'live' | 'exited'
+  pid: number
+  creationFiletime: string
+}
+
+export interface WindowsJobGuardianHandle {
+  targetPid: number
+  creationFiletime: string
+  guardianPid: number
+  guardianCreationFiletime: string
+  process: WindowsJobGuardianProcess
+  requestStatus: (timeoutMs?: number) => Promise<WindowsJobGuardianStatus>
+  requestForce: (timeoutMs?: number) => Promise<'graceful' | 'forced'>
+  /**
+   * Resolves on the NEXT `EMPTY` message, whether it is a direct response to
+   * requestForce() or a spontaneous notification that the Job became empty
+   * on its own (e.g. the guest exited gracefully via IPC shutdown). This is
+   * the primitive `stopOwned()`'s graceful-wait step (P1-3 point 5) is built on.
+   */
+  waitForEmpty: (timeoutMs?: number) => Promise<'graceful' | 'forced'>
+  onOwnershipLost: (listener: (detail: string) => void) => void
+}
+
+const DEFAULT_READY_TIMEOUT_MS = 5_000
+const DEFAULT_REQUEST_TIMEOUT_MS = 5_000
+/** One full bounded protocol line plus headroom for a partial next line, never unbounded accumulation. */
+const MAX_STDOUT_BUFFER_BYTES = MAX_GUARDIAN_LINE_BYTES * 2
+
+function detailFor(error: unknown): string {
+  return error instanceof Error ? error.message : String(error ?? 'unknown error')
+}
+
+function defaultGenerateNonce(): string {
+  return randomBytes(16).toString('hex')
+}
+
+export async function spawnWindowsJobGuardian(deps: SpawnWindowsJobGuardianDeps): Promise<WindowsJobGuardianHandle> {
+  const platform = deps.platform ?? process.platform
+
+  if (platform !== 'win32') {
+    throw new Error('[open-design windows-job-guardian] ownership_unavailable: the Job guardian is Windows-only')
+  }
+
+  const readyTimeoutMs = deps.readyTimeoutMs ?? DEFAULT_READY_TIMEOUT_MS
+  const requestTimeoutMs = deps.requestTimeoutMs ?? DEFAULT_REQUEST_TIMEOUT_MS
+  const nonce = (deps.generateNonce ?? defaultGenerateNonce)()
+
+  const child = deps.spawn(
+    deps.guardianExePath,
+    [nonce, deps.targetExecutablePath, ...(deps.targetArgs ?? [])],
+    {
+      shell: false,
+      windowsHide: true,
+      stdio: ['pipe', 'pipe', 'pipe']
+    }
+  )
+
+  // Installed synchronously, before any other branch or await -- see P1-1
+  // (supervisor.ts's attachPermanentErrorGuard) for the exact same reasoning:
+  // a real spawn failure surfaces asynchronously via 'error' with no PID and
+  // no 'close', and an unhandled 'error' event throws inside Node internals.
+  child.on('error', () => {
+    // Startup failures are handled by the READY race below via the process's
+    // own 'close'/'error' path; this guard's only job is to guarantee the
+    // event is never unhandled, including after the handle is returned.
+  })
+
+  let phase: 'handshake' | 'operational' = 'handshake'
+  let pendingReady: { resolve: (message: GuardianProtocolMessage & { type: 'ready' }) => void; reject: (error: unknown) => void } | null = null
+
+  let pendingRequest: {
+    kind: 'STATUS'
+    resolve: (message: GuardianProtocolMessage) => void
+    reject: (error: unknown) => void
+    timer: ReturnType<typeof setTimeout>
+  } | null = null
+
+  let ownershipLostListener: ((detail: string) => void) | null = null
+  let emptyObserved = false
+
+  let emptyWaiters: Array<{
+    resolve: (kind: 'graceful' | 'forced') => void
+    reject: (error: Error) => void
+    timer: ReturnType<typeof setTimeout>
+  }> = []
+
+  let stdoutBuffer = ''
+  let overflowed = false
+
+  const onOwnershipLost = (detail: string) => {
+    ownershipLostListener?.(detail)
+  }
+
+  const handleMessage = (message: GuardianProtocolMessage) => {
+    if (phase === 'handshake') {
+      // Anything other than the very first message being READY is a broken
+      // handshake; the ready race below owns rejecting on a mismatch.
+      if (pendingReady) {
+        const resolve = pendingReady.resolve
+        const reject = pendingReady.reject
+        pendingReady = null
+
+        if (message.type === 'ready') {
+          resolve(message as GuardianProtocolMessage & { type: 'ready' })
+        } else {
+          reject(new Error(`[open-design windows-job-guardian] expected READY as the first protocol message, got ${message.type}`))
+        }
+      }
+
+      return
+    }
+
+    if (message.type === 'empty') {
+      // EMPTY is not necessarily a direct response to a request -- the Job
+      // can become empty spontaneously (e.g. the guest exited gracefully via
+      // IPC shutdown). Resolve every current waiter; this also resolves a
+      // FORCE-initiated wait (requestForce() registers one). Only a real
+      // parsed EMPTY message ever sets this -- never a guardian exit alone.
+      emptyObserved = true
+      const waiters = emptyWaiters
+      emptyWaiters = []
+
+      for (const waiter of waiters) {
+        clearTimeout(waiter.timer)
+        waiter.resolve(message.kind)
+      }
+
+      return
+    }
+
+    if (!pendingRequest) {
+      // An unsolicited TARGET/ERROR outside of a pending request (or after
+      // handshake) carries no actionable meaning at this layer; the
+      // guardian's own subsequent EMPTY/close is what matters.
+      return
+    }
+
+    if (message.type === 'target' && pendingRequest.kind === 'STATUS') {
+      const request = pendingRequest
+      pendingRequest = null
+      clearTimeout(request.timer)
+      request.resolve(message)
+    } else if (message.type === 'error') {
+      const request = pendingRequest
+      pendingRequest = null
+      clearTimeout(request.timer)
+      request.reject(new Error(`[open-design windows-job-guardian] guardian reported an error: stage=${message.stage} win32Error=${message.win32Error}`))
+    }
+  }
+
+  const failOverflow = () => {
+    if (overflowed) {return}
+    overflowed = true
+
+    const error = new Error(`[open-design windows-job-guardian] guardian stdout exceeded the ${MAX_STDOUT_BUFFER_BYTES}-byte bounded buffer without a newline (protocol violation)`)
+
+    if (pendingReady) {
+      const reject = pendingReady.reject
+      pendingReady = null
+      reject(error)
+    }
+
+    if (pendingRequest) {
+      const request = pendingRequest
+      pendingRequest = null
+      clearTimeout(request.timer)
+      request.reject(error)
+    }
+
+    onOwnershipLost(detailFor(error))
+  }
+
+  // The single, permanent stdout listener for the entire lifetime of this
+  // handle -- there is exactly one line parser, never two independently
+  // mutating the same buffer.
+  child.stdout?.on('data', chunk => {
+    if (overflowed) {return}
+
+    stdoutBuffer += chunk.toString()
+    let newlineIndex = stdoutBuffer.indexOf('\n')
+
+    while (newlineIndex >= 0) {
+      const line = stdoutBuffer.slice(0, newlineIndex)
+      stdoutBuffer = stdoutBuffer.slice(newlineIndex + 1)
+
+      try {
+        handleMessage(parseGuardianProtocolLine(line))
+      } catch {
+        // A malformed/forged line on the trusted stdout channel is dropped
+        // rather than crashing the adapter; only a well-formed protocol
+        // message can ever settle the handshake, a pending request, or an
+        // EMPTY waiter.
+      }
+
+      newlineIndex = stdoutBuffer.indexOf('\n')
+    }
+
+    if (Buffer.byteLength(stdoutBuffer, 'utf8') > MAX_STDOUT_BUFFER_BYTES) {
+      failOverflow()
+    }
+  })
+
+  const onClose = (code: number | null, signal: string | null) => {
+    if (pendingReady) {
+      const reject = pendingReady.reject
+      pendingReady = null
+      reject(new Error(`[open-design windows-job-guardian] guardian closed before READY (code=${code}, signal=${signal})`))
+    }
+
+    if (pendingRequest) {
+      const request = pendingRequest
+      pendingRequest = null
+      clearTimeout(request.timer)
+      request.reject(new Error(`[open-design windows-job-guardian] guardian closed before responding (code=${code}, signal=${signal})`))
+    }
+
+    // A guardian that closes without ever having proven EMPTY is an
+    // abnormal ownership loss, even if a FORCE/stdin-EOF was in flight --
+    // only an actually-observed EMPTY message is proof, never the exit
+    // itself. Any still-pending waitForEmpty()/requestForce() caller is
+    // rejected explicitly rather than left hanging forever.
+    if (phase === 'operational' && !emptyObserved) {
+      const waiters = emptyWaiters
+      emptyWaiters = []
+      const detail = `guardian closed without valid EMPTY proof (code=${code}, signal=${signal})`
+
+      for (const waiter of waiters) {
+        waiter.reject(new Error(`[open-design windows-job-guardian] ${detail}`))
+      }
+
+      onOwnershipLost(detail)
+    }
+  }
+
+  child.on('close', onClose)
+
+  function sendStatusRequest(timeoutMs: number): Promise<GuardianProtocolMessage> {
+    if (pendingRequest) {
+      return Promise.reject(new Error('[open-design windows-job-guardian] a STATUS request is already in flight'))
+    }
+
+    return new Promise((resolve, reject) => {
+      const timer = setTimeout(() => {
+        pendingRequest = null
+        reject(new Error(`[open-design windows-job-guardian] STATUS request timed out after ${timeoutMs}ms`))
+      }, timeoutMs)
+
+      pendingRequest = { kind: 'STATUS', resolve, reject, timer }
+      child.stdin.write(formatGuardianCommand('STATUS'))
+    })
+  }
+
+  function waitForEmpty(timeoutMs: number): Promise<'graceful' | 'forced'> {
+    return new Promise<'graceful' | 'forced'>((resolve, reject) => {
+      const waiter: {
+        resolve: (kind: 'graceful' | 'forced') => void
+        reject: (error: Error) => void
+        timer: ReturnType<typeof setTimeout>
+      } = {
+        resolve: (kind: 'graceful' | 'forced') => {
+          clearTimeout(waiter.timer)
+          resolve(kind)
+        },
+        reject: (error: Error) => {
+          clearTimeout(waiter.timer)
+          reject(error)
+        },
+        timer: setTimeout(() => {
+          emptyWaiters = emptyWaiters.filter(entry => entry !== waiter)
+          reject(new Error(`[open-design windows-job-guardian] timed out after ${timeoutMs}ms waiting for EMPTY`))
+        }, timeoutMs)
+      }
+
+      emptyWaiters.push(waiter)
+    })
+  }
+
+  const ready = await new Promise<GuardianProtocolMessage & { type: 'ready' }>((resolve, reject) => {
+    let settled = false
+
+    const timer = setTimeout(() => {
+      if (settled) {return}
+      settled = true
+      pendingReady = null
+      reject(new Error(`[open-design windows-job-guardian] guardian did not report READY within ${readyTimeoutMs}ms`))
+    }, readyTimeoutMs)
+
+    pendingReady = {
+      resolve: message => {
+        if (settled) {return}
+        settled = true
+        clearTimeout(timer)
+        resolve(message)
+      },
+      reject: error => {
+        if (settled) {return}
+        settled = true
+        clearTimeout(timer)
+        reject(error instanceof Error ? error : new Error(detailFor(error)))
+      }
+    }
+  })
+
+  if (ready.sourceCommit !== deps.expectedSourceCommit) {
+    throw new Error(
+      `[open-design windows-job-guardian] protocol/source commit mismatch: expected ${deps.expectedSourceCommit}, got ${ready.sourceCommit}`
+    )
+  }
+
+  if (ready.nonce !== nonce) {
+    throw new Error('[open-design windows-job-guardian] stale or wrong launch nonce in READY handshake -- refusing to trust this guardian')
+  }
+
+  if (ready.guardianPid !== child.pid) {
+    throw new Error(
+      `[open-design windows-job-guardian] guardian self-reported pid does not match the exact retained child process: expected ${child.pid}, got ${ready.guardianPid}`
+    )
+  }
+
+  phase = 'operational'
+
+  return {
+    targetPid: ready.targetPid,
+    creationFiletime: ready.targetCreationFiletime,
+    guardianPid: ready.guardianPid,
+    guardianCreationFiletime: ready.guardianCreationFiletime,
+    process: child,
+    async requestStatus(timeoutMs = requestTimeoutMs) {
+      const message = await sendStatusRequest(timeoutMs)
+
+      if (message.type !== 'target') {
+        throw new Error(`[open-design windows-job-guardian] unexpected response to STATUS: ${message.type}`)
+      }
+
+      return { state: message.state, pid: message.pid, creationFiletime: message.creationFiletime }
+    },
+    async requestForce(timeoutMs = requestTimeoutMs) {
+      const waiting = waitForEmpty(timeoutMs)
+      child.stdin.write(formatGuardianCommand('FORCE'))
+
+      return await waiting
+    },
+    waitForEmpty(timeoutMs = requestTimeoutMs) {
+      return waitForEmpty(timeoutMs)
+    },
+    onOwnershipLost(listener) {
+      ownershipLostListener = listener
+    }
+  }
+}
diff --git a/apps/desktop/electron/open-design/windows-owned-runtime.test.ts b/apps/desktop/electron/open-design/windows-owned-runtime.test.ts
