@@ -0,0 +1,35 @@
+import assert from 'node:assert/strict'
+
+import { test } from 'vitest'
+
+import {
+  AgentCatalogPollFailure,
+  classifyAgentCatalogPollFailure
+} from './agent-catalog-failure'
+
+test('classifies only the allowlisted catalog polling failure codes', () => {
+  const expected = [
+    ['fetch-timeout-transport', 'fetch-timeout-transport'],
+    ['http-status', 'http-status'],
+    ['malformed-response-shape', 'malformed-response-shape'],
+    ['no-hermes-entry', 'no-hermes-entry'],
+    ['unavailable', 'unavailable'],
+    ['path-mismatch', 'path-mismatch'],
+    ['no-models', 'no-models'],
+    ['non-live-models-source', 'non-live-models-source']
+  ] as const
+
+  for (const [input, code] of expected) {
+    assert.equal(classifyAgentCatalogPollFailure(new AgentCatalogPollFailure(input)), code)
+  }
+})
+
+test('classifies fetch aborts and transport failures without returning error details', () => {
+  assert.equal(classifyAgentCatalogPollFailure({ name: 'AbortError', message: 'private timeout detail' }), 'fetch-timeout-transport')
+  assert.equal(classifyAgentCatalogPollFailure(new TypeError('private transport detail')), 'fetch-timeout-transport')
+})
+
+test('fails closed to unknown for unrecognized polling failures', () => {
+  assert.equal(classifyAgentCatalogPollFailure(new Error('private upstream detail')), 'unknown')
+  assert.equal(classifyAgentCatalogPollFailure(null), 'unknown')
+})
diff --git a/apps/desktop/electron/open-design/agent-catalog-failure.ts b/apps/desktop/electron/open-design/agent-catalog-failure.ts
new file mode 100644
index 0000000000..1cd68eb460
--- /dev/null
+++ b/apps/desktop/electron/open-design/agent-catalog-failure.ts
@@ -0,0 +1,41 @@
+/**
+ * Safe, allowlisted outcomes for the live-smoke agent catalog retry loop.
+ *
+ * The classifier is deliberately pure and returns a fixed code only. Callers
+ * must retain this code rather than the originating response or exception.
+ */
+export const AGENT_CATALOG_POLL_FAILURE_CODES = [
+  'fetch-timeout-transport',
+  'http-status',
+  'malformed-response-shape',
+  'no-hermes-entry',
+  'unavailable',
+  'path-mismatch',
+  'no-models',
+  'non-live-models-source',
+  'unknown'
+] as const
+
+export type AgentCatalogPollFailureCode = typeof AGENT_CATALOG_POLL_FAILURE_CODES[number]
+
+export class AgentCatalogPollFailure extends Error {
+  constructor(readonly code: Exclude<AgentCatalogPollFailureCode, 'unknown'>) {
+    super(`[open-design agent-catalog] polling failure: ${code}`)
+    this.name = 'AgentCatalogPollFailure'
+  }
+}
+
+export function classifyAgentCatalogPollFailure(failure: unknown): AgentCatalogPollFailureCode {
+  if (failure instanceof AgentCatalogPollFailure) {
+    return failure.code
+  }
+
+  if (failure && typeof failure === 'object') {
+    const name = (failure as { name?: unknown }).name
+    if (name === 'AbortError' || name === 'TimeoutError' || failure instanceof TypeError) {
+      return 'fetch-timeout-transport'
+    }
+  }
+
+  return 'unknown'
+}
