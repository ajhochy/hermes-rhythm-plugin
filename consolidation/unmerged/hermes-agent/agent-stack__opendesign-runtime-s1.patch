index 0000000000..729410d3c8
--- /dev/null
+++ b/apps/desktop/electron/open-design/windows-owned-runtime.test.ts
@@ -0,0 +1,193 @@
+import assert from 'node:assert/strict'
+
+import { test } from 'vitest'
+
+import {
+  type OpenDesignIpcRequester,
+  stopWindowsOwnedRuntime,
+  type StopWindowsOwnedRuntimeOptions,
+  type WindowsOwnedGuardianLike
+} from './windows-owned-runtime'
+
+function makeGuardian(overrides: Partial<WindowsOwnedGuardianLike> = {}): WindowsOwnedGuardianLike {
+  return {
+    requestStatus: async () => ({ state: 'live', pid: 4242, creationFiletime: '1' }),
+    requestForce: async () => 'forced' as const,
+    waitForEmpty: async () => 'graceful' as const,
+    ...overrides
+  }
+}
+
+const defaultRequestIpc: OpenDesignIpcRequester = async ({ payload }: any) => payload.type === 'status'
+  ? { pid: 4242, state: 'running', windowVisible: false, url: 'http://127.0.0.1:53211' }
+  : { accepted: true }
+
+function baseOptions(overrides: Partial<StopWindowsOwnedRuntimeOptions> = {}): StopWindowsOwnedRuntimeOptions {
+  return {
+    guardian: makeGuardian(),
+    namespace: 'hz-default-abc123',
+    expectedGuardianTargetPid: 4242,
+    expectedGuardianTargetCreationFiletime: '1',
+    gracefulTimeoutMs: 500,
+    statusTimeoutMs: 200,
+    forceTimeoutMs: 500,
+    requestIpc: defaultRequestIpc,
+    ...overrides
+  }
+}
+
+test('happy path: guardian live, IPC status matches, shutdown accepted, guardian proves graceful EMPTY', async () => {
+  const result = await stopWindowsOwnedRuntime(baseOptions())
+  assert.deepEqual(result, { forced: false, parentExited: true, treeExited: true })
+})
+
+test('requests exact graceful IPC shutdown only after the desktop status response matches the validated owned runtime', async () => {
+  const requestedPayloads: any[] = []
+
+  const result = await stopWindowsOwnedRuntime(baseOptions({
+    requestIpc: async ({ payload }: any) => {
+      requestedPayloads.push(payload)
+
+      return payload.type === 'status'
+        ? { pid: 4242, state: 'running', windowVisible: false, url: 'http://127.0.0.1:53211' }
+        : { accepted: true }
+    }
+  }))
+
+  assert.deepEqual(requestedPayloads, [{ type: 'status' }, { type: 'shutdown' }])
+  assert.equal(result.forced, false)
+})
+
+test('never derives the IPC endpoint from anything but the supplied namespace -- no renderer/guest endpoint override exists in the options shape', async () => {
+  const endpoints: string[] = []
+
+  await stopWindowsOwnedRuntime(baseOptions({
+    requestIpc: async ({ endpoint, payload }: any) => {
+      endpoints.push(endpoint)
+
+      return payload.type === 'status'
+        ? { pid: 4242, state: 'running', windowVisible: false, url: 'http://127.0.0.1:53211' }
+        : { accepted: true }
+    }
+  }))
+
+  assert.ok(endpoints.every(endpoint => endpoint.includes('hz-default-abc123')))
+  assert.ok(endpoints.every(endpoint => endpoint.includes('desktop')))
+})
+
+test('skips the shutdown request when the desktop status pid does not match the owned runtime, and still waits for guardian EMPTY', async () => {
+  let shutdownRequested = false
+
+  const result = await stopWindowsOwnedRuntime(baseOptions({
+    requestIpc: async ({ payload }: any) => {
+      if (payload.type === 'shutdown') {shutdownRequested = true}
+
+      return { pid: 9999, state: 'running', windowVisible: false, url: 'http://127.0.0.1:53211' }
+    }
+  }))
+
+  assert.equal(shutdownRequested, false)
+  assert.deepEqual(result, { forced: false, parentExited: true, treeExited: true })
+})
+
+test('skips the shutdown request when the guardian-reported target creation FILETIME does not match the retained owned runtime (PID-reuse defense), and still waits for guardian EMPTY', async () => {
+  let ipcCalled = false
+
+  const result = await stopWindowsOwnedRuntime(baseOptions({
+    guardian: makeGuardian({ requestStatus: async () => ({ state: 'live', pid: 4242, creationFiletime: 'some-other-process-creation-time' }) }),
+    requestIpc: async (args: any) => {
+      ipcCalled = true
+
+      return defaultRequestIpc(args)
+    }
+  }))
+
+  assert.equal(ipcCalled, false)
+  assert.deepEqual(result, { forced: false, parentExited: true, treeExited: true })
+})
+
+test('treats a shutdown response without accepted:true as a failed graceful request and still waits for guardian EMPTY rather than trusting it', async () => {
+  const requestedPayloads: any[] = []
+
+  const result = await stopWindowsOwnedRuntime(baseOptions({
+    requestIpc: async ({ payload }: any) => {
+      requestedPayloads.push(payload)
+
+      return payload.type === 'status'
+        ? { pid: 4242, state: 'running', windowVisible: false, url: 'http://127.0.0.1:53211' }
+        : { accepted: false }
+    }
+  }))
+
+  assert.deepEqual(requestedPayloads, [{ type: 'status' }, { type: 'shutdown' }])
+  assert.deepEqual(result, { forced: false, parentExited: true, treeExited: true }, 'guardian EMPTY proof is still authoritative even though accepted:true was never returned')
+})
+
+test('falls back to force when IPC status/shutdown fails outright (connection refused before the daemon IPC server is up)', async () => {
+  let forceCalled = false
+
+  const result = await stopWindowsOwnedRuntime(baseOptions({
+    requestIpc: async () => {
+      throw new Error('ECONNREFUSED')
+    },
+    guardian: makeGuardian({
+      waitForEmpty: async () => {
+        throw new Error('timed out')
+      },
+      requestForce: async () => {
+        forceCalled = true
+
+        return 'forced' as const
+      }
+    })
+  }))
+
+  assert.equal(forceCalled, true)
+  assert.deepEqual(result, { forced: true, parentExited: true, treeExited: true })
+})
+
+test('falls back to force when the graceful wait for guardian EMPTY times out', async () => {
+  let forceCalled = false
+
+  const result = await stopWindowsOwnedRuntime(baseOptions({
+    guardian: makeGuardian({
+      waitForEmpty: async () => {
+        throw new Error('[open-design windows-job-guardian] timed out after 500ms waiting for EMPTY')
+      },
+      requestForce: async () => {
+        forceCalled = true
+
+        return 'forced' as const
+      }
+    })
+  }))
+
+  assert.equal(forceCalled, true)
+  assert.deepEqual(result, { forced: true, parentExited: true, treeExited: true })
+})
+
+test('reports forced:true when the guardian itself reports a forced EMPTY (e.g. it had to force independently)', async () => {
+  const result = await stopWindowsOwnedRuntime(baseOptions({
+    guardian: makeGuardian({ waitForEmpty: async () => 'forced' as const })
+  }))
+
+  assert.deepEqual(result, { forced: true, parentExited: true, treeExited: true })
+})
+
+test('skips the IPC status/shutdown request entirely when the guardian itself reports the target already exited', async () => {
+  let ipcCalled = false
+
+  const result = await stopWindowsOwnedRuntime(baseOptions({
+    guardian: makeGuardian({ requestStatus: async () => ({ state: 'exited', pid: 4242, creationFiletime: '1' }) }),
+    requestIpc: async (args: any) => {
+      ipcCalled = true
+
+      return args.payload.type === 'status'
+        ? { pid: 4242, state: 'running', windowVisible: false, url: 'http://127.0.0.1:53211' }
+        : { accepted: true }
+    }
+  }))
+
+  assert.equal(ipcCalled, false)
+  assert.deepEqual(result, { forced: false, parentExited: true, treeExited: true })
+})
