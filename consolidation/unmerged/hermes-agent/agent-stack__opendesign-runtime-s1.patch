+++ b/apps/desktop/scripts/utils.test.mjs
@@ -0,0 +1,74 @@
+import assert from 'node:assert/strict'
+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+
+import { test } from 'vitest'
+
+import { markPathTreeFilesReadOnly } from './utils.mjs'
+
+function tmpdir() {
+  return fs.mkdtempSync(path.join(os.tmpdir(), 'hermes-utils-readonly-'))
+}
+
+test('markPathTreeFilesReadOnly strips the write bit from every nested file, recursively', () => {
+  const root = tmpdir()
+
+  try {
+    fs.writeFileSync(path.join(root, 'top.txt'), 'top')
+    fs.mkdirSync(path.join(root, 'nested', 'deeper'), { recursive: true })
+    fs.writeFileSync(path.join(root, 'nested', 'mid.txt'), 'mid')
+    fs.writeFileSync(path.join(root, 'nested', 'deeper', 'bottom.txt'), 'bottom')
+
+    markPathTreeFilesReadOnly(root)
+
+    for (const relative of ['top.txt', path.join('nested', 'mid.txt'), path.join('nested', 'deeper', 'bottom.txt')]) {
+      const mode = fs.statSync(path.join(root, relative)).mode
+      assert.equal(mode & 0o222, 0, `${relative} must have no write bits set`)
+    }
+  } finally {
+    fs.chmodSync(root, 0o755)
+    fs.rmSync(root, { recursive: true, force: true })
+  }
+})
+
+test('markPathTreeFilesReadOnly leaves directory write bits untouched so the whole tree can still be removed', () => {
+  const root = tmpdir()
+
+  try {
+    fs.mkdirSync(path.join(root, 'nested'), { recursive: true })
+    fs.writeFileSync(path.join(root, 'nested', 'file.txt'), 'content')
+
+    markPathTreeFilesReadOnly(root)
+
+    assert.equal(fs.statSync(root).mode & 0o200, 0o200, 'the root directory itself must keep its write bit')
+    assert.equal(fs.statSync(path.join(root, 'nested')).mode & 0o200, 0o200, 'nested directories must keep their write bit')
+
+    // The real point: rm -rf must still work without first chmod-ing anything back.
+    assert.doesNotThrow(() => fs.rmSync(root, { recursive: true, force: true }))
+    assert.equal(fs.existsSync(root), false)
+  } finally {
+    fs.rmSync(root, { recursive: true, force: true })
+  }
+})
+
+test('markPathTreeFilesReadOnly actually prevents a naive in-place overwrite of a staged file', () => {
+  const root = tmpdir()
+
+  try {
+    const filePath = path.join(root, 'staged.json')
+    fs.writeFileSync(filePath, 'original')
+
+    markPathTreeFilesReadOnly(root)
+
+    assert.throws(() => fs.writeFileSync(filePath, 'tampered', { flag: 'r+' }), /EACCES|EPERM/)
+    assert.equal(fs.readFileSync(filePath, 'utf8'), 'original')
+  } finally {
+    fs.chmodSync(root, 0o755)
+    fs.rmSync(root, { recursive: true, force: true })
+  }
+})
+
+test('markPathTreeFilesReadOnly is a safe no-op for a missing path', () => {
+  assert.doesNotThrow(() => markPathTreeFilesReadOnly(path.join(os.tmpdir(), 'hermes-does-not-exist-at-all')))
+})
diff --git a/apps/desktop/scripts/vitest-test-collection.test.mjs b/apps/desktop/scripts/vitest-test-collection.test.mjs
new file mode 100644
index 0000000000..f3abdf51d7
--- /dev/null
+++ b/apps/desktop/scripts/vitest-test-collection.test.mjs
@@ -0,0 +1,105 @@
+// Policy regression: vitest.config.ts's `electron` project `include` globs
+// must actually match every real *.test.ts/*.test.mjs file under electron/
+// and scripts/ -- not just look like they do.
+//
+// Commit 28a00a765 added a working recursive pattern
+// (`scripts/**/*.test.{ts,mjs}`) specifically because an earlier
+// `scripts/**.test.{ts,mjs}` entry does NOT recurse: `**` glued directly to
+// `.test` (no path separator between them) degrades to a same-directory `*`
+// under picomatch/tinyglobby, so nested files like
+// scripts/open-design/stage.test.mjs were silently dropped. That broken
+// entry was left in the array alongside the fix (dead weight, and a trap for
+// the next person who "cleans up" the array and drops the wrong one) -- this
+// test both proves the CURRENT config drops no real test file, and locks in
+// why the glued-`**` shape is wrong so it can't be reintroduced unnoticed.
+import assert from 'node:assert/strict'
+import fs from 'node:fs'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+import { test } from 'vitest'
+
+const desktopRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
+
+function compileTestGlob(pattern) {
+  const match = /^([^*]+)\/\*\*\/\*\.test\.(?:\{([^}]+)\}|(\w+))$/.exec(pattern)
+
+  if (!match) {
+    throw new Error(
+      `[vitest-test-collection policy] this test's matcher does not understand glob shape ${JSON.stringify(pattern)} -- ` +
+        'update compileTestGlob() before relying on it, do not assume it is covered.'
+    )
+  }
+
+  const dir = match[1]
+  const exts = (match[2] ?? match[3]).split(',')
+
+  return { dir, exts }
+}
+
+function matchesCompiledGlob({ dir, exts }, relativePath) {
+  if (!relativePath.startsWith(`${dir}/`)) {
+    return false
+  }
+
+  return exts.some(ext => relativePath.endsWith(`.test.${ext}`))
+}
+
+function findTestFiles(rootDir, relativeDir, extensions) {
+  const absoluteDir = path.join(rootDir, relativeDir)
+
+  if (!fs.existsSync(absoluteDir)) {
+    return []
+  }
+
+  return fs
+    .readdirSync(absoluteDir, { recursive: true, withFileTypes: true })
+    .filter(entry => entry.isFile() && extensions.some(ext => entry.name.endsWith(`.test.${ext}`)))
+    .map(entry => {
+      // Node's recursive readdirSync exposes each dirent's own subdirectory
+      // via `.parentPath` (or the older `.path` alias) relative to the
+      // directory that was walked, not the walked root itself.
+      const parent = entry.parentPath ?? entry.path
+      const absoluteFile = path.join(parent, entry.name)
+
+      return path.relative(rootDir, absoluteFile).split(path.sep).join('/')
+    })
+}
+
+async function loadElectronProjectConfig() {
+  const configModule = await import(path.join(desktopRoot, 'vitest.config.ts'))
+  const config = configModule.default
+  const electronProject = config.test.projects.find(project => project.test.name === 'electron')
+
+  assert.ok(electronProject, 'vitest.config.ts must define a project named "electron"')
+
+  return electronProject.test
+}
+
+test('every real *.test.ts file under electron/, and *.test.{ts,mjs} file under scripts/, is matched by at least one configured include glob', async () => {
+  const electronTestConfig = await loadElectronProjectConfig()
+  const includePatterns = electronTestConfig.include ?? []
+  const excludePatterns = new Set(electronTestConfig.exclude ?? [])
+
+  assert.ok(includePatterns.length > 0, 'the electron project must declare at least one include glob')
+
+  const compiledIncludes = includePatterns.map(compileTestGlob)
+
+  const discovered = [
+    ...findTestFiles(desktopRoot, 'electron', ['ts']),
+    ...findTestFiles(desktopRoot, 'scripts', ['ts', 'mjs'])
+  ]
+
+  assert.ok(discovered.length > 0, 'sanity check: recursive discovery must find at least one real test file, or this test proves nothing')
+
+  const unmatched = discovered.filter(relativePath =>
+    !excludePatterns.has(relativePath)
+    && !compiledIncludes.some(compiled => matchesCompiledGlob(compiled, relativePath))
+  )
+
+  assert.deepEqual(
+    unmatched,
+    [],
+    `these real test files exist on disk but would be silently omitted from every test run by vitest.config.ts's electron project include globs: ${JSON.stringify(unmatched)}`
+  )
+})
