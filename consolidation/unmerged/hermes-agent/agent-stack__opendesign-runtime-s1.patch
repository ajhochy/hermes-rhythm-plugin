+import assert from 'node:assert/strict'
+
+import { test } from 'vitest'
+
+import { resolveOpenDesignDesktopIpcEndpoint } from './ipc-endpoint'
+
+test('resolves the exact pinned Windows named pipe path for a namespace', () => {
+  const endpoint = resolveOpenDesignDesktopIpcEndpoint('hz-default-abc123', { platform: 'win32' })
+
+  assert.equal(endpoint, '\\\\.\\pipe\\open-design-hz-default-abc123-desktop')
+})
+
+test('resolves the exact pinned POSIX default socket path for a namespace', () => {
+  const endpoint = resolveOpenDesignDesktopIpcEndpoint('hz-default-abc123', { platform: 'darwin' })
+
+  assert.equal(endpoint, '/tmp/open-design/ipc/hz-default-abc123/desktop.sock')
+})
+
+test('resolves under an explicit non-default POSIX ipc base', () => {
+  const endpoint = resolveOpenDesignDesktopIpcEndpoint('hz-default-abc123', {
+    platform: 'linux',
+    ipcBase: '/var/run/open-design/ipc'
+  })
+
+  assert.equal(endpoint, '/var/run/open-design/ipc/hz-default-abc123/desktop.sock')
+})
+
+test('rejects a namespace containing a path separator or traversal segment', () => {
+  for (const unsafe of ['../evil', 'hz/evil', 'hz\\evil', '']) {
+    assert.throws(() => resolveOpenDesignDesktopIpcEndpoint(unsafe, { platform: 'darwin' }))
+  }
+})
diff --git a/apps/desktop/electron/open-design/ipc-endpoint.ts b/apps/desktop/electron/open-design/ipc-endpoint.ts
new file mode 100644
index 0000000000..fac606c3e2
--- /dev/null
+++ b/apps/desktop/electron/open-design/ipc-endpoint.ts
@@ -0,0 +1,41 @@
+/**
+ * ipc-endpoint.ts — resolves the exact pinned Open Design desktop sidecar IPC
+ * endpoint for a namespace, matching `resolveAppIpcPath()` in the pinned
+ * guest (`packages/sidecar/src/paths.ts` at commit
+ * fa3cb4cdf3d1703e984a5655bd9654f8d44c493b, tag open-design-v0.20.0) for the
+ * `desktop` app key. Used by both P1-2's readiness cross-check and the
+ * Windows Job guardian's graceful-shutdown IPC. Never accepts a
+ * renderer/guest-supplied endpoint -- this always derives the endpoint from
+ * an already-validated namespace, never from external input.
+ */
+
+import path from 'node:path'
+
+const WINDOWS_PIPE_PREFIX = 'open-design'
+const DEFAULT_POSIX_IPC_BASE = '/tmp/open-design/ipc'
+const NAMESPACE_RE = /^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$/
+
+export interface ResolveOpenDesignDesktopIpcEndpointOptions {
+  platform?: NodeJS.Platform
+  /** POSIX only. Defaults to the pinned guest's own default ipc base. */
+  ipcBase?: string
+}
+
+export function resolveOpenDesignDesktopIpcEndpoint(
+  namespace: string,
+  options: ResolveOpenDesignDesktopIpcEndpointOptions = {}
+): string {
+  if (typeof namespace !== 'string' || !NAMESPACE_RE.test(namespace) || /[\\/]/.test(namespace)) {
+    throw new Error(`[open-design ipc-endpoint] invalid namespace: ${JSON.stringify(namespace)}`)
+  }
+
+  const platform = options.platform ?? process.platform
+
+  if (platform === 'win32') {
+    return `\\\\.\\pipe\\${WINDOWS_PIPE_PREFIX}-${namespace}-desktop`
+  }
+
+  const ipcBase = options.ipcBase ?? DEFAULT_POSIX_IPC_BASE
+
+  return path.posix.join(ipcBase, namespace, 'desktop.sock')
+}
diff --git a/apps/desktop/electron/open-design/json-ipc-client.test.ts b/apps/desktop/electron/open-design/json-ipc-client.test.ts
new file mode 100644
index 0000000000..4f31f09e82
--- /dev/null
+++ b/apps/desktop/electron/open-design/json-ipc-client.test.ts
@@ -0,0 +1,176 @@
+import assert from 'node:assert/strict'
+import fs from 'node:fs'
+import net from 'node:net'
+import os from 'node:os'
+import path from 'node:path'
+
+import { test } from 'vitest'
+
+import { requestOpenDesignIpc } from './json-ipc-client'
+
+function socketPath(): string {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'hermes-od-ipc-'))
+
+  return path.join(root, 'desktop.sock')
+}
+
+function startServer(
+  endpoint: string,
+  handler: (message: unknown, socket: net.Socket) => void
+): Promise<net.Server> {
+  return new Promise((resolve, reject) => {
+    const server = net.createServer(socket => {
+      let buffer = ''
+
+      socket.on('data', chunk => {
+        buffer += chunk.toString('utf8')
+        const newlineIndex = buffer.indexOf('\n')
+
+        if (newlineIndex < 0) {
+          return
+        }
+
+        const frame = buffer.slice(0, newlineIndex)
+
+        try {
+          handler(JSON.parse(frame), socket)
+        } catch (error) {
+          socket.end(`${JSON.stringify({ ok: false, error: { message: String(error) } })}\n`)
+        }
+      })
+    })
+
+    server.once('error', reject)
+    server.listen(endpoint, () => {
+      server.off('error', reject)
+      resolve(server)
+    })
+  })
+}
+
+async function withServer(
+  handler: (message: unknown, socket: net.Socket) => void,
+  run: (endpoint: string) => Promise<void>
+): Promise<void> {
+  const endpoint = socketPath()
+  const server = await startServer(endpoint, handler)
+
+  try {
+    await run(endpoint)
+  } finally {
+    await new Promise<void>(resolve => server.close(() => resolve()))
+    fs.rmSync(path.dirname(endpoint), { recursive: true, force: true })
+  }
+}
+
+test('sends exactly one newline-delimited JSON request per connection and resolves the result', async () => {
+  await withServer(
+    (message, socket) => {
+      assert.deepEqual(message, { type: 'status' })
+      socket.end(`${JSON.stringify({ ok: true, result: { pid: 4242, state: 'running', windowVisible: false, url: 'http://127.0.0.1:53211' } })}\n`)
+    },
+    async endpoint => {
+      const result = await requestOpenDesignIpc({ endpoint, payload: { type: 'status' } })
+      assert.deepEqual(result, { pid: 4242, state: 'running', windowVisible: false, url: 'http://127.0.0.1:53211' })
+    }
+  )
+})
+
+test('rejects with the server error message when the response reports ok:false', async () => {
+  await withServer(
+    (_message, socket) => {
+      socket.end(`${JSON.stringify({ ok: false, error: { message: 'namespace not found' } })}\n`)
+    },
+    async endpoint => {
+      await assert.rejects(
+        requestOpenDesignIpc({ endpoint, payload: { type: 'status' } }),
+        /namespace not found/
+      )
+    }
+  )
+})
+
+test('rejects on malformed JSON in the response frame', async () => {
+  await withServer(
+    (_message, socket) => {
+      socket.end('not json at all\n')
+    },
+    async endpoint => {
+      await assert.rejects(requestOpenDesignIpc({ endpoint, payload: { type: 'status' } }))
+    }
+  )
+})
+
+test('rejects when the response never arrives within the bounded timeout', async () => {
+  await withServer(
+    () => {
+      // Never respond.
+    },
+    async endpoint => {
+      await assert.rejects(
+        requestOpenDesignIpc({ endpoint, payload: { type: 'status' }, responseTimeoutMs: 100 }),
+        /time/i
+      )
+    }
+  )
+})
+
+test('rejects and closes the connection when the response exceeds the 64 KiB cap without a newline', async () => {
+  let serverSawClose = false
+
+  await withServer(
+    (_message, socket) => {
+      socket.on('error', () => {
+        // The client is expected to destroy its end once it hits the cap;
+        // a subsequent write from this still-running interval can legitimately
+        // EPIPE/ECONNRESET here. That is the exact "closes the connection"
+        // behavior under test, not a fixture bug.
+      })
+      socket.on('close', () => {
+        serverSawClose = true
+      })
+      // Stream well past the cap without ever sending a newline.
+      const chunk = Buffer.alloc(8192, 'a')
+
+      const interval = setInterval(() => {
+        if (socket.destroyed) {
+          clearInterval(interval)
+
+          return
+        }
+
+        socket.write(chunk)
+      }, 1)
+
+      socket.once('close', () => clearInterval(interval))
+    },
+    async endpoint => {
+      await assert.rejects(
+        requestOpenDesignIpc({ endpoint, payload: { type: 'status' }, maxResponseBytes: 65_536, responseTimeoutMs: 5_000 }),
+        /(64|65536|oversized|too large|exceeds)/i
+      )
+    }
+  )
+
+  await new Promise(resolve => setTimeout(resolve, 20))
+  assert.equal(serverSawClose, true, 'the client must close the connection rather than keep reading forever')
+})
+
+test('rejects a request payload that would exceed the 64 KiB cap without ever attempting to connect', async () => {
+  const oversizedPayload = { type: 'status', junk: 'x'.repeat(70_000) }
+
+  await assert.rejects(
+    requestOpenDesignIpc({ endpoint: '/definitely/does/not/exist.sock', payload: oversizedPayload }),
+    /(64|65536|oversized|too large|exceeds)/i
+  )
+})
+
+test('rejects when the connection cannot be established within the bounded connect timeout', async () => {
+  await assert.rejects(
+    requestOpenDesignIpc({
+      endpoint: path.join(fs.mkdtempSync(path.join(os.tmpdir(), 'hermes-od-ipc-missing-')), 'nope.sock'),
+      payload: { type: 'status' },
+      connectTimeoutMs: 200
+    })
+  )
+})
diff --git a/apps/desktop/electron/open-design/json-ipc-client.ts b/apps/desktop/electron/open-design/json-ipc-client.ts
new file mode 100644
index 0000000000..243c05cdc6
--- /dev/null
+++ b/apps/desktop/electron/open-design/json-ipc-client.ts
@@ -0,0 +1,155 @@
+/**
+ * json-ipc-client.ts — a bounded newline-delimited JSON IPC request matching
+ * the pinned Open Design guest's wire format exactly (see
+ * `requestJsonIpc()` in `packages/sidecar/src/json-ipc.ts` at commit
+ * fa3cb4cdf3d1703e984a5655bd9654f8d44c493b, tag open-design-v0.20.0): one
+ * connection per request, one JSON frame per direction, `{ok:true,result}` /
+ * `{ok:false,error}` response shape. Works identically over a POSIX unix
+ * socket or a Windows named pipe -- `node:net` abstracts both behind the same
+ * path-based API.
+ *
+ * Used for the P1-2 headless/status readiness cross-check and the Windows
+ * Job guardian's graceful-shutdown status/shutdown requests. Never accepts a
+ * renderer/guest-supplied endpoint -- callers must resolve `endpoint` via
+ * `ipc-endpoint.ts` from an already-validated namespace.
+ */
+
+import net from 'node:net'
+
+const DEFAULT_CONNECT_TIMEOUT_MS = 1_500
+const DEFAULT_RESPONSE_TIMEOUT_MS = 1_500
+const DEFAULT_MAX_BYTES = 64 * 1024
+
+export interface RequestOpenDesignIpcOptions {
+  endpoint: string
+  payload: unknown
+  connectTimeoutMs?: number
+  responseTimeoutMs?: number
+  maxRequestBytes?: number
+  maxResponseBytes?: number
+  connect?: (endpoint: string) => net.Socket
+}
+
+function byteLengthOf(value: string): number {
+  return Buffer.byteLength(value, 'utf8')
+}
+
+export async function requestOpenDesignIpc<T = unknown>(options: RequestOpenDesignIpcOptions): Promise<T> {
+  const connectTimeoutMs = options.connectTimeoutMs ?? DEFAULT_CONNECT_TIMEOUT_MS
+  const responseTimeoutMs = options.responseTimeoutMs ?? DEFAULT_RESPONSE_TIMEOUT_MS
+  const maxRequestBytes = options.maxRequestBytes ?? DEFAULT_MAX_BYTES
+  const maxResponseBytes = options.maxResponseBytes ?? DEFAULT_MAX_BYTES
+  const connect = options.connect ?? ((endpoint: string) => net.createConnection(endpoint))
+
+  const frame = `${JSON.stringify(options.payload)}\n`
+
+  if (byteLengthOf(frame) > maxRequestBytes) {
+    throw new Error(
+      `[open-design json-ipc-client] request payload exceeds the ${maxRequestBytes}-byte cap (oversized, too large)`
+    )
+  }
+
+  return await new Promise<T>((resolve, reject) => {
+    let settled = false
+    let buffer = ''
+    let bufferBytes = 0
+    let connectTimer: ReturnType<typeof setTimeout> | null = null
+    let responseTimer: ReturnType<typeof setTimeout> | null = null
+
+    const socket = connect(options.endpoint)
+
+    const clearTimers = () => {
+      if (connectTimer) {
+        clearTimeout(connectTimer)
+        connectTimer = null
+      }
+
+      if (responseTimer) {
+        clearTimeout(responseTimer)
+        responseTimer = null
+      }
+    }
+
+    const finish = (fn: () => void) => {
+      if (settled) {
+        return
+      }
+
+      settled = true
+      clearTimers()
+      socket.removeAllListeners()
+      socket.destroy()
+      fn()
+    }
+
+    connectTimer = setTimeout(() => {
+      finish(() => reject(new Error(
+        `[open-design json-ipc-client] connect timed out after ${connectTimeoutMs}ms: ${options.endpoint}`
+      )))
+    }, connectTimeoutMs)
+
+    socket.on('connect', () => {
+      if (connectTimer) {
+        clearTimeout(connectTimer)
+        connectTimer = null
+      }
+
+      responseTimer = setTimeout(() => {
+        finish(() => reject(new Error(
+          `[open-design json-ipc-client] response timed out after ${responseTimeoutMs}ms: ${options.endpoint}`
+        )))
+      }, responseTimeoutMs)
+
+      socket.write(frame)
+    })
+
+    socket.on('data', chunk => {
+      bufferBytes += chunk.byteLength
+
+      if (bufferBytes > maxResponseBytes) {
+        finish(() => reject(new Error(
+          `[open-design json-ipc-client] response exceeds the ${maxResponseBytes}-byte cap (oversized, too large)`
+        )))
+
+        return
+      }
+
+      buffer += chunk.toString('utf8')
+      const newlineIndex = buffer.indexOf('\n')
+
+      if (newlineIndex < 0) {
+        return
+      }
+
+      const line = buffer.slice(0, newlineIndex)
+
+      finish(() => {
+        let response: { ok: boolean; result?: T; error?: { message?: string } }
+
+        try {
+          response = JSON.parse(line)
+        } catch (error) {
+          reject(new Error(`[open-design json-ipc-client] malformed JSON response: ${error instanceof Error ? error.message : String(error)}`))
+
+          return
+        }
+
+        if (!response || response.ok !== true) {
+          reject(new Error(response?.error?.message ?? '[open-design json-ipc-client] IPC request failed'))
+
+          return
+        }
+
+        resolve(response.result as T)
+      })
+    })
+
+    socket.on('error', error => {
+      finish(() => reject(error))
+    })
+
+    socket.on('close', () => {
+      finish(() => reject(new Error('[open-design json-ipc-client] connection closed before a complete response was received')))
+    })
+  })
+}
diff --git a/apps/desktop/electron/open-design/native-guardian-manifest.test.ts b/apps/desktop/electron/open-design/native-guardian-manifest.test.ts
