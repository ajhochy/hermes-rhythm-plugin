diff --git a/apps/desktop/scripts/node-version-policy.test.mjs b/apps/desktop/scripts/node-version-policy.test.mjs
new file mode 100644
index 0000000000..5accf1ea29
--- /dev/null
+++ b/apps/desktop/scripts/node-version-policy.test.mjs
@@ -0,0 +1,111 @@
+// Policy regression: every CI lane that executes apps/desktop's Open Design
+// contract gates (docs/open-design-integration.contract.json, criterion
+// OD-13: "Node 22.22.0 or newer Node 22") must pin Node via an exact,
+// non-ambiguous reference to the root .nvmrc -- never a bare floating major
+// like `node-version: 22` (which resolves to "whatever the latest 22.x
+// happens to be today") and never an unrelated major like 26.
+import assert from 'node:assert/strict'
+import fs from 'node:fs'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+import { test } from 'vitest'
+
+const desktopRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
+const repoRoot = path.resolve(desktopRoot, '..', '..')
+
+// Lanes that run at least one command from
+// docs/open-design-integration.contract.json's requiredCommands (typecheck,
+// lint, test:open-design, test:desktop:platforms/all, build).
+const DESKTOP_CONTRACT_GATE_WORKFLOWS = ['desktop-windows-guardian.yml', 'desktop-node22-checks.yml']
+
+function readNvmrc() {
+  return fs.readFileSync(path.join(repoRoot, '.nvmrc'), 'utf8').trim()
+}
+
+function readWorkflow(name) {
+  return fs.readFileSync(path.join(repoRoot, '.github', 'workflows', name), 'utf8')
+}
+
+/** Finds the node-version/node-version-file value configured for every actions/setup-node step, in file order. */
+function findSetupNodeVersions(yaml) {
+  const lines = yaml.split(/\r?\n/)
+  const found = []
+
+  for (let i = 0; i < lines.length; i += 1) {
+    if (!/actions\/setup-node@/.test(lines[i])) {
+      continue
+    }
+
+    let resolved = null
+
+    for (let j = i + 1; j < lines.length && j < i + 8; j += 1) {
+      const versionMatch = /^\s*node-version:\s*['"]?([^'"#\s]+)/.exec(lines[j])
+      const versionFileMatch = /^\s*node-version-file:\s*['"]?([^'"#\s]+)/.exec(lines[j])
+
+      if (versionMatch) {
+        resolved = { kind: 'node-version', value: versionMatch[1], line: j + 1 }
+        break
+      }
+
+      if (versionFileMatch) {
+        resolved = { kind: 'node-version-file', value: versionFileMatch[1], line: j + 1 }
+        break
+      }
+    }
+
+    assert.ok(resolved, `${lines[i].trim()} (line ${i + 1}) must configure node-version or node-version-file within the following few lines`)
+    found.push(resolved)
+  }
+
+  return found
+}
+
+test('.nvmrc pins an exact Node version satisfying the frozen contract\'s 22.22+ floor', () => {
+  const version = readNvmrc()
+
+  assert.match(version, /^22\.\d+\.\d+$/, `.nvmrc must pin an exact Node 22.x.y version, got ${JSON.stringify(version)}`)
+  const minor = Number(version.split('.')[1])
+  assert.ok(minor >= 22, `.nvmrc (${version}) must be at least 22.22.0 per contract criterion OD-13`)
+})
+
+test('apps/desktop/package.json engines.node encodes the same Node version as .nvmrc', () => {
+  const version = readNvmrc()
+  const pkg = JSON.parse(fs.readFileSync(path.join(desktopRoot, 'package.json'), 'utf8'))
+
+  assert.ok(
+    typeof pkg.engines?.node === 'string' && pkg.engines.node.includes(version),
+    `apps/desktop/package.json engines.node (${JSON.stringify(pkg.engines?.node)}) must reference the exact .nvmrc version ${JSON.stringify(version)}`
+  )
+})
+
+test('every CI lane that executes apps/desktop contract gates pins Node via node-version-file: .nvmrc, never a bare ambiguous major', () => {
+  for (const name of DESKTOP_CONTRACT_GATE_WORKFLOWS) {
+    const versions = findSetupNodeVersions(readWorkflow(name))
+
+    assert.ok(versions.length > 0, `${name} must configure at least one actions/setup-node step`)
+
+    for (const found of versions) {
+      assert.equal(
+        found.kind,
+        'node-version-file',
+        `${name}:${found.line} must use node-version-file: '.nvmrc' (found node-version: ${JSON.stringify(found.value)}), an ambiguous floating major rather than the exact pinned 22.22+ contract requirement`
+      )
+      assert.equal(
+        found.value.replace(/^\.\//, ''),
+        '.nvmrc',
+        `${name}:${found.line} must reference the root .nvmrc, got ${JSON.stringify(found.value)}`
+      )
+    }
+  }
+})
+
+test('js-tests.yml\'s shared Node-26 dynamic matrix excludes apps/desktop (it runs under its own Node-22 lane instead)', () => {
+  const yaml = readWorkflow('js-tests.yml')
+
+  assert.match(
+    yaml,
+    /location\s*!==\s*['"]apps\/desktop['"]/,
+    'js-tests.yml must filter apps/desktop out of its workspace-discovery matrix so desktop contract gates run exactly once, under Node 22, never a second time under Node 26'
+  )
+})
