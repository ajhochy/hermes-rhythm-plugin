@@ -0,0 +1,115 @@
+import assert from 'node:assert/strict'
+
+import { test } from 'vitest'
+
+import { openDesignNamespacePaths } from '../../electron/open-design/namespace.js'
+import { createLiveSmokeNamespace, resolveLiveSmokeProfileHome } from './live-smoke-profile-home.mjs'
+
+function fileSystem({ directories, files = {} }) {
+  const directorySet = new Set(directories)
+  const fileMap = new Map(Object.entries(files))
+
+  return {
+    isDirectory: candidate => directorySet.has(candidate),
+    fileExists: candidate => fileMap.has(candidate),
+    readText: candidate => {
+      if (!fileMap.has(candidate)) throw new Error('missing selector')
+      return fileMap.get(candidate)
+    }
+  }
+}
+
+test('resolves an explicit named HERMES_HOME instead of an empty synthetic home', () => {
+  const namedHome = '/profiles-root/profiles/writer'
+  const fs = fileSystem({ directories: [namedHome] })
+
+  const selected = resolveLiveSmokeProfileHome({
+    env: { HERMES_HOME: namedHome },
+    homeDir: '/unused',
+    platform: 'darwin',
+    ...fs
+  })
+
+  assert.deepEqual(selected, { hermesHome: namedHome, profile: 'writer', source: 'explicit-profile' })
+})
+
+test('resolves the root active_profile to its named profile home', () => {
+  const root = '/profiles-root'
+  const namedHome = '/profiles-root/profiles/writer'
+  const fs = fileSystem({
+    directories: [root, namedHome],
+    files: { [`${root}/active_profile`]: 'writer\n' }
+  })
+
+  const selected = resolveLiveSmokeProfileHome({
+    env: { HERMES_HOME: root },
+    homeDir: '/unused',
+    platform: 'darwin',
+    ...fs
+  })
+
+  assert.deepEqual(selected, { hermesHome: namedHome, profile: 'writer', source: 'active-profile' })
+})
+
+test('uses the default home when no active profile is selected', () => {
+  const root = '/home/smoke/.hermes'
+  const fs = fileSystem({ directories: [root] })
+
+  const selected = resolveLiveSmokeProfileHome({
+    env: {},
+    homeDir: '/home/smoke',
+    platform: 'darwin',
+    ...fs
+  })
+
+  assert.deepEqual(selected, { hermesHome: root, profile: 'default', source: 'default' })
+})
+
+test('fails closed for malformed homes, selectors, and unavailable profile directories', () => {
+  const root = '/profiles-root'
+  const fs = fileSystem({
+    directories: [root],
+    files: { [`${root}/active_profile`]: '../outside' }
+  })
+
+  assert.throws(
+    () => resolveLiveSmokeProfileHome({ env: { HERMES_HOME: 'relative' }, homeDir: '/unused', platform: 'darwin', ...fs }),
+    /trusted absolute directory/i
+  )
+  assert.throws(
+    () => resolveLiveSmokeProfileHome({ env: { HERMES_HOME: `${root}\0suffix` }, homeDir: '/unused', platform: 'darwin', ...fs }),
+    /trusted absolute directory/i
+  )
+  assert.throws(
+    () => resolveLiveSmokeProfileHome({ env: { HERMES_HOME: `${root}\nsuffix` }, homeDir: '/unused', platform: 'darwin', ...fs }),
+    /trusted absolute directory/i
+  )
+  assert.throws(
+    () => resolveLiveSmokeProfileHome({ env: { HERMES_HOME: root }, homeDir: '/unused', platform: 'darwin', ...fs }),
+    /selector is invalid/i
+  )
+  assert.throws(
+    () => resolveLiveSmokeProfileHome({
+      env: { HERMES_HOME: root },
+      homeDir: '/unused',
+      platform: 'darwin',
+      ...fileSystem({ directories: [root], files: { [`${root}/active_profile`]: 'writer' } })
+    }),
+    /directory is unavailable/i
+  )
+  assert.throws(
+    () => resolveLiveSmokeProfileHome({ env: { HERMES_HOME: 7 }, homeDir: '/unused', platform: 'darwin', ...fs }),
+    /trusted absolute directory/i
+  )
+})
+
+test('uses a fresh random namespace beneath the selected profile home', () => {
+  const first = createLiveSmokeNamespace(() => '11111111-1111-4111-8111-111111111111')
+  const second = createLiveSmokeNamespace(() => '22222222-2222-4222-8222-222222222222')
+  const selectedHome = '/profiles-root/profiles/writer'
+  const paths = openDesignNamespacePaths(selectedHome, first)
+
+  assert.notEqual(first, second)
+  assert.match(first, /^hz-live-smoke-/)
+  assert.match(paths.root, /^\/profiles-root\/profiles\/writer\/open-design\/namespaces\//)
+})
