+import assert from 'node:assert/strict'
+
+import { test } from 'vitest'
+
+import {
+  formatGuardianCommand,
+  MAX_GUARDIAN_LINE_BYTES,
+  parseGuardianProtocolLine
+} from './windows-job-guardian-protocol'
+
+const GOOD_READY_LINE = 'ODJOB/1 READY 999 133699999999999999 4242 133700000000000000 fa3cb4cdf3d1703e984a5655bd9654f8d44c493b aabbccdd11223344'
+
+test('parses a READY line with guardian pid/creation-filetime, target pid/creation-filetime, source commit, and nonce', () => {
+  const message = parseGuardianProtocolLine(GOOD_READY_LINE)
+
+  assert.deepEqual(message, {
+    type: 'ready',
+    guardianPid: 999,
+    guardianCreationFiletime: '133699999999999999',
+    targetPid: 4242,
+    targetCreationFiletime: '133700000000000000',
+    sourceCommit: 'fa3cb4cdf3d1703e984a5655bd9654f8d44c493b',
+    nonce: 'aabbccdd11223344'
+  })
+})
+
+test('rejects a malformed/non-hex READY nonce', () => {
+  assert.throws(
+    () => parseGuardianProtocolLine('ODJOB/1 READY 999 133699999999999999 4242 133700000000000000 fa3cb4cdf3d1703e984a5655bd9654f8d44c493b not-hex!'),
+    /nonce/i
+  )
+})
+
+test('parses a TARGET line for both live and exited states', () => {
+  assert.deepEqual(
+    parseGuardianProtocolLine('ODJOB/1 TARGET live 4242 133700000000000000'),
+    { type: 'target', state: 'live', pid: 4242, creationFiletime: '133700000000000000' }
+  )
+  assert.deepEqual(
+    parseGuardianProtocolLine('ODJOB/1 TARGET exited 4242 133700000000000000'),
+    { type: 'target', state: 'exited', pid: 4242, creationFiletime: '133700000000000000' }
+  )
+})
+
+test('parses an EMPTY line for both graceful and forced', () => {
+  assert.deepEqual(parseGuardianProtocolLine('ODJOB/1 EMPTY graceful'), { type: 'empty', kind: 'graceful' })
+  assert.deepEqual(parseGuardianProtocolLine('ODJOB/1 EMPTY forced'), { type: 'empty', kind: 'forced' })
+})
+
+test('parses an ERROR line with stage and win32 error code', () => {
+  assert.deepEqual(
+    parseGuardianProtocolLine('ODJOB/1 ERROR CreateJobObject 5'),
+    { type: 'error', stage: 'CreateJobObject', win32Error: '5' }
+  )
+})
+
+test('rejects an unrecognized protocol prefix (guest output must never be able to forge a protocol line)', () => {
+  for (const line of [
+    'some random guest stdout line',
+    'ODJOB/2 READY 1 1 abc',
+    'odjob/1 READY 1 1 abc',
+    ''
+  ]) {
+    assert.throws(() => parseGuardianProtocolLine(line), /protocol|prefix/i)
+  }
+})
+
+test('rejects an unrecognized message kind', () => {
+  assert.throws(() => parseGuardianProtocolLine('ODJOB/1 BOGUS 1 2 3'), /unrecognized|message/i)
+})
+
+test('rejects malformed field counts for every message kind', () => {
+  for (const line of [
+    'ODJOB/1 READY 4242',
+    'ODJOB/1 READY 4242 133700000000000000 abc extra',
+    'ODJOB/1 TARGET live 4242',
+    'ODJOB/1 EMPTY',
+    'ODJOB/1 EMPTY graceful extra',
+    'ODJOB/1 ERROR OnlyStage'
+  ]) {
+    assert.throws(() => parseGuardianProtocolLine(line), /malformed/i)
+  }
+})
+
+test('rejects a non-numeric or non-positive pid in READY (guardian or target) and TARGET', () => {
+  for (const line of [
+    'ODJOB/1 READY notanumber 133699999999999999 4242 133700000000000000 abc aabbccdd11223344',
+    'ODJOB/1 READY -1 133699999999999999 4242 133700000000000000 abc aabbccdd11223344',
+    'ODJOB/1 READY 0 133699999999999999 4242 133700000000000000 abc aabbccdd11223344',
+    'ODJOB/1 READY 999 133699999999999999 notanumber 133700000000000000 abc aabbccdd11223344',
+    'ODJOB/1 READY 999 133699999999999999 -1 133700000000000000 abc aabbccdd11223344',
+    'ODJOB/1 TARGET live notanumber 133700000000000000'
+  ]) {
+    assert.throws(() => parseGuardianProtocolLine(line), /pid/i)
+  }
+})
+
+test('rejects an invalid TARGET/EMPTY enum value', () => {
+  assert.throws(() => parseGuardianProtocolLine('ODJOB/1 TARGET unknown 4242 133700000000000000'), /state/i)
+  assert.throws(() => parseGuardianProtocolLine('ODJOB/1 EMPTY unknown'), /kind/i)
+})
+
+test('rejects a protocol line exceeding the bounded size (fails closed on oversized/malformed input)', () => {
+  const oversized = `ODJOB/1 ERROR ${'x'.repeat(MAX_GUARDIAN_LINE_BYTES)} 1`
+  assert.throws(() => parseGuardianProtocolLine(oversized), /exceeds|bounded|size/i)
+})
+
+test('formatGuardianCommand produces exactly bounded STATUS/FORCE stdin commands', () => {
+  assert.equal(formatGuardianCommand('STATUS'), 'STATUS\n')
+  assert.equal(formatGuardianCommand('FORCE'), 'FORCE\n')
+})
