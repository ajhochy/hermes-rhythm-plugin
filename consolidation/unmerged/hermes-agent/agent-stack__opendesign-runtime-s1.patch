+import assert from 'node:assert/strict'
+
+import { test } from 'vitest'
+
+import { toRendererOpenDesignState } from './state'
+
+test('toRendererOpenDesignState only exposes the documented fields', () => {
+  const internal = {
+    state: 'ready' as const,
+    source: 'packaged' as const,
+    version: '0.20.0',
+    profile: 'default',
+    origin: 'http://127.0.0.1:53211',
+    retry: { attempt: 0, maxAttempts: 3 },
+    // Fields that must never reach the renderer:
+    entryPath: '/Users/me/.hermes/open-design/hz-default-abc/runtime/headless.mjs',
+    nodeBinaryPath: '/Users/me/.hermes/open-design/bin/node',
+    argv: ['--headless', '--namespace', 'hz-default-abc'],
+    env: { HERMES_BIN: '/usr/local/bin/hermes', ANTHROPIC_API_KEY: 'sk-secret' },
+    childPid: 4242,
+    logPath: '/Users/me/.hermes/open-design/hz-default-abc/logs/latest.log',
+    stdoutTail: 'some captured child output'
+  }
+
+  const state = toRendererOpenDesignState(internal)
+
+  assert.deepEqual(state, {
+    state: 'ready',
+    source: 'packaged',
+    version: '0.20.0',
+    profile: 'default',
+    origin: 'http://127.0.0.1:53211',
+    retry: { attempt: 0, maxAttempts: 3 }
+  })
+
+  const serialized = JSON.stringify(state)
+  assert.ok(!serialized.includes('sk-secret'))
+  assert.ok(!serialized.includes('entryPath'))
+  assert.ok(!serialized.includes('nodeBinaryPath'))
+  assert.ok(!serialized.includes('argv'))
+  assert.ok(!serialized.includes('env'))
+  assert.ok(!serialized.includes('childPid'))
+  assert.ok(!serialized.includes('logPath'))
+  assert.ok(!serialized.includes('stdoutTail'))
+})
+
+test('toRendererOpenDesignState omits optional fields entirely when absent, rather than sending null', () => {
+  const state = toRendererOpenDesignState({ state: 'idle' as const, profile: 'default' })
+
+  assert.deepEqual(state, { state: 'idle', profile: 'default' })
+  assert.ok(!('source' in state))
+  assert.ok(!('origin' in state))
+})
+
+test('toRendererOpenDesignState includes a sanitized error message when present', () => {
+  const state = toRendererOpenDesignState({
+    state: 'error' as const,
+    profile: 'default',
+    error: 'readiness probe timed out after 30000ms'
+  })
+
+  assert.equal(state.error, 'readiness probe timed out after 30000ms')
+})
diff --git a/apps/desktop/electron/open-design/state.ts b/apps/desktop/electron/open-design/state.ts
new file mode 100644
index 0000000000..f5bf47b9ce
--- /dev/null
+++ b/apps/desktop/electron/open-design/state.ts
@@ -0,0 +1,71 @@
+/**
+ * state.ts — the sanitized shape sent to the renderer over the (future,
+ * slice-3) typed IPC bridge. Internal supervisor state carries executable
+ * paths, argv, env, child pids, and log content; none of that may cross to
+ * the renderer. This module is the single allowlist boundary.
+ */
+
+export type OpenDesignRuntimeStateValue = 'idle' | 'starting' | 'ready' | 'error' | 'stopped'
+
+export interface OpenDesignRetryState {
+  attempt: number
+  maxAttempts: number
+}
+
+export interface OpenDesignInternalState {
+  state: OpenDesignRuntimeStateValue
+  profile: string
+  source?: 'packaged' | 'installed'
+  version?: string
+  origin?: string
+  retry?: OpenDesignRetryState
+  error?: string
+  // Everything else (entryPath, nodeBinaryPath, argv, env, childPid,
+  // logPath, stdoutTail, ...) is internal-only and deliberately not part of
+  // this type; toRendererOpenDesignState never reads it even if present.
+  [internalOnly: string]: unknown
+}
+
+export interface OpenDesignRendererState {
+  state: OpenDesignRuntimeStateValue
+  profile: string
+  source?: 'packaged' | 'installed'
+  version?: string
+  origin?: string
+  retry?: OpenDesignRetryState
+  error?: string
+}
+
+/**
+ * Project internal supervisor state down to the renderer-safe allowlist.
+ * Optional fields are omitted entirely (not sent as `undefined`/`null`) so
+ * `JSON.stringify` over IPC never round-trips a stray key.
+ */
+export function toRendererOpenDesignState(internal: OpenDesignInternalState): OpenDesignRendererState {
+  const state: OpenDesignRendererState = {
+    state: internal.state,
+    profile: internal.profile
+  }
+
+  if (internal.source !== undefined) {
+    state.source = internal.source
+  }
+
+  if (internal.version !== undefined) {
+    state.version = internal.version
+  }
+
+  if (internal.origin !== undefined) {
+    state.origin = internal.origin
+  }
+
+  if (internal.retry !== undefined) {
+    state.retry = { attempt: internal.retry.attempt, maxAttempts: internal.retry.maxAttempts }
+  }
+
+  if (internal.error !== undefined) {
+    state.error = internal.error
+  }
+
+  return state
+}
diff --git a/apps/desktop/electron/open-design/supervisor.test.ts b/apps/desktop/electron/open-design/supervisor.test.ts
new file mode 100644
index 0000000000..da409f2dcc
--- /dev/null
+++ b/apps/desktop/electron/open-design/supervisor.test.ts
@@ -0,0 +1,205 @@
+import assert from 'node:assert/strict'
+import { EventEmitter } from 'node:events'
+
+import { test } from 'vitest'
+
+import { OpenDesignRuntimeSupervisor } from './supervisor'
+
+class FakeChild extends EventEmitter {
+  pid: number
+  killed = false
+  killSignals: string[] = []
+
+  constructor(pid: number) {
+    super()
+    this.pid = pid
+  }
+
+  kill(signal: string) {
+    this.killSignals.push(signal)
+    this.killed = true
+  }
+}
+
+const CANDIDATE = {
+  source: 'packaged' as const,
+  version: '0.20.0',
+  entryPath: '/staged/headless.mjs',
+  resourceRoot: '/staged/Resources',
+  dataDir: '/hermes-home/open-design/hz-default-abc/data'
+}
+
+function makeDeps(overrides: Partial<any> = {}) {
+  const spawnedChildren: FakeChild[] = []
+  let nextPid = 1000
+
+  const deps = {
+    namespace: 'hz-default-abc',
+    profile: 'default',
+    hermesBin: 'hermes',
+    maxRetries: 2,
+    resolveCandidate: () => CANDIDATE,
+    spawn: (_command: string, _args: string[], _options: any) => {
+      const child = new FakeChild(nextPid++)
+      spawnedChildren.push(child)
+
+      return child
+    },
+    waitForReady: async () => ({ origin: 'http://127.0.0.1:53211' }),
+    sleep: async () => {},
+    ...overrides
+  }
+
+  return { deps, spawnedChildren }
+}
+
+test('start() is idempotent and concurrency-safe: concurrent calls share one in-flight launch', async () => {
+  const { deps, spawnedChildren } = makeDeps()
+  const supervisor = new OpenDesignRuntimeSupervisor(deps)
+
+  const [a, b] = await Promise.all([supervisor.start(), supervisor.start()])
+
+  assert.equal(spawnedChildren.length, 1)
+  assert.equal(a.state, 'ready')
+  assert.deepEqual(a, b)
+})
+
+test('sanitized getState() never exposes internal paths, argv, env, or child pid', () => {
+  const { deps } = makeDeps()
+  const supervisor = new OpenDesignRuntimeSupervisor(deps)
+  const state = supervisor.getState()
+
+  const serialized = JSON.stringify(state)
+  assert.ok(!serialized.includes('entryPath'))
+  assert.ok(!serialized.includes('resourceRoot'))
+  assert.ok(!serialized.includes('pid'))
+  assert.equal(state.profile, 'default')
+})
+
+test('attaches to an existing healthy runtime for the namespace instead of spawning', async () => {
+  const { deps, spawnedChildren } = makeDeps({
+    probeAttach: async () => ({ origin: 'http://127.0.0.1:9999', version: '0.20.0', source: 'packaged' })
+  })
+
+  const supervisor = new OpenDesignRuntimeSupervisor(deps)
+
+  const state = await supervisor.start()
+
+  assert.equal(spawnedChildren.length, 0)
+  assert.equal(state.state, 'ready')
+  assert.equal(state.origin, 'http://127.0.0.1:9999')
+})
+
+test('stopOwned() never kills an attached runtime that Hermes did not start', async () => {
+  const { deps, spawnedChildren } = makeDeps({
+    probeAttach: async () => ({ origin: 'http://127.0.0.1:9999', version: '0.20.0', source: 'packaged' })
+  })
+
+  const supervisor = new OpenDesignRuntimeSupervisor(deps)
+
+  await supervisor.start()
+  await supervisor.stopOwned()
+
+  assert.equal(spawnedChildren.length, 0) // nothing was ever spawned to kill
+  assert.equal(supervisor.getState().state, 'ready') // attached runtime keeps running
+})
+
+test('stopOwned() gracefully terminates an owned child', async () => {
+  const { deps, spawnedChildren } = makeDeps()
+  const supervisor = new OpenDesignRuntimeSupervisor(deps)
+
+  await supervisor.start()
+  const stopPromise = supervisor.stopOwned()
+  spawnedChildren[0].emit('exit', 0, null)
+  await stopPromise
+
+  assert.deepEqual(spawnedChildren[0].killSignals, ['SIGTERM'])
+  assert.equal(supervisor.getState().state, 'stopped')
+})
+
+test('stopOwned() escalates to a force signal after a bounded graceful timeout', async () => {
+  let now = 0
+
+  const { deps, spawnedChildren } = makeDeps({
+    now: () => now,
+    sleep: async (ms: number) => {
+      now += ms
+    },
+    stopTimeoutMs: 500
+  })
+
+  const supervisor = new OpenDesignRuntimeSupervisor(deps)
+
+  await supervisor.start()
+  // Child never emits 'exit' -- simulates a hung process.
+  await supervisor.stopOwned()
+
+  assert.deepEqual(spawnedChildren[0].killSignals, ['SIGTERM', 'SIGKILL'])
+})
+
+test('readiness timeout kills the child, records an error state, and retries a bounded number of times', async () => {
+  const { deps, spawnedChildren } = makeDeps({
+    maxRetries: 2,
+    waitForReady: async () => {
+      throw new Error('timed out waiting for readiness')
+    }
+  })
+
+  const supervisor = new OpenDesignRuntimeSupervisor(deps)
+
+  const state = await supervisor.start()
+
+  // Initial attempt + 2 retries = 3 spawns total, all cleaned up.
+  assert.equal(spawnedChildren.length, 3)
+
+  for (const child of spawnedChildren) {
+    assert.ok(child.killed, 'every failed attempt must kill its child')
+  }
+
+  assert.equal(state.state, 'error')
+  assert.match(state.error ?? '', /timed out waiting for readiness/)
+})
+
+test('an unexpected child exit after becoming ready is reflected in state and does not hang forever', async () => {
+  const { deps, spawnedChildren } = makeDeps({ maxRetries: 0 })
+  const supervisor = new OpenDesignRuntimeSupervisor(deps)
+
+  await supervisor.start()
+  assert.equal(supervisor.getState().state, 'ready')
+
+  spawnedChildren[0].emit('exit', 1, null)
+  // Allow any microtask-queued state transition to flush.
+  await Promise.resolve()
+  await Promise.resolve()
+
+  assert.notEqual(supervisor.getState().state, 'ready')
+})
+
+test('stop requested while start() is still in flight does not leak a running child', async () => {
+  let resolveReady: (value: any) => void = () => {}
+
+  const readyGate = new Promise(resolve => {
+    resolveReady = resolve
+  })
+
+  const { deps, spawnedChildren } = makeDeps({
+    waitForReady: async () => {
+      await readyGate
+
+      return { origin: 'http://127.0.0.1:53211' }
+    }
+  })
+
+  const supervisor = new OpenDesignRuntimeSupervisor(deps)
+
+  const startPromise = supervisor.start()
+  const stopPromise = supervisor.stopOwned()
+
+  resolveReady({})
+  spawnedChildren[0]?.emit('exit', 0, null)
+
+  await Promise.all([startPromise, stopPromise])
+
+  assert.ok(spawnedChildren[0].killed, 'the child spawned during the in-flight start must be killed, not leaked')
+  assert.notEqual(supervisor.getState().state, 'ready')
+})
diff --git a/apps/desktop/electron/open-design/supervisor.ts b/apps/desktop/electron/open-design/supervisor.ts
new file mode 100644
index 0000000000..089bfbd034
--- /dev/null
+++ b/apps/desktop/electron/open-design/supervisor.ts
@@ -0,0 +1,328 @@
+/**
+ * supervisor.ts — concurrency-safe, idempotent lifecycle supervisor for the
+ * Open Design headless runtime.
+ *
+ * Design notes:
+ * - Open Design owns its own daemon/web sidecar restart internally once
+ *   launched (see open-design-integration.md "Runtime flow"). This
+ *   supervisor's retry loop is only for the top-level headless process
+ *   itself failing to start or exiting unexpectedly, and it is bounded
+ *   (`maxRetries`) — never an infinite crash loop.
+ * - "Attach" (a healthy runtime already running for this namespace) and
+ *   "owned" (a child this instance spawned) are tracked separately.
+ *   stopOwned() must never touch an attached runtime.
+ * - All fs/network/process effects are injected so this is testable under
+ *   plain Node with fakes (no Electron, no real child_process).
+ */
+
+import { type OpenDesignInternalState, type OpenDesignRendererState, toRendererOpenDesignState } from './state'
+
+export interface OpenDesignSpawnedChild {
+  pid: number
+  kill: (signal: string) => void
+  once: (event: 'exit', listener: (code: number | null, signal: string | null) => void) => void
+  off?: (event: 'exit', listener: (code: number | null, signal: string | null) => void) => void
+}
+
+export interface OpenDesignRuntimeCandidate {
+  source: 'packaged' | 'installed'
+  version: string
+  entryPath: string
+  nodeBinaryPath?: string
+  resourceRoot: string
+  dataDir: string
+}
+
+export interface OpenDesignAttachInfo {
+  origin: string
+  version: string
+  source: 'packaged' | 'installed'
+}
+
+export interface OpenDesignSupervisorDeps {
+  namespace: string
+  profile: string
+  hermesBin: string
+  resolveCandidate: () => OpenDesignRuntimeCandidate | null
+  spawn: (command: string, args: string[], options: { env: Record<string, string> }) => OpenDesignSpawnedChild
+  waitForReady: (candidate: OpenDesignRuntimeCandidate, child: OpenDesignSpawnedChild) => Promise<{ origin: string }>
+  /** Probes for an existing healthy runtime to attach to instead of spawning. Returns null if none. */
+  probeAttach?: () => Promise<OpenDesignAttachInfo | null>
+  buildChildEnv?: (candidate: OpenDesignRuntimeCandidate) => Record<string, string>
+  maxRetries?: number
+  stopTimeoutMs?: number
+  now?: () => number
+  sleep?: (ms: number) => Promise<void>
+}
+
+const DEFAULT_MAX_RETRIES = 3
+const DEFAULT_STOP_TIMEOUT_MS = 5_000
+
+function sanitizeErrorMessage(error: unknown): string {
+  return error instanceof Error ? error.message : String(error ?? 'unknown error')
+}
+
+export class OpenDesignRuntimeSupervisor {
+  private readonly deps: OpenDesignSupervisorDeps
+  private state: OpenDesignInternalState
+  private child: OpenDesignSpawnedChild | null = null
+  private owned = false
+  private startPromise: Promise<OpenDesignRendererState> | null = null
+  private stopRequested = false
+  private intentionalStop = false
+  private childExitListener: ((code: number | null, signal: string | null) => void) | null = null
+
+  constructor(deps: OpenDesignSupervisorDeps) {
+    this.deps = deps
+    this.state = { state: 'idle', profile: deps.profile }
+  }
+
+  getState(): OpenDesignRendererState {
+    return toRendererOpenDesignState(this.state)
+  }
+
+  /**
+   * Idempotent and concurrency-safe: concurrent callers share the same
+   * in-flight launch promise instead of racing separate spawns.
+   */
+  start(): Promise<OpenDesignRendererState> {
+    if (this.startPromise) {
+      return this.startPromise
+    }
+
+    if (this.state.state === 'ready') {
+      return Promise.resolve(this.getState())
+    }
+
+    this.stopRequested = false
+    this.startPromise = this.runStart().finally(() => {
+      this.startPromise = null
+    })
+
+    return this.startPromise
+  }
+
+  private async runStart(): Promise<OpenDesignRendererState> {
+    this.state = { state: 'starting', profile: this.deps.profile }
+
+    if (this.deps.probeAttach) {
+      const attach = await this.deps.probeAttach()
+
+      if (attach) {
+        this.owned = false
+        this.child = null
+        this.state = {
+          state: 'ready',
+          profile: this.deps.profile,
+          source: attach.source,
+          version: attach.version,
+          origin: attach.origin
+        }
+
+        return this.getState()
+      }
+    }
+
+    return this.launchOwnedWithRetry()
+  }
+
+  private async launchOwnedWithRetry(): Promise<OpenDesignRendererState> {
+    const maxRetries = this.deps.maxRetries ?? DEFAULT_MAX_RETRIES
+    let lastError: unknown = null
+
+    for (let attempt = 0; attempt <= maxRetries; attempt += 1) {
+      this.state = {
+        state: 'starting',
+        profile: this.deps.profile,
+        retry: { attempt, maxAttempts: maxRetries }
+      }
+
+      if (this.stopRequested) {
+        this.state = { state: 'stopped', profile: this.deps.profile }
+        this.stopRequested = false
+
+        return this.getState()
+      }
+
+      const candidate = this.deps.resolveCandidate()
+
+      if (!candidate) {
+        this.state = {
+          state: 'error',
+          profile: this.deps.profile,
+          error: 'no Open Design runtime candidate available'
+        }
+
+        return this.getState()
+      }
+
+      const env = this.deps.buildChildEnv ? this.deps.buildChildEnv(candidate) : {}
+      const child = this.deps.spawn(this.deps.hermesBin, [], { env })
+
+      this.child = child
+      this.owned = true
+
+      if (this.stopRequested) {
+        this.killChild(child, 'SIGTERM')
+        this.child = null
+        this.owned = false
+        this.state = { state: 'stopped', profile: this.deps.profile }
+        this.stopRequested = false
+
+        return this.getState()
+      }
+
+      try {
+        const exited = new Promise<{ exited: true; code: number | null; signal: string | null }>(resolve => {
+          child.once('exit', (code, signal) => resolve({ exited: true, code, signal }))
+        })
+
+        const ready = this.deps
+          .waitForReady(candidate, child)
+          .then(result => ({ exited: false as const, ...result }))
+
+        const outcome = await Promise.race([ready, exited])
+
+        if (outcome.exited) {
+          const failed = outcome as { exited: true; code: number | null; signal: string | null }
+
+          throw new Error(`Open Design exited before becoming ready (code=${failed.code}, signal=${failed.signal})`)
+        }
+
+        const succeeded = outcome as { exited: false; origin: string }
+
+        if (this.stopRequested) {
+          // A stop arrived while we were mid-flight waiting on readiness.
+          // The child just became healthy, but honoring the stop request
+          // takes precedence over reporting 'ready' -- otherwise this is
+          // exactly how a late child leaks past a shutdown-during-startup.
+          this.killChild(child, 'SIGTERM')
+          this.child = null
+          this.owned = false
+          this.state = { state: 'stopped', profile: this.deps.profile }
+          this.stopRequested = false
+
+          return this.getState()
+        }
+
+        this.state = {
+          state: 'ready',
+          profile: this.deps.profile,
+          source: candidate.source,
+          version: candidate.version,
+          origin: succeeded.origin
+        }
+        this.attachUnexpectedExitHandler(child)
+
+        return this.getState()
+      } catch (error) {
+        lastError = error
+        this.killChild(child, 'SIGTERM')
+        this.child = null
+        this.owned = false
+
+        if (attempt === maxRetries) {
+          break
+        }
+      }
+    }
+
+    this.state = {
+      state: 'error',
+      profile: this.deps.profile,
+      error: sanitizeErrorMessage(lastError),
+      retry: { attempt: maxRetries, maxAttempts: maxRetries }
+    }
+
+    return this.getState()
+  }
+
+  /**
+   * Watches a *ready* owned child for an unexpected exit (crash). A
+   * deliberate stopOwned() sets `intentionalStop` first so this handler
+   * reports a clean stop instead of trying to relaunch.
+   */
+  private attachUnexpectedExitHandler(child: OpenDesignSpawnedChild) {
+    const listener = () => {
+      const wasIntentional = this.intentionalStop
+      this.intentionalStop = false
+      this.child = null
+      this.owned = false
+
+      if (wasIntentional) {
+        this.state = { state: 'stopped', profile: this.deps.profile }
+
+        return
+      }
+
+      this.state = {
+        state: 'error',
+        profile: this.deps.profile,
+        error: 'Open Design exited unexpectedly'
+      }
+    }
+
+    this.childExitListener = listener
+    child.once('exit', listener)
+  }
+
+  private killChild(child: OpenDesignSpawnedChild, signal: string) {
+    try {
+      child.kill(signal)
+    } catch {
+      // Already gone.
+    }
+  }
+
+  /**
+   * Gracefully terminates only an owned child; never touches an attached
+   * runtime Hermes did not start. Escalates to SIGKILL after a bounded
+   * timeout if the child does not exit on its own.
+   */
+  async stopOwned(): Promise<void> {
+    this.stopRequested = true
+
+    if (this.startPromise) {
+      await this.startPromise.catch(() => {})
+    }
+
+    if (!this.owned || !this.child) {
+      return
+    }
+
+    const child = this.child
+    const stopTimeoutMs = this.deps.stopTimeoutMs ?? DEFAULT_STOP_TIMEOUT_MS
+    const now = this.deps.now ?? Date.now
+    const sleep = this.deps.sleep ?? ((ms: number) => new Promise<void>(resolve => setTimeout(resolve, ms)))
+
+    this.intentionalStop = true
+
+    let exited = false
+
+    const onExit = () => {
+      exited = true
+    }
+
+    child.once('exit', onExit)
+
+    this.killChild(child, 'SIGTERM')
+
+    const deadline = now() + stopTimeoutMs
+    const pollMs = Math.max(1, Math.min(50, stopTimeoutMs))
+
+    while (!exited && now() < deadline) {
+      await sleep(pollMs)
+    }
+
+    if (!exited) {
+      this.killChild(child, 'SIGKILL')
+    }
+
+    this.child = null
+    this.owned = false
+
+    if (this.state.state !== 'stopped') {
+      this.state = { state: 'stopped', profile: this.deps.profile }
+    }
+  }
+}
