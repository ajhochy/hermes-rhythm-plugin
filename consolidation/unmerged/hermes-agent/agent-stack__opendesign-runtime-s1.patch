@@ -0,0 +1,283 @@
+#!/usr/bin/env node
+// live-smoke.mjs — real, no-mock headless smoke test for the Open Design
+// runtime. Not part of the mocked unit-test suite (`npm run test:open-design`):
+// this actually verifies the cached official DMG's checksum, stages the
+// complete signed app into a disposable location, launches its own
+// executable with `--headless`, a disposable namespace/data root, an
+// atomically-written no-telemetry config, and an allowlisted environment,
+// then asserts /api/health reports version 0.20.0 before terminating the
+// child and removing only the disposable data it created.
+//
+// Usage: node scripts/open-design/live-smoke.mjs
+//
+// Requires the official darwin-arm64 DMG already cached at
+// ~/Library/Caches/Hermes/OpenDesign/<version>/darwin-arm64/<asset name>
+// (falls back to stage.mjs's own cache dir). Never downloads silently in
+// CI; fails closed with a clear message if neither cache has the asset.
+
+import { execFile, spawn } from 'node:child_process'
+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { promisify } from 'node:util'
+
+import { buildOpenDesignChildEnv } from '../../electron/open-design/child-env.js'
+import { buildSafePackagedConfig, writeSafePackagedConfigFile } from '../../electron/open-design/packaged-config.js'
+import { parseOpenDesignWebIdentity, validateOpenDesignWebIdentity } from '../../electron/open-design/identity.js'
+import { loadContractManifest, resolveAssetForPlatform, verifyChecksumOrThrow, extractDmg, STAGED_APP_DIR_NAME } from './stage.mjs'
+import { isMain } from '../utils.mjs'
+
+const execFileAsync = promisify(execFile)
+const here = path.dirname(fileURLToPath(import.meta.url))
+const desktopRoot = path.resolve(here, '..', '..')
+
+function log(message) {
+  process.stdout.write(`[open-design live-smoke] ${message}\n`)
+}
+
+function findCachedDmg(manifest, asset) {
+  const candidates = [
+    path.join(os.homedir(), 'Library', 'Caches', 'Hermes', 'OpenDesign', manifest.version, 'darwin-arm64', asset.name),
+    path.join(os.homedir(), '.cache', 'hermes-desktop', 'open-design', manifest.version, 'darwin-arm64', asset.name)
+  ]
+
+  return candidates.find(candidate => fs.existsSync(candidate)) ?? null
+}
+
+function findAppExecutable(appRoot) {
+  const macOsDir = path.join(appRoot, 'Contents', 'MacOS')
+  const entries = fs.readdirSync(macOsDir).filter(entry => {
+    const stat = fs.statSync(path.join(macOsDir, entry))
+    return stat.isFile() && (stat.mode & 0o111) !== 0
+  })
+
+  if (entries.length !== 1) {
+    throw new Error(`[open-design live-smoke] expected exactly one executable in ${macOsDir}, found: ${entries.join(', ') || '(none)'}`)
+  }
+
+  return path.join(macOsDir, entries[0])
+}
+
+async function waitForFile(filePath, timeoutMs, pollMs = 200) {
+  const deadline = Date.now() + timeoutMs
+
+  while (Date.now() < deadline) {
+    if (fs.existsSync(filePath)) {
+      try {
+        return JSON.parse(fs.readFileSync(filePath, 'utf8'))
+      } catch {
+        // Mid-write; keep polling.
+      }
+    }
+
+    await new Promise(resolve => setTimeout(resolve, pollMs))
+  }
+
+  throw new Error(`[open-design live-smoke] timed out after ${timeoutMs}ms waiting for ${filePath}`)
+}
+
+async function fetchJson(url, timeoutMs = 5000) {
+  const controller = new AbortController()
+  const timer = setTimeout(() => controller.abort(), timeoutMs)
+
+  try {
+    const response = await fetch(url, { signal: controller.signal })
+
+    if (!response.ok) {
+      throw new Error(`HTTP ${response.status}`)
+    }
+
+    return await response.json()
+  } finally {
+    clearTimeout(timer)
+  }
+}
+
+async function waitForProcessExit(pid, timeoutMs) {
+  const deadline = Date.now() + timeoutMs
+
+  while (Date.now() < deadline) {
+    try {
+      process.kill(pid, 0)
+    } catch {
+      return true
+    }
+
+    await new Promise(resolve => setTimeout(resolve, 100))
+  }
+
+  return false
+}
+
+async function main() {
+  if (process.platform !== 'darwin' || process.arch !== 'arm64') {
+    log(`skipping: this smoke test only runs on darwin-arm64 (host is ${process.platform}-${process.arch})`)
+    return
+  }
+
+  const manifest = loadContractManifest()
+  const asset = resolveAssetForPlatform(manifest, 'darwin', 'arm64')
