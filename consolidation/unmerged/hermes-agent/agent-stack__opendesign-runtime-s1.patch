+
+// ── Exact CPU architecture parsing (PE COFF Machine, Mach-O cputype/fat) ────
+//
+// Duplicated from electron/open-design/native-runtime-closure.ts's
+// parsePeMachineFromBuffer/parseMachOArchitectures/verifyNativeBinaryArchitecture
+// (same magic-byte offsets and cputype constants): this script runs under
+// plain node (no TS transpilation), the same duplication-with-a-cross-
+// reference pattern already used between that module and this file's own
+// classifyNativeBinary import above. classifyNativeBinary alone only proves
+// FILE FORMAT (ELF/Mach-O/PE); it cannot tell an arm64 binary from an x64 one
+// of the same format, or a fat binary missing the requested slice.
+const PE_MACHINE_X64 = 0x8664
+const PE_MACHINE_ARM64 = 0xaa64
+const DOS_HEADER_MIN_BYTES = 0x40
+const MACHO_MAGIC_64_BE = 0xfeedfacf
+const MACHO_MAGIC_64_LE = 0xcffaedfe
+const FAT_MAGIC_BE = 0xcafebabe
+const FAT_MAGIC_LE = 0xbebafeca
+const CPU_TYPE_X86_64 = 0x01000007
+const CPU_TYPE_ARM64 = 0x0100000c
+const MAX_FAT_ARCH_ENTRIES = 32
+const FAT_ARCH_ENTRY_BYTES = 20
+const PE_HEADER_PROBE_BYTES = 4096
