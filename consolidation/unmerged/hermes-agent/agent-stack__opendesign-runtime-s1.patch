+/**
+ * Checks BOTH the exe file's own ACL and its containing directory's ACL: an
+ * attacker who cannot write the file directly but CAN delete/replace it via
+ * a writable containing directory has the same swap capability. A no-op off
+ * win32 -- the guardian never runs there, and `icacls` does not exist to call.
+ */
+export function assertSecureGuardianAcl(targetPath: string, options: AssertSecureGuardianAclOptions = {}): void {
+  const platform = options.platform ?? process.platform
+
+  if (platform !== 'win32') {
+    return
+  }
+
+  const execFileSync = options.execFileSync ?? defaultIcaclsQuery
+  const trustedPrincipals = options.trustedPrincipals ?? DEFAULT_TRUSTED_GUARDIAN_ACL_PRINCIPALS
