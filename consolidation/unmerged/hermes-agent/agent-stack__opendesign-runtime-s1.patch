+    const bigEndian = magic === FAT_MAGIC_BE
+    const nfatArch = bigEndian ? buffer.readUInt32BE(4) : buffer.readUInt32LE(4)
+    if (nfatArch === 0 || nfatArch > MAX_FAT_ARCH_ENTRIES) return null
