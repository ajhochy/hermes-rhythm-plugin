index 0000000000..a617dd9454
--- /dev/null
+++ b/apps/desktop/native/open-design-job/lifecycle-target.cpp
@@ -0,0 +1,111 @@
+// Real Windows-only target used by windows-job-guardian.real-exe.test.ts.
+// It reports facts from its first user-mode instruction through a file the
+// parent test owns; it never speaks the guardian protocol or fakes a Job.
+#include <windows.h>
+
+#include <fstream>
+#include <string>
+#include <vector>
+
+namespace {
+std::wstring ArgValue(int argc, wchar_t **argv, const wchar_t *name) {
+  for (int i = 1; i + 1 < argc; ++i) {
+    if (wcscmp(argv[i], name) == 0) return argv[i + 1];
+  }
+  return L"";
+}
+
+bool HasArg(int argc, wchar_t **argv, const wchar_t *name) {
+  for (int i = 1; i < argc; ++i) {
+    if (wcscmp(argv[i], name) == 0) return true;
+  }
+  return false;
+}
+
+void Append(const std::wstring &path, const std::wstring &line) {
+  std::wofstream out(path, std::ios::app);
+  out << line << L"\n";
+  out.flush();
+}
+
+std::wstring SelfPath() {
+  std::vector<wchar_t> buffer(32768);
+  DWORD count = GetModuleFileNameW(nullptr, buffer.data(), static_cast<DWORD>(buffer.size()));
+  return std::wstring(buffer.data(), count);
+}
+
+std::wstring Quote(const std::wstring &value) { return L"\"" + value + L"\""; }
+
+DWORD SpawnSelf(const std::wstring &report, const wchar_t *mode, DWORD flags = 0,
+                const wchar_t *extra = L"") {
+  std::wstring command = Quote(SelfPath()) + L" --report " + Quote(report) + L" --mode " + mode + L" " + extra;
+  std::vector<wchar_t> mutableCommand(command.begin(), command.end());
+  mutableCommand.push_back(L'\0');
+  STARTUPINFOW startup{};
+  startup.cb = sizeof(startup);
+  PROCESS_INFORMATION process{};
+  if (!CreateProcessW(nullptr, mutableCommand.data(), nullptr, nullptr, FALSE, flags, nullptr, nullptr, &startup, &process)) {
+    return 0;
+  }
+  CloseHandle(process.hThread);
+  CloseHandle(process.hProcess);
+  return process.dwProcessId;
+}
+}
+
+int wmain(int argc, wchar_t **argv) {
+  const std::wstring report = ArgValue(argc, argv, L"--report");
+  const std::wstring mode = ArgValue(argc, argv, L"--mode");
+  if (report.empty() || mode.empty()) return 2;
+
+  if (mode == L"child") {
+    BOOL childInJob = FALSE;
+    if (!IsProcessInJob(GetCurrentProcess(), nullptr, &childInJob)) return 6;
+    Append(report, L"child_in_job=" + std::to_wstring(childInJob ? 1 : 0));
+    Append(report, L"child_pid=" + std::to_wstring(GetCurrentProcessId()));
+    if (HasArg(argc, argv, L"--spawn-grandchild")) {
+      DWORD grandchild = SpawnSelf(report, L"grandchild");
+      if (grandchild == 0) return 7;
+      Append(report, L"grandchild_pid=" + std::to_wstring(grandchild));
+    }
+    Sleep(INFINITE);
+    return 0;
+  }
+
+  if (mode == L"grandchild") {
+    BOOL grandchildInJob = FALSE;
+    if (!IsProcessInJob(GetCurrentProcess(), nullptr, &grandchildInJob)) return 8;
+    Append(report, L"grandchild_in_job=" + std::to_wstring(grandchildInJob ? 1 : 0));
+    Append(report, L"grandchild_pid=" + std::to_wstring(GetCurrentProcessId()));
+    Sleep(INFINITE);
+    return 0;
+  }
+
+  BOOL inJob = FALSE;
+  if (!IsProcessInJob(GetCurrentProcess(), nullptr, &inJob)) return 3;
+  Append(report, L"in_job=" + std::to_wstring(inJob ? 1 : 0));
+  Append(report, L"target_pid=" + std::to_wstring(GetCurrentProcessId()));
+
+  if (mode == L"descendants" || mode == L"crash" || mode == L"pressure") {
+    const int count = mode == L"pressure" ? 12 : 2;
+    for (int i = 0; i < count; ++i) {
+      DWORD pid = SpawnSelf(report, L"child", 0, i == 0 && mode == L"descendants" ? L"--spawn-grandchild" : L"");
+      if (pid == 0) return 4;
+      Append(report, L"spawned_pid=" + std::to_wstring(pid));
+    }
+  }
+
+  if (mode == L"breakaway") {
+    DWORD pid = SpawnSelf(report, L"child", CREATE_BREAKAWAY_FROM_JOB);
+    if (pid != 0) {
+      Append(report, L"breakaway_pid=" + std::to_wstring(pid));
+      return 5;
+    }
+    Append(report, L"breakaway_error=" + std::to_wstring(GetLastError()));
+  }
+
+  if (mode == L"crash") TerminateProcess(GetCurrentProcess(), 91);
+  if (mode == L"exit") return 0;
+  Sleep(INFINITE);
+  return 0;
+}
