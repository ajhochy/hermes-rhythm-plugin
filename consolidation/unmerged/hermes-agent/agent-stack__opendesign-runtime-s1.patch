index 0000000000..0436ec2f7e
--- /dev/null
+++ b/apps/desktop/electron/open-design/native-runtime-closure.ts
@@ -0,0 +1,175 @@
+/**
+ * native-runtime-closure.ts — validates the FULL platform native-module
+ * closure node-pty actually requires, mirroring
+ * `tools/pack/src/node-pty-runtime.ts` in the pinned Open Design source
+ * exactly (commit fa3cb4cdf3d1703e984a5655bd9654f8d44c493b, tag
+ * open-design-v0.20.0):
+ *
+ *   - darwin-arm64 / darwin-x64: `pty.node`, executable `spawn-helper`
+ *   - win32-x64: `conpty.node`, `conpty_console_list.node`, `pty.node`,
+ *     `winpty-agent.exe`, `winpty.dll`
+ *
+ * A prior candidate validated only `pty.node`, which let an incomplete
+ * Windows payload (missing conpty/winpty files entirely) pass. This checks
+ * regular-file type, nonzero size, executable mode where applicable, and the
+ * file's actual architecture via its binary header -- never filename alone.
+ *
+ * Used at both staging time (scripts/open-design/stage.mjs, which mirrors
+ * this same magic-byte classification via stage-native-deps.mjs's
+ * classifyNativeBinary) and resolver time (resolver.ts, below).
+ */
+
+import type path from 'node:path'
+
+export interface RequiredNodePtyRuntimeFile {
+  label: string
+  relativePath: string
+  executable?: boolean
+}
+
+export const REQUIRED_NODE_PTY_RUNTIME_FILES: Record<string, readonly RequiredNodePtyRuntimeFile[]> = {
+  'darwin-arm64': [
+    { label: 'pty.node', relativePath: 'pty.node' },
+    { label: 'spawn-helper', relativePath: 'spawn-helper', executable: true }
+  ],
+  'darwin-x64': [
+    { label: 'pty.node', relativePath: 'pty.node' },
+    { label: 'spawn-helper', relativePath: 'spawn-helper', executable: true }
+  ],
+  'win32-x64': [
+    { label: 'conpty.node', relativePath: 'conpty.node' },
+    { label: 'conpty_console_list.node', relativePath: 'conpty_console_list.node' },
+    { label: 'pty.node', relativePath: 'pty.node' },
+    { label: 'winpty-agent.exe', relativePath: 'winpty-agent.exe' },
+    { label: 'winpty.dll', relativePath: 'winpty.dll' }
+  ]
+}
+
+export type NativeBinaryPlatformClass = 'linux' | 'darwin' | 'win32'
+
+/**
+ * Classifies a native binary's target platform from its first bytes.
+ * Mirrors scripts/stage-native-deps.mjs's classifyNativeBinary exactly (same
+ * magic-byte constants) so staging-time and resolver-time validation never
+ * drift from each other.
+ */
+export function classifyNativeBinaryHeader(header: Buffer): NativeBinaryPlatformClass | null {
+  if (header.length < 4) {
+    return null
+  }
+
+  // ELF: \x7f E L F
+  if (header[0] === 0x7f && header[1] === 0x45 && header[2] === 0x4c && header[3] === 0x46) {
+    return 'linux'
+  }
+
+  // Mach-O 32-bit BE (feedface), 64-bit BE (feedfacf), 32-bit LE/CIGAM (cefaedfe), 64-bit LE/CIGAM (cffaedfe)
+  const macho = [
+    [0xfe, 0xed, 0xfa, 0xce],
+    [0xfe, 0xed, 0xfa, 0xcf],
+    [0xce, 0xfa, 0xed, 0xfe],
+    [0xcf, 0xfa, 0xed, 0xfe]
+  ]
+
+  // Fat/Universal binary BE (cafebabe) / LE (bebafeca)
+  const fat = [
+    [0xca, 0xfe, 0xba, 0xbe],
+    [0xbe, 0xba, 0xfe, 0xca]
+  ]
+
+  for (const magic of [...macho, ...fat]) {
+    if (header[0] === magic[0] && header[1] === magic[1] && header[2] === magic[2] && header[3] === magic[3]) {
+      return 'darwin'
+    }
+  }
+
+  // PE: MZ DOS header
+  if (header[0] === 0x4d && header[1] === 0x5a) {
+    return 'win32'
+  }
+
+  return null
+}
+
+function expectedPlatformClassFor(platformKey: string): NativeBinaryPlatformClass | null {
+  if (platformKey.startsWith('darwin-')) {
+    return 'darwin'
+  }
+
+  if (platformKey.startsWith('win32-')) {
+    return 'win32'
+  }
+
+  if (platformKey.startsWith('linux-')) {
+    return 'linux'
+  }
+
+  return null
+}
+
+export interface NativeFileProbeResult {
+  isFile: boolean
+  size: number
+  /** POSIX permission bits; absent/ignored on Windows. */
+  mode?: number
+  /** At least the first 4 bytes of the file. */
+  header: Buffer
+}
+
+export interface ValidateNodePtyRuntimeClosureOptions {
+  /** Absolute path to the app's `node_modules` directory (mirrors the pinned module's `appRoot/node_modules`). */
+  nativeRoot: string
+  platformKey: string
+  pathModule: typeof path.posix | typeof path.win32
+  probe: (candidatePath: string) => NativeFileProbeResult | null
+}
+
+export type ValidateNodePtyRuntimeClosureResult =
+  | { ok: true }
+  | { ok: false; reason: string }
+
+export function validateNodePtyRuntimeClosure(
+  options: ValidateNodePtyRuntimeClosureOptions
+): ValidateNodePtyRuntimeClosureResult {
+  const { nativeRoot, platformKey, pathModule, probe } = options
+  const files = REQUIRED_NODE_PTY_RUNTIME_FILES[platformKey]
+
+  if (!files) {
+    return { ok: false, reason: `node-pty packaged runtime does not support ${platformKey}` }
+  }
+
+  const expectedPlatformClass = expectedPlatformClassFor(platformKey)
+  const prebuildDir = pathModule.join(nativeRoot, 'node-pty', 'prebuilds', platformKey)
+
+  for (const file of files) {
+    const candidatePath = pathModule.join(prebuildDir, file.relativePath)
+    const probed = probe(candidatePath)
+
+    if (!probed) {
+      return { ok: false, reason: `node-pty ${file.label} is missing: ${candidatePath}` }
+    }
+
+    if (!probed.isFile) {
+      return { ok: false, reason: `node-pty ${file.label} is not a regular file: ${candidatePath}` }
+    }
+
+    if (probed.size === 0) {
+      return { ok: false, reason: `node-pty ${file.label} is empty: ${candidatePath}` }
+    }
+
+    if (file.executable && expectedPlatformClass !== 'win32' && probed.mode != null && (probed.mode & 0o111) === 0) {
+      return { ok: false, reason: `node-pty ${file.label} is not executable: ${candidatePath}` }
+    }
+
+    const classified = classifyNativeBinaryHeader(probed.header)
+
+    if (expectedPlatformClass && classified !== expectedPlatformClass) {
+      return {
+        ok: false,
+        reason: `node-pty ${file.label} has the wrong architecture/file header (expected ${expectedPlatformClass}, got ${classified ?? 'unknown'}): ${candidatePath}`
+      }
+    }
+  }
+
+  return { ok: true }
+}
