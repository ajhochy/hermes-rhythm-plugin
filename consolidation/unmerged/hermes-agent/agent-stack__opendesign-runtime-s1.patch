+function parsePeMachineFromBuffer(buffer) {
+  if (buffer.length < DOS_HEADER_MIN_BYTES) return null
+  if (buffer[0] !== 0x4d || buffer[1] !== 0x5a) return null
+
+  const peHeaderOffset = buffer.readUInt32LE(0x3c)
+  if (peHeaderOffset < DOS_HEADER_MIN_BYTES || peHeaderOffset + 6 > buffer.length) return null
+
+  if (
+    buffer[peHeaderOffset] !== 0x50 ||
+    buffer[peHeaderOffset + 1] !== 0x45 ||
+    buffer[peHeaderOffset + 2] !== 0x00 ||
+    buffer[peHeaderOffset + 3] !== 0x00
+  ) {
+    return null
+  }
+
+  return buffer.readUInt16LE(peHeaderOffset + 4)
+}
+
+function cpuTypeToArchitecture(cpuType) {
+  if (cpuType === CPU_TYPE_X86_64) return 'x64'
+  if (cpuType === CPU_TYPE_ARM64) return 'arm64'
+  return 'other'
+}
