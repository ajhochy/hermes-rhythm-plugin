+/**
+ * Rejects any grant of Full/Modify/Write-capable rights to a principal
+ * outside the trusted set. A DENY entry only narrows access and is never
+ * itself the risk, so it is skipped rather than evaluated.
+ */
+export function evaluateGuardianAcl(
+  grants: readonly AclGrant[],
+  trustedPrincipals: readonly string[]
+): { ok: true } | { ok: false; reason: string } {
+  const normalizedTrusted = trustedPrincipals.map(principal => principal.toLowerCase())
+
+  for (const grant of grants) {
+    if (grant.deny) {
+      continue
+    }
+
+    if (normalizedTrusted.includes(grant.principal.toLowerCase())) {
+      continue
+    }
+
+    if (WRITE_CAPABLE_RIGHTS_RE.test(grant.rightsToken)) {
+      return {
+        ok: false,
+        reason: `untrusted principal "${grant.principal}" holds write-capable rights (${grant.rightsToken})`
+      }
+    }
+  }
+
+  return { ok: true }
+}
