+    buildWindowsJobGuardian({ sourceCommit }).then(result => {
+      console.log(`[build-windows-job-guardian] built ${result.outputPath} (sha256 ${result.manifest.sha256})`)
+    }).catch(error => {
+      console.error(error.message || error)
+      process.exitCode = 1
+    })
+  }
+}
