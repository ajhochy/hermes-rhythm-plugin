+  fs.mkdirSync(dataDir, { recursive: true })
+  fs.mkdirSync(hermesHome, { recursive: true })
+
+  let child = null
+
+  try {
+    log(`staging the complete signed app into disposable dir: ${workDir}`)
+    await extractDmg({
+      dmgPath,
+      destRoot: workDir,
+      copyResources: async ({ mountPoint, run }) => {
+        const appBundle = fs.readdirSync(mountPoint).find(entry => entry.endsWith('.app'))
+
+        if (!appBundle) {
+          throw new Error(`[open-design live-smoke] no .app bundle found in mounted volume ${mountPoint}`)
+        }
+
+        await run('ditto', [path.join(mountPoint, appBundle), path.join(workDir, STAGED_APP_DIR_NAME)])
+      }
+    })
+
+    const appRoot = path.join(workDir, STAGED_APP_DIR_NAME)
+    const executablePath = findAppExecutable(appRoot)
+    const officialConfigPath = path.join(appRoot, 'Contents', 'Resources', 'open-design-config.json')
+    const officialConfig = fs.existsSync(officialConfigPath) ? JSON.parse(fs.readFileSync(officialConfigPath, 'utf8')) : {}
+
+    log(`resolved executable: ${executablePath}`)
+
+    const safeConfig = buildSafePackagedConfig(officialConfig, { namespace, namespaceBaseRoot })
+    const packagedConfigPath = path.join(namespaceBaseRoot, 'od-packaged-config.json')
+    await writeSafePackagedConfigFile(packagedConfigPath, safeConfig)
+    log(`wrote no-telemetry packaged config: ${packagedConfigPath}`)
+    log(`omitted fields present in official config: ${Object.keys(officialConfig).filter(k => !(k in safeConfig)).join(', ') || '(none)'}`)
+
+    const env = buildOpenDesignChildEnv({
+      baseEnv: process.env,
+      hermesBin: process.env.HERMES_OD_LIVE_SMOKE_HERMES_BIN || 'hermes',
+      hermesHome,
+      packagedConfigPath,
+      namespace,
+      namespaceBaseRoot,
+      dataDir
+    })
+
+    log(`spawning: ${executablePath} --headless (shell=false)`)
+    child = spawn(executablePath, ['--headless'], { env, shell: false, stdio: 'inherit' })
+    const spawnedPid = child.pid
+
+    let exitedEarly = null
+    child.once('exit', (code, signal) => {
+      exitedEarly = { code, signal }
+    })
+
+    const webIdentityPath = path.join(namespaceRoot, 'runtime', 'web-root.json')
+    log(`polling for web identity: ${webIdentityPath}`)
+
+    let identity = null
+    const deadline = Date.now() + 60_000
+
+    while (Date.now() < deadline) {
+      if (exitedEarly) {
+        throw new Error(`[open-design live-smoke] child exited before reporting readiness (code=${exitedEarly.code}, signal=${exitedEarly.signal})`)
+      }
+
+      if (fs.existsSync(webIdentityPath)) {
+        try {
+          const raw = JSON.parse(fs.readFileSync(webIdentityPath, 'utf8'))
+          const parsed = parseOpenDesignWebIdentity(raw)
+
+          if (parsed) {
+            const validation = validateOpenDesignWebIdentity(parsed, { expectedNamespace: namespace, expectedPid: spawnedPid })
+
+            if (validation.ok) {
+              identity = parsed
+              break
+            }
+
+            if (validation.code !== 'pid_mismatch') {
+              throw new Error(`[open-design live-smoke] identity validation failed: ${validation.reason}`)
+            }
+          }
+        } catch {
+          // Mid-write; keep polling.
+        }
+      }
+
+      await new Promise(resolve => setTimeout(resolve, 300))
+    }
+
+    if (!identity) {
+      throw new Error('[open-design live-smoke] timed out waiting for a valid web identity')
+    }
+
+    log(`web identity ready: origin=${identity.url} pid=${identity.pid}`)
+
+    const health = await fetchJson(`${identity.url}/api/health`)
+    log(`GET /api/health -> ${JSON.stringify(health)}`)
+
+    if (health.version !== manifest.version) {
+      throw new Error(`[open-design live-smoke] /api/health reported version ${health.version}, expected ${manifest.version}`)
+    }
+
+    try {
+      const agents = await fetchJson(`${identity.url}/api/agents`)
+      log(`GET /api/agents -> ${JSON.stringify(agents)}`)
+    } catch (error) {
+      log(`(non-fatal) GET /api/agents failed: ${error.message}`)
+    }
+
+    log('SIGTERM -> owned headless process')
+    process.kill(spawnedPid, 'SIGTERM')
+    const exited = await waitForProcessExit(spawnedPid, 15_000)
+    log(exited ? 'owned process exited cleanly' : 'owned process did not exit within 15s (may require SIGKILL manually)')
+
+    log('LIVE SMOKE PASSED')
+  } finally {
+    if (child && child.exitCode === null && child.pid) {
+      try {
+        process.kill(child.pid, 'SIGKILL')
+      } catch {
+        // Already gone.
+      }
+    }
+    fs.rmSync(workDir, { recursive: true, force: true })
+  }
+}
+
+if (isMain(import.meta.url)) {
+  main().catch(error => {
+    console.error(error.message || error)
+    process.exitCode = 1
+  })
+}
