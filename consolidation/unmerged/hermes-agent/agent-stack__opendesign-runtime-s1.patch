+    const provenance = JSON.parse(fs.readFileSync(path.join(destRoot, 'provenance.json'), 'utf8'))
+    assert.equal(provenance.version, '0.20.0')
+    assert.equal(provenance.platform, 'darwin-arm64')
+    assert.equal(provenance.sha256, sha256)
+  } finally {
+    fs.rmSync(dir, { recursive: true, force: true })
+  }
+})
