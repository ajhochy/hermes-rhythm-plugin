+@pytest.mark.parametrize("source", ["webhook", "reconciliation"])
+def test_validate_both_sources_accepted(
+    validate_issue_fn, supported_envelope, repository_map, source
+):
+    env = copy.deepcopy(supported_envelope)
+    env["source"] = source
+    env["delivery_id"] = "delivery-A" if source == "webhook" else None
+    _ok(validate_issue_fn(env, repository_map))
+
