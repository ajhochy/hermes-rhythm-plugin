+"""
+Fixtures and guardrails for github-intake contract tests.
+
+Never imports plugins/github-intake by package name (directory is hyphenated).
+Loads intake.py via importlib.util from a file path.
+"""
+from __future__ import annotations
+
+import copy
+import importlib.util
+import json
+import socket
+import subprocess
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+_REPO_ROOT = Path(__file__).parents[3]
+_INTAKE_PATH = _REPO_ROOT / "plugins" / "github-intake" / "intake.py"
+
+REPOSITORY_MAP = {"NousResearch/Hermes-Agent": "hermes-agent"}
+
+
+def _load_fixture(name: str) -> Any:
+    path = Path(__file__).parent / "fixtures" / name
+    return json.loads(path.read_text(encoding="utf-8"))
+
+
+def _try_load_intake():
+    if not _INTAKE_PATH.exists():
+        return None
+    spec = importlib.util.spec_from_file_location("_github_intake_impl", _INTAKE_PATH)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)  # type: ignore[union-attr]
+    return mod
+
+
+@pytest.fixture(scope="session")
+def _intake_module_or_none():
+    return _try_load_intake()
+
+
+@pytest.fixture
+def intake_module(_intake_module_or_none):
+    """Skip the test if intake.py is absent or incomplete."""
+    if _intake_module_or_none is None:
+        pytest.skip("blocked by missing intake contract")
+    if not (
+        callable(getattr(_intake_module_or_none, "validate_issue", None))
+        and callable(getattr(_intake_module_or_none, "normalize_issue", None))
+    ):
+        pytest.skip("blocked by missing intake contract")
+    return _intake_module_or_none
+
+
+@pytest.fixture
+def validate_issue_fn(intake_module):
+    return intake_module.validate_issue
+
+
+@pytest.fixture
+def normalize_issue_fn(intake_module):
+    return intake_module.normalize_issue
+
+
+@pytest.fixture
+def repository_map():
+    return dict(REPOSITORY_MAP)
+
+
+@pytest.fixture
+def supported_envelope():
+    return copy.deepcopy(_load_fixture("supported_issue_opened.json"))
+
+
+@pytest.fixture
+def untrusted_envelope():
+    return copy.deepcopy(_load_fixture("untrusted_issue_opened.json"))
+
+
+# ── Security guardrails ──────────────────────────────────────────────────────
+
+@pytest.fixture(autouse=True)
+def _block_network(monkeypatch):
+    def _no_connect(self, address):
+        raise RuntimeError(f"Network access blocked in tests: {address!r}")
+
+    monkeypatch.setattr(socket.socket, "connect", _no_connect)
+
+
+@pytest.fixture(autouse=True)
+def _block_subprocess(monkeypatch):
+    def _blocked(*args, **kwargs):
+        raise RuntimeError(f"Subprocess blocked in tests: {args!r}")
+
+    monkeypatch.setattr(subprocess, "Popen", _blocked)
+    monkeypatch.setattr(subprocess, "run", _blocked)
+    monkeypatch.setattr(subprocess, "call", _blocked)
+    monkeypatch.setattr(subprocess, "check_output", _blocked)
+    monkeypatch.setattr(subprocess, "check_call", _blocked)
+
+
+@pytest.fixture(autouse=True)
+def _isolate_hermes_home(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path / "hermes_home"))
