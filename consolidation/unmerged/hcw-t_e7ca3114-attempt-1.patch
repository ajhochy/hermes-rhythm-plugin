+"""
+Validation contract tests for github-intake.
+
+Sentinel: test_intake_implementation_available — fails (RED) when intake.py
+is absent. All behavior-contract tests skip via the intake_module fixture
+when intake.py is absent ('blocked by missing intake contract').
+
+API contract:
+  validate_issue(envelope, repository_map) -> {'accepted': bool, 'reason': str | None}
+  normalize_issue(envelope, repository_map) -> None for every rejection
+"""
+from __future__ import annotations
+
+import copy
+import importlib.util
+import json
+from pathlib import Path
+
+import pytest
+
+_REPO_ROOT = Path(__file__).parents[3]
+_INTAKE_PATH = _REPO_ROOT / "plugins" / "github-intake" / "intake.py"
+
+_REPOSITORY_MAP = {"NousResearch/Hermes-Agent": "hermes-agent"}
+
+# ── Availability sentinel ────────────────────────────────────────────────────
+
+
+def test_intake_implementation_available():
+    """Fails until intake.py exists with callable validate_issue and normalize_issue."""
+    missing = not _INTAKE_PATH.exists()
+    if not missing:
+        spec = importlib.util.spec_from_file_location("_sentinel_check", _INTAKE_PATH)
+        mod = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(mod)  # type: ignore[union-attr]
+        missing = not (
+            callable(getattr(mod, "validate_issue", None))
+            and callable(getattr(mod, "normalize_issue", None))
+        )
+    assert not missing, (
+        "missing GitHub intake implementation: expected plugins/github-intake/intake.py "
+        "with callable validate_issue and normalize_issue"
+    )
+
+
+# ── Helpers ──────────────────────────────────────────────────────────────────
+
+
+def _make_reconciliation(envelope: dict) -> dict:
+    env = copy.deepcopy(envelope)
+    env["source"] = "reconciliation"
+    env["delivery_id"] = None
+    return env
+
+
+def _set_action(envelope: dict, action: str) -> dict:
+    env = copy.deepcopy(envelope)
+    env["payload"]["action"] = action
+    return env
+
+
+def _ok(result: dict) -> None:
+    assert result == {"accepted": True, "reason": None}
+
+
+def _rejected(result: dict, reason: str) -> None:
+    assert result == {"accepted": False, "reason": reason}
+
+
+# ── Acceptance: supported envelope ──────────────────────────────────────────
+
+
+def test_validate_supported_webhook_accepted(
+    validate_issue_fn, supported_envelope, repository_map
+):
+    _ok(validate_issue_fn(supported_envelope, repository_map))
+
