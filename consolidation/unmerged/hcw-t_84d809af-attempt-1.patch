@@ -0,0 +1,333 @@
+"""
+Reusable test-only harness for hermetic HCW GitHub-intake testing.
+
+Public surface:
+  TempGitRepo        — deterministic temporary Git repository builder
+  RunResult          — normalized subprocess result with artifact capture
+  HCWSubprocessRunner — isolated subprocess runner for the HCW launcher
+  build_isolated_env — build a minimal hermetic environment dict
+  load_fixed_intake  — load the pinned intake fixture
+"""
+from __future__ import annotations
+
+import json
+import os
+import shutil
+import stat
+import subprocess
+import tempfile
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any
+
+_TESTS_DIR = Path(__file__).parent
+_SUPPORT_DIR = _TESTS_DIR / "support"
+_FIXTURES_DIR = _TESTS_DIR / "fixtures"
+
+# Pinned identity for all deterministic commits.
+_GIT_AUTHOR_NAME = "Harness Test"
+_GIT_AUTHOR_EMAIL = "harness@test.invalid"
+_GIT_FIXED_DATE = "2024-01-01T00:00:00+00:00"
+_GIT_INITIAL_BRANCH = "main"
+
+
+# ---------------------------------------------------------------------------
+# RunResult
+# ---------------------------------------------------------------------------
+
+@dataclass
+class RunResult:
+    """Normalized result from a single HCW subprocess invocation."""
+
+    argv: list[str]
+    exit_code: int
+    stdout: str
+    stderr: str
+    artifacts: dict[str, bytes] = field(default_factory=dict)
+
+    def normalize(self, tmp_prefix: str = "") -> "RunResult":
+        """Return a copy with volatile temporary path prefixes replaced."""
+        def _strip(s: str) -> str:
+            if tmp_prefix:
+                s = s.replace(tmp_prefix, "<TMP>")
+            return s
+
+        return RunResult(
+            argv=self.argv,
+            exit_code=self.exit_code,
+            stdout=_strip(self.stdout),
+            stderr=_strip(self.stderr),
+            artifacts={k: v for k, v in self.artifacts.items()},
+        )
+
+    def assert_success(self) -> None:
+        if self.exit_code != 0:
+            raise AssertionError(
+                f"Command exited {self.exit_code} (expected 0)\n"
+                f"argv: {self.argv!r}\n"
+                f"stdout:\n{self.stdout}\n"
+                f"stderr:\n{self.stderr}"
+            )
+
+    def assert_failure(self) -> None:
+        if self.exit_code == 0:
+            raise AssertionError(
+                f"Expected non-zero exit but command succeeded\n"
+                f"argv: {self.argv!r}\n"
+                f"stdout:\n{self.stdout}\n"
+                f"stderr:\n{self.stderr}"
+            )
+
+    def diagnostics(self) -> str:
+        """Human-readable summary for use in assertion failure messages."""
+        return (
+            f"argv: {self.argv!r}\n"
+            f"exit_code: {self.exit_code}\n"
+            f"stdout:\n{self.stdout}\n"
+            f"stderr:\n{self.stderr}\n"
+            f"artifacts: {sorted(self.artifacts)}"
+        )
+
+
+# ---------------------------------------------------------------------------
+# TempGitRepo
+# ---------------------------------------------------------------------------
+
+class TempGitRepo:
+    """
+    Builds a deterministic temporary Git repository.
+
+    All Git environment variables are pinned so that repeated calls with
+    identical inputs produce identical commit SHAs.
+    """
+
+    def __init__(self, path: Path) -> None:
+        self.path = path
+        self._env = _deterministic_git_env(path)
+
+    # -- builder API -------------------------------------------------------
+
+    def init(self) -> "TempGitRepo":
+        self.path.mkdir(parents=True, exist_ok=True)
+        # --initial-branch requires git ≥ 2.28; fall back gracefully.
+        try:
+            self._git("init", "--initial-branch", _GIT_INITIAL_BRANCH)
+        except subprocess.CalledProcessError:
+            self._git("init")
+            self._git("symbolic-ref", "HEAD", f"refs/heads/{_GIT_INITIAL_BRANCH}")
+        self._git("config", "user.name", _GIT_AUTHOR_NAME)
+        self._git("config", "user.email", _GIT_AUTHOR_EMAIL)
+        return self
+
+    def add_file(self, name: str, content: bytes) -> "TempGitRepo":
+        dest = self.path / name
+        dest.parent.mkdir(parents=True, exist_ok=True)
+        dest.write_bytes(content)
+        return self
+
+    def commit(self, message: str = "initial") -> "TempGitRepo":
+        self._git("add", "-A")
+        self._git(
+            "commit", "--allow-empty", "-m", message,
+            extra={
+                "GIT_AUTHOR_DATE": _GIT_FIXED_DATE,
+                "GIT_COMMITTER_DATE": _GIT_FIXED_DATE,
+            },
+        )
+        return self
+
+    def head_sha(self) -> str:
+        result = subprocess.run(
+            ["git", "rev-parse", "HEAD"],
+            cwd=self.path,
+            capture_output=True,
+            text=True,
+            env=self._env,
+            check=True,
+        )
+        return result.stdout.strip()
+
+    # -- internals ---------------------------------------------------------
+
+    def _git(self, *args: str, extra: dict[str, str] | None = None) -> None:
+        env = dict(self._env)
+        if extra:
+            env.update(extra)
+        result = subprocess.run(
+            ["git", *args],
+            cwd=self.path,
+            capture_output=True,
+            text=True,
+            env=env,
+        )
+        if result.returncode != 0:
+            raise subprocess.CalledProcessError(
+                result.returncode,
+                ["git", *args],
+                output=result.stdout,
+                stderr=result.stderr,
+            )
+
+
+def _deterministic_git_env(repo_path: Path) -> dict[str, str]:
+    """Minimal, system-config-free env for deterministic git operations."""
+    config_dir = repo_path.parent / ".git-harness-config"
+    config_dir.mkdir(parents=True, exist_ok=True)
+    return {
+        "HOME": str(repo_path.parent),
+        "GIT_CONFIG_NOSYSTEM": "1",
+        "GIT_CONFIG_GLOBAL": str(config_dir / "gitconfig"),
+        "GIT_AUTHOR_NAME": _GIT_AUTHOR_NAME,
+        "GIT_AUTHOR_EMAIL": _GIT_AUTHOR_EMAIL,
+        "GIT_COMMITTER_NAME": _GIT_AUTHOR_NAME,
+        "GIT_COMMITTER_EMAIL": _GIT_AUTHOR_EMAIL,
+        "PATH": os.environ.get("PATH", "/usr/bin:/bin"),
+        "LANG": "C.UTF-8",
+        "LC_ALL": "C.UTF-8",
+        "TZ": "UTC",
+    }
+
+
+# ---------------------------------------------------------------------------
+# Isolated environment builder
+# ---------------------------------------------------------------------------
+
+def build_isolated_env(
+    tmp_dir: Path,
+    launcher: str | None = None,
+    extra_path_dirs: list[str] | None = None,
+) -> dict[str, str]:
+    """
+    Build a minimal hermetic environment dict for subprocess invocation.
+
+    Isolates: HOME, HERMES_HOME, XDG_* dirs, Git system/global config,
+    locale, timezone, prompts, credentials, and network proxies.
+    Exposes: the support/ directory (boundary wrappers), any extra_path_dirs,
+    and minimal system executables.
+    """
+    board_dir = tmp_dir / "board"
+    hermes_home = tmp_dir / "hermes_home"
+    config_home = tmp_dir / "xdg_config"
+    cache_home = tmp_dir / "xdg_cache"
+    home_dir = tmp_dir / "home"
+    for d in [board_dir, hermes_home, config_home, cache_home, home_dir]:
+        d.mkdir(parents=True, exist_ok=True)
+
+    path_parts: list[str] = [str(_SUPPORT_DIR)]
+    if extra_path_dirs:
+        path_parts.extend(extra_path_dirs)
+    path_parts.extend(["/usr/bin", "/bin"])
+
+    env: dict[str, str] = {
+        "HOME": str(home_dir),
+        "HERMES_HOME": str(hermes_home),
+        "HERMES_KANBAN_HOME": str(board_dir),
+        "XDG_CONFIG_HOME": str(config_home),
+        "XDG_CACHE_HOME": str(cache_home),
+        "GIT_CONFIG_NOSYSTEM": "1",
+        "GIT_CONFIG_GLOBAL": str(config_home / "gitconfig"),
+        "PATH": os.pathsep.join(path_parts),
+        "LANG": "C.UTF-8",
+        "LC_ALL": "C.UTF-8",
+        "TZ": "UTC",
+        "PYTHONHASHSEED": "0",
+        "PYTHONUTF8": "1",
+        # Block interactive credential prompts.
+        "GIT_TERMINAL_PROMPT": "0",
+        "GIT_ASKPASS": "true",
+        "SSH_ASKPASS": "true",
+        "GIT_SSH_COMMAND": "false",
+    }
+    if launcher:
+        env["HCW_LAUNCHER"] = launcher
+
+    # Explicitly blank all known proxy / credential variables so nothing
+    # leaks from the outer developer environment.
+    for k in [
+        "http_proxy", "https_proxy", "HTTP_PROXY", "HTTPS_PROXY",
+        "ALL_PROXY", "all_proxy", "NO_PROXY", "no_proxy",
+        "GITHUB_TOKEN", "GH_TOKEN", "ANTHROPIC_API_KEY",
+        "OPENAI_API_KEY", "HERMES_API_KEY",
+    ]:
+        env[k] = ""
+
+    return env
+
+
+# ---------------------------------------------------------------------------
+# HCW subprocess runner
+# ---------------------------------------------------------------------------
+
+class HCWSubprocessRunner:
+    """
+    Runs ``hcw create-run`` through a subprocess with an isolated environment.
+
+    The launcher is invoked as an external process; no HCW runtime modules
+    are imported into the test process.
+    """
+
+    def __init__(self, launcher: str, tmp_dir: Path) -> None:
+        self.launcher = launcher
+        self.tmp_dir = tmp_dir
+
+    def run(
+        self,
+        *,
+        repo_path: Path,
+        run_id: str,
+        package: str,
+        scope: str,
+        board: str,
+        goal: str,
+        extra_env: dict[str, str] | None = None,
+    ) -> RunResult:
+        env = build_isolated_env(self.tmp_dir, launcher=self.launcher)
+        if extra_env:
+            env.update(extra_env)
+        argv = [
+            self.launcher,
+            "create-run",
+            "--repo", str(repo_path),
+            "--run-id", run_id,
+            "--package", package,
+            "--scope", scope,
+            "--board", board,
+            "--goal", goal,
+        ]
+        proc = subprocess.run(
+            argv,
+            capture_output=True,
+            text=True,
+            env=env,
+            cwd=str(repo_path),
+            timeout=120,
+        )
+        artifacts = _collect_artifacts(repo_path, run_id)
+        return RunResult(
+            argv=argv,
+            exit_code=proc.returncode,
+            stdout=proc.stdout,
+            stderr=proc.stderr,
+            artifacts=artifacts,
+        )
+
+
+def _collect_artifacts(repo_path: Path, run_id: str) -> dict[str, bytes]:
+    """Collect declared workflow and repository artifacts after a run."""
+    artifacts: dict[str, bytes] = {}
+    run_dir = repo_path / ".hermes" / "runs" / run_id
+    if run_dir.exists():
+        for f in sorted(run_dir.rglob("*")):
+            if f.is_file():
+                rel = str(f.relative_to(repo_path))
+                artifacts[rel] = f.read_bytes()
+    return artifacts
+
+
+# ---------------------------------------------------------------------------
+# Fixture loader
+# ---------------------------------------------------------------------------
+
+def load_fixed_intake() -> dict[str, Any]:
+    """Load and return the pinned intake fixture."""
+    return json.loads((_FIXTURES_DIR / "fixed_intake.json").read_text())
diff --git a/plugins/github-intake/tests/support/git b/plugins/github-intake/tests/support/git
new file mode 100644
index 0000000000..3e00696190
--- /dev/null
+++ b/plugins/github-intake/tests/support/git
@@ -0,0 +1,68 @@
+#!/usr/bin/env python3
+"""
+Harness git wrapper — placed at the start of PATH inside hermetic test
+subprocesses.  Blocks any subcommand that touches a remote; forwards all
+other invocations to the real git found later in PATH.
+"""
+from __future__ import annotations
+
+import os
+import sys
+
+_BLOCKED_SUBCOMMANDS = frozenset(
+    [
+        "clone",
+        "fetch",
+        "push",
+        "pull",
+        "remote",
+        "ls-remote",
+        "submodule",
+        "archive",
+    ]
+)
+
+_SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
+
+
+def _find_real_git() -> str | None:
+    path_env = os.environ.get("PATH", "")
+    for directory in path_env.split(os.pathsep):
+        real = os.path.realpath(directory)
+        if real == _SCRIPT_DIR:
+            continue
+        candidate = os.path.join(directory, "git")
+        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
+            return candidate
+    return None
+
+
+def main() -> int:
+    args = sys.argv[1:]
+    # Find the first non-option argument as the subcommand.
+    subcommand = None
+    for arg in args:
+        if not arg.startswith("-"):
+            subcommand = arg
+            break
+
+    if subcommand in _BLOCKED_SUBCOMMANDS:
+        sys.stderr.write(
+            f"harness[git]: '{subcommand}' is a remote operation — "
+            "blocked in hermetic test environment; no live network access permitted\n"
+        )
+        sys.stderr.flush()
+        return 1
+
+    real_git = _find_real_git()
+    if real_git is None:
+        sys.stderr.write("harness[git]: real git binary not found in PATH\n")
+        sys.stderr.flush()
+        return 127
+
+    os.execv(real_git, [real_git] + args)
+    return 0  # unreachable
+
+
+if __name__ == "__main__":
+    sys.exit(main())
