@@ -0,0 +1,278 @@
+"""
+T3 / T4 — boundary guard contracts.
+
+Verifies that:
+  * support/sitecustomize.py blocks outbound socket connections inside any
+    Python subprocess that has support/ on its PYTHONPATH.
+  * support/git wrapper rejects remote-touching subcommands (clone, fetch,
+    push, pull, remote, ls-remote) and forwards local subcommands to the
+    real git.
+  * build_isolated_env() emits no credential or proxy variables.
+  * The isolated environment contains no known API-key variables.
+"""
+from __future__ import annotations
+
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from harness import build_isolated_env, RunResult
+
+_TESTS_DIR = Path(__file__).parent
+_SUPPORT_DIR = _TESTS_DIR / "support"
+
+
+# ---------------------------------------------------------------------------
+# Socket boundary guard (sitecustomize.py)
+# ---------------------------------------------------------------------------
+
+
+def _python_with_sitecustomize(tmp_path: Path) -> list[str]:
+    """Build a subprocess command that loads sitecustomize from support/."""
+    env = build_isolated_env(tmp_path)
+    env["PYTHONPATH"] = str(_SUPPORT_DIR)
+    return env
+
+
+@pytest.mark.parametrize("address", [
+    "('8.8.8.8', 80)",
+    "('api.github.com', 443)",
+])
+def test_socket_connect_blocked(tmp_path: Path, address: str) -> None:
+    """sitecustomize.py must block socket.connect() in a guarded subprocess."""
+    env = build_isolated_env(tmp_path)
+    env["PYTHONPATH"] = str(_SUPPORT_DIR)
+    env["PATH"] = os.environ.get("PATH", "/usr/bin:/bin")
+
+    code = f"import socket; s=socket.socket(); s.connect({address})"
+    result = subprocess.run(
+        [sys.executable, "-c", code],
+        capture_output=True,
+        text=True,
+        env=env,
+    )
+    assert result.returncode != 0, (
+        f"Expected socket.connect({address}) to be blocked but it succeeded.\n"
+        f"stdout: {result.stdout}\nstderr: {result.stderr}"
+    )
+    combined = result.stdout + result.stderr
+    assert "blocked" in combined.lower() or "OSError" in combined or "harness" in combined, (
+        f"Expected a harness-block message in output.\nstdout: {result.stdout}\nstderr: {result.stderr}"
+    )
+
+
+def test_create_connection_blocked(tmp_path: Path) -> None:
+    """sitecustomize.py must block socket.create_connection() as well."""
+    env = build_isolated_env(tmp_path)
+    env["PYTHONPATH"] = str(_SUPPORT_DIR)
+    env["PATH"] = os.environ.get("PATH", "/usr/bin:/bin")
+
+    code = "import socket; socket.create_connection(('example.com', 80))"
+    result = subprocess.run(
+        [sys.executable, "-c", code],
+        capture_output=True,
+        text=True,
+        env=env,
+    )
+    assert result.returncode != 0, (
+        "Expected socket.create_connection to be blocked but it succeeded.\n"
+        f"stdout: {result.stdout}\nstderr: {result.stderr}"
+    )
+
+
+def test_normal_python_code_runs_in_guarded_subprocess(tmp_path: Path) -> None:
+    """The socket guard must not break non-network Python code."""
+    env = build_isolated_env(tmp_path)
+    env["PYTHONPATH"] = str(_SUPPORT_DIR)
+    env["PATH"] = os.environ.get("PATH", "/usr/bin:/bin")
+
+    code = "import math; print(math.sqrt(4))"
+    result = subprocess.run(
+        [sys.executable, "-c", code],
+        capture_output=True,
+        text=True,
+        env=env,
+    )
+    assert result.returncode == 0, (
+        f"Non-network code must still run.\nstdout: {result.stdout}\nstderr: {result.stderr}"
+    )
+    assert "2.0" in result.stdout
+
+
+# ---------------------------------------------------------------------------
+# Git wrapper boundary guard (support/git)
+# ---------------------------------------------------------------------------
+
+
+def _git_wrapper_env(tmp_path: Path) -> dict[str, str]:
+    """Build environment that routes `git` through the harness wrapper."""
+    env = build_isolated_env(tmp_path)
+    # support/ is already first in PATH from build_isolated_env; ensure
+    # real git is also reachable after it.
+    real_git_dir = _find_real_git_dir()
+    if real_git_dir:
+        env["PATH"] = str(_SUPPORT_DIR) + os.pathsep + real_git_dir + os.pathsep + "/usr/bin:/bin"
+    else:
+        env["PATH"] = str(_SUPPORT_DIR) + os.pathsep + "/usr/bin:/bin"
+    return env
+
+
+def _find_real_git_dir() -> str | None:
+    """Return the directory containing the real git binary (not our wrapper)."""
+    import shutil
+    real = shutil.which("git")
+    if real:
+        real_path = Path(real).resolve()
+        wrapper_path = (_SUPPORT_DIR / "git").resolve()
+        if real_path != wrapper_path:
+            return str(Path(real).parent)
+    return None
+
+
+@pytest.mark.parametrize("subcommand", [
+    "clone", "fetch", "push", "pull", "remote", "ls-remote",
+])
+def test_git_remote_subcommand_blocked(tmp_path: Path, subcommand: str) -> None:
+    """support/git must reject remote-touching subcommands with exit code 1."""
+    env = _git_wrapper_env(tmp_path)
+    result = subprocess.run(
+        ["git", subcommand, "https://example.com/repo.git"],
+        capture_output=True,
+        text=True,
+        env=env,
+        cwd=str(tmp_path),
+    )
+    assert result.returncode != 0, (
+        f"Expected `git {subcommand}` to be blocked but it succeeded.\n"
+        f"stderr: {result.stderr}"
+    )
+    assert "blocked" in result.stderr.lower() or "harness" in result.stderr.lower(), (
+        f"Expected harness-block message in stderr.\nstderr: {result.stderr}"
+    )
+
+
+def test_git_local_init_allowed(tmp_path: Path) -> None:
+    """support/git must forward `git init` to the real git."""
+    env = _git_wrapper_env(tmp_path)
+    repo_path = tmp_path / "test-repo"
+    repo_path.mkdir()
+    result = subprocess.run(
+        ["git", "init", str(repo_path)],
+        capture_output=True,
+        text=True,
+        env=env,
+        cwd=str(tmp_path),
+    )
+    assert result.returncode == 0, (
+        f"`git init` must be allowed.\nstdout: {result.stdout}\nstderr: {result.stderr}"
+    )
+
+
+def test_git_local_status_allowed(tmp_path: Path) -> None:
+    """support/git must forward `git status` to the real git."""
+    env = _git_wrapper_env(tmp_path)
+    # Need a real git repo for status to work.
+    from harness import TempGitRepo
+    repo = TempGitRepo(tmp_path / "repo")
+    repo.init()
+    repo.add_file("x.txt", b"x")
+    repo.commit("init")
+
+    result = subprocess.run(
+        ["git", "status"],
+        capture_output=True,
+        text=True,
+        env=env,
+        cwd=str(tmp_path / "repo"),
+    )
+    assert result.returncode == 0, (
+        f"`git status` must be allowed.\nstdout: {result.stdout}\nstderr: {result.stderr}"
+    )
+
+
+# ---------------------------------------------------------------------------
+# Isolated environment hygiene
+# ---------------------------------------------------------------------------
+
+
+def test_isolated_env_no_credential_vars(tmp_path: Path) -> None:
+    """build_isolated_env() must blank all known credential variables."""
+    env = build_isolated_env(tmp_path)
+    credential_vars = [
+        "GITHUB_TOKEN", "GH_TOKEN", "ANTHROPIC_API_KEY",
+        "OPENAI_API_KEY", "HERMES_API_KEY",
+    ]
+    for var in credential_vars:
+        assert env.get(var, "") == "", (
+            f"Credential variable {var!r} must be blanked in isolated env"
+        )
+
+
+def test_isolated_env_no_proxy_vars(tmp_path: Path) -> None:
+    """build_isolated_env() must blank all proxy variables."""
+    env = build_isolated_env(tmp_path)
+    proxy_vars = [
+        "http_proxy", "https_proxy", "HTTP_PROXY", "HTTPS_PROXY",
+        "ALL_PROXY", "all_proxy", "NO_PROXY", "no_proxy",
+    ]
+    for var in proxy_vars:
+        assert env.get(var, "") == "", (
+            f"Proxy variable {var!r} must be blanked in isolated env"
+        )
+
+
+def test_isolated_env_git_terminal_prompt_disabled(tmp_path: Path) -> None:
+    """build_isolated_env() must set GIT_TERMINAL_PROMPT=0."""
+    env = build_isolated_env(tmp_path)
+    assert env.get("GIT_TERMINAL_PROMPT") == "0"
+
+
+def test_isolated_env_has_hermes_home(tmp_path: Path) -> None:
+    """build_isolated_env() must provide an isolated HERMES_HOME."""
+    env = build_isolated_env(tmp_path)
