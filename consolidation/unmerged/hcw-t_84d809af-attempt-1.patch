+"""
+T2 / T4 — harness repeatability contracts.
+
+Verifies that:
+  * TempGitRepo produces the same HEAD SHA on two independent instantiations
+    with the same inputs (deterministic commits).
+  * load_fixed_intake() returns stable, schema-correct data.
+  * RunResult.normalize() strips temporary path prefixes reproducibly.
+  * Two RunResult instances with identical fields compare equal.
+  * RunResult.diagnostics() includes argv and captured output so assertion
+    failures are self-describing.
+"""
+from __future__ import annotations
+
+import tempfile
+from pathlib import Path
+
+import pytest
+
+from harness import RunResult, TempGitRepo, load_fixed_intake
+
+
+# ---------------------------------------------------------------------------
+# TempGitRepo determinism
+# ---------------------------------------------------------------------------
+
+
+def test_deterministic_head_sha(tmp_path: Path) -> None:
+    """Two repos built with identical inputs must produce the same HEAD SHA."""
+    repo_a = tmp_path / "a"
+    repo_b = tmp_path / "b"
+
+    def _build(root: Path) -> str:
+        r = TempGitRepo(root)
+        r.init()
+        r.add_file("README.md", b"# Hermetic intake test repository\n")
+        r.commit("initial commit")
+        return r.head_sha()
+
+    sha_a = _build(repo_a)
+    sha_b = _build(repo_b)
+
+    assert sha_a == sha_b, (
+        f"Expected identical SHAs but got:\n  a={sha_a}\n  b={sha_b}"
+    )
+
+
+def test_head_sha_changes_with_content(tmp_path: Path) -> None:
+    """Different file content must produce a different HEAD SHA."""
+    def _build(root: Path, content: bytes) -> str:
+        r = TempGitRepo(root)
+        r.init()
+        r.add_file("README.md", content)
+        r.commit("initial commit")
+        return r.head_sha()
+
+    sha_a = _build(tmp_path / "a", b"# version A\n")
+    sha_b = _build(tmp_path / "b", b"# version B\n")
+
+    assert sha_a != sha_b, "Different content must yield different SHAs"
+
+
+def test_repo_has_main_branch(tmp_path: Path) -> None:
+    """The initial branch must be named 'main'."""
+    import subprocess
+
+    repo_path = tmp_path / "repo"
+    r = TempGitRepo(repo_path)
+    r.init()
+    r.add_file("f.txt", b"hello\n")
+    r.commit("init")
+
+    result = subprocess.run(
+        ["git", "rev-parse", "--abbrev-ref", "HEAD"],
+        cwd=repo_path,
+        capture_output=True,
+        text=True,
+    )
+    assert result.returncode == 0
+    assert result.stdout.strip() == "main"
+
+
+# ---------------------------------------------------------------------------
+# Fixed intake fixture
+# ---------------------------------------------------------------------------
+
+
+def test_fixed_intake_loads() -> None:
+    """load_fixed_intake() must return a dict with required keys."""
+    intake = load_fixed_intake()
+    assert isinstance(intake, dict)
+    for key in ("run_id", "package", "scope", "board", "goal"):
+        assert key in intake, f"Missing required key: {key!r}"
+
+
+def test_fixed_intake_run_id() -> None:
+    """The pinned run_id must match the task run identifier."""
+    intake = load_fixed_intake()
+    assert intake["run_id"] == "t_84d809af"
+
+
+def test_fixed_intake_values_are_strings() -> None:
+    """All intake values must be non-empty strings."""
+    intake = load_fixed_intake()
+    for key in ("run_id", "package", "scope", "board", "goal"):
+        val = intake[key]
+        assert isinstance(val, str) and val, f"{key!r} must be a non-empty string"
+
+
+# ---------------------------------------------------------------------------
+# RunResult normalization
+# ---------------------------------------------------------------------------
+
+
+def test_run_result_normalize_strips_prefix() -> None:
+    """normalize() must replace the given prefix with '<TMP>'."""
+    rr = RunResult(
+        argv=["hcw", "create-run"],
+        exit_code=0,
+        stdout="/tmp/pytest-xyz/test_foo/out.txt",
+        stderr="/tmp/pytest-xyz/test_foo/error.txt",
+    )
+    normed = rr.normalize(tmp_prefix="/tmp/pytest-xyz/test_foo")
+    assert normed.stdout == "<TMP>/out.txt"
+    assert normed.stderr == "<TMP>/error.txt"
+
+
+def test_run_result_normalize_noop_without_prefix() -> None:
+    """normalize() with no prefix must return identical string fields."""
+    rr = RunResult(
+        argv=["hcw"],
+        exit_code=0,
+        stdout="hello",
+        stderr="world",
+    )
+    normed = rr.normalize()
+    assert normed.stdout == "hello"
+    assert normed.stderr == "world"
+
+
+def test_run_result_equality() -> None:
+    """Two RunResult instances with identical fields must compare equal."""
+    a = RunResult(
+        argv=["hcw", "create-run", "--run-id", "t_84d809af"],
+        exit_code=0,
+        stdout="created run t_84d809af\n",
+        stderr="",
+        artifacts={".hermes/runs/t_84d809af/plan.md": b"# plan\n"},
+    )
+    b = RunResult(
+        argv=["hcw", "create-run", "--run-id", "t_84d809af"],
+        exit_code=0,
+        stdout="created run t_84d809af\n",
+        stderr="",
+        artifacts={".hermes/runs/t_84d809af/plan.md": b"# plan\n"},
+    )
+    assert a == b
+
+
+def test_run_result_inequality_on_exit_code() -> None:
+    """RunResult instances must not compare equal if exit codes differ."""
+    a = RunResult(argv=["hcw"], exit_code=0, stdout="", stderr="")
+    b = RunResult(argv=["hcw"], exit_code=1, stdout="", stderr="")
+    assert a != b
+
+
+def test_run_result_inequality_on_artifacts() -> None:
+    """RunResult instances must not compare equal if artifacts differ."""
+    a = RunResult(
+        argv=["hcw"], exit_code=0, stdout="", stderr="",
+        artifacts={"plan.md": b"v1"},
+    )
+    b = RunResult(
+        argv=["hcw"], exit_code=0, stdout="", stderr="",
+        artifacts={"plan.md": b"v2"},
+    )
+    assert a != b
+
+
+# ---------------------------------------------------------------------------
+# RunResult diagnostics
+# ---------------------------------------------------------------------------
+
+
+def test_diagnostics_contains_argv() -> None:
+    """diagnostics() output must include the full argv."""
+    rr = RunResult(
+        argv=["hcw", "create-run", "--run-id", "t_84d809af"],
+        exit_code=1,
+        stdout="",
+        stderr="fatal: something went wrong",
+    )
+    diag = rr.diagnostics()
+    assert "t_84d809af" in diag
+    assert "create-run" in diag
+
+
+def test_diagnostics_contains_stderr() -> None:
+    """diagnostics() output must include captured stderr."""
+    rr = RunResult(
+        argv=["hcw"],
+        exit_code=1,
+        stdout="",
+        stderr="unique-diagnostic-string-xyz",
+    )
+    assert "unique-diagnostic-string-xyz" in rr.diagnostics()
+
+
+def test_assert_success_raises_with_diagnostics() -> None:
+    """assert_success() must raise AssertionError that includes argv and output."""
+    rr = RunResult(
+        argv=["hcw", "create-run"],
+        exit_code=2,
+        stdout="partial output",
+        stderr="fatal error message",
+    )
+    with pytest.raises(AssertionError) as exc_info:
+        rr.assert_success()
+    msg = str(exc_info.value)
+    assert "create-run" in msg
+    assert "fatal error message" in msg
+
+
+def test_assert_failure_raises_when_success() -> None:
+    """assert_failure() must raise AssertionError when exit_code is 0."""
+    rr = RunResult(argv=["hcw"], exit_code=0, stdout="ok", stderr="")
+    with pytest.raises(AssertionError):
+        rr.assert_failure()
+
+
+# ---------------------------------------------------------------------------
+# Fresh-run equivalence (two normalized results from same fixture)
+# ---------------------------------------------------------------------------
+
+
+def _make_synthetic_result(tmp_prefix: str, run_id: str) -> RunResult:
+    """Helper that simulates what two identical runs would produce."""
+    return RunResult(
+        argv=["hcw", "create-run", "--run-id", run_id, "--repo", f"{tmp_prefix}/repo"],
+        exit_code=0,
+        stdout=f"created run {run_id} in {tmp_prefix}/repo\n",
+        stderr="",
+        artifacts={
+            f".hermes/runs/{run_id}/plan.md": b"# plan\n",
+            f".hermes/runs/{run_id}/brief.json": b'{"run_id":"' + run_id.encode() + b'"}',
+        },
+    )
+
+
+def test_fresh_runs_normalize_equally(tmp_path: Path) -> None:
+    """
+    Two synthetic RunResults with identical structure but different tmp paths
+    must compare equal after normalization.
+    """
+    run_id = "t_84d809af"
+    prefix_a = str(tmp_path / "run_a")
+    prefix_b = str(tmp_path / "run_b")
+
+    result_a = _make_synthetic_result(prefix_a, run_id).normalize(prefix_a)
+    result_b = _make_synthetic_result(prefix_b, run_id).normalize(prefix_b)
+
+    assert result_a == result_b, (
+        f"Normalized results should be equal.\n"
+        f"A: {result_a.diagnostics()}\n"
+        f"B: {result_b.diagnostics()}"
+    )
