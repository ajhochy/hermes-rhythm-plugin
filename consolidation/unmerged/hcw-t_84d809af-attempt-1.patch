+    assert env.get("GIT_CONFIG_NOSYSTEM") == "1"
+
+
+# ---------------------------------------------------------------------------
+# RunResult diagnostics (T4 contract — shared across scenarios)
+# ---------------------------------------------------------------------------
+
+
+def test_run_result_diagnostics_in_assertion_failure() -> None:
+    """
+    A failed RunResult assertion must include argv and captured output,
+    satisfying the T4 contract that failures are self-describing.
+    """
+    rr = RunResult(
+        argv=["hcw", "create-run", "--run-id", "t_84d809af"],
+        exit_code=127,
+        stdout="",
+        stderr="hcw: command not found",
