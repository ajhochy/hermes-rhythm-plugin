+"""
+T1 / T4 — black-box contract tests for the installed HCW create-run command.
+
+All tests in this file skip automatically when the HCW launcher is not
+present (HCW_LAUNCHER env var unset and `hcw` not in PATH).
+
+Contracts verified:
+  * create-run with fixed intake arguments exits with a documented status.
+  * Declared workflow and repository artifacts are present after a run.
+  * Two fresh runs with identical inputs produce equal normalized results.
+  * No HCW runtime module is imported into the test process.
+"""
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+
+import pytest
+
+from harness import HCWSubprocessRunner, RunResult, TempGitRepo, load_fixed_intake
+
+_RUN_ID = "t_84d809af"
+
+
+# ---------------------------------------------------------------------------
+# Helpers
+# ---------------------------------------------------------------------------
+
+
+def _build_repo(tmp_path: Path) -> TempGitRepo:
+    repo = TempGitRepo(tmp_path / "repo")
+    repo.init()
+    repo.add_file("README.md", b"# Hermetic intake test repository\n")
+    repo.commit("initial commit")
+    return repo
+
+
+# ---------------------------------------------------------------------------
+# T1: public exit-behavior contract
+# ---------------------------------------------------------------------------
+
+
+def test_create_run_exits_cleanly(
+    hcw_runner: HCWSubprocessRunner,
+    temp_git_repo: TempGitRepo,
+    fixed_intake: dict,
+    tmp_scenario: Path,
+) -> None:
+    """
+    hcw create-run with fixed intake arguments must exit 0.
+
+    Asserts the public exit-code contract only; does not inspect internals.
+    """
+    result = hcw_runner.run(
+        repo_path=temp_git_repo.path,
+        run_id=fixed_intake["run_id"],
+        package=fixed_intake["package"],
+        scope=fixed_intake["scope"],
+        board=fixed_intake["board"],
+        goal=fixed_intake["goal"],
+    )
+    assert result.exit_code == 0, (
+        f"hcw create-run must exit 0 with fixed intake arguments.\n"
+        f"{result.diagnostics()}"
+    )
+
+
+def test_create_run_stdout_non_empty(
+    hcw_runner: HCWSubprocessRunner,
+    temp_git_repo: TempGitRepo,
+    fixed_intake: dict,
+    tmp_scenario: Path,
+) -> None:
+    """hcw create-run must produce at least some stdout output."""
+    result = hcw_runner.run(
+        repo_path=temp_git_repo.path,
+        run_id=fixed_intake["run_id"],
+        package=fixed_intake["package"],
+        scope=fixed_intake["scope"],
+        board=fixed_intake["board"],
+        goal=fixed_intake["goal"],
+    )
+    result.assert_success()
+    assert result.stdout.strip(), (
+        f"Expected non-empty stdout.\n{result.diagnostics()}"
+    )
+
+
+# ---------------------------------------------------------------------------
+# T1: declared artifact contract
+# ---------------------------------------------------------------------------
+
+
+def test_create_run_produces_run_artifacts(
+    hcw_runner: HCWSubprocessRunner,
+    temp_git_repo: TempGitRepo,
+    fixed_intake: dict,
+    tmp_scenario: Path,
+) -> None:
+    """
+    hcw create-run must produce at least one artifact under
+    .hermes/runs/<run_id>/ in the repository.
+    """
+    result = hcw_runner.run(
+        repo_path=temp_git_repo.path,
+        run_id=fixed_intake["run_id"],
+        package=fixed_intake["package"],
+        scope=fixed_intake["scope"],
+        board=fixed_intake["board"],
+        goal=fixed_intake["goal"],
+    )
+    result.assert_success()
+    assert result.artifacts, (
+        f"Expected at least one artifact under .hermes/runs/{_RUN_ID}/.\n"
+        f"{result.diagnostics()}"
+    )
+
+
+def test_create_run_artifact_paths_include_run_id(
+    hcw_runner: HCWSubprocessRunner,
+    temp_git_repo: TempGitRepo,
+    fixed_intake: dict,
+    tmp_scenario: Path,
+) -> None:
+    """All collected artifacts must live under the declared run directory."""
+    result = hcw_runner.run(
+        repo_path=temp_git_repo.path,
+        run_id=fixed_intake["run_id"],
+        package=fixed_intake["package"],
+        scope=fixed_intake["scope"],
+        board=fixed_intake["board"],
+        goal=fixed_intake["goal"],
+    )
+    result.assert_success()
+    expected_prefix = f".hermes/runs/{_RUN_ID}/"
+    for path in result.artifacts:
+        assert path.startswith(expected_prefix), (
+            f"Artifact {path!r} must be under {expected_prefix!r}.\n"
+            f"{result.diagnostics()}"
+        )
+
+
+# ---------------------------------------------------------------------------
+# T4: fresh-run equivalence contract
+# ---------------------------------------------------------------------------
+
+
+def test_create_run_fresh_runs_normalize_equally(
+    hcw_launcher: str,
+    fixed_intake: dict,
+    tmp_path: Path,
+) -> None:
+    """
+    Two independent invocations with identical inputs must produce equal
+    normalized results (idempotent, deterministic public output).
+    """
+    run_id = fixed_intake["run_id"]
+
+    tmp_a = tmp_path / "run_a"
+    tmp_b = tmp_path / "run_b"
+    tmp_a.mkdir()
+    tmp_b.mkdir()
+
+    def _run(tmp_dir: Path) -> RunResult:
+        repo = TempGitRepo(tmp_dir / "repo")
+        repo.init()
+        repo.add_file("README.md", b"# Hermetic intake test repository\n")
+        repo.commit("initial commit")
