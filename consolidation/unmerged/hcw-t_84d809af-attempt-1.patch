index 0000000000..c223cc9f91
--- /dev/null
+++ b/plugins/github-intake/tests/support/sitecustomize.py
@@ -0,0 +1,58 @@
+"""
+Loaded automatically when this directory is in PYTHONPATH.
+Installs fail-closed boundary guards in child processes used by the
+hermetic intake test harness.
+
+Guards installed:
+  - socket.socket.connect / connect_ex: blocked unconditionally so no
+    TCP/UDP outbound connection can succeed inside a guarded subprocess.
+  - socket.create_connection: blocked unconditionally.
+"""
+from __future__ import annotations
+
+import socket as _socket
+import sys as _sys
+
+
+def _fmt(address: object) -> str:
+    try:
+        host, port = address  # type: ignore[misc]
+        return f"{host}:{port}"
+    except Exception:
+        return repr(address)
+
+
+def _blocked_connect(self: _socket.socket, address: object) -> None:
+    msg = (
+        f"harness[sitecustomize]: outbound connection BLOCKED "
+        f"— attempted connect to {_fmt(address)}; "
+        "live network access is not permitted inside hermetic tests"
+    )
+    _sys.stderr.write(msg + "\n")
+    _sys.stderr.flush()
+    raise OSError(msg)
+
+
+def _blocked_connect_ex(self: _socket.socket, address: object) -> int:
+    _blocked_connect(self, address)
+    return 111  # ECONNREFUSED — never reached, but satisfies type checkers
+
+
+def _blocked_create_connection(
+    address: object,
+    timeout: object = _socket._GLOBAL_DEFAULT_TIMEOUT,  # type: ignore[attr-defined]
+    source_address: object = None,
+) -> _socket.socket:
+    msg = (
+        f"harness[sitecustomize]: create_connection BLOCKED "
+        f"— attempted connect to {_fmt(address)}; "
+        "live network access is not permitted inside hermetic tests"
+    )
+    _sys.stderr.write(msg + "\n")
+    _sys.stderr.flush()
+    raise OSError(msg)
+
+
+_socket.socket.connect = _blocked_connect  # type: ignore[method-assign]
+_socket.socket.connect_ex = _blocked_connect_ex  # type: ignore[method-assign]
+_socket.create_connection = _blocked_create_connection  # type: ignore[assignment]
