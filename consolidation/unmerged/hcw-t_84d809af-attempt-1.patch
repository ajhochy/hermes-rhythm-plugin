+"""pytest conftest for plugins/github-intake/tests.
+
+Sets up sys.path so that `import harness` works in every test file, makes
+the support/git wrapper executable at session start, and provides shared
+fixtures for the harness test suite.
+"""
+from __future__ import annotations
+
+import os
+import shutil
+import stat
+import sys
+from pathlib import Path
+
+import pytest
+
+# Make `harness` directly importable from every test file in this directory.
+_TESTS_DIR = Path(__file__).parent
+if str(_TESTS_DIR) not in sys.path:
+    sys.path.insert(0, str(_TESTS_DIR))
+
+# Ensure the support/git wrapper is executable at import time so tests that
+# use build_isolated_env() can invoke it without a separate chmod step.
+_GIT_WRAPPER = _TESTS_DIR / "support" / "git"
+if _GIT_WRAPPER.exists():
+    _current = _GIT_WRAPPER.stat().st_mode
+    _GIT_WRAPPER.chmod(_current | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
+
+
+# ---------------------------------------------------------------------------
+# Core fixtures
+# ---------------------------------------------------------------------------
+
+from harness import (  # noqa: E402 — import after sys.path mutation
+    TempGitRepo,
+    HCWSubprocessRunner,
+    build_isolated_env,
+    load_fixed_intake,
+)
+
+
+@pytest.fixture
+def tmp_scenario(tmp_path: Path) -> Path:
+    """Isolated temporary directory for a single test scenario."""
+    return tmp_path
+
+
+@pytest.fixture
+def temp_git_repo(tmp_scenario: Path) -> TempGitRepo:
+    """
+    Deterministic temporary Git repository with one pinned commit.
+    The HEAD SHA is reproducible across runs given the same harness
+    identity constants.
+    """
+    repo_path = tmp_scenario / "repo"
+    repo = TempGitRepo(repo_path)
+    repo.init()
+    repo.add_file("README.md", b"# Hermetic intake test repository\n")
+    repo.commit("initial commit")
+    return repo
+
+
+@pytest.fixture
+def fixed_intake() -> dict:
+    """Pinned intake arguments loaded from fixtures/fixed_intake.json."""
+    return load_fixed_intake()
+
+
+@pytest.fixture
+def hcw_launcher() -> str:
+    """
+    Locate the installed HCW launcher or skip.
+
+    Reads HCW_LAUNCHER from the environment first; falls back to PATH.
+    Tests that require a real HCW binary are automatically skipped when
+    neither source provides one.
+    """
+    env_val = os.environ.get("HCW_LAUNCHER", "").strip()
+    if env_val and Path(env_val).is_file():
+        return env_val
+    found = shutil.which("hcw")
+    if found:
+        return found
+    pytest.skip("HCW_LAUNCHER env var not set and `hcw` not found in PATH — skipping")
+
+
+@pytest.fixture
+def hcw_runner(hcw_launcher: str, tmp_scenario: Path) -> HCWSubprocessRunner:
+    """Configured HCWSubprocessRunner backed by the installed launcher."""
+    return HCWSubprocessRunner(launcher=hcw_launcher, tmp_dir=tmp_scenario)
