+
+    def test_invalid_signature_is_rejected(self, intake_config):
+        body = payload_bytes(OPENED)
+        headers = signed_headers(body, secret="wrong-secret")
+        headers["X-Hub-Signature-256"] = "sha256=badhash"
+        result = intake_pipeline.verify_signature(body, headers, config=intake_config)
+        assert result is False
+
+    def test_missing_signature_header_is_rejected(self, intake_config):
+        body = payload_bytes(OPENED)
+        headers = {"X-GitHub-Event": "issues", "X-GitHub-Delivery": "x"}
+        result = intake_pipeline.verify_signature(body, headers, config=intake_config)
+        assert result is False
+
+    def test_tampered_body_invalidates_signature(self, intake_config):
