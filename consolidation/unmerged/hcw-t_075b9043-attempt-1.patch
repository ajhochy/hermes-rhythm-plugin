+
+
+# ---------------------------------------------------------------------------
+# Stable canonical identity
+# ---------------------------------------------------------------------------
+
+class TestCanonicalIdentity:
+    def test_canonical_id_is_stable_across_equivalent_deliveries(self, intake_config):
+        r1 = intake_pipeline.normalize(OPENED, config=intake_config)
+        r2 = intake_pipeline.normalize(copy.deepcopy(OPENED), config=intake_config)
+        assert r1.canonical_id == r2.canonical_id
+
+    def test_canonical_id_is_deterministic_string(self, intake_config):
