+"""RED tests for HCW routing contracts.
+
+Uses a test fake HCW adapter that records requests but never starts workers
+or invokes the launcher. Proves stable inputs, exactly-one eligible route,
+replay-safe at-most-once routing, and explicit ineligible/unsupported outcomes.
+
+All tests fail because plugins/github_intake production code is absent.
+"""
+from __future__ import annotations
+
+import copy
+from typing import Any
+
+import pytest
+
+from plugins.github_intake import pipeline as intake_pipeline  # type: ignore[import]
+from plugins.github_intake import router as intake_router  # type: ignore[import]
+from plugins.github_intake import models as intake_models  # type: ignore[import]
+
+from .fixtures.github_payloads import (
+    OPENED,
+    EDITED,
+    CLOSED,
+    REOPENED,
+    UNSUPPORTED_ACTION,
+    DISALLOWED_REPO_PAYLOAD,
+    MALFORMED_MISSING_ACTION,
+    REPLAY_OPENED,
+)
+
+
+# ---------------------------------------------------------------------------
+# Stable routing inputs
+# ---------------------------------------------------------------------------
+
+class TestStableRoutingInputs:
+    def test_routing_request_contains_canonical_id(self, intake_config, fake_kanban, fake_hcw):
+        record = intake_pipeline.normalize(OPENED, config=intake_config)
+        intake_pipeline.persist_to_kanban(record, store=fake_kanban)
+        intake_router.route(record, hcw=fake_hcw, config=intake_config)
+
+        assert len(fake_hcw.recorded_requests) == 1
+        req = fake_hcw.recorded_requests[0]
+        assert req["canonical_id"] == record.canonical_id
+
+    def test_routing_request_is_deterministic(self, intake_config, fake_kanban, fake_hcw):
+        r1 = intake_pipeline.normalize(OPENED, config=intake_config)
+        r2 = intake_pipeline.normalize(copy.deepcopy(OPENED), config=intake_config)
+
+        fake_hcw2 = type(fake_hcw)()
+        intake_router.route(r1, hcw=fake_hcw, config=intake_config)
+        intake_router.route(r2, hcw=fake_hcw2, config=intake_config)
+
+        req1 = fake_hcw.recorded_requests[0]
+        req2 = fake_hcw2.recorded_requests[0]
+        assert req1["canonical_id"] == req2["canonical_id"]
+
+    def test_routing_request_contains_full_record(self, intake_config, fake_kanban, fake_hcw):
+        record = intake_pipeline.normalize(OPENED, config=intake_config)
+        intake_router.route(record, hcw=fake_hcw, config=intake_config)
+        req = fake_hcw.recorded_requests[0]
+        assert "record" in req
+        assert req["record"]["canonical_id"] == record.canonical_id
+
+    def test_routing_does_not_modify_canonical_record(self, intake_config, fake_kanban, fake_hcw):
+        record = intake_pipeline.normalize(OPENED, config=intake_config)
+        before = copy.deepcopy(record.to_canonical_dict())
+        intake_router.route(record, hcw=fake_hcw, config=intake_config)
+        assert record.to_canonical_dict() == before
+
+
+# ---------------------------------------------------------------------------
+# Exactly one eligible route
+# ---------------------------------------------------------------------------
+
+class TestExactlyOneEligibleRoute:
+    def test_opened_routes_exactly_once(self, intake_config, fake_kanban, fake_hcw):
+        record = intake_pipeline.normalize(OPENED, config=intake_config)
+        intake_router.route(record, hcw=fake_hcw, config=intake_config)
+        assert len(fake_hcw.recorded_requests) == 1
+
+    def test_edited_routes_exactly_once(self, intake_config, fake_kanban, fake_hcw):
+        r_opened = intake_pipeline.normalize(OPENED, config=intake_config)
+        intake_pipeline.persist_to_kanban(r_opened, store=fake_kanban)
+
+        r_edited = intake_pipeline.normalize(EDITED, config=intake_config)
+        intake_router.route(r_edited, hcw=fake_hcw, config=intake_config)
+        assert len(fake_hcw.recorded_requests) == 1
+
+    def test_closed_routes_exactly_once(self, intake_config, fake_kanban, fake_hcw):
+        record = intake_pipeline.normalize(CLOSED, config=intake_config)
+        intake_router.route(record, hcw=fake_hcw, config=intake_config)
+        assert len(fake_hcw.recorded_requests) == 1
+
+    def test_reopened_routes_exactly_once(self, intake_config, fake_kanban, fake_hcw):
+        record = intake_pipeline.normalize(REOPENED, config=intake_config)
+        intake_router.route(record, hcw=fake_hcw, config=intake_config)
+        assert len(fake_hcw.recorded_requests) == 1
+
+
+# ---------------------------------------------------------------------------
+# Replay-safe at-most-once routing
+# ---------------------------------------------------------------------------
+
+class TestAtMostOnceRouting:
+    def test_replay_is_not_re_routed(self, intake_config, fake_kanban, fake_hcw):
+        r_opened = intake_pipeline.normalize(OPENED, config=intake_config)
+        intake_router.route(r_opened, hcw=fake_hcw, config=intake_config)
+
+        r_replay = intake_pipeline.normalize(REPLAY_OPENED, config=intake_config)
+        result = intake_router.route(r_replay, hcw=fake_hcw, config=intake_config)
+        assert result.outcome in ("duplicate", "skipped", "already_routed")
+        assert len(fake_hcw.recorded_requests) == 1
+
+    def test_identical_canonical_id_routed_at_most_once(self, intake_config, fake_kanban, fake_hcw):
+        record = intake_pipeline.normalize(OPENED, config=intake_config)
+        intake_router.route(record, hcw=fake_hcw, config=intake_config)
+        intake_router.route(record, hcw=fake_hcw, config=intake_config)
+        assert len(fake_hcw.recorded_requests) == 1
+
+    def test_routing_result_is_idempotent_for_replay(self, intake_config, fake_kanban, fake_hcw):
+        r1 = intake_pipeline.normalize(OPENED, config=intake_config)
+        res1 = intake_router.route(r1, hcw=fake_hcw, config=intake_config)
+
+        r2 = intake_pipeline.normalize(REPLAY_OPENED, config=intake_config)
+        res2 = intake_router.route(r2, hcw=fake_hcw, config=intake_config)
+
+        assert res2.outcome in ("duplicate", "skipped", "already_routed")
+
+
+# ---------------------------------------------------------------------------
+# Unsupported / ineligible outcomes
+# ---------------------------------------------------------------------------
+
+class TestIneligibleRouting:
+    def test_unsupported_action_is_not_routed(self, intake_config, fake_hcw):
+        result = intake_pipeline.validate_envelope(UNSUPPORTED_ACTION, config=intake_config)
+        assert result.is_valid is False
+        assert len(fake_hcw.recorded_requests) == 0
+
+    def test_disallowed_repo_is_not_routed(self, intake_config, fake_hcw):
+        result = intake_pipeline.validate_envelope(DISALLOWED_REPO_PAYLOAD, config=intake_config)
+        assert result.is_valid is False
+        assert len(fake_hcw.recorded_requests) == 0
+
+    def test_malformed_payload_is_not_routed(self, intake_config, fake_hcw):
+        result = intake_pipeline.validate_envelope(MALFORMED_MISSING_ACTION, config=intake_config)
+        assert result.is_valid is False
+        assert len(fake_hcw.recorded_requests) == 0
+
+    def test_ineligible_route_returns_explicit_outcome(self, intake_config, fake_hcw):
+        result = intake_router.evaluate_eligibility(UNSUPPORTED_ACTION, config=intake_config)
+        assert result.eligible is False
+        assert isinstance(result.reason, str)
+        assert len(result.reason) > 0
+
+    def test_fake_hcw_never_starts_workers(self, intake_config, fake_hcw):
+        record = intake_pipeline.normalize(OPENED, config=intake_config)
+        intake_router.route(record, hcw=fake_hcw, config=intake_config)
+        # FakeHCWAdapter.route() records but never spawns processes;
+        # if a real launcher were invoked the _no_subprocess fixture would raise.
+        assert True  # reaching here means no subprocess was started
