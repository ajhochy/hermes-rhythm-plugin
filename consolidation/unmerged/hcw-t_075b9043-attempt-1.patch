+"""Synthetic GitHub webhook payloads for hermetic testing.
+
+All payloads are static dicts — no network calls, no real tokens, no real
+repository identifiers beyond the allowed synthetic ones.
+"""
+from __future__ import annotations
+
+import copy
+import hashlib
+import hmac
+import json
+from typing import Any
+
+# ---------------------------------------------------------------------------
+# Synthetic constants
+# ---------------------------------------------------------------------------
+
+ALLOWED_REPO = "synthetic-org/allowed-repo"
+DISALLOWED_REPO = "synthetic-org/disallowed-repo"
+WEBHOOK_SECRET = "test-webhook-secret-not-real"  # noqa: S105 — synthetic only
+DELIVERY_ID_BASE = "abc00000-0000-0000-0000-000000000001"
+
+ISSUE_BASE: dict[str, Any] = {
+    "id": 1001,
+    "number": 42,
+    "title": "Test issue title",
+    "body": "Test issue body",
+    "state": "open",
+    "html_url": "https://github.example.invalid/synthetic-org/allowed-repo/issues/42",
+    "user": {"login": "test-user", "id": 9001},
+    "labels": [],
+    "assignees": [],
+    "created_at": "2024-01-01T00:00:00Z",
+    "updated_at": "2024-01-01T00:00:00Z",
+    "closed_at": None,
+    "node_id": "I_synthetic_001",
+}
+
+REPO_BASE: dict[str, Any] = {
+    "id": 5001,
+    "full_name": ALLOWED_REPO,
+    "private": False,
+    "html_url": "https://github.example.invalid/synthetic-org/allowed-repo",
+    "owner": {"login": "synthetic-org", "id": 8001},
+}
+
+SENDER_BASE: dict[str, Any] = {
+    "login": "test-sender",
+    "id": 9002,
+}
+
+
+def _make_envelope(
+    action: str,
+    issue: dict[str, Any] | None = None,
+    repo: dict[str, Any] | None = None,
+    sender: dict[str, Any] | None = None,
+    delivery_id: str = DELIVERY_ID_BASE,
+    event_type: str = "issues",
+) -> dict[str, Any]:
+    return {
+        "_meta": {
+            "event_type": event_type,
+            "delivery_id": delivery_id,
+            "x_hub_signature_256": None,  # computed separately when needed
+        },
+        "action": action,
+        "issue": copy.deepcopy(issue or ISSUE_BASE),
+        "repository": copy.deepcopy(repo or REPO_BASE),
+        "sender": copy.deepcopy(sender or SENDER_BASE),
+    }
+
+
+def sign_payload(raw_body: bytes, secret: str = WEBHOOK_SECRET) -> str:
+    """Return the HMAC-SHA256 signature GitHub would attach."""
+    sig = hmac.new(secret.encode(), raw_body, hashlib.sha256).hexdigest()
+    return f"sha256={sig}"
+
+
+# ---------------------------------------------------------------------------
+# Canonical event payloads
+# ---------------------------------------------------------------------------
+
+OPENED = _make_envelope("opened", delivery_id="delivery-opened-001")
+EDITED = _make_envelope(
+    "edited",
+    issue={**ISSUE_BASE, "title": "Updated title", "updated_at": "2024-01-02T00:00:00Z"},
+    delivery_id="delivery-edited-001",
+)
+CLOSED = _make_envelope(
+    "closed",
+    issue={**ISSUE_BASE, "state": "closed", "closed_at": "2024-01-03T00:00:00Z"},
+    delivery_id="delivery-closed-001",
+)
+REOPENED = _make_envelope(
+    "reopened",
+    issue={**ISSUE_BASE, "state": "open", "closed_at": None},
+    delivery_id="delivery-reopened-001",
+)
+
+# ---------------------------------------------------------------------------
+# Unsupported / negative cases
+# ---------------------------------------------------------------------------
+
+UNSUPPORTED_ACTION = _make_envelope("labeled", delivery_id="delivery-labeled-001")
+UNSUPPORTED_EVENT = _make_envelope(
+    "created",
+    delivery_id="delivery-unsupported-event-001",
+    event_type="issue_comment",
+)
+DISALLOWED_REPO_PAYLOAD = _make_envelope(
+    "opened",
+    repo={**REPO_BASE, "full_name": DISALLOWED_REPO},
+    delivery_id="delivery-disallowed-001",
+)
+
+# ---------------------------------------------------------------------------
+# Malformed / hostile payloads
+# ---------------------------------------------------------------------------
+
+MALFORMED_MISSING_ACTION: dict[str, Any] = {
+    "_meta": {"event_type": "issues", "delivery_id": "delivery-malformed-001"},
+    "issue": copy.deepcopy(ISSUE_BASE),
+    "repository": copy.deepcopy(REPO_BASE),
+}
+
+MALFORMED_MISSING_ISSUE: dict[str, Any] = {
+    "_meta": {"event_type": "issues", "delivery_id": "delivery-malformed-002"},
+    "action": "opened",
+    "repository": copy.deepcopy(REPO_BASE),
+}
+
+HOSTILE_XSS_TITLE = _make_envelope(
+    "opened",
+    issue={**ISSUE_BASE, "title": "<script>alert('xss')</script>"},
+    delivery_id="delivery-hostile-xss-001",
+)
+
+HOSTILE_SQLI_BODY = _make_envelope(
+    "opened",
+    issue={**ISSUE_BASE, "body": "'; DROP TABLE issues; --"},
+    delivery_id="delivery-hostile-sqli-001",
+)
+
+HOSTILE_OVERSIZED_TITLE = _make_envelope(
+    "opened",
+    issue={**ISSUE_BASE, "title": "A" * 100_000},
+    delivery_id="delivery-hostile-oversized-001",
+)
+
+HOSTILE_SECRET_IN_BODY = _make_envelope(
+    "opened",
+    issue={**ISSUE_BASE, "body": "My token is ghp_ABCDEFGHIJKLMNOPQRSTUVWXYZabcdef"},
+    delivery_id="delivery-hostile-secret-001",
+)
+
+# ---------------------------------------------------------------------------
+# Duplicate / replay / stale / out-of-order / conflicting
+# ---------------------------------------------------------------------------
+
+DUPLICATE_OPENED = copy.deepcopy(OPENED)
+DUPLICATE_OPENED["_meta"]["delivery_id"] = "delivery-opened-001"  # same as OPENED
+
+REPLAY_OPENED = copy.deepcopy(OPENED)
+REPLAY_OPENED["_meta"]["delivery_id"] = "delivery-replay-001"
+# Same logical issue, different delivery — treated as replay
+
+STALE_EDITED = _make_envelope(
+    "edited",
+    issue={**ISSUE_BASE, "title": "Stale edit", "updated_at": "2023-12-31T00:00:00Z"},
+    delivery_id="delivery-stale-001",
+)
+
+OUT_OF_ORDER_CLOSED_BEFORE_OPENED = _make_envelope(
+    "closed",
+    issue={**ISSUE_BASE, "state": "closed", "closed_at": "2024-01-03T00:00:00Z"},
+    delivery_id="delivery-ooo-closed-001",
+)
+
+CONFLICTING_EDIT_A = _make_envelope(
+    "edited",
+    issue={**ISSUE_BASE, "title": "Conflicting title A", "updated_at": "2024-01-02T00:00:00Z"},
+    delivery_id="delivery-conflict-a-001",
+)
+CONFLICTING_EDIT_B = _make_envelope(
+    "edited",
+    issue={**ISSUE_BASE, "title": "Conflicting title B", "updated_at": "2024-01-02T00:00:00Z"},
+    delivery_id="delivery-conflict-b-001",
+)
+
+# ---------------------------------------------------------------------------
+# Helpers
+# ---------------------------------------------------------------------------
+
+def payload_bytes(payload: dict[str, Any]) -> bytes:
+    """Serialize a payload to canonical UTF-8 JSON bytes."""
+    return json.dumps(payload, sort_keys=True, separators=(",", ":")).encode("utf-8")
+
+
+def signed_headers(
+    raw_body: bytes,
+    delivery_id: str = DELIVERY_ID_BASE,
+    event_type: str = "issues",
+    secret: str = WEBHOOK_SECRET,
+) -> dict[str, str]:
+    """Return HTTP headers as GitHub would send them."""
+    return {
+        "X-GitHub-Event": event_type,
+        "X-GitHub-Delivery": delivery_id,
+        "X-Hub-Signature-256": sign_payload(raw_body, secret),
+        "Content-Type": "application/json",
+    }
