+
+# ---------------------------------------------------------------------------
+# Webhook signature validation
+# ---------------------------------------------------------------------------
+
+class TestWebhookSignature:
+    def test_valid_signature_is_accepted(self, intake_config):
+        body = payload_bytes(OPENED)
+        headers = signed_headers(
+            body,
+            delivery_id=OPENED["_meta"]["delivery_id"],
+            secret=WEBHOOK_SECRET,
+        )
