+"""RED production-safety contract tests.
+
+Proves: disabled-by-default, authenticated allowlists, kill switch,
+dry-run rollback-safety, hostile-input rejection, secret redaction,
+bounded retries, quarantine/dead-letter outcomes, and auditable decisions.
+
+Network, subprocess, product persistence, and uncontrolled filesystem
+entry points are patched to fail if touched. Only temporary test state
+and synthetic non-secret credentials are used.
+
+All tests fail because plugins/github_intake production code is absent.
+"""
+from __future__ import annotations
+
+import copy
+import os
+import re
+from typing import Any
+
+import pytest
+
+from plugins.github_intake import pipeline as intake_pipeline  # type: ignore[import]
+from plugins.github_intake import safety as intake_safety  # type: ignore[import]
+from plugins.github_intake import models as intake_models  # type: ignore[import]
+
+from .fixtures.github_payloads import (
+    OPENED,
+    DISALLOWED_REPO_PAYLOAD,
+    HOSTILE_XSS_TITLE,
+    HOSTILE_SQLI_BODY,
+    HOSTILE_OVERSIZED_TITLE,
+    HOSTILE_SECRET_IN_BODY,
+    MALFORMED_MISSING_ACTION,
+    MALFORMED_MISSING_ISSUE,
+    WEBHOOK_SECRET,
+    payload_bytes,
+    signed_headers,
+)
+
+_SECRET_PATTERN = re.compile(r"ghp_[A-Za-z0-9]{36}", re.IGNORECASE)
+
