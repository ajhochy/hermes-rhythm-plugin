+"""Hermetic test fixtures and helpers for plugins/github-intake.
+
+Invariants enforced here:
+- Time is frozen to a deterministic UTC epoch.
+- Persistence is isolated to a per-test tempdir; no real ~/.hermes writes.
+- All network and subprocess boundaries are replaced with rejecting fakes
+  that raise AssertionError if called, proving the pipeline never touches
+  live services.
+- The expected production import surface is declared; collection fails if
+  plugins/github-intake production modules are absent.
+"""
+from __future__ import annotations
+
+import os
+import sys
+import tempfile
+import shutil
+from collections.abc import Generator
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+from unittest import mock
+
+import pytest
+
+# ---------------------------------------------------------------------------
+# Path setup — make plugins/github-intake importable as a package
+# ---------------------------------------------------------------------------
+
+_REPO_ROOT = Path(__file__).resolve().parents[4]
+_PLUGIN_ROOT = Path(__file__).resolve().parents[2]  # plugins/github-intake/
+
+for _p in (_REPO_ROOT, _PLUGIN_ROOT.parent):
+    if str(_p) not in sys.path:
+        sys.path.insert(0, str(_p))
+
+# ---------------------------------------------------------------------------
+# Production import surface declaration (RED: these modules must exist)
+# ---------------------------------------------------------------------------
+# Each import below will raise ImportError during collection if the
+# production module is absent, making the entire test file fail with a
+# clear "module not found" error — the correct RED reason.
+
+from plugins.github_intake import (  # noqa: E402  # type: ignore[import]
+    pipeline as intake_pipeline,
+    models as intake_models,
+    router as intake_router,
+    safety as intake_safety,
+)
+
+# ---------------------------------------------------------------------------
+# Frozen clock
+# ---------------------------------------------------------------------------
+
+FROZEN_UTC = datetime(2024, 6, 15, 12, 0, 0, tzinfo=timezone.utc)
+FROZEN_TIMESTAMP = FROZEN_UTC.isoformat()
+
+
+@pytest.fixture()
+def frozen_time(monkeypatch: pytest.MonkeyPatch):
+    """Patch datetime.now/utcnow everywhere inside the plugin to a fixed value."""
+    fixed = FROZEN_UTC
+
+    class _FrozenDatetime(datetime):
+        @classmethod
+        def now(cls, tz=None):
+            return fixed.replace(tzinfo=tz) if tz else fixed
+
+        @classmethod
+        def utcnow(cls):
+            return fixed.replace(tzinfo=None)
+
+    monkeypatch.setattr("plugins.github_intake.pipeline.datetime", _FrozenDatetime, raising=False)
+    monkeypatch.setattr("plugins.github_intake.models.datetime", _FrozenDatetime, raising=False)
+    monkeypatch.setattr("plugins.github_intake.router.datetime", _FrozenDatetime, raising=False)
+    monkeypatch.setattr("plugins.github_intake.safety.datetime", _FrozenDatetime, raising=False)
+    return fixed
+
+
+# ---------------------------------------------------------------------------
+# Isolated temporary persistence
+# ---------------------------------------------------------------------------
+
+@pytest.fixture()
+def isolated_store(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> Path:
+    """Point all persistence at a per-test tempdir; never touch real state."""
+    store_dir = tmp_path / "github_intake_store"
+    store_dir.mkdir(parents=True, exist_ok=True)
+    monkeypatch.setenv("GITHUB_INTAKE_STORE_PATH", str(store_dir))
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path / "hermes_home"))
+    (tmp_path / "hermes_home").mkdir(parents=True, exist_ok=True)
+    return store_dir
+
+
+# ---------------------------------------------------------------------------
+# Network-rejecting fakes
+# ---------------------------------------------------------------------------
+
+def _reject_network(*args: Any, **kwargs: Any) -> None:
+    raise AssertionError(
+        "Test made a live network call — all network boundaries must be faked. "
+        f"Call args: {args!r}, kwargs: {kwargs!r}"
+    )
+
+
+def _reject_subprocess(*args: Any, **kwargs: Any) -> None:
+    raise AssertionError(
+        "Test invoked a subprocess — all subprocess boundaries must be faked. "
+        f"Call args: {args!r}, kwargs: {kwargs!r}"
+    )
+
+
+@pytest.fixture(autouse=True)
+def _no_network(monkeypatch: pytest.MonkeyPatch):
+    """Replace all network entry points with rejecting fakes."""
+    import urllib.request
+
+    monkeypatch.setattr("urllib.request.urlopen", _reject_network)
+    monkeypatch.setattr("urllib.request.urlretrieve", _reject_network)
+
+    try:
+        import httpx
+        monkeypatch.setattr(httpx, "get", _reject_network)
+        monkeypatch.setattr(httpx, "post", _reject_network)
+        monkeypatch.setattr(httpx, "request", _reject_network)
+        monkeypatch.setattr(httpx, "AsyncClient", _reject_network)
+    except ImportError:
+        pass
+
+    try:
+        import requests
+        monkeypatch.setattr(requests, "get", _reject_network)
+        monkeypatch.setattr(requests, "post", _reject_network)
+        monkeypatch.setattr(requests, "request", _reject_network)
+        monkeypatch.setattr(requests.Session, "request", _reject_network)
+    except ImportError:
+        pass
+
+    try:
+        import aiohttp
+        monkeypatch.setattr(aiohttp, "ClientSession", _reject_network)
+    except ImportError:
+        pass
+
+
+@pytest.fixture(autouse=True)
+def _no_subprocess(monkeypatch: pytest.MonkeyPatch):
+    """Replace subprocess entry points with rejecting fakes."""
+    import subprocess
+
+    monkeypatch.setattr(subprocess, "run", _reject_subprocess)
+    monkeypatch.setattr(subprocess, "call", _reject_subprocess)
+    monkeypatch.setattr(subprocess, "check_call", _reject_subprocess)
+    monkeypatch.setattr(subprocess, "check_output", _reject_subprocess)
+    monkeypatch.setattr(subprocess, "Popen", _reject_subprocess)
+
+
+# ---------------------------------------------------------------------------
+# Fake HCW adapter
+# ---------------------------------------------------------------------------
+
+class FakeHCWAdapter:
+    """Records routing requests; never starts workers or runs the launcher."""
+
+    def __init__(self) -> None:
+        self.recorded_requests: list[dict[str, Any]] = []
+        self.routed_ids: set[str] = set()
+
+    def route(self, canonical_record: dict[str, Any]) -> dict[str, Any]:
+        canonical_id = canonical_record.get("canonical_id", "")
+        request = {
+            "canonical_id": canonical_id,
+            "record": canonical_record,
+        }
+        self.recorded_requests.append(request)
+        self.routed_ids.add(canonical_id)
+        return {"status": "accepted", "canonical_id": canonical_id}
+
+    def reset(self) -> None:
+        self.recorded_requests.clear()
+        self.routed_ids.clear()
+
+
+@pytest.fixture()
+def fake_hcw() -> FakeHCWAdapter:
+    return FakeHCWAdapter()
+
+
+# ---------------------------------------------------------------------------
+# Fake Kanban store
+# ---------------------------------------------------------------------------
+
+class FakeKanbanStore:
+    """In-memory Kanban persistence; never touches the real Kanban service."""
+
+    def __init__(self) -> None:
+        self._records: dict[str, dict[str, Any]] = {}
+        self._seen_deliveries: set[str] = set()
+
+    def upsert(self, canonical_id: str, record: dict[str, Any]) -> dict[str, Any]:
+        self._records[canonical_id] = dict(record)
+        return self._records[canonical_id]
+
+    def get(self, canonical_id: str) -> dict[str, Any] | None:
+        return self._records.get(canonical_id)
+
+    def all(self) -> list[dict[str, Any]]:
+        return list(self._records.values())
+
+    def mark_delivery_seen(self, delivery_id: str) -> bool:
+        """Return True if delivery_id is new; False if already seen (duplicate)."""
+        if delivery_id in self._seen_deliveries:
+            return False
+        self._seen_deliveries.add(delivery_id)
+        return True
+
+    def reset(self) -> None:
+        self._records.clear()
+        self._seen_deliveries.clear()
+
+
+@pytest.fixture()
+def fake_kanban() -> FakeKanbanStore:
+    return FakeKanbanStore()
+
+
+# ---------------------------------------------------------------------------
+# Config helpers
+# ---------------------------------------------------------------------------
+
+ALLOWED_REPOS = {"synthetic-org/allowed-repo"}
+ALLOWED_EVENTS = {"issues"}
+ALLOWED_ACTIONS = {"opened", "edited", "closed", "reopened"}
+
+
+@pytest.fixture()
+def intake_config(monkeypatch: pytest.MonkeyPatch) -> dict[str, Any]:
+    """Minimal production-safe config with synthetic credentials."""
+    cfg: dict[str, Any] = {
+        "enabled": True,
+        "webhook_secret": "test-webhook-secret-not-real",
+        "allowed_repositories": list(ALLOWED_REPOS),
+        "allowed_events": list(ALLOWED_EVENTS),
+        "allowed_actions": list(ALLOWED_ACTIONS),
+        "dry_run": False,
+        "kill_switch": False,
+        "max_retries": 3,
+        "quarantine_on_failure": True,
+    }
+    monkeypatch.setenv("GITHUB_INTAKE_ENABLED", "true")
+    monkeypatch.setenv("GITHUB_INTAKE_WEBHOOK_SECRET", cfg["webhook_secret"])
+    monkeypatch.setenv("GITHUB_INTAKE_ALLOWED_REPOS", ",".join(cfg["allowed_repositories"]))
+    return cfg
+
+
+@pytest.fixture()
+def disabled_intake_config(monkeypatch: pytest.MonkeyPatch) -> dict[str, Any]:
+    """Config with the plugin disabled (default state)."""
+    cfg: dict[str, Any] = {
+        "enabled": False,
+        "webhook_secret": "test-webhook-secret-not-real",
+        "allowed_repositories": list(ALLOWED_REPOS),
+        "allowed_events": list(ALLOWED_EVENTS),
+        "allowed_actions": list(ALLOWED_ACTIONS),
+        "dry_run": False,
+        "kill_switch": False,
+        "max_retries": 3,
+        "quarantine_on_failure": True,
+    }
+    monkeypatch.setenv("GITHUB_INTAKE_ENABLED", "false")
+    return cfg
