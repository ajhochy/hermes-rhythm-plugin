+        assert result.enabled is False
+
+    def test_disabled_plugin_rejects_all_deliveries(self, disabled_intake_config, fake_kanban):
+        result = intake_pipeline.ingest(OPENED, store=fake_kanban, config=disabled_intake_config)
+        assert result.outcome == "disabled"
+        assert fake_kanban.all() == []
+
+    def test_disabled_plugin_does_not_mutate_any_state(self, disabled_intake_config, fake_kanban, fake_hcw):
+        intake_pipeline.ingest(OPENED, store=fake_kanban, config=disabled_intake_config)
+        assert fake_kanban.all() == []
+        assert fake_hcw.recorded_requests == []
+
+    def test_no_env_var_means_disabled(self, monkeypatch, fake_kanban):
