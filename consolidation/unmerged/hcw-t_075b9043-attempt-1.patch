+"""RED contract tests: envelope validation, typed provenance, deterministic
+serialization, stable canonical identity, and Kanban record creation/update.
+
+All tests fail because plugins/github_intake production code is absent.
+No GitHub API or real Kanban service is ever contacted.
+"""
+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+from typing import Any
+
+import pytest
+
+from plugins.github_intake import pipeline as intake_pipeline  # type: ignore[import]
+from plugins.github_intake import models as intake_models  # type: ignore[import]
+
+from .fixtures.github_payloads import (
+    OPENED,
+    EDITED,
+    CLOSED,
+    REOPENED,
+    UNSUPPORTED_ACTION,
+    UNSUPPORTED_EVENT,
+    DISALLOWED_REPO_PAYLOAD,
+    MALFORMED_MISSING_ACTION,
+    MALFORMED_MISSING_ISSUE,
+    HOSTILE_XSS_TITLE,
+    HOSTILE_SQLI_BODY,
+    HOSTILE_OVERSIZED_TITLE,
+    HOSTILE_SECRET_IN_BODY,
+    ALLOWED_REPO,
+    payload_bytes,
+    signed_headers,
+    WEBHOOK_SECRET,
+)
+
+
+# ---------------------------------------------------------------------------
+# Envelope validation
+# ---------------------------------------------------------------------------
+
+class TestEnvelopeValidation:
+    def test_valid_opened_envelope_passes_validation(self, intake_config):
+        result = intake_pipeline.validate_envelope(OPENED, config=intake_config)
+        assert result.is_valid is True
+        assert result.errors == []
+
+    def test_missing_action_fails_validation(self, intake_config):
+        result = intake_pipeline.validate_envelope(MALFORMED_MISSING_ACTION, config=intake_config)
+        assert result.is_valid is False
+        assert result.errors
+
+    def test_missing_issue_fails_validation(self, intake_config):
+        result = intake_pipeline.validate_envelope(MALFORMED_MISSING_ISSUE, config=intake_config)
+        assert result.is_valid is False
+        assert result.errors
+
+    def test_disallowed_repo_fails_validation(self, intake_config):
+        result = intake_pipeline.validate_envelope(DISALLOWED_REPO_PAYLOAD, config=intake_config)
+        assert result.is_valid is False
+        assert any("repository" in e.lower() or "repo" in e.lower() for e in result.errors)
+
+    def test_unsupported_action_fails_validation(self, intake_config):
+        result = intake_pipeline.validate_envelope(UNSUPPORTED_ACTION, config=intake_config)
+        assert result.is_valid is False
+
+    def test_unsupported_event_type_fails_validation(self, intake_config):
+        result = intake_pipeline.validate_envelope(UNSUPPORTED_EVENT, config=intake_config)
+        assert result.is_valid is False
+
+    def test_hostile_oversized_title_fails_validation(self, intake_config):
+        result = intake_pipeline.validate_envelope(HOSTILE_OVERSIZED_TITLE, config=intake_config)
+        assert result.is_valid is False
+
+    def test_validation_does_not_mutate_payload(self, intake_config):
+        original = copy.deepcopy(OPENED)
+        intake_pipeline.validate_envelope(OPENED, config=intake_config)
+        assert OPENED == original
+
+
+# ---------------------------------------------------------------------------
+# Typed provenance
+# ---------------------------------------------------------------------------
+
+class TestTypedProvenance:
+    def test_opened_envelope_produces_typed_provenance(self, intake_config):
+        record = intake_pipeline.normalize(OPENED, config=intake_config)
+        assert isinstance(record, intake_models.CanonicalIssueRecord)
