+class TestConflictingDeliveries:
+    def test_conflicting_edits_produce_stable_winner(self, intake_config, fake_kanban):
+        r_opened = intake_pipeline.normalize(OPENED, config=intake_config)
+        intake_pipeline.persist_to_kanban(r_opened, store=fake_kanban)
+
+        r_a = intake_pipeline.normalize(CONFLICTING_EDIT_A, config=intake_config)
+        r_b = intake_pipeline.normalize(CONFLICTING_EDIT_B, config=intake_config)
+        intake_pipeline.process_delivery(r_a, store=fake_kanban)
+        intake_pipeline.process_delivery(r_b, store=fake_kanban)
+
+        stored = fake_kanban.get(r_a.canonical_id)
+        assert stored["title"] in ("Conflicting title A", "Conflicting title B")
+        assert len(fake_kanban.all()) == 1
+
+    def test_concurrent_delivery_processing_is_safe(self, intake_config, fake_kanban):
+        """Two threads processing the same issue produce exactly one record."""
+        r_opened_a = intake_pipeline.normalize(OPENED, config=intake_config)
+        r_opened_b = intake_pipeline.normalize(copy.deepcopy(OPENED), config=intake_config)
+
+        errors: list[Exception] = []
+
+        def process(record):
+            try:
+                intake_pipeline.process_delivery(record, store=fake_kanban)
+            except Exception as e:
+                errors.append(e)
+
+        t1 = threading.Thread(target=process, args=(r_opened_a,))
+        t2 = threading.Thread(target=process, args=(r_opened_b,))
+        t1.start()
+        t2.start()
+        t1.join(timeout=5)
+        t2.join(timeout=5)
+
+        assert errors == []
+        assert len(fake_kanban.all()) == 1
+
+    def test_conflicting_edits_do_not_duplicate_record(self, intake_config, fake_kanban):
+        r_opened = intake_pipeline.normalize(OPENED, config=intake_config)
+        intake_pipeline.persist_to_kanban(r_opened, store=fake_kanban)
+
+        for payload in [CONFLICTING_EDIT_A, CONFLICTING_EDIT_B]:
+            r = intake_pipeline.normalize(payload, config=intake_config)
+            intake_pipeline.process_delivery(r, store=fake_kanban)
+
+        assert len(fake_kanban.all()) == 1
