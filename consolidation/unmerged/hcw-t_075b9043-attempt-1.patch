+
+class TestKanbanRecordCreation:
+    def test_opened_creates_new_kanban_record(self, intake_config, fake_kanban):
+        record = intake_pipeline.normalize(OPENED, config=intake_config)
+        result = intake_pipeline.persist_to_kanban(record, store=fake_kanban)
