+        assert record.provenance.repo_owner == "synthetic-org"
+        assert record.provenance.repo_name == "allowed-repo"
+
+
+# ---------------------------------------------------------------------------
+# Deterministic serialization
+# ---------------------------------------------------------------------------
+
+class TestDeterministicSerialization:
