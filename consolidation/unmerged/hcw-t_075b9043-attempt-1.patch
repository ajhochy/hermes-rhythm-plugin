+"""RED deterministic tests for issue lifecycle transitions and concurrency.
+
+Covers: opened, edited, closed, reopened, duplicate, replayed, stale,
+out-of-order, concurrent, and conflicting deliveries.
+
+All tests fail because plugins/github_intake production code is absent.
+"""
+from __future__ import annotations
+
+import copy
+import threading
+from typing import Any
+
+import pytest
+
+from plugins.github_intake import pipeline as intake_pipeline  # type: ignore[import]
+from plugins.github_intake import models as intake_models  # type: ignore[import]
+
+from .fixtures.github_payloads import (
+    OPENED,
+    EDITED,
+    CLOSED,
+    REOPENED,
+    DUPLICATE_OPENED,
+    REPLAY_OPENED,
+    STALE_EDITED,
+    OUT_OF_ORDER_CLOSED_BEFORE_OPENED,
+    CONFLICTING_EDIT_A,
+    CONFLICTING_EDIT_B,
+)
+
+
+# ---------------------------------------------------------------------------
+# Basic lifecycle transitions
+# ---------------------------------------------------------------------------
+
+class TestIssueLifecycleTransitions:
+    def test_opened_creates_record_in_open_state(self, intake_config, fake_kanban):
+        record = intake_pipeline.normalize(OPENED, config=intake_config)
+        intake_pipeline.persist_to_kanban(record, store=fake_kanban)
+        stored = fake_kanban.get(record.canonical_id)
+        assert stored["state"] == "open"
+        assert stored["title"] == "Test issue title"
+
+    def test_edited_updates_title_preserves_canonical_id(self, intake_config, fake_kanban):
+        r_opened = intake_pipeline.normalize(OPENED, config=intake_config)
+        intake_pipeline.persist_to_kanban(r_opened, store=fake_kanban)
+
+        r_edited = intake_pipeline.normalize(EDITED, config=intake_config)
+        intake_pipeline.persist_to_kanban(r_edited, store=fake_kanban)
+
+        assert r_opened.canonical_id == r_edited.canonical_id
+        stored = fake_kanban.get(r_edited.canonical_id)
+        assert stored["title"] == "Updated title"
+        assert stored["state"] == "open"
+
+    def test_closed_transitions_to_closed_state(self, intake_config, fake_kanban):
+        r_opened = intake_pipeline.normalize(OPENED, config=intake_config)
+        intake_pipeline.persist_to_kanban(r_opened, store=fake_kanban)
+
+        r_closed = intake_pipeline.normalize(CLOSED, config=intake_config)
+        intake_pipeline.persist_to_kanban(r_closed, store=fake_kanban)
+        stored = fake_kanban.get(r_closed.canonical_id)
+        assert stored["state"] == "closed"
+
+    def test_reopened_transitions_back_to_open(self, intake_config, fake_kanban):
+        r_opened = intake_pipeline.normalize(OPENED, config=intake_config)
+        intake_pipeline.persist_to_kanban(r_opened, store=fake_kanban)
+        r_closed = intake_pipeline.normalize(CLOSED, config=intake_config)
+        intake_pipeline.persist_to_kanban(r_closed, store=fake_kanban)
+
+        r_reopened = intake_pipeline.normalize(REOPENED, config=intake_config)
+        intake_pipeline.persist_to_kanban(r_reopened, store=fake_kanban)
+        stored = fake_kanban.get(r_reopened.canonical_id)
+        assert stored["state"] == "open"
+
+    def test_one_logical_issue_maps_to_one_canonical_record(self, intake_config, fake_kanban):
+        for payload in [OPENED, EDITED, CLOSED, REOPENED]:
+            record = intake_pipeline.normalize(payload, config=intake_config)
+            intake_pipeline.persist_to_kanban(record, store=fake_kanban)
+        assert len(fake_kanban.all()) == 1
+
+
+# ---------------------------------------------------------------------------
+# Duplicate and replay idempotency
+# ---------------------------------------------------------------------------
+
+class TestDuplicateAndReplay:
+    def test_duplicate_delivery_is_idempotent(self, intake_config, fake_kanban):
+        r1 = intake_pipeline.normalize(OPENED, config=intake_config)
+        result1 = intake_pipeline.persist_to_kanban(r1, store=fake_kanban)
+
+        r2 = intake_pipeline.normalize(DUPLICATE_OPENED, config=intake_config)
+        result2 = intake_pipeline.process_delivery(r2, store=fake_kanban)
+
+        assert result2.outcome == "duplicate" or result2.outcome == "skipped"
+        assert len(fake_kanban.all()) == 1
+
+    def test_replay_of_opened_is_idempotent(self, intake_config, fake_kanban):
+        r1 = intake_pipeline.normalize(OPENED, config=intake_config)
+        intake_pipeline.persist_to_kanban(r1, store=fake_kanban)
+
+        r_replay = intake_pipeline.normalize(REPLAY_OPENED, config=intake_config)
+        result = intake_pipeline.process_delivery(r_replay, store=fake_kanban)
+        assert result.outcome in ("duplicate", "skipped", "idempotent")
+        assert len(fake_kanban.all()) == 1
+
+    def test_equivalent_replay_does_not_change_record(self, intake_config, fake_kanban):
+        r1 = intake_pipeline.normalize(OPENED, config=intake_config)
+        intake_pipeline.persist_to_kanban(r1, store=fake_kanban)
+        before = copy.deepcopy(fake_kanban.get(r1.canonical_id))
+
+        r_replay = intake_pipeline.normalize(REPLAY_OPENED, config=intake_config)
+        intake_pipeline.process_delivery(r_replay, store=fake_kanban)
+        after = fake_kanban.get(r1.canonical_id)
+        assert before == after
+
+    def test_duplicate_delivery_id_is_detected(self, intake_config, fake_kanban):
+        delivery_id = OPENED["_meta"]["delivery_id"]
+        is_new = fake_kanban.mark_delivery_seen(delivery_id)
+        assert is_new is True
+
+        is_new_again = fake_kanban.mark_delivery_seen(delivery_id)
+        assert is_new_again is False
+
+
+# ---------------------------------------------------------------------------
+# Stale deliveries
+# ---------------------------------------------------------------------------
+
+class TestStaleDeliveries:
+    def test_stale_edit_does_not_overwrite_newer_record(self, intake_config, fake_kanban):
+        r_opened = intake_pipeline.normalize(OPENED, config=intake_config)
+        intake_pipeline.persist_to_kanban(r_opened, store=fake_kanban)
+        r_edited = intake_pipeline.normalize(EDITED, config=intake_config)
+        intake_pipeline.persist_to_kanban(r_edited, store=fake_kanban)
+
+        r_stale = intake_pipeline.normalize(STALE_EDITED, config=intake_config)
+        result = intake_pipeline.process_delivery(r_stale, store=fake_kanban)
